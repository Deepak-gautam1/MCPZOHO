				 map PublicService.appInit(String appVersion, int platform)
                 {
                 	versionData = thisapp.AccountsHandler.version_controler(platform,appVersion);
                 	appStrings = thisapp.localisableAppStrings.getEnglish();
                 	appStrings.put("app_version",versionData);
                 	return appStrings;
                 }
				 map PublicService.getKKGuestDetailViewResponse(Map param)
                 {
                 	type = param.get("type").toLong();
                 	if(type == 1)
                 	{
                 		return thisapp.Offers.getOfferCatalogDetailView(param.get("offer_id"));
                 	}
                 	return param;
                 }
				 map PublicService.krispykremeapp(int type, String app_current_version, int platform)
                 {
                 	try 
                 	{
                 		type = type.toLong();
                 		if(type == 1)
                 		{
                 			return thisapp.PublicService.appInit(app_current_version,platform);
                 		}
                 		else if(type == 2)
                 		{
                 			return thisapp.GuestUser.homeResponse();
                 		}
                 		else if(type == 3)
                 		{
                 			return {"data":copy_of_product_catalogue_management.productManagement.getAllProducts("4661594000001750007","4661594000001749003","4661594000002303003","4661594000002096381")};
                 		}
                 		else if(type == 4)
                 		{
                 			return thisapp.Offers.getOfferCatalogDetailView("");
                 		}
                 	}
                 	catch (e)
                 	{
                 		return thisapp.PublicService.appInit("0",1);
                 	}
                 	return null;
                 }
