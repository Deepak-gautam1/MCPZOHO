                 				contentText = contentText + thisapp.loyaltyEngineCSS.membershipLevelCardRange(membershipThreshold.ID,membershipThreshold.Membership_Level,pointsText,if(false,true,false),membershipThreshold.Discount_percentage,membershipThreshold.Description);
                 			}
                 			contentText = contentText + "</div></div>";
                 		}
                 		contentText = contentText + "</div>";
                 		return contentText;
                 	} */
