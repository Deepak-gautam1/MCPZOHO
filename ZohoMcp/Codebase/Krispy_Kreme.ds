				 string crmIntegration.pushCustomersToCrm(String lastName, String email, String phone)
                 {
                 	try 
                 	{
                 		param = {"Last_Name":lastName,"Email":email,"Phone":phone,"Added_Time":zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ss"),"Status":"Active","Loyalty_Brand":2,"Brand_Name":"Krispy Kreme"};
                 		response = zoho.crm.createRecord("Contacts",param);
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="Function - crmIntegration.pushCustomersToCrm - Crm Contact Push Record Response"
                 			error=response
                 		];
                 		return response.get("id");
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - crmIntegration.pushCustomersToCrm",e);
                 	}
                 	return null;
                 }
				 int customerProfile.addNewCustomer(String lastName, String number)
                 {
                 	try 
                 	{
                 		phoneNumber = zoho.loginuser.mobilenumber;
                 		firstChar = lastName.subString(0,1).toUpperCase();
                 		lastNameLength = lastName.toList("").size();
                 		lastName = firstChar + lastName.subString(1,lastNameLength - 1);
                 		try 
                 		{
                 			newCustomer = insert into Customer
                 			[
                 				Added_User=zoho.loginuser
                 				Name=lastName
                 				Status="Active"
                 				Phone_Number=phoneNumber
                 				Phone_Encrypted=phoneNumber
                 				Gender="Prefer not to say"
                 				Market=Market[Market_From_Catalog.Market_ID == 4].Market_From_Catalog
                 			];
                 			if(isNumber(newCustomer))
                 			{
                 				history = insert into Member_History
                 				[
                 					Added_User=zoho.loginuser
                 					Customer=newCustomer
                 					Start_Time=zoho.currenttime
                 				];
                 			}
                 		}
                 		catch (e)
                 		{
                 			thisapp.ErrorHandling.catchCall("KK Function - customerProfile.addNewCustomer - Duplicate Call",e);
                 			return Customer[Phone_Number == number].ID;
                 		}
                 		relatedCRMID = thisapp.crmIntegration.pushCustomersToCrm(lastName,"",number);
                 		customerPoints = insert into Customer_Points_System
                 		[
                 			Added_User=zoho.loginuser
                 			Customer=newCustomer
                 			Total_Points_Burned=0
                 			Total_Points_Earned=0
                 			Available_Points=500
                 			Is_Free_drink_available=true
                 			Membership_Level="Silver"
                 			Free_Drink_Expiry_Date=zoho.currentdate.addMonth(1)
                 			Free_Drink_Status="Available"
                 			Related_CRM_ID=relatedCRMID
                 		];
                 		// 		
                 		return newCustomer;
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - customerProfile.addNewCustomer - Final Catch",e);
                 	}
                 	return null;
                 }
				 int customerProfile.checkLoginUserMobile()
                 {
                 	number = zoho.loginuser.mobilenumber;
                 	if(number != null)
                 	{
                 		customer = Customer[Phone_Number == number];
                 		if(customer.count() > 0)
                 		{
                 			return customer.ID;
                 		}
                 	}
                 	return 0;
                 }
				 void customerProfile.deleteCustomer(String loginUserPhone)
                 {
                 	try 
                 	{
                 		customer = Customer[Phone_Number == loginUserPhone];
                 		customer.Status="In Active";
                 		endTime = zoho.currenttime;
                 		getHistory = Member_History[Customer == customer.ID] sort by Added_Time desc,ID;
                 		getHistory.End_Time=endTime;
                 		getHistory.No_of_Days=getHistory.Start_Time.daysBetween(endTime);
                 		thisapp.crmIntegration.deleteCrmContact(customer.Customer_Points_System_Total_Points_Earned.Related_CRM_ID);
                 		thisapp.portal.deleteUser(loginUserPhone);
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - customerProfile.deleteCustomer",e);
                 	}
                 }
