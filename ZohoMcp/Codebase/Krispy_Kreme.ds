		workflow
		{
		form
		{
			On_Success_Customer as "On Success - Customer"
			{
				type =  form
				form = Customer

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.crmIntegration.pushCustomersToCrm(input.Name,input.Email,input.Phone_Number);
										customerPoints = insert into Customer_Points_System
										[
											Added_User=zoho.loginuser
											Customer=input.ID
											Total_Points_Burned=0
											Total_Points_Earned=0
											Available_Points=0
											Membership_Level="Silver"
										];
						)
					}
				}

			}
			Update_customer_data as "Update customer data"
			{
				type =  form
				form = Update_Profile
				button = Submit
				on click
				{
					actions 
					{
					on click
					(
						getRec = Customer[Phone_Number == input.Phone_Number];
										if(getRec.count() > 0)
										{
											getRec.Name=input.Name.first_name;
											getRec.Email=input.Email;
										}
										openUrl("#Script:page.refresh","same window");
					)
					}
				}
			}
			Pre_populate_data as "Pre populate data"
			{
				type =  form
				form = Update_Profile

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide ids;
										getRec = Customer[ID == input.ids.toLong()];
										disable Phone_Number;
										if(getRec.count() > 0)
										{
											Customer = getRec.Name;
											input.Email = getRec.Email;
											input.Phone_Number = getRec.Phone_Number;
											// 	input.Image=getRec.Image;
										}
						)
					}
				}

			}
			Prepare_Monile_API_respon as "Prepare Monile API response"
			{
				type =  form
				form = Mobile_API_Response

				record event = on add or edit

				on user input of Api_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Api_Type == "1")
										{
											requestBody = input.Request_Body.toMap();
											input.API_Response = thisapp.fetchRecords.getHomePageResponse(zoho.loginuser.mobilenumber,requestBody.get("local_time"));
										}
										else if(input.Api_Type == "3")
										{
											offerList = thisapp.fetchRecords.getOffers(0);
											if(offerList != null)
											{
												input.API_Response = "[" + offerList + "]";
											}
											else
											{
												input.API_Response = "[]";
											}
										}
										else if(input.Api_Type == "7")
										{
											requestBody = input.Request_Body.toMap();
											transactions = thisapp.OrderHistory.getOrders(zoho.loginuser.mobilenumber,requestBody.get("start_index").toLong(),requestBody.get("end_index").toLong());
											input.API_Response = if(transactions != null && transactions != "","[" + transactions + "]",null);
										}
										else if(input.Api_Type == "8")
										{
											requestBody = input.Request_Body.toMap();
											thisapp.loyaltyEngine.updateCountry(requestBody.get("country"));
										}
										else if(input.Api_Type == "9")
										{
											requestBody = input.Request_Body.toMap();
											input.API_Response = thisapp.loyaltyEngine.updateMembershipLevel(zoho.loginuser.mobilenumber);
										}
										else if(input.Api_Type == "10")
										{
											thisapp.customerProfile.deleteCustomer(zoho.loginuser.mobilenumber);
										}
										else if(input.Api_Type == "11")
										{
											input.API_Response = thisapp.fetchRecords.homeScreenResponse_v2();
										}
										else if(input.Api_Type == "12")
										{
											// 	getCustomer = Customer[Phone_Number == "+971567048172"];
											getCustomer = Customer[Phone_Number == zoho.loginuser.mobilenumber];
											marketID = getCustomer.Market;
											allProducts = copy_of_product_catalogue_management.productManagement.getAllProducts("4661594000001750007",marketID.toString(),"4661594000002303003","4661594000002096381");
											//All_Assets
											allCategory = Map();
											allCategory.put("category_name","All Categories");
											allCategory.put("category_id","all_items");
											categoryData = Map();
											categoryData.put("category_name","All Categories");
											categoryData.put("category_id","all_items");
											categoryData.put("public_image","");
											categoryImageData = Map();
											getAssetImage = Assets[Type_field == 1];
											if(getAssetImage.count() > 0)
											{
												categoryData.put("category_id","all_items");
												categoryData.put("public_image",thisapp.PublicUrl.assets(getAssetImage.ID,thisapp.FileManagement.processImageUrl(getAssetImage.Image)));
												categoryImageData.put("report_name","All_Assets");
												categoryImageData.put("field_name","Image");
												categoryImageData.put("image_src",thisapp.FileManagement.processImageUrl(getAssetImage.Image));
												categoryImageData.put("image_refernce_id",getAssetImage.ID.toString());
											}
											else
											{
												categoryImageData.put("report_name","");
												categoryImageData.put("field_name","");
												categoryImageData.put("image_src","");
												categoryImageData.put("image_refernce_id","");
											}
											categoryData.put("image",categoryImageData);
											allCategory.put("category_data",categoryData);
											allCategory.put("menu_list",{});
											allCategoryList = {allCategory};
											allCategoryList.addAll(allProducts);
											input.API_Response = "[" + allCategoryList + "]";
										}
										else if(input.Api_Type == "13")
										{
											requestBody = input.Request_Body.toMap();
											input.API_Response = copy_of_product_catalogue_management.productManagement.getProductDetailView(requestBody.get("productID"));
										}
										else if(input.Api_Type == "14")
										{
											orderHistory = thisapp.OrderHistory.getOrders("",0,500);
											input.API_Response = if(orderHistory != null,"[" + orderHistory + "]",null);
										}
										else if(input.Api_Type == "15")
										{
											requestBody = input.Request_Body.toMap();
											input.API_Response = thisapp.OrderHistory.getDetailView(requestBody.get("orderID").toLong());
										}
										else if(input.Api_Type == "16")
										{
											input.API_Response = thisapp.Offers.getOffers();
										}
										else if(input.Api_Type == "17")
										{
											input.API_Response = restaurant_management.storemanagement.enableStoreScreenStrings();
										}
										else if(input.Api_Type == "18")
										{
											requestBody = input.Request_Body.toMap();
											customer = Customer[Phone_Number == zoho.loginuser.mobilenumber];
											input.API_Response = restaurant_management.storemanagement.getAllStore("4661594000001750007",customer.Market.toString(),requestBody.get("local_time"));
											/* 		customer = Customer[Phone_Number == "+971567048172"];
											input.API_Response = restaurant_management.storemanagement.getAllStore("4661594000001750007",customer.Market.toString(),"09-Jan-2020 00:00:00"); */
										}
										else if(input.Api_Type == "19")
										{
											loginUserCountry = Customer[Phone_Number == zoho.loginuserid].Market.Code;
											// 	loginUserCountry = Customer[Phone_Number == "+971567048172"].Market.Code;
											input.API_Response = thisapp.profile.getProfileMenuData(1);
										}
										else if(input.Api_Type == "20")
										{
											allMarkets = thisapp.MarketHandler.getAllMarkets();
											input.API_Response = allMarkets;
										}
										else if(input.Api_Type == "21")
										{
											requestBody = input.Request_Body.toMap();
											thisapp.MarketHandler.changeMarket(requestBody.get("market_code"));
										}
										else if(input.Api_Type == "22")
										{
											thisapp.customerProfile.deleteCustomer(zoho.loginuser.mobilenumber);
										}
										else if(input.Api_Type == "23")
										{
											input.API_Response = thisapp.Offers.getOfferCatalogMobile_currentVersion();
										}
										else if(input.Api_Type == "24")
										{
											input.API_Response = "[" + thisapp.FileManagement.getImagesToBePreLoaded() + "]";
										}
										else if(input.Api_Type == "25")
										{
											requestBody = input.Request_Body;
											requestBody = requestBody.toMap();
											orderHistory = thisapp.OrderHistory.getOrders("",requestBody.get("start_index"),requestBody.get("end_index"));
											input.API_Response = if(orderHistory != null,"[" + orderHistory + "]",null);
										}
										else if(input.Api_Type == "26")
										{
											requestBody = input.Request_Body.toMap();
											offerID = requestBody.get("offer_id");
											input.API_Response = thisapp.Offers.getOfferCatalogDetailView(offerID);
										}
						)
					}
				}

			}
			update_product_details as "update product details"
			{
				type =  form
				form = Orders

				record event = on add or edit

				on user input of Line_Items.Product
				{
					actions 
					{
						custom deluge script
						(
											currency = input.Currency;
										if(row.Product != null)
										{
											priceList = Product_Price_List[Product == row.Product && Currency_Type == currency];
											if(priceList.count() > 0)
											{
												price = priceList.Price;
												row.Price=price;
											}
											qty = row.Qty;
											if(qty == null || qty <= 0)
											{
												qty = 1;
												row.Qty=1;
											}
											row.Total=price * qty;
											input.Total_Amount = input.Line_Items.sum(Total);
										}
						)
					}
				}

			}
			update_price_details as "update price details"
			{
				type =  form
				form = Orders

				record event = on add or edit

				on user input of Line_Items.Qty
				{
					actions 
					{
						custom deluge script
						(
											currency = input.Currency;
										if(row.Product != null)
										{
											price = row.Price;
											if(price != null)
											{
												qty = row.Qty;
												if(qty == null || qty <= 0)
												{
													qty = 1;
													row.Qty=1;
												}
												row.Total=price * qty;
												input.Total_Amount = input.Line_Items.sum(Total);
											}
										}
						)
					}
				}

			}
			user_input_action as "user input action"
			{
				type =  form
				form = Offers

				record event = on add or edit

				on user input of Offer_Based_On
				{
					actions 
					{
						custom deluge script
						(
											offerBasedOn = input.Offer_Based_On;
										if(offerBasedOn == "Category Level")
										{
											// 	show Category;
											// 	hide Membership_Level;
											// 	hide Customer;
										}
										else if(offerBasedOn == "Membership Level")
										{
											// 	show Membership_Level;
											// 	 Category;
											// 	hide Customer;
											enable Membership_Level;
											input.Membership_Level = "";
											hide Customers;
										}
										else if(Offer_Based_On == "Individual Offer - Platinum")
										{
											// 	show Customer;
											// 	hide Category;
											// 	hide Membership_Level;
											show Customers;
											userList = List();
											platinumCus = Customer_Points_System[Membership_Level == "Platinum"];
											for each  user in platinumCus
											{
												userList.add(user.Customer.Name);
											}
											input.Customers:ui.add(userList);
											disable Membership_Level;
											input.Membership_Level = "Platinum";
										}
										else
										{
											hide Customers;
											enable Membership_Level;
											input.Membership_Level = "";
											// 	hide Category;
											// 	hide Membership_Level;
											// 	hide Customer;
										}
						)
					}
				}

			}
