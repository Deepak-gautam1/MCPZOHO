		}
	}


		 functions
		 {
			 Deluge
			 {
				 void deleteProducts(Add_Product product)
                 {
                 	for each  rec in product
                 	{
                 		delete from Joining_Rules[Product == product];
                 		delete from Add_Product[ID == product];
                 	}
                 }
				 string formatDate(date dateValue)
                 {
                 	strDate = dateValue.toString();
                 	splitted = strDate.toList(" ").get(0).toList("-");
                 	return splitted.get(1) + " " + splitted.get(0) + ", " + splitted.get(2);
                 }
				 string formatRestaurantPhone(String phone)
                 {
                 	sample = phone;
                 	if(sample.toList("").size() >= 14)
                 	{
                 		sample = sample.replaceAll(" ","");
                 		firstPortion = sample.subString(0,4);
                 		secondPortion = sample.subString(4,6);
                 		thirdPortion = sample.subString(6,9);
                 		fourthPortion = sample.subString(9);
                 		return firstPortion + " " + secondPortion + " " + thirdPortion + " " + fourthPortion;
                 	}
                 	else
                 	{
                 		return sample;
                 	}
                 }
				 string getMonth(int monthIndex)
                 {
                 	months = {"January","February","March","April","May","June","July","August","September","October","November","December"};
                 	monthIndex = monthIndex - 1;
                 	if(monthIndex <= months.size())
                 	{
                 		return months.get(monthIndex);
                 	}
                 	return null;
                 }
				 void updateEncryptedPhoneNumberOnTransaction()
                 {
                 	data = Transaction[ID != 0];
                 	for each  rec in data
                 	{
                 		rec.Phone_Number=rec.Customer.Phone_Number;
                 	}
                 }
				 map AccountsHandler.version_controler(int platformType, String currentUsrVersion)
                 {
                 	localisibleStrings = Map();
                 	localisibleStrings.put("title","App update Required!");
                 	localisibleStrings.put("description","Our latest update includes new features and bug fixes for more seamless experience");
                 	localisibleStrings.put("update_button_text","Update App");
                 	localisibleStrings.put("skip_button_text","Skip");
                 	platforms = {"android","ios"};
                 	versions = {{"platform":"android","latest_version":"1.1.1","force_updates_needed_for":{},"nonenforcement_update_for":{},"popup_needed":true,"should_logout":false},{"platform":"ios","latest_version":"1.1.1","force_updates_needed_for":{},"nonenforcement_update_for":{},"popup_needed":true,"should_logout":false}};
                 	targetedPlatform = platforms.get(platformType - 1);
                 	for each  versionData in versions
                 	{
                 		if(versionData.get("platform") == targetedPlatform)
                 		{
                 			if(currentUsrVersion == versionData.get("latest_version"))
                 			{
                 				return {"is_upto_date":true};
                 			}
                 			else
                 			{
                 				forceUpdatedFor = versionData.get("force_updates_needed_for");
                 				if(forceUpdatedFor.isText() == true && forceUpdatedFor == "all")
                 				{
                 					return {"is_upto_date":false,"force_updated_needed":true,"popup_needed":versionData.get("popup_needed"),"should_logout":versionData.get("should_logout"),"strings":localisibleStrings};
                 				}
                 				else if(forceUpdatedFor.contains(currentUsrVersion))
                 				{
                 					return {"is_upto_date":false,"force_updated_needed":true,"popup_needed":versionData.get("popup_needed"),"should_logout":versionData.get("should_logout"),"strings":localisibleStrings};
                 				}
                 				else
                 				{
                 					nonforcementUpdateFor = versionData.get("nonenforcement_update_for");
                 					if(nonforcementUpdateFor.isText() == true && nonforcementUpdateFor == "all")
                 					{
                 						return {"is_upto_date":false,"force_updated_needed":false,"popup_needed":versionData.get("popup_needed"),"should_logout":versionData.get("should_logout"),"strings":localisibleStrings};
                 					}
                 					else if(nonforcementUpdateFor.contains(currentUsrVersion))
                 					{
                 						return {"is_upto_date":false,"force_updated_needed":false,"popup_needed":versionData.get("popup_needed"),"should_logout":versionData.get("should_logout"),"strings":localisibleStrings};
                 					}
                 					else
                 					{
                 						return {"is_upto_date":true};
                 					}
                 				}
                 			}
                 		}
                 	}
                 	return {};
                 }
				 map americana_brands.getBrand(int brandID)
                 {
                 	allbrands = copy_of_product_catalogue_management.brandsManagement.getAllBrands();
                 	for each  brand in allbrands
                 	{
                 		if(brand.get("brand_id").toLong() == brandID)
                 		{
                 			return brand;
                 		}
                 	}
                 	info allbrands;
                 	return Map();
                 }
				 list appStatements.termsAndCondition(String countryCode, String currency)
                 {
                 	stringList = List();
                 	text1 = Map();
                 	text1.put("value","KRISPY KREME REWARDS PROGRAM");
                 	text1.put("style",1);
                 	stringList.add(text1);
                 	text2 = Map();
                 	text2.put("value","The below terms govern the participation and use of Krispy Kreme  rewards customer loyalty program (“Krispy Kreme/ “Rewards Program”) initiated by Kuwait Food Company (Americana) Restaurant LLC and its affiliates (“Company”) for users joining Krispy Kreme Rewards (“Member”/ “Members”) through Krispy Kreme  mobile app (“Mobile App”) published in " + countryCode + "  (“Territory”).");
                 	text2.put("style",2);
                 	stringList.add(text2);
                 	text3 = Map();
                 	text3.put("value","These terms supersede all other communications with respect to Krispy Kreme Rewards and acceptance of these, terms and conditions is mandatory to be considered as  Krispy Kreme Rewards Member(s).");
                 	text3.put("style",3);
                 	stringList.add(text3);
                 	text4 = Map();
                 	text4.put("value","A Member can earn credits (“Reward Points”) for purchases made at Krispy Kreme in the Territory.");
                 	text4.put("style",3);
                 	stringList.add(text4);
                 	text5 = Map();
                 	text5.put("value","However, Reward Points can be redeemed only through the Peet’s Coffee App for the purchase of free products (the “Rewards”) from a list of rewards (“Rewards catalog”) available correspondingly on the Mobile App.");
                 	text5.put("style",3);
                 	stringList.add(text5);
                 	text6 = Map();
                 	text6.put("value","a. Krispy Kreme Rewards Enrolment ");
                 	text6.put("style",4);
                 	stringList.add(text6);
                 	text7 = Map();
                 	text7.put("value","i. Enrolment in Rewards Program is free of charge, and no initial purchase is required in order to become a Member. ");
                 	text7.put("style",5);
                 	stringList.add(text7);
                 	text8 = Map();
                 	text8.put("value","ii. Customers, at their sole discretion can opt-in to join the program using Krispy Kreme  App and accepting Krispy Kreme’s Rewards terms and conditions.");
                 	text8.put("style",5);
                 	stringList.add(text8);
                 	text9 = Map();
                 	text9.put("value","iii. Rewards Program is enabled only (“Rewards Eligible Locations”) in the Territory.");
                 	text9.put("style",5);
                 	stringList.add(text9);
                 	text10 = Map();
                 	text10.put("value","iv. Phone number verification and Mobile login is essentially required for a  Member, to opt for  Krispy Kreme Rewards. ");
                 	text10.put("style",5);
                 	stringList.add(text10);
                 	text11 = Map();
                 	text11.put("value","v. Members will receive a welcome bonus (\"Free  Doughnut\") on joining  Krispy Kreme Rewards as part of the launch promotion.");
                 	text11.put("style",5);
                 	stringList.add(text11);
                 	text12 = Map();
                 	text12.put("value","vi. Upon enrolment in Krispy Kreme Rewards, the user's/Member profile will be automatically updated in the Krispy Kreme App ");
                 	text12.put("style",5);
                 	stringList.add(text12);
                 	text13 = Map();
                 	text13.put("value","vii. The Company will have the sole discretion to restrict a user from participating in Krispy Kreme Rewards. Any Member, who has been blocked/barred by the Company will not be able to join the Program again. ");
                 	text13.put("style",5);
                 	stringList.add(text13);
                 	text14 = Map();
                 	text14.put("value","viii. A Member who deactivates / deletes its Krispy Kreme Rewards profile, will be entitled to re-enroll for Krispy Kreme Rewards. However, in case of re-joining, any such Member will not be eligible for any additional welcome joining bonus and/or Reward Points accumulated prior to the deactivation or deletion of its profile.");
                 	text14.put("style",5);
                 	stringList.add(text14);
                 	text15 = Map();
                 	text15.put("value","ix. A Member at its sole discretion shall have an option to un-enroll (or opt-out) from Krispy Kreme Rewards program by calling Company’s customer support team. (UAE: +971 600522252)");
                 	text15.put("style",5);
                 	stringList.add(text15);
                 	text16 = Map();
                 	text16.put("value","x. Joining bonus and Reward Points earned in a particular country can be used to redeem rewards from that country’s Rewards Catalogue i.e. Reward Points earned in one country cannot be used to redeem rewards in any other country.");
                 	text16.put("style",5);
                 	stringList.add(text16);
                 	text17 = Map();
                 	text17.put("value","b. App account deletion");
                 	text17.put("style",4);
                 	stringList.add(text17);
                 	text18 = Map();
                 	text18.put("value","i. Members understand and acknowledge that deletion of their Krispy Kreme App account will not completely erase the historical data of their loyalty transactions. Transactional details related to the Member profiles will be retained by the loyalty system even after account deletion. ");
                 	text18.put("style",5);
                 	stringList.add(text18);
                 	text19 = Map();
                 	text19.put("value","ii. Upon deletion of a Member’s Krispy Kreme  App account, its Krispy Kreme Points balance would become zero and the account would remain suspended till the Member re-joins the Krispy Kreme program i.e., no earning/ redemption can be done while an account is inactive");
                 	text19.put("style",5);
                 	stringList.add(text19);
                 	text20 = Map();
                 	text20.put("value","c. Restrictions");
                 	text20.put("style",4);
                 	stringList.add(text20);
                 	text21 = Map();
                 	text21.put("value","i. In case of any illegal activity by a Member, the Company reserves the right to remove a Member from Krispy Kreme Rewards at its sole discretion and without providing a reason or intimation.");
                 	text21.put("style",5);
                 	stringList.add(text21);
                 	text22 = Map();
                 	text22.put("value","ii. In the sole opinion of the Company, if a Member is believed to have abused the privileges or failed to comply with the term of Krispy Kreme Rewards, the Company has the right to permanently deactivate such Member’s profile on Krispy Kreme Rewards/Krispy Kreme App. The Company reserves the right to reset the points balance for any such Members to zero based on its discretion.");
                 	text22.put("style",5);
                 	stringList.add(text22);
                 	text23 = Map();
                 	text23.put("value","d. Earning");
                 	text23.put("style",4);
                 	stringList.add(text23);
                 	text24 = Map();
                 	text24.put("value","i. Members can earn Krispy Kreme Points by placing an order in Krispy Kreme stores within the Territory.");
                 	text24.put("style",5);
                 	stringList.add(text24);
                 	text25 = Map();
                 	text25.put("value","ii. Points can be earned for orders placed only at Rewards eligible locations as per the below rules (“Reward earning rules”) subject to earning limitations as mentioned in sub-section d.iii below:");
                 	text25.put("style",5);
                 	stringList.add(text25);
                 	text26 = Map();
                 	text26.put("value","1. " + countryCode + ": Members can earn 10 points for every 1 " + currency + " spent by them on an order");
                 	text26.put("style",6);
                 	stringList.add(text26);
                 	text27 = Map();
                 	text27.put("value","For Example,");
                 	text27.put("style",7);
                 	stringList.add(text27);
                 	text28 = Map();
                 	text28.put("value","Order Total = 100 " + currency + "");
                 	text28.put("style",8);
                 	stringList.add(text28);
                 	text29 = Map();
                 	text29.put("value","Earned Points = 1000 Points");
                 	text29.put("style",8);
                 	stringList.add(text29);
                 	/* 	text30 = Map();
                 	text30.put("value","Then, potential points earned = 40*(130-13)/10 = 468 Rewards Points rounded to 440 Points. (Lowest multiple of 40 will be applied)");
                 	text30.put("style",7);
                 	stringList.add(text30); */
                 	text32 = Map();
                 	text32.put("value","iii. Earned points have no cash value and are not exchangeable for cash");
                 	text32.put("style",5);
                 	stringList.add(text32);
                 	text33 = Map();
                 	text33.put("value","iv. Members can check their Rewards balance only through Krispy Kreme App published within the Territory. Actual points earned will be automatically calculated and credited to a member's account within 48 hours of order. ");
                 	text33.put("style",5);
                 	stringList.add(text33);
                 	text34 = Map();
                 	text34.put("value","v. f any Member’s account gets blocked/ deactivated / deleted before order confirmation, no Krispy Kreme Rewards points will be credited to such Members ");
                 	text34.put("style",5);
                 	stringList.add(text34);
                 	text35 = Map();
                 	text35.put("value","e. Points expiry");
                 	text35.put("style",4);
                 	stringList.add(text35);
                 	text36 = Map();
                 	text36.put("value","i. Reward Points will be valid for a limited tenure and shall expire on completion of one year from the date of credit to a Member's account. ");
                 	text36.put("style",5);
                 	stringList.add(text36);
                 	text37 = Map();
                 	text37.put("value","f. Redemption");
                 	text37.put("style",4);
                 	stringList.add(text37);
                 	text38 = Map();
                 	text38.put("value","i. Members will be entitled to use their Reward Points balance to obtain a free product from the selected range of products.");
                 	text38.put("style",5);
                 	stringList.add(text38);
                 	text39 = Map();
                 	text39.put("value","ii. Rewards Points, once used for redemption cannot be reversed.");
                 	text39.put("style",5);
                 	stringList.add(text39);
                 	text40 = Map();
                 	text40.put("value","iii. A Krispy Kreme Reward can be redeemed more than once within the same day, provided the Member has balance points for redemption.");
                 	text40.put("style",5);
                 	stringList.add(text40);
                 	text41 = Map();
                 	text41.put("value","g. Rights of the Company");
                 	text41.put("style",4);
                 	stringList.add(text41);
                 	text42 = Map();
                 	text42.put("value","1. The Company reserves the rights to withdraw Krispy Kreme Rewards program and/or alter its terms and conditions at its discretion from time to time without any consent from or prior notice to the Members. The revised terms and condition can be referred on the Krispy Kreme App. ");
                 	text42.put("style",5);
                 	stringList.add(text42);
                 	text43 = Map();
                 	text43.put("value","h. Governing Laws and Jurisdiction");
                 	text43.put("style",4);
                 	stringList.add(text43);
                 	text44 = Map();
                 	text44.put("value","i. The Krispy Kreme Reward program shall be governed by the laws of United Arab Emirates and the Dubai courts will have the exclusive jurisdiction to entertain all disputes and customer concerns related to this program. ");
                 	text44.put("style",5);
                 	stringList.add(text44);
                 	return stringList;
                 }
