			ids
			(
    			type = text
				displayname = "id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_of_Birth
			(
    			type = date
				displayname = "Date of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
    			defaultcountry="ae"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
				Reset
				(
   					type = reset
   					displayname = "Reset"
				)
			}
		}
	}
	reports
	{
		list My_Profile
		{
			displayName = "My Profile"
			show all rows from Customer  [ID == thisapp.customerProfile.checkLoginUserMobile()]  
			(
				Email
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				Customer_Points_System_Total_Points_Earned.ID
				ID
				Phone_Encrypted as "Phone"
				(
					encryption format = show last 4 characters
					show value on click = enable
					displayformat = plainnumber 
				)
				Email_Encrypted as "Email"
				(
					encryption format = show first 4 characters
					show value on click = enable
				)
			)
		}
		default list All_Customers
		{
			displayName = "Loyalty Customers"
			show all rows from Customer  [Status != "Duplicate"]  
			(
				Email
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				Added_Time as "Added Time"
				Customer_Points_System_Total_Points_Earned as "Customer Points System - Total Points Earned"
				custom action "Edit Profile"
				(
	  			workflow = open_update_profile
				show action in edit record menu = true
				column header = "Edit Profile"
				condition = (Phone_Number is not null)
				)
				Name
				Status
				Market
				Image
				Phone_Encrypted as "Phone"
				(
					encryption format = show last 4 characters
					show value on click = enable
					displayformat = plainnumber 
				)
				Email_Encrypted as "Email"
				(
					encryption format = show first 4 characters
					show value on click = enable
				)
				Date_Of_Birth as "Date Of Birth"
				(
					encryption format = hide all
					show value on click = enable
					displayformat = fulldate
				)
			)
			sort by
			(
				Added_Time descending
			)
		}
		default list All_Product_Price_Lists
		{
			displayName = "Price Lists"
			show all rows from Product_Price_List    
			(
				Currency_Type as "Currency Type"
				Price
				Product
				Added_Time as "Added Time"
			)
			group by
			(
				Product ascending
			)
			sort by
			(
				Added_Time ascending
			)
		}
		list CRM_Product
		{
			displayName = "CRM Product"
			show all rows from Add_Product    
			(
				Category
				Product_Name as "Product Name"
				Additional_Notes as "Additional Notes"
				Added_Time as "Added Time"
			)
			sort by
			(
				Added_Time descending
			)
		}
		default list All_Categories
		{
			displayName = "Categories"
			show all rows from Category    
			(
				Category_Name as "Category Name"
				Image
				Display_Sequence_Priority as "Display Sequence Priority"
				Status
				Item_Type as "Item Type"
				Item_Type.Item_Type_Image as "Item Type Image"
				Item_Type.Item_Type as "Item Type (EN)"
				Item_Type.Item_Type_Localized as "Item Type"
				Item_Type.Brand
				Item_Type.Thumbnail_Image as "Thumbnail Image"
			)
			sort by
			(
				Display_Sequence_Priority ascending
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Status == "Active")
				fields = [Status]
				format = "color:#4ea64c;"
				}
				"New Formatting"
				{
				condition = (Status == "In Active")
				fields = [Status]
				format = "color:#e64d3b;"
				}
			)
		}
		default list All_Products
		{
			displayName = "Product List"
			show all rows from Add_Product    
			(
				Category
				Product_Name as "Product Name"
				Description
				Additional_Notes as "Additional Notes"
				Display_Sequence_Priority as "Display Priority Seq"
				ID_Link as "ID Link"
				Home_Screen_Sequence_Priority as "Home Screen Seq Priority"
				Price
				Product_From_Catalog as "Product Name"
				Product_From_Catalog.Image_Mobile as "Image Mobile"
				Product_From_Catalog.Market_Lookup as "Market"
				Product_From_Catalog.Item_Type_Lookup as "Item Type"
				Product_From_Catalog.Price
				Product_From_Catalog.Description as "Description (EN)"
				Product_From_Catalog.Description_Localized as "Description"
			)
			sort by
			(
				Display_Sequence_Priority ascending
			)
			custom actions
			(
				"Delete Products"
				(
	  			workflow = delete_products1
				show action in view header = true
				show action in edit record menu = true
				execute action for collection of records
				confirmation before execution
				(
					message for multiple records = "Execute the Delete action for the selected ${record_count} products?\n\nDeleting a product will remove it from all other dependencies, which may affect Free drinks and Loyalty Engine functionalities. This action cannot be undone."
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				"Status Change"
				(
	  			workflow = Activity_Status_Change
				show action in view header = true
				show action in edit record menu = true
				)
				"Status changes"
				(
	  			workflow = Multiple_Status_Change
				show action in view header = true
				show action in edit record menu = true
				confirmation before execution
				(
					message for multiple records = "Execute the Status changes action for the selected ${record_count} records?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
		}
