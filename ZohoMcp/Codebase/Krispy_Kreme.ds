				 map Offers.validateOfferCatalog(Map redemptionPrompt, Customer_Points_System loyaltyPointSystem)
                 {
                 	try 
                 	{
                 		availableLoyaltyPoints = loyaltyPointSystem.Available_Points.toLong();
                 		offerCatalogValidation = Map();
                 		overallDiscountAmount = 0;
                 		overallRedeemedPoints = 0;
                 		for each  redemptionData in redemptionPrompt
                 		{
                 			appliedPromotionCode = redemptionData.get("promotion_code");
                 			redeemableItems = redemptionData.get("redeemable_items");
                 			offerCatalog = Catalog_Offer[Promotion_Code == appliedPromotionCode && Points_threshold <= availableLoyaltyPoints];
                 			if(offerCatalog.count() > 0)
                 			{
                 				availableGroups = offerCatalog.Available_Groups.toList();
                 				if(redeemableItems.size() == availableGroups.size())
                 				{
                 					isPromotionCodeHasMandatoryItem = false;
                 					approvedItemsCount = 0;
                 					totalPrice = 0;
                 					for each  redeemableItem in redeemableItems
                 					{
                 						for each  offerItems in offerCatalog.Items
                 						{
                 							if(offerItems.Item.Link_ID == redeemableItem.get("product_id").toLong() && availableGroups.contains(offerItems.Group))
                 							{
                 								availableGroups.removeElement(offerItems.Group);
                 								approvedItemsCount = approvedItemsCount + 1;
                 								totalPrice = totalPrice + offerItems.Item.Price;
                 								break;
                 							}
                 						}
                 					}
                 					if(approvedItemsCount == offerCatalog.Number_Of_Selections)
                 					{
                 						overallDiscountAmount = overallDiscountAmount + totalPrice;
                 						overallRedeemedPoints = overallRedeemedPoints + offerCatalog.Points_threshold;
                 						if(overallRedeemedPoints > availableLoyaltyPoints)
                 						{
                 							offerCatalogValidation.put("is_available",false);
                 							offerCatalogValidation.put("message","Given redemptionPrompt is not eligible for this customer");
                 							return offerCatalogValidation;
                 						}
                 					}
                 					else
                 					{
                 						offerCatalogValidation.put("is_available",false);
                 						offerCatalogValidation.put("message"," Invalid items / Some items seems to be missing");
                 						return offerCatalogValidation;
                 					}
                 				}
                 				else
                 				{
                 					offerCatalogValidation.put("is_available",false);
                 					offerCatalogValidation.put("message","Invalid Items count");
                 					return offerCatalogValidation;
                 				}
                 			}
                 			else
                 			{
                 				offerCatalogValidation.put("is_available",false);
                 				offerCatalogValidation.put("message","Given Promotion Code is not eligible for this customer");
                 				return offerCatalogValidation;
                 			}
                 		}
                 		offerCatalogValidation.put("is_available",true);
                 		offerCatalogValidation.put("price",overallDiscountAmount);
                 		offerCatalogValidation.put("redeemable_points",overallRedeemedPoints);
                 		return offerCatalogValidation;
                 	}
                 	catch (exception)
                 	{
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="KK : Function - offers.validateOfferCatalog"
                 			error=exception
                 		];
                 		offerCatalogValidation.put("is_available",false);
                 		offerCatalogValidation.put("message","Error occured please contatct your developer");
                 		return offerCatalogValidation;
                 	}
                 	offerCatalogValidation.put("is_available",false);
                 	offerCatalogValidation.put("message","Could not process your request, please ensure your request param in valid");
                 	return offerCatalogValidation;
                 }
				 map Offers.validateRedeemableItem(Map redemptionPrompt, Customer_Points_System loyaltyPointSystem)
                 {
                 	try 
                 	{
                 		redeemableProductValidation = Map();
                 		redeemingProduct = redemptionPrompt.get("product_id");
                 		eligibleProductList = Redeem_Points[Points_threshold <= loyaltyPointSystem.Available_Points.toLong()];
                 		isProductEligible = false;
                 		price = 0;
                 		redeemablePoints = 0;
                 		for each  productlist in eligibleProductList
                 		{
                 			for each  productLine in productlist.Redeemable_Products
                 			{
                 				if(productLine.Product.ID.toString() == redeemingProduct)
                 				{
                 					isProductEligible = true;
                 					price = productLine.Product.Price.toString().toDecimal();
                 					redeemablePoints = productlist.Points_threshold;
                 					break;
                 				}
                 			}
                 		}
                 		redeemableProductValidation.put("is_available",isProductEligible);
                 		redeemableProductValidation.put("price",price);
                 		redeemableProductValidation.put("redeemable_points",redeemablePoints);
                 		return redeemableProductValidation;
                 	}
                 	catch (exception)
                 	{
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="offers.validateRedeemableItem"
                 			error=exception
                 		];
                 	}
                 	return null;
                 }
				 map OrderHistory.getDetailView(int orderID)
                 {
                 	getOrder = Transaction[ID == orderID];
                 	if(getOrder.count() > 0)
                 	{
                 		orderedItemsList = List();
                 		for each  lineItems in getOrder.Ordered_Items
                 		{
                 			if(lineItems.Product_Name != null)
                 			{
                 				orderedItem = Map();
                 				orderedItem.put("id",lineItems.Product_Name + "");
                 				orderedItem.put("name",lineItems.Product_Name.Name);
                 				orderedItem.put("price",lineItems.Product_Name.Price);
                 				orderedItem.put("loyalty_reference",lineItems.Product_Name.Loyalty_Reference + "");
                 				orderedItem.put("image_src",thisapp.FileManagement.processImageUrl(lineItems.Product_Name.Image_Mobile));
                 				orderedItem.put("currency","AED");
                 				orderedItem.put("quantity",lineItems.Qty);
                 				orderedItem.put("total_price",lineItems.Total);
                 				orderedItemsList.add(orderedItem);
                 			}
                 		}
                 		paymentHistory = Map();
                 		paymentHistory.put("invoice_amount",getOrder.Total_Invoice_Amount);
                 		paymentHistory.put("total_amount",getOrder.Total_Purchase_Amount);
                 		paymentHistory.put("discount",{"coupen_used":"SUMMER2024","discounted_amount":getOrder.Total_Discount_Amount});
                 		paymentHistory.put("shipping","Free");
                 		orderHistoryDetailView = Map();
                 		orderHistoryDetailView.put("order_id",if(getOrder.Order_ID != null,"Order #" + getOrder.Order_ID,"Order #ORD4794998759"));
                 		orderHistoryDetailView.put("transaction_time",getOrder.Transaction_Time);
                 		// 		orderHistoryDetailView.put("order_id","Order #ORD4794998759");
                 		orderHistoryDetailView.put("order_currency","AED");
                 		restaurantDetail = Map();
                 		restaurantDetail.put("restaurant_name",getOrder.Restaurant_From_Manager.Restaurant_Name);
                 		restaurantDetail.put("restaurant_id",getOrder.Restaurant_From_Manager.toString());
                 		//
                 		basicStore = Map();
                 		basicStore.put("id",getOrder.Restaurant_From_Manager.toString());
                 		basicStore.put("restaurant_name",getOrder.Restaurant_From_Manager.Restaurant_Name);
                 		basicStore.put("address",getOrder.Restaurant_From_Manager.Address);
                 		basicStore.put("menu_description","Donuts, Desserts, Coffee");
                 		storeImageBasic = Map();
                 		storeImageBasic.put("report_name","All_Stores");
                 		storeImageBasic.put("field_name","Restaurant_Management.Home_Image");
                 		storeImageBasic.put("image_refernce_id",getOrder.Restaurant_From_Manager.Loyalty_Reference.toString());
                 		storeImageBasic.put("image_src",thisapp.FileManagement.processImageUrl(getOrder.Restaurant_From_Manager.Home_Image));
                 		if(getOrder.Restaurant_From_Manager.Phone_Number != null)
                 		{
                 			basicStore.put("phone",toString(restaurant_management.formater.Format_Phone(toString(getOrder.Restaurant_From_Manager.Phone_Number))));
                 		}
                 		else
                 		{
                 			basicStore.put("phone",toString(getOrder.Restaurant_From_Manager.Phone_Number));
                 		}
                 		basicStore.put("image",storeImageBasic);
                 		orderHistoryDetailView.put("basic_store",basicStore);
                 		//
                 		orderHistoryDetailView.put("restaurant",restaurantDetail);
                 		orderHistoryDetailView.put("ordered_items",orderedItemsList);
                 		orderHistoryDetailView.put("payment_history",paymentHistory);
                 		loyaltySummary = Map();
                 		loyaltySummary.put("points_before_order","+ " + getOrder.Available_Points_Before_Cancellation.toLong() + " Pts");
                 		purchasePoints = getOrder.Earned_Loyalty_Points;
                 		if(purchasePoints > 0)
                 		{
                 			//Earn Case
                 			purchasePoints = "+ " + purchasePoints.toLong() + " Pts";
                 		}
                 		else if(purchasePoints < 0)
                 		{
                 			//Refund Case
                 			purchasePoints = "- " + (purchasePoints * -1).toLong() + " Pts";
                 		}
                 		else
                 		{
                 			// No transaction
                 			purchasePoints = "0 pts";
                 		}
                 		loyaltySummary.put("earned_loyalty_points",purchasePoints);
                 		burnedPoints = getOrder.Burned_Points;
                 		if(burnedPoints > 0)
                 		{
                 			//Burn Case
                 			burnedPoints = "- " + burnedPoints.toLong() + " Pts";
                 		}
                 		else if(burnedPoints < 0)
                 		{
                 			// Burn Redund
                 			burnedPoints = "+ " + (burnedPoints * -1).toLong() + " Pts";
                 		}
                 		else
                 		{
                 			burnedPoints = "- 0 Pts";
                 		}
                 		loyaltySummary.put("burned_points",burnedPoints);
                 		loyaltySummary.put("total_points_in_hand","+ " + getOrder.Available_Points.toLong() + " Pts");
                 		orderHistoryDetailView.put("loyalty_summary",loyaltySummary);
                 		return orderHistoryDetailView;
                 	}
                 	return null;
                 }
				 list OrderHistory.getOrders(String loginUserNumber, int startIndex, int endIndex)
                 {
                 	//Example - 4661594000000578128,1,20
                 	try 
                 	{
                 		allTransactions = Transaction[Customer.Phone_Number == zoho.loginuser.mobilenumber] sort by Transaction_Time desc range from startIndex to endIndex;
                 		if(allTransactions.count() > 0)
                 		{
                 			transactionList = List();
                 			for each  transaction in allTransactions
                 			{
                 				exsitence = false;
                 				transactionTime = transaction.Transaction_Time;
                 				for each  transactionRec in transactionList
                 				{
                 					if(transactionRec.get("month_index") == transactionTime.getMonth() && transactionRec.get("year") == transactionTime.getYear())
                 					{
                 						transactionDetail = transactionRec;
                 						transactionRec.put("this_month_earned_points",(transactionRec.get("this_month_earned_points") + transaction.Earned_Loyalty_Points - transaction.Burned_Points).toLong());
                 						transactionHistory = transactionRec.get("transaction_history");
                 						exsitence = true;
                 						break;
                 					}
                 				}
                 				if(!exsitence)
                 				{
                 					transactionDetail = Map();
                 					monthIndex = transactionTime.getMonth();
                 					transactionDetail.put("month",thisapp.getMonth(monthIndex));
                 					transactionDetail.put("year",transactionTime.getYear());
                 					transactionDetail.put("month_index",transactionTime.getMonth());
                 					thisMonthEarnedLoylatyPoints = (transaction.Earned_Loyalty_Points - transaction.Burned_Points).toLong();
                 					transactionDetail.put("this_month_earned_points",thisMonthEarnedLoylatyPoints);
                 					transactionDetail.put("points_suffix","pts");
                 					transactionHistory = List();
                 					transactionDetail.put("transaction_history",transactionHistory);
                 					transactionList.add(transactionDetail);
                 				}
                 				transactionData = Map();
                 				restaurantDetail = Map();
                 				transactionData.put("restaurant",restaurantDetail);
                 				restaurantDetail.put("restaurant_name",transaction.Restaurant_From_Manager.Restaurant_Name);
                 				restaurantDetail.put("restaurant_id",transaction.Restaurant_From_Manager.toString());
                 				//
                 				basicStore = Map();
                 				basicStore.put("id",transaction.Restaurant_From_Manager.toString());
                 				basicStore.put("restaurant_name",transaction.Restaurant_From_Manager.Restaurant_Name);
                 				basicStore.put("address",transaction.Restaurant_From_Manager.Address);
                 				basicStore.put("menu_description","Donuts, Desserts, Coffee");
                 				storeImageBasic = Map();
                 				storeImageBasic.put("report_name","All_Stores");
                 				storeImageBasic.put("field_name","Restaurant_Management.Home_Image");
                 				storeImageBasic.put("image_refernce_id",transaction.Restaurant_From_Manager.Loyalty_Reference.toString());
                 				storeImageBasic.put("image_src",thisapp.FileManagement.processImageUrl(transaction.Restaurant_From_Manager.Home_Image));
                 				transactionData.put("basic_store",basicStore);
                 				transactionData.put("order_type",transaction.Type_field);
                 				if(transaction.Restaurant_From_Manager.Phone_Number != null)
                 				{
                 					basicStore.put("phone",toString(restaurant_management.formater.Format_Phone(toString(transaction.Restaurant_From_Manager.Phone_Number))));
                 				}
                 				else
                 				{
                 					basicStore.put("phone",toString(transaction.Restaurant_From_Manager.Phone_Number));
                 				}
                 				basicStore.put("image",storeImageBasic);
                 				//
                 				transactionData.put("transaction_time",transaction.Transaction_Time.toString());
                 				transactionData.put("type",transaction.Type_field);
                 				transactionData.put("total_purchase_amount",transaction.Total_Purchase_Amount);
                 				transactionData.put("total_discount_amount",transaction.Total_Discount_Amount);
                 				purchasePoints = transaction.Earned_Loyalty_Points;
                 				if(purchasePoints > 0)
                 				{
                 					//Earn Case
                 					purchasePoints = "+ " + purchasePoints.toLong() + " pts";
                 				}
                 				else if(purchasePoints < 0)
                 				{
                 					//Refund Case
                 					purchasePoints = "- " + (purchasePoints * -1).toLong() + " pts";
                 				}
                 				else
                 				{
                 					// No transaction
                 					purchasePoints = "0 pts";
                 				}
                 				transactionData.put("earned_loyalty_points",purchasePoints);
                 				burnedPoints = transaction.Burned_Points;
                 				if(burnedPoints > 0)
                 				{
                 					//Burn Case
                 					burnedPoints = "- " + burnedPoints.toLong() + " pts";
                 				}
                 				else if(burnedPoints < 0)
                 				{
                 					// Burn Redund
                 					burnedPoints = "+ " + (burnedPoints * -1).toLong() + " pts";
                 				}
                 				else
                 				{
                 					burnedPoints = "";
                 				}
                 				transactionData.put("burned_points",burnedPoints);
                 				transactionData.put("overall_points_earned",transaction.Total_Points_Earned.toLong());
                 				transactionData.put("total_points_burned",transaction.Total_Points_Burned.toLong());
                 				transactionData.put("available_points","Wallet Points: " + transaction.Available_Points.toLong());
                 				transactionData.put("order_id",transaction.Order_ID);
                 				transactionData.put("record_id",transaction.ID.toString());
                 				transactionHistory.add(transactionData);
                 			}
                 			return transactionList;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getTransactions",e);
                 	}
                 	return null;
                 }
				 map PhoneNumberHandler.getUserPhone(Customer customer)
                 {
                 	dialingCodes = {{"country":"UAE","code":"+971"},{"country":"KSA","code":"+966"},{"country":"BHR","code":"+973"},{"country":"EGY","code":"+20"},{"country":"KWT","code":"+965"},{"country":"QAT","code":"+974"},{"country":"KAZ","code":"+7"},{"country":"JOR","code":"+962"}};
                 	if(customer == null)
                 	{
                 		customer = Customer[Phone_Number == zoho.loginuser.mobilenumber];
                 	}
                 	phoneNumber = customer.Phone_Number;
                 	for each  dialCode in dialingCodes
                 	{
                 		dialingCode = dialCode.get("code");
                 		if(phoneNumber.startsWith(dialingCode))
                 		{
                 			market = Market[Market_From_Catalog.Code == dialCode.get("country")];
                 			if(market.count() > 0)
                 			{
                 				phone = Map();
                 				phone.put("code",dialingCode);
                 				phone.put("number",phoneNumber.remove(dialingCode));
                 				phone.put("country",thisapp.MarketHandler.createMarketModel(market));
                 				return phone;
                 			}
                 		}
                 	}
                 	return null;
                 }
