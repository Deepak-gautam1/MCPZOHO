				 list fetchRecords.getLetsGetReward(int market)
                 {
                 	getRec = Home_Overview[ID != 0 && Market == input.market];
                 	rewardsList = List();
                 	for each  rewards in getRec
                 	{
                 		rewardsMap = Map();
                 		rewardsMap.put("title",rewards.Title);
                 		rewardsMap.put("description",rewards.Description);
                 		rewardsMap.put("id",rewards.ID.toString());
                 		rewardsMap.put("public_image",thisapp.PublicUrl.rewards(rewards.ID,thisapp.FileManagement.processImageUrl(rewards.Image)));
                 		image = Map();
                 		image.put("image_src",thisapp.FileManagement.processImageUrl(rewards.Image));
                 		image.put("filepath",thisapp.FileManagement.processImageUrl(rewards.Image));
                 		image.put("report_name","All_Home_Overviews");
                 		image.put("field_name","Image");
                 		image.put("id",rewards.ID.toString());
                 		image.put("image_refernce_id",rewards.ID.toString());
                 		rewardsMap.put("image",image);
                 		rewardsList.add(rewardsMap);
                 	}
                 	return rewardsList;
                 }
				 list fetchRecords.getOffers(int loginUserID)
                 {
                 	try 
                 	{
                 		today = zoho.currenttime;
                 		// 		applicableMembership = if(memberShipLevel == "Silver",{"Silver"},if(memberShipLevel == "Gold",{"Silver","Gold"},{"Silver","Gold","Platinum"}));
                 		fetchOffers = Offers[Does_Expiration_Apply == false || Offer_Ends_On >= zoho.currenttime && Status == "Active" || Selected_Customer == loginUserID] sort by Display_Sequence_Priority asc;
                 		if(fetchOffers.count() > 0)
                 		{
                 			offerListData = List();
                 			for each  offer in fetchOffers
                 			{
                 				isExist = false;
                 				for each  existOffer in offerListData
                 				{
                 					if(existOffer.get("offer_category_id") == ifnull(offer.Offer_Group,0))
                 					{
                 						isExist = true;
                 						offerList = existOffer.get("offer_list");
                 						break;
                 					}
                 				}
                 				if(!isExist)
                 				{
                 					offerData = Map();
                 					offerData.put("offer_category",offer.Offer_Group.Offer_Group);
                 					offerData.put("offer_category_id",offer.Offer_Group.toString());
                 					offerList = List();
                 					offerData.put("offer_list",offerList);
                 					offerListData.add(offerData);
                 				}
                 				offerDetail = Map();
                 				offerDetail.put("offer_based_on",offer.Offer_Based_On);
                 				offerDetail.put("membership_level",offer.Membership_Level);
                 				offerCategory = Map();
                 				offerDetail.put("category",offerCategory);
                 				offerCategory.put("category_name",offer.Category.Category_Name);
                 				offerCategory.put("category_id",offer.Category);
                 				offerDetail.put("available_from","From: " + thisapp.formatDate(offer.Offer_Start_From));
                 				offerDetail.put("expires_on",if(offer.Offer_Ends_On != null,"To: " + thisapp.formatDate(offer.Offer_Ends_On),""));
                 				offerDetail.put("does_expiration_applicable",offer.Does_Expiration_Apply);
                 				offerDetail.put("offer_name",offer.Offer_Name);
                 				offerImage = Map();
                 				offerDetail.put("image",offerImage);
                 				offerImage.put("report_name","Offers_Report");
                 				offerImage.put("field_name","Image");
                 				offerImage.put("image_src",thisapp.FileManagement.processImageUrl(offer.Image));
                 				offerImage.put("temp_img_src","");
                 				offerDetail.put("offer_type",offer.Offer_Type);
                 				offerDetail.put("offer_discount",if(offer.Discount_Percentage != null,offer.Discount_Percentage,0).toLong());
                 				freeProducts = List();
                 				for each  freeProduct in offer.Products
                 				{
                 					freeProductData = Map();
                 					freeProductData.put("product",freeProduct.Product_Name);
                 					freeProductData.put("id",freeProduct.ID);
                 					freeProducts.add(freeProductData);
                 				}
                 				offerDetail.put("free_products",freeProducts);
                 				offerDetail.put("id",offer.ID.toString());
                 				offerList.add(offerDetail);
                 			}
                 			/* 		offerData = Map();
                                  		presentOfferList = List();
                                  		futureOfferList = List();
                                  		offerData.put("present_offers",presentOfferList);
                                  		offerData.put("future_offers",futureOfferList); */
                 			/* 		for each  offer in fetchOffers
                                  		{
                                  			offerDetail = Map();
                                  			
                                  			if(offer.Offer_Start_From < today)
                                  			{
                                  				presentOfferList.add(offerDetail);
                                  			}
                                  			else
                                  			{
                                  				futureOfferList.add(offerDetail);
                                  			}
                                  		} */
                 			return offerListData;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getOffers",e);
                 	}
                 	return null;
                 }
