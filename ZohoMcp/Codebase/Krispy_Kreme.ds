			On_Success_Both4 as "On Success - Both"
			{
				type =  form
				form = Customer_Points_System

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											availablePoints = input.Available_Points;
										totalPointsEarned = input.Total_Points_Earned;
										totalPointsBurned = input.Total_Points_Burned;
										if(availablePoints < 0)
										{
											alert "Available points cannot be negative";
											cancel submit;
										}
										else if(availablePoints != totalPointsEarned - totalPointsBurned)
										{
											alert "Calculation mismatch encountered";
											cancel submit;
										}
										else if(totalPointsBurned > totalPointsEarned)
										{
											alert "Total points burned can not be greater than Total points earned";
											cancel submit;
										}
						)
					}
				}

			}
			On_Success_Creation1 as "On Success - Creation"
			{
				type =  form
				form = Transaction

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											try 
										{
											customerData = Customer[Phone_Number == zoho.loginuser.mobilenumber];
											input.Customer = customerData.ID;
											input.Transaction_Time = zoho.currenttime;
											pointsEarned = input.Total_Purchase_Amount * 10;
											loyaltySystem = Customer_Points_System[Customer == customerData.ID];
											input.Available_Points_Before_Cancellation = loyaltySystem.Available_Points;
											loyaltySystem.Total_Points_Earned=loyaltySystem.Total_Points_Earned + pointsEarned;
											loyaltySystem.Total_Points_Burned=loyaltySystem.Total_Points_Burned + input.Burned_Points;
											loyaltySystem.Available_Points=loyaltySystem.Total_Points_Earned - loyaltySystem.Total_Points_Burned;
											input.Earned_Loyalty_Points = pointsEarned;
											input.Total_Points_Earned = pointsEarned;
											input.Total_Points_Burned = 0;
											input.Available_Points = loyaltySystem.Available_Points;
											input.Remaining_Points = pointsEarned;
											input.Utilized_Points = 0;
											input.Status = "Not Utilized";
										}
										catch (e)
										{
											err = insert into ncr_logs
											[
												Added_User=zoho.loginuser
												Title="On_Success_Creation - Order"
												error=e
											];
										}
						)
					}
				}

			}
			Send_Push_Notification as "Send Push Notification"
			{
				type =  form
				form = Push_Notification

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											zoho.pushNotification(zoho.loginuser,input.Title,input.Message,"All_Push_Notifications",input.ID);
						)
					}
				}

			}
			filterItemChoicesBasedOnM as "filterItemChoicesBasedOnMarket"
			{
				type =  form
				form = Catalog_Offer

				record event = on add or edit

				on add row of Items
				{
					actions 
					{
						custom deluge script
						(
											// Itemlist = PartsForm [Vendor == input.Vendor] sort by Product;
										// clear row.Items;
										// row.Items:UI.append(Itemlist.ID.getall());
										row.Market_Lookup=input.Market;
						)
					}
				}

			}
			hide as "hide"
			{
				type =  form
				form = Catalog_Offer

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Items.Market_Lookup;
						)
					}
				}

			}
			populate_product_based_on as "populate product based on market"
			{
				type =  form
				form = Catalog_Offer

				record event = on add or edit

				on add row of Items
				{
					actions 
					{
						custom deluge script
						(
											products = copy_of_product_catalogue_management.KrispyKremeProducts.getProductBasedOnMarket(input.Market);
										clear row.Item;
										row.Item:ui.add(products);
						)
					}
				}

			}
			Update_StatusLabel as "Update - StatusLabel"
			{
				type =  form
				form = Deals

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Start_Date > zoho.currentdate)
										{
											input.Status_Label = "Deal drops in " + abs(input.Start_Date.daysBetween(zoho.currentdate)) + " days";
											input.Is_Redeemable = false;
										}
										else if(input.Start_Date <= zoho.currentdate && input.End_Date >= zoho.currentdate)
										{
											input.Status_Label = "Deal ends in " + abs(zoho.currentdate.daysBetween(input.End_Date)) + " days";
											input.Is_Redeemable = true;
										}
										else if(input.End_Date < zoho.currentdate)
										{
											input.Status_Label = "Expired";
											input.Is_Redeemable = false;
										}
						)
					}
				}

			}
			Hide_Fileds as "Hide Fileds"
			{
				type =  form
				form = Newly_In

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Deeplink_Record_ID;
										hide Type_field;
						)
					}
				}

			}
		}

		schedule
		{
			expire_free_drink as "expire free drink"
			{
				type =  schedule
				form = Customer_Points_System[Is_Free_drink_available == true]
					status = inactive
				start = Free_Drink_Expiry_Date at "00:00:00"
				time zone = "Asia/Dubai"
				on start
				{
					actions 
					{
					on load
					(
						input.Is_Free_drink_available = false;
										input.Free_Drink_Status = "Expired";
					)
					}
				}
			}
			expire_loyalty_points as "expire loyalty points"
			{
				type =  schedule
				form = Transaction[Status == "Not Utilized" || Status == "Partially Utilized"]
					status = inactive
				start = after 180 days from Transaction_Time
				time zone = "Asia/Dubai"
				on start
				{
					actions 
					{
					on load
					(
						overAllCustomPoints = Customer_Points_System[Customer == input.Customer];
										if(overAllCustomPoints.count() > 0)
										{
											initialPoints = overAllCustomPoints.Available_Points;
											overAllCustomPoints.Available_Points=overAllCustomPoints.Available_Points - input.Remaining_Points;
											overAllCustomPoints.Total_Points_Burned=overAllCustomPoints.Total_Points_Burned + input.Remaining_Points;
											response = insert into Transaction
											[
												Added_User=zoho.loginuser
												Order_ID=input.Order_ID
												Restaurant_From_Manager=input.Restaurant_From_Manager
												Type_field="Expiration"
												Earned_Loyalty_Points=0
												Burned_Points=input.Remaining_Points
												Market=overAllCustomPoints.Customer.Market
												Available_Points=overAllCustomPoints.Available_Points
												Customer=overAllCustomPoints.Customer
												Transaction_Time=zoho.currenttime
												Total_Purchase_Amount=0
												Total_Invoice_Amount=0
												Total_Discount_Amount=0
												Available_Points_Before_Cancellation=initialPoints
												Available_Points=overAllCustomPoints.Available_Points
												Total_Points_Earned=overAllCustomPoints.Available_Points - input.Remaining_Points
												Total_Points_Burned=overAllCustomPoints.Total_Points_Burned
											];
											input.Status = "Expired";
										}
					)
					}
				}
			}
			Check_Deal_Status as "Check Deal Status"
			{
				type =  schedule
				start = "2026-08-27 00:05:00"
				frequency = daily
				time zone = "Asia/Dubai"
				on start
				{
					actions 
					{
					on load
					(
						for each  deal in Deals[End_Date > zoho.currentdate]
										{
											// Check if upcoming
											if(deal.Start_Date > zoho.currentdate)
											{
												deal.Status_Label="Starts in " + abs(deal.Start_Date.daysbetween(zoho.currentdate)) + " days";
												deal.Is_Redeemable=false;
											}
											else if(deal.Start_Date <= zoho.currentdate && deal.End_Date >= zoho.currentdate)
											{
												deal.Status_Label="Ends in " + abs(zoho.currentdate.daysbetween(deal.End_Date)) + " days";
												deal.Is_Redeemable=true;
											}
											else if(deal.End_Date < zoho.currentdate)
											{
												Status_Label = "Expired";
												Is_Redeemable = false;
											}
										}
					)
					}
				}
			}
		}



		batchworkflow
		{
			Expire_Free_Drink
			{
    			display name = "Expire Free Drink"
    			type = batchworkflow
    			form = Customer_Points_System[Is_Free_drink_available == true]
    			event = "On Schedule"
    			start = "01-Sep-2024 23:59:59"
    			frequency = daily
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											freeDrinks = Customer_Points_System[Is_Free_drink_available && Free_Drink_Expiry_Date == zoho.currentdate];
										for each  rec in freeDrinks
										{
											rec.Is_Free_drink_available=false;
											rec.Free_Drink_Status="Expired";
										}
						)
					}
    			}
    			on success 
    			{
					actions 
					{
						custom deluge script
						(
											log = insert into ncr_logs
										[
											Added_User=zoho.loginuser
											Title="Schedule - Free Drink Expiration"
											error="Free drink expiration has been completed successfully"
										];
						)
					}
    			}
			}
			Expire_Loyalty_Points
			{
    			display name = "Expire Loyalty Points"
    			type = batchworkflow
    			form = Transaction[Status == "Not Utilized" || Status == "Partially Utilized"]
    			event = "On Schedule"
    			start = "01-Sep-2024 23:59:59"
    			frequency = daily
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											transactions = Transaction[Transaction_Time == zoho.currentdate.subDay(180) && Status == "Not Utilized" || Status == "Partially Utilized"];
										for each  rec in transactions
										{
											overAllCustomPoints = Customer_Points_System[Customer == rec.Customer];
											if(overAllCustomPoints.count() > 0)
											{
												initialPoints = overAllCustomPoints.Available_Points;
												overAllCustomPoints.Available_Points=overAllCustomPoints.Available_Points - rec.Remaining_Points;
												overAllCustomPoints.Total_Points_Burned=overAllCustomPoints.Total_Points_Burned + rec.Remaining_Points;
												response = insert into Transaction
												[
													Added_User=zoho.loginuser
													Order_ID=rec.Order_ID
													Restaurant_From_Manager=rec.Restaurant_From_Manager
													Type_field="Expiration"
													Earned_Loyalty_Points=0
													Burned_Points=rec.Remaining_Points
													Market=overAllCustomPoints.Customer.Market
													Available_Points=overAllCustomPoints.Available_Points
													Customer=overAllCustomPoints.Customer
													Transaction_Time=zoho.currenttime
													Total_Purchase_Amount=0
													Total_Invoice_Amount=0
													Total_Discount_Amount=0
													Expired_Points=rec.Remaining_Points
													Available_Points_Before_Cancellation=initialPoints
													Available_Points=overAllCustomPoints.Available_Points
													Total_Points_Earned=overAllCustomPoints.Available_Points - rec.Remaining_Points
													Total_Points_Burned=overAllCustomPoints.Total_Points_Burned
													Status="Expired"
												];
												rec.Status="Expired";
											}
										}
						)
					}
    			}
    			on success 
    			{
					actions 
					{
						custom deluge script
						(
											log = insert into ncr_logs
										[
											Added_User=zoho.loginuser
											Title="Points Expiration - Schedlule"
											error="PE Schedlule executed successfully"
										];
						)
					}
    			}
			}
		}

