			delete_products1 as "delete products"
			{
				type =  functions
				form = Add_Product
				execution type = collection of records	
				on start
				{
					actions 
					{
						thisapp.deleteProducts(Add_Product);
					}
				}
			}
			Activity_Status_Change as "Activity Status Change"
			{
				type =  functions
				form = Add_Product
				execution type = for each record	
				on start
				{
					actions  (Status == "Active")
					{
					update Add_Product[ID == input.ID]
					[
						Status = "In Active"
					]
					}
				}
			}
			Multiple_Status_Change as "Multiple Status Change"
			{
				type =  functions
				form = Add_Product
				execution type = for each record	
				on start
				{
					actions 
					{
					update Add_Product[ID == input.ID]
					[
						Status = "In Active"
					]
					}
				}
			}
		}
	}
