				 list fetchRecords.getStoreLocations(String country, String localTime)
                 {
                 	try 
                 	{
                 		days = {"Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"};
                 		today = days.get(localTime.toTime().getDayOfWeek() - 1);
                 		getStores = Stores[Hub_Name.Market_Name == country];
                 		if(getStores.count() > 0)
                 		{
                 			storeLocationList = List();
                 			for each  store in getStores
                 			{
                 				storeDetail = Map();
                 				storeDetail.put("store_id",store.Store_ID);
                 				storeDetail.put("restaurant_code",store.Restaurant_ID);
                 				storeDetail.put("restaurant_name",store.Restaurant);
                 				hubDetail = Map();
                 				storeDetail.put("market",hubDetail);
                 				hubDetail.put("market_name",store.Hub_Name.Market_Name);
                 				hubDetail.put("market_id",store.Hub_Name.toString());
                 				areaDetail = Map();
                 				storeDetail.put("area_data",areaDetail);
                 				areaDetail.put("area_name",store.Area.Area_Name);
                 				areaDetail.put("area_id",store.Area.toString());
                 				storeDetail.put("latitude",store.Latitude);
                 				storeDetail.put("longitude",store.Longitude);
                 				storeDetail.put("phone",thisapp.formatRestaurantPhone(store.Phone));
                 				storeDetail.put("opening_time","");
                 				storeDetail.put("closing_time","");
                 				storeImage = Map();
                 				storeDetail.put("image",storeImage);
                 				storeImage.put("report_name","All_Stores");
                 				storeImage.put("field_name","Image");
                 				storeImage.put("image_src",thisapp.FileManagement.processImageUrl(store.Image));
                 				storeDetail.put("restaurant_image","");
                 				storeDetail.put("id",store.ID.toString());
                 				for each  timing in store.Timings
                 				{
                 					if(timing.Day == today)
                 					{
                 						storeStatusString = "";
                 						isOpened = false;
                 						storeDetail.put("opening_time",timing.From);
                 						storeDetail.put("closing_time",timing.To);
                 						fromTime = (zoho.currentdate.toString() + " " + timing.From.toString()).toTime();
                 						toTime = (zoho.currentdate.toString() + " " + timing.To.toString()).toTime();
                 						parsedLocalTime = localTime.toTime();
                 						if(fromTime > toTime)
                 						{
                 							toTime = toTime.addHour(24);
                 							if(parsedLocalTime < fromTime)
                 							{
                 								parsedLocalTime = parsedLocalTime.addHour(24);
                 							}
                 						}
                 						if(fromTime > parsedLocalTime || toTime < parsedLocalTime)
                 						{
                 							fromTimeString = "";
                 							fromSuffixString = "AM";
                 							if(fromTime.getHour() > 12)
                 							{
                 								fromTimeString = fromTime.getHour() - 12;
                 								fromSuffixString = "PM";
                 							}
                 							else
                 							{
                 								fromTimeString = fromTime.getHour();
                 							}
                 							storeStatusString = "Closed (Opens at " + fromTimeString + ":" + if(fromTime.getMinutes() < 10,fromTime.getMinutes() + "0",fromTime.getMinutes()) + " " + fromSuffixString + ")";
                 						}
                 						else if(fromTime <= parsedLocalTime && toTime >= parsedLocalTime)
                 						{
                 							isOpened = true;
                 							toTimeString = "";
                 							toSuffixString = "AM";
                 							if(toTime.getHour() > 12)
                 							{
                 								toTimeString = toTime.getHour() - 12;
                 								toSuffixString = "PM";
                 							}
                 							else if(toTime.getHour() <= 0)
                 							{
                 								toTimeString = "12";
                 							}
                 							else
                 							{
                 								toTimeString = toTime.getHour();
                 							}
                 							storeStatusString = "Open (Closes at " + toTimeString + ":" + if(toTime.getMinutes() < 10,toTime.getMinutes() + "0",toTime.getMinutes()) + " " + toSuffixString + ")";
                 						}
                 						storeDetail.put("store_status",storeStatusString);
                 						storeDetail.put("is_opened",isOpened);
                 						break;
                 					}
                 				}
                 				storeLocationList.add(storeDetail);
                 			}
                 			return storeLocationList;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getStoreLocations",e);
                 	}
                 	return null;
                 }
				 map fetchRecords.homeScreenResponse_v2()
                 {
                 	try 
                 	{
                 		response = Map();
                 		loginUser = Customer[Phone_Number == zoho.loginuser.mobilenumber];
                 		// 		loginUser = Customer[Phone_Number == "+971567048172"];
                 		if(loginUser.count() == 0)
                 		{
                 			response.put("user_type",1);
                 			customerID = thisapp.customerProfile.addNewCustomer(zoho.loginuser,zoho.loginuser.mobilenumber);
                 			loginUser = Customer[ID == customerID];
                 		}
                 		else
                 		{
                 			response.put("user_type",2);
                 			if(loginUser.Status == "In Active")
                 			{
                 				loginUser.Status="Active";
                 				History = insert into Member_History
                 				[
                 					Added_User=zoho.loginuser
                 					Customer=loginUser.ID
                 					Start_Time=zoho.currenttime
                 				];
                 			}
                 		}
                 		customerPointsSystem = Customer_Points_System[Customer == loginUser.ID];
                 		response.put("customer",thisapp.fetchRecords.getCustomerDetails(loginUser,customerPointsSystem));
                 		brand = thisapp.americana_brands.getBrand(21);
                 		if(brand != null)
                 		{
                 			itemTypes = copy_of_product_catalogue_management.allItemTypeManagement.getAllItemType(brand.get("uid"),1,loginUser.Market);
                 			response.put("item_types",itemTypes);
                 		}
                 		response.put("loyalty_points",thisapp.loyaltyData.getLoyaltyPoints(customerPointsSystem));
                 		loyaltyPanelImage = Map();
                 		getAssetImage = Assets[Type_field == 2];
                 		loyaltyPanelImage.put("report_name","All_Assets");
                 		loyaltyPanelImage.put("field_name","Image");
                 		loyaltyPanelImage.put("image_src",thisapp.FileManagement.processImageUrl(getAssetImage.Image));
                 		loyaltyPanelImage.put("image_refernce_id",getAssetImage.ID.toString());
                 		response.put("loylaty_panel_public_img",thisapp.PublicUrl.assets(getAssetImage.ID,thisapp.FileManagement.processImageUrl(getAssetImage.Image)));
                 		response.put("loyalty_panel_image",loyaltyPanelImage);
                 		getCatalogOffers = Catalog_Offer[Points_threshold <= customerPointsSystem.Available_Points.toLong() && Market == loginUser.Market];
                 		response.put("loylaty_rewards_text","Rewards x " + getCatalogOffers.count());
                 		response.put("rewards",thisapp.fetchRecords.getLetsGetReward(loginUser.Market));
                 		response.put("deals",thisapp.Offers.getDeals(loginUser.Market));
                 		// ----------- V2 ----------
                 		try 
                 		{
                 			response.put("today_deals",{"header_text":"Today Deals","deal_list":thisapp.Offers.getDealsByFilter(loginUser.Market,"Today")});
                 			response.put("upcoming_deals",{"header_text":"Upcoming Deals","deal_list":thisapp.Offers.getDealsByFilter(loginUser.Market,"Upcoming")});
                 			response.put("promo_screen",{"show_promo":true,"promo_video_section":thisapp.FileManagement.getVideoLink(3,false)});
                 			response.put("newly_in",{"header_text":"Fresh Drops","newly_in_list":thisapp.Offers.getNewlyIn(loginUser.Market)});
                 		}		catch (e)
                 		{
                 			log = insert into ncr_logs
                 			[
                 				Added_User=zoho.loginuser
                 				Title="KK : Function - HomeScreen - New V2"
                 				error=e
                 			];
                 		}
                 	}	catch (e)
                 	{
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="KK : Function - HomeScreen - New"
                 			error=e
                 		];
                 	}
                 	return response;
                 }
