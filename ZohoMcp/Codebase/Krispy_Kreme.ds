				 string FileManagement.processImageUrl(String image)
                 {
                 	try 
                 	{
                 		if(image != null)
                 		{
                 			image = image.getsuffix("downqual = ");
                 			image = image.getsuffix("\"");
                 			image = image.getprefix("\"");
                 			imageSplits = image.toList("/");
                 			image = imageSplits.get(imageSplits.size() - 1);
                 			return image;
                 		}
                 		else
                 		{
                 			// 			log = insert into ncr_logs
                 			// 			[
                 			// 				Added_User=zoho.loginuser
                 			// 				Title="Function - fileManagement.processImageUrl - Empty Image"
                 			// 			];
                 		}
                 	}
                 	catch (e)
                 	{
                 		// 		thisapp.ErrorHandling.catchCall("Function - fileManagement.processImageUrl - Catch",e);
                 	}
                 	return "";
                 }
