		}
		page Delete_Free_Drink_Rule(int recId)
		{
			displayname = "Delete Free Drink Rule"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet4' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet4()\ncontent\n&lt;%{\n\t%&gt;\n&lt;div style=&quot;text-align: center;padding: 15px 0 0 0;&quot;&gt;\n&lt;svg width=&quot;40&quot; height=&quot;40&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;\n&lt;path d=&quot;M10 15L10 12&quot; stroke=&quot;#33363F&quot; stroke-width=&quot;1.5&quot; stroke-linecap=&quot;round&quot;/&gt;\n&lt;path d=&quot;M14 15L14 12&quot; stroke=&quot;#33363F&quot; stroke-width=&quot;1.5&quot; stroke-linecap=&quot;round&quot;/&gt;\n&lt;path d=&quot;M3 7H21V7C20.0681 7 19.6022 7 19.2346 7.15224C18.7446 7.35523 18.3552 7.74458 18.1522 8.23463C18 8.60218 18 9.06812 18 10V16C18 17.8856 18 18.8284 17.4142 19.4142C16.8284 20 15.8856 20 14 20H10C8.11438 20 7.17157 20 6.58579 19.4142C6 18.8284 6 17.8856 6 16V10C6 9.06812 6 8.60218 5.84776 8.23463C5.64477 7.74458 5.25542 7.35523 4.76537 7.15224C4.39782 7 3.93188 7 3 7V7Z&quot; stroke=&quot;#33363F&quot; stroke-width=&quot;1.5&quot; stroke-linecap=&quot;round&quot;/&gt;\n&lt;path d=&quot;M10.0681 3.37059C10.1821 3.26427 10.4332 3.17033 10.7825 3.10332C11.1318 3.03632 11.5597 3 12 3C12.4403 3 12.8682 3.03632 13.2175 3.10332C13.5668 3.17033 13.8179 3.26427 13.9319 3.37059&quot; stroke=&quot;#33363F&quot; stroke-width=&quot;1.5&quot; stroke-linecap=&quot;round&quot;/&gt;\n&lt;/svg&gt; &lt;/div&gt;\n\n&lt;div style=&quot;text-align: center; font-weight: 500; font-size: 20px; padding: 10px;&quot;&gt;Do you want to delete this product rule from loyalty engine?&lt;/div&gt;\n\n&lt;div style=&quot;text-align: center; font-weight: 400; font-size: 14px; padding: 10px 0 20px 0;&quot;&gt;This may affect Loyalty Engine functionalities. This action cannot be undone.&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n    action = 'ExecuteFunction'\n\n\t\tparameters = '${recId}' \n\t\tfunctionName = 'loyaltyEngine.removeFreeDrinkRule'  \n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttext ='Delete'\n\t\ttype = 'rounded'\n\t\tbgColor = '#FF596F'\n\t\tcornerRadius = '45.5903px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n</zml>"
		}
