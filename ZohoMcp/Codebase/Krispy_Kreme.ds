				 string loyaltyData.getLoyaltyEarningRate(int marketID)
                 {
                 	market = Market[Market_From_Catalog == marketID];
                 	loyaltyRule = Loyalty_Rules[Market_From_Catalog == marketID && Mark_as_Active];
                 	return if(loyaltyRule.count() > 0,"Get " + loyaltyRule.Points_Per_threshold.toLong() + " Points for every " + loyaltyRule.Purchase_threshold.toLong() + " " + market.Market_From_Catalog.Currency_Lookup.Name,"Get 10 Points for every 1 AED");
                 }
				 map loyaltyData.getLoyaltyPoints(Customer_Points_System customerPointsSystem)
                 {
                 	if(customerPointsSystem == null)
                 	{
                 		customerPointsSystem = Customer_Points_System[Customer.Phone_Number == zoho.loginuser.mobilenumber];
                 	}
                 	loayltyPoints = Map();
                 	if(customerPointsSystem.count() > 0)
                 	{
                 		loayltyPoints.put("available_points",customerPointsSystem.Available_Points.toLong());
                 		loayltyPoints.put("total_earned_points",customerPointsSystem.Total_Points_Earned.toLong());
                 		loayltyPoints.put("total_burned_points",customerPointsSystem.Total_Points_Burned.toLong());
                 		loayltyPoints.put("loyalty_earning_rate",thisapp.loyaltyData.getLoyaltyEarningRate(customerPointsSystem.Customer.Market));
                 		return loayltyPoints;
                 	}
                 	loayltyPoints.put("available_points",0);
                 	loayltyPoints.put("total_earned_points",0);
                 	loayltyPoints.put("total_burned_points",0);
                 	return loayltyPoints;
                 }
				 string loyaltyEngine.addZeroPrefix(String mobileNumber)
                 {
                 	dialingCodes = {{"country":"UAE","code":"+971"},{"country":"KSA","code":"+966"},{"country":"BHR","code":"+973"},{"country":"EGY","code":"+20"},{"country":"KWT","code":"+965"},{"country":"QAT","code":"+974"},{"country":"KAZ","code":"+7"},{"country":"JOR","code":"+962"}};
                 	for each  rec in dialingCodes
                 	{
                 		code = rec.get("code");
                 		if(mobileNumber.contains(code))
                 		{
                 			codeRemovedNumber = mobileNumber.remove(code);
                 			return code + "0" + codeRemovedNumber;
                 		}
                 	}
                 	return mobileNumber;
                 }
				 float loyaltyEngine.calculateLoyaltyPoints(Loyalty_Rules loyaltyRule, float purchasedAmount)
                 {
                 	try 
                 	{
                 		if(loyaltyRule.count() > 0)
                 		{
                 			purchaseThreshold = loyaltyRule.Purchase_threshold;
                 			pointsPerThreshold = loyaltyRule.Points_Per_threshold;
                 			return pointsPerThreshold * floor(purchasedAmount / purchaseThreshold);
                 		}
                 		else
                 		{
                 			purchaseThreshold = 1;
                 			pointsPerThreshold = 10;
                 			return pointsPerThreshold * floor(purchasedAmount / purchaseThreshold);
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.calculateLoyaltyPoints",e);
                 	}
                 	return null;
                 }
				 map loyaltyEngine.executeLoyaltyProgramme(Map requestParams)
                 {
                 	try 
                 	{
                 		customerPhone = requestParams.get("phone_number");
                 		if(customerPhone != null)
                 		{
                 			customer = Customer[Phone_Number == customerPhone];
                 			isExistingUser = thisapp.loyaltyEngine.isUserExist(customer);
                 			if(!isExistingUser)
                 			{
                 				customer = Customer[Phone_Number == thisapp.loyaltyEngine.addZeroPrefix(customerPhone)];
                 				isExistingUser = thisapp.loyaltyEngine.isUserExist(customer);
                 			}
                 			if(isExistingUser)
                 			{
                 				loyaltyPoints = Customer_Points_System[Customer == customer.ID];
                 				transactionHistory = Transaction[Customer == customer.ID];
                 				ncrCallType = requestParams.get("type");
                 				if(ncrCallType != null)
                 				{
                 					if(ncrCallType == 3 || ncrCallType == 4 || ncrCallType == 5)
                 					{
                 						transactionData = requestParams.get("transaction");
                 						if(transactionData != null)
                 						{
                 							totalPurchaseAmount = transactionData.get("total_purchase_amount");
                 							totalPointsRedeemed = transactionData.get("total_points_redeemed");
                 							if(ncrCallType == 3)
                 							{
                 								transactionData.put("transaction_type","purchase");
                 								return thisapp.loyaltyEngine.updateLoyaltyPoints(transactionData,customer,loyaltyPoints,transactionHistory);
                 							}
                 							else if(ncrCallType == 5)
                 							{
                 								return thisapp.loyaltyEngine.preOrderApproval(transactionData,customer,loyaltyPoints,transactionHistory);
                 							}
                 							else if(ncrCallType == 4)
                 							{
                 								// 							return thisapp.loyaltyEngine.refundAction(transactionData,customer,loyaltyPoints);
                 								return thisapp.loyaltyEngine.refund_2_0(transactionData,customer,loyaltyPoints);
                 							}
                 						}
                 					}
                 					else if(ncrCallType == 1 || ncrCallType == 2)
                 					{
                 						authorizationResponse = thisapp.loyaltyEngine.getLoyaltyData(customer,loyaltyPoints,transactionHistory);
                 						rewards = authorizationResponse.get("loyalty_details").get("rewards");
                 						// 					rewards.put("membership_discount",thisapp.loyaltyEngine.getMembershipDiscount(loyaltyPoints.Membership_Level,customer.Country,"-1"));
                 						return authorizationResponse;
                 					}
                 				}
                 			}
                 			else
                 			{
                 				response = Map();
                 				response.put("authorized",false);
                 				return response;
                 			}
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.executeLoyaltyProgramme",e);
                 	}
                 	return null;
                 }
				 map loyaltyEngine.getAvailableOffers(Customer customer, Customer_Points_System customerLoysltyPointSystem, Transaction transactionHistory)
                 {
                 	try 
                 	{
                 		memberShipLevel = customerLoysltyPointSystem.Membership_Level;
                 		applicableMembership = if(memberShipLevel == "Silver",{"Silver"},if(memberShipLevel == "Gold",{"Silver","Gold"},{"Silver","Gold","Platinum"}));
                 		utlizedOffers = {};
                 		for each  transaction in transactionHistory
                 		{
                 			for each  orderedItems in transaction.Ordered_Items
                 			{
                 				if(orderedItems.Applied_Offers != null)
                 				{
                 					utlizedOffers.addAll(orderedItems.Applied_Offers);
                 				}
                 			}
                 		}
                 		availabelOffers = Offers[Does_Expiration_Apply == false || Offer_Ends_On >= zoho.currenttime && Membership_Level in applicableMembership || Selected_Customer == customer.ID || Selected_Customer in customer.ID && ID not in utlizedOffers] sort by Display_Sequence_Priority asc;
                 		offersData = Map();
                 		if(availabelOffers.count() > 0)
                 		{
                 			offersData.put("is_available",true);
                 			offersList = List();
                 			offersData.put("available_offers",offersList);
                 			for each  offer in availabelOffers
                 			{
                 				offerDetail = Map();
                 				offerDetail.put("offer_name",offer.Offer_Name);
                 				offerDetail.put("offer_id",offer.ID.toString());
                 				offerDetail.put("description",offer.Description);
                 				offerType = if(offer.Offer_Type == "Flat Discount",1,2);
                 				offerDetail.put("offer_type",offerType);
                 				if(offerType == 1)
                 				{
                 					discountDetails = Map();
                 					offerDetail.put("discount_details",discountDetails);
                 					discountDetails.put("category_name",offer.Category.Category_Name);
                 					discountDetails.put("category_id",offer.Category.toString());
                 					discountDetails.put("discount_percentage",offer.Discount_Percentage);
                 				}
                 				else
                 				{
                 					freeProductsDetail = Map();
                 					offerDetail.put("free_product",freeProductsDetail);
                 					freeProductsDetail.put("category_name",offer.Category.Category_Name);
                 					freeProductsDetail.put("category_id",offer.Category.toString());
                 					productList = List();
                 					freeProductsDetail.put("product_list",productList);
                 					for each  product in offer.Products
                 					{
                 						productDetail = Map();
                 						productDetail.put("product_name",product.Product_Name);
                 						productDetail.put("product_id",product.ID_Link);
                 						productDetail.put("description",product.Description);
                 						productList.add(productDetail);
                 					}
                 				}
                 				offersList.add(offerDetail);
                 			}
                 			return offersData;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.getAvailableOffers",e);
                 	}
                 	return offersData;
                 }
				 list loyaltyEngine.getCustomerOrientedRedemptionList(Customer customer, float availablePoints)
                 {
                 	redemptionRule = Redemption_Rules[Market = customer.Country && Points_threshold > availablePoints] sort by Points_threshold asc range from 1 to 1;
                 	return thisapp.loyaltyEngine.getRedemptionRules(redemptionRule);
                 }
				 map loyaltyEngine.getLoyaltyData(Customer customer, Customer_Points_System customerLoysltyPointSystem, Transaction transactionHistory)
                 {
                 	response = Map();
                 	response.put("authorized",true);
                 	response.put("country",customer.Country.Market_Name);
                 	customerDetail = Map();
                 	response.put("customer",customerDetail);
                 	// 	customerDetail.put("first_name",customer.Name.first_name);
                 	// 	customerDetail.put("last_name",customer.Name.last_name);
                 	customerDetail.put("name",customer.Name);
                 	customerDetail.put("phone_number",customer.Phone_Number);
                 	loyaltyDetails = Map();
                 	response.put("loyalty_details",loyaltyDetails);
                 	rewards = Map();
                 	loyaltyDetails.put("rewards",rewards);
                 	// 	rewards.put("joining_drinks",thisapp.loyaltyEngine.getAvailableFreeDrinks(customer,customerLoysltyPointSystem));
                 	rewards.put("catalog_offers",thisapp.Offers.getCatalogOffres(customerLoysltyPointSystem));
                 	/* 	rewards.put("offers",thisapp.loyaltyEngine.getAvailableOffers(customer,customerLoysltyPointSystem,transactionHistory));
                                  	redeemableItems = thisapp.loyaltyEngine.getRedemptionRules(Redemption_Rules[Market = customer.Country && Points_threshold < customerLoysltyPointSystem.Available_Points]);
                                  	rewards.put("redeemable_items",redeemableItems); */
                 	loyaltyDetails.put("available_points",customerLoysltyPointSystem.Available_Points);
                 	loyaltyDetails.put("total_points_earn",customerLoysltyPointSystem.Total_Points_Earned);
                 	loyaltyDetails.put("total_points_burn",customerLoysltyPointSystem.Total_Points_Burned);
                 	loyaltyDetails.put("membership_level",customerLoysltyPointSystem.Membership_Level);
                 	loyaltyDetails.put("last_redemption_date",if(transactionHistory.count() > 0,transactionHistory.Transaction_Time.toString(),null));
                 	return response;
                 }
				 map loyaltyEngine.getMembershipDiscount(String membershipLevel, int market, String discountID)
                 {
                 	if(discountID != "-1")
                 	{
                 		memberShipDiscount = Membership_Points_System[Membership_Level == membershipLevel && Market == market && Discount_ID == discountID];
                 	}
                 	else
                 	{
                 		memberShipDiscount = Membership_Points_System[Membership_Level == membershipLevel && Market == market];
                 	}
                 	if(memberShipDiscount.count() > 0)
                 	{
                 		discountDetails = Map();
                 		discountPercentage = memberShipDiscount.Discount_percentage;
                 		if(discountPercentage != null && discountPercentage > 0)
                 		{
                 			discountDetails.put("discount_percentage",discountPercentage);
                 			discountDetails.put("discount_id",memberShipDiscount.Discount_ID);
                 			discountDetails.put("description",memberShipDiscount.Discount_description);
                 			return discountDetails;
                 		}
                 	}
                 	return null;
                 }
				 map loyaltyEngine.getOfferDiscountEstimation(int type, Map product, Map offer)
                 {
                 	productPrice = product.get("price").toDecimal();
                 	quantity = product.get("quantity").toLong();
                 	totalPrice = productPrice * quantity;
                 	if(type == 1)
                 	{
                 		product.put("total_product_price",totalPrice);
                 		discount = totalPrice * offer.get("discount_details").get("discount_percentage") / 100;
                 		product.put("discount_amount",discount);
                 		product.put("net_total",totalPrice - discount);
                 	}
                 	else if(type == 2)
                 	{
                 		product.put("total_product_price",totalPrice);
                 		product.put("discount_amount",totalPrice);
                 		product.put("net_total",0);
                 	}
                 	else
                 	{
                 		product.put("total_product_price",totalPrice);
                 		// 		product.put("discount_amount",0);
                 		product.put("net_total",totalPrice);
                 	}
                 	return product;
                 }
				 list loyaltyEngine.getRedemptionRules(Redemption_Rules redemptionRule)
                 {
                 	try 
                 	{
                 		if(redemptionRule.count() > 0)
                 		{
                 			redemptionList = List();
                 			for each  rule in redemptionRule
                 			{
                 				redemptionData = Map();
                 				redemptionData.put("rule_name",rule.Rule_Name);
                 				redemptionData.put("points_threshold",rule.Points_threshold);
                 				redemptionData.put("id",rule.ID);
                 				redemptionData.put("description",rule.Description);
                 				categories = List();
                 				redemptionData.put("redeemable_categories",categories);
                 				for each  category in rule.Category
                 				{
                 					categoryDetails = Map();
                 					categoryDetails.put("category_name",category.Category_Name);
                 					categoryDetails.put("category_id",category.ID);
                 					categories.add(categoryDetails);
                 				}
                 				redemptionList.add(redemptionData);
                 			}
                 			return redemptionList;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.getRedemptionRules",e);
                 	}
                 	return {};
                 }
				 bool loyaltyEngine.isUserExist(Customer customer)
                 {
                 	if(customer.count() > 0)
                 	{
                 		return true;
                 	}
                 	else
                 	{
                 		return false;
                 	}
                 }
				 map loyaltyEngine.preOrderApproval(Map transaction, Customer customer, Customer_Points_System customerLoyaltyPointSystem, Transaction transactionHistory)
                 {
                 	approvalMap = Map();
                 	try 
                 	{
                 		approvalMap.put("authorized",true);
                 		approvalMap.put("is_approved",true);
                 		approvalMap.put("country",customer.Country.Market_Name);
                 		customerData = Map();
                 		approvalMap.put("customer",customerData);
                 		customerData.put("name",customer.Name);
                 		customerData.put("phone_number",customer.Phone_Number);
                 		loyaltyDetails = Map();
                 		approvalMap.put("loyalty_details",loyaltyDetails);
                 		redemptionPrompt = transaction.get("rewards").get("catalog_offer");
                 		totalPurchaseAmount = transaction.get("total_invoice_amount").toDecimal();
                 		totalDiscountAmount = 0;
                 		freeDrinkAmount = 0;
                 		if(redemptionPrompt != null)
                 		{
                 			// 			loyaltyDetails.put("redeemable_item",thisapp.loyaltyEngine.validateFreeDrink(redemptionPrompt,customer,customerLoyaltyPointSystem));
                 			//phase 2
                 			loyaltyDetails.put("redeemable_item",thisapp.Offers.validateOfferCatalog(redemptionPrompt,customerLoyaltyPointSystem));
                 			//final phase
                 			// 			loyaltyDetails.put("test_phase",thisapp.offers.validateOfferCatalog(redemptionPrompt2,customerLoyaltyPointSystem));
                 			if(loyaltyDetails.get("redeemable_item").get("is_available"))
                 			{
                 				freeDrinkAmount = loyaltyDetails.get("redeemable_item").get("price").toDecimal();
                 				if(totalPurchaseAmount > freeDrinkAmount)
                 				{
                 					totalPurchaseAmount = totalPurchaseAmount - freeDrinkAmount;
                 				}
                 				else
                 				{
                 					totalPurchaseAmount = 0;
                 				}
                 				totalDiscountAmount = totalDiscountAmount + freeDrinkAmount;
                 			}
                 			else
                 			{
                 				approvalMap.put("is_approved",false);
                 				approvalMap.put("message",loyaltyDetails.get("redeemable_item").get("message"));
                 			}
                 		}
                 		loyaltyDetails.put("items",thisapp.loyaltyEngine.processItem2(transaction.get("items"),customer,customerLoyaltyPointSystem,transactionHistory));
                 		totalGrandTotal = 0;
                 		itemList = approvalMap.get("loyalty_details").get("items");
                 		/* 		for each  productDiscounted in itemList
                                  		{
                                  			totalPurchaseAmount = totalPurchaseAmount + productDiscounted.get("net_total");
                                  			totalGrandTotal = totalGrandTotal + productDiscounted.get("net_total");
                                  			}
                                  		if(transaction.get("rewards").containKey("membership_discount") && transaction.get("rewards").get("membership_discount") != null)
                                  		{
                                  			discountID = transaction.get("rewards").get("membership_discount").get("discount_id");
                                  			membershipDiscount = thisapp.loyaltyEngine.getMembershipDiscount(customerLoyaltyPointSystem.Membership_Level,customer.Country,discountID);
                                  			if(membershipDiscount != null && itemList.size() > 0)
                                  			{
                                  				totalDiscountAmount = totalDiscountAmount + totalPurchaseAmount * membershipDiscount.get("discount_percentage").toDecimal() / 100;
                                  			}
                                  		} */
                 		approvalMap.put("total_invoice_amount",transaction.get("total_invoice_amount").toDecimal());
                 		approvalMap.put("total_purchase_amount",totalPurchaseAmount);
                 		approvalMap.put("total_discount_amount",totalDiscountAmount);
                 		approvalMap.put("grand_total",transaction.get("total_invoice_amount").toDecimal() - totalDiscountAmount);
                 		loyaltyDetails.put("available_points",customerLoyaltyPointSystem.Available_Points);
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.preOrderApproval",e);
                 	}
                 	return approvalMap;
                 }
				 list loyaltyEngine.processItem2(List productsToBeOrdered, Customer customer, Customer_Points_System CustomerPointsSystem, Transaction transactionHistory)
                 {
                 	offers = thisapp.loyaltyEngine.getAvailableOffers(customer,CustomerPointsSystem,transactionHistory);
                 	processedPoducts = List();
                 	for each  product in productsToBeOrdered
                 	{
                 		if(product.containKey("applied_offer") == true && product.get("applied_offer") != null)
                 		{
                 			appliedOffer = product.get("applied_offer");
                 			appliedOfferID = appliedOffer.get("offer_id");
                 			for each  offer in offers.get("available_offers")
                 			{
                 				appliedOffer.put("is_applied",false);
                 				appliedOffer.put("message","given offer is not available for the user");
                 				if(appliedOfferID == offer.get("offer_id"))
                 				{
                 					appliedOffer.put("description",offer.get("description"));
                 					offerType = offer.get("offer_type");
                 					productModel = Add_Product[ID_Link == product.get("product_id")];
                 					if(offerType == 1)
                 					{
                 						if(productModel.count() > 0)
                 						{
                 							if(productModel.Category == offer.get("discount_details").get("category_id").toLong())
                 							{
                 								appliedOffer.put("is_applied",true);
                 								// 							appliedOffer.put("discount_details",offer.get("discount_details"));
                 								appliedOffer.put("message","discount applied successfully");
                 								processedPoducts.add(thisapp.loyaltyEngine.getOfferDiscountEstimation(1,product,offer));
                 							}
                 							else
                 							{
                 								appliedOffer.put("message","this offer is avilable but not applicable for this product");
                 								processedPoducts.add(thisapp.loyaltyEngine.getOfferDiscountEstimation(3,product,offer));
                 							}
                 						}
                 						else
                 						{
                 							product.put("message","item not availbale");
                 							product.remove("applied_offer");
                 							processedPoducts.add(product);
                 						}
                 					}
                 					else if(offerType == 2)
                 					{
                 						if(productModel.count() > 0)
                 						{
                 							if(productModel.Category == offer.get("free_product").get("category_id").toLong())
                 							{
                 								appliedOffer.put("is_applied",true);
                 								processedPoducts.add(thisapp.loyaltyEngine.getOfferDiscountEstimation(2,product,offer));
                 								appliedOffer.put("message","free with offer applied");
                 							}
                 							else
                 							{
                 								appliedOffer.put("message","this offer is avilable but not applicable for this product");
                 								processedPoducts.add(thisapp.loyaltyEngine.getOfferDiscountEstimation(3,product,offer));
                 							}
                 						}
                 						else
                 						{
                 							product.put("message","item not availbale");
                 							product.remove("applied_offer");
                 							processedPoducts.add(product);
                 						}
                 					}
                 					break;
                 				}
                 			}
                 			if(!appliedOffer.get("is_applied"))
                 			{
                 				appliedOffer.put("message","this offer is not avilable for this user");
                 				processedPoducts.add(thisapp.loyaltyEngine.getOfferDiscountEstimation(3,product,offer));
                 			}
                 		}
                 		else
                 		{
                 			processedPoducts.add(thisapp.loyaltyEngine.getOfferDiscountEstimation(3,product,offer));
                 		}
                 	}
                 	return processedPoducts;
                 }
				 map loyaltyEngine.refund_2_0(Map transaction, Customer customer, Customer_Points_System customerLoysltyPointSystem)
                 {
                 	try 
                 	{
                 		if(transaction.containKey("type"))
                 		{
                 			if(transaction.get("type") == 1)
                 			{
                 				orderTransaction = Transaction[Customer == customer.ID && Order_ID == transaction.get("order_id")] sort by Transaction_Time desc;
                 			}
                 			else
                 			{
                 				orderTransaction = Transaction[Customer == customer.ID] sort by Transaction_Time desc;
                 			}
                 		}
                 		if(orderTransaction.count() > 0 && orderTransaction.Type_field != "Cancellation")
                 		{
                 			avaialablePoints = customerLoysltyPointSystem.Available_Points;
                 			totalEarnedPoints = ifnull(orderTransaction.Earned_Loyalty_Points,0);
                 			totalBurnedPoints = ifnull(orderTransaction.Burned_Points,0);
                 			orderTransaction.Status="Cancelled";
                 			/* 			orderTransaction.Earned_Loyalty_Points=totalEarnedPoints * -1;
                                  			orderTransaction.Burned_Points=totalBurnedPoints * -1; */
                 			transactionID = insert into Transaction
                 			[
                 				Added_User=zoho.loginuser
                 				Customer=customer.ID
                 				Market=customer.Market
                 				Restaurant_From_Manager=orderTransaction.Restaurant_From_Manager
                 				Type_field="Cancellation"
                 				Order_ID=orderTransaction.Order_ID
                 				Total_Purchase_Amount=orderTransaction.Total_Purchase_Amount
                 				Total_Discount_Amount=orderTransaction.Total_Discount_Amount
                 				Total_Invoice_Amount=orderTransaction.Total_Invoice_Amount
                 				Earned_Loyalty_Points=totalEarnedPoints * -1
                 				Burned_Points=totalBurnedPoints * -1
                 				Transaction_Time=zoho.currenttime
                 				Available_Points_Before_Cancellation=customerLoysltyPointSystem.Available_Points
                 			];
                 			customerLoysltyPointSystem.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned - orderTransaction.Earned_Loyalty_Points;
                 			customerLoysltyPointSystem.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned - orderTransaction.Burned_Points;
                 			customerLoysltyPointSystem.Available_Points=customerLoysltyPointSystem.Total_Points_Earned - customerLoysltyPointSystem.Total_Points_Burned;
                 			getTransaction = Transaction[ID == transactionID];
                 			getTransaction.Status="Cancelled";
                 			getTransaction.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned;
                 			getTransaction.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned;
                 			getTransaction.Available_Points=customerLoysltyPointSystem.Available_Points;
                 			if(customerLoysltyPointSystem.Transaction == orderTransaction.ID)
                 			{
                 				customerLoysltyPointSystem.Is_Free_drink_available=true;
                 				customerLoysltyPointSystem.Redeemed_Product=null;
                 				customerLoysltyPointSystem.Transaction=null;
                 			}
                 			thisapp.loyaltyEngine.restoreRemainingPoints(orderTransaction.ID);
                 			return thisapp.loyaltyEngine.getLoyaltyData(customer,customerLoysltyPointSystem,orderTransaction);
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.refund_2_0",e);
                 	}
                 	return null;
                 }
				 void loyaltyEngine.removeFreeDrinkRule(int id)
                 {
                 	delete from Joining_Rules[ID == id];
                 	openUrl("#Script:page.refresh","same window");
                 }
				 void loyaltyEngine.restoreRemainingPoints(int transactionID)
                 {
                 	transaction = Transaction[Transaction_Used_For == transactionID];
                 	for each  rec in transaction
                 	{
                 		rec.Utilized_Points=rec.Utilized_Points - rec.Last_Used_Points;
                 		rec.Remaining_Points=rec.Last_Used_Points;
                 		rec.Transaction_Used_For=null;
                 		if(rec.Remaining_Points == rec.Earned_Loyalty_Points)
                 		{
                 			rec.Status="Not Utilized";
                 		}
                 		else
                 		{
                 			rec.Status="Partially Utilized";
                 		}
                 	}
                 }
				 void loyaltyEngine.updateCountry(String country)
                 {
                 	market = Market[Market_Name == country.toUpperCase()];
                 	if(market.count() > 0)
                 	{
                 		customer = Customer[Phone_Number == zoho.loginuser.mobilenumber];
                 		customer.Country=market.ID;
                 	}
                 	// 	customer = Customer[Email == "as17209217@gmail.com"];
                 	// 	customer.Phone_Number = "+971567480172";
                 }
				 map loyaltyEngine.updateLoyaltyPoints(Map transaction, Customer customer, Customer_Points_System customerLoysltyPointSystem, Transaction transactionHistory)
                 {
                 	try 
                 	{
                 		loyaltyRule = Loyalty_Rules[Market_From_Catalog == customer.Market && Mark_as_Active];
                 		transactionMap = {"joining_points":"Joining Points","purchase":"Purchase","cancellation":"Cancellation"};
                 		transactionType = transactionMap.get(transaction.get("transaction_type"));
                 		if(true)
                 		{
                 			approvalResponse = thisapp.loyaltyEngine.preOrderApproval(transaction,customer,customerLoysltyPointSystem,transactionHistory);
                 			loyaltyDtails = approvalResponse.get("loyalty_details");
                 			if(approvalResponse.get("is_approved"))
                 			{
                 				try 
                 				{
                 					totalPurchaseAmount = approvalResponse.get("total_purchase_amount");
                 					totalDiscountAmount = approvalResponse.get("total_discount_amount");
                 					burnedPoints = 0;
                 					receivedPoints = thisapp.loyaltyEngine.calculateLoyaltyPoints(loyaltyRule,totalPurchaseAmount);
                 					if(burnedPoints <= customerLoysltyPointSystem.Available_Points)
                 					{
                 						transactionEarned = insert into Transaction
                 						[
                 							Added_User=zoho.loginuser
                 							Customer=customer.ID
                 							Phone_Number=customer.Phone_Number
                 							Market=customer.Market
                 							Restaurant_From_Manager=restaurant_management.storemanagement.getRestaurantByID(transaction.get("restaurant_id"))
                 							Type_field=transactionType
                 							Order_ID=transaction.get("order_id")
                 							Total_Purchase_Amount=transaction.get("total_invoice_amount").toDecimal()
                 							Total_Discount_Amount=totalDiscountAmount
                 							Total_Invoice_Amount=totalPurchaseAmount
                 							Earned_Loyalty_Points=receivedPoints
                 							Utilized_Points=0
                 							Remaining_Points=receivedPoints
                 							Transaction_Time=zoho.currenttime
                 							Status="Not Utilized"
                 							Available_Points_Before_Cancellation=customerLoysltyPointSystem.Available_Points
                 						];
                 						if(loyaltyDtails.containKey("redeemable_item"))
                 						{
                 							freeDrink = loyaltyDtails.get("redeemable_item");
                 							if(freeDrink.get("is_available"))
                 							{
                 								redeemablePoints = freeDrink.get("redeemable_points");
                 								/* 								log = insert into ncr_logs
                 								[
                 									Added_User=zoho.loginuser
                 									Title="True value of free item"
                 									error=freeDrink.get("redeemable_points")
                 								]; */
                 								burnedPoints = redeemablePoints;
                 								thisapp.loyaltyEngine.updateRemainingPointsInTransaction(customer.ID,transactionEarned,redeemablePoints);
                 							}
                 						}
                 						getTransaction = Transaction[ID == transactionEarned];
                 						getTransaction.Available_Points=customerLoysltyPointSystem.Available_Points + receivedPoints - burnedPoints;
                 						getTransaction.Burned_Points=burnedPoints;
                 						getTransaction.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned + receivedPoints;
                 						getTransaction.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned + burnedPoints;
                 						itemList = loyaltyDtails.get("items");
                 						for each  purchasedItem in itemList
                 						{
                 							product = Add_Product[Product_From_Catalog.Market_Lookup == customer.Market && Product_From_Catalog.Link_ID == purchasedItem.get("product_id").toLong()];
                 							/* 							log = insert into ncr_logs
                 							[
                 								Added_User=zoho.loginuser
                 								Title="Transcation Items"
                 								error=product + "<br>" + product.Product_From_Catalog
                 							]; */
                 							if(purchasedItem.containKey("applied_offer") && purchasedItem.get("applied_offer") != null)
                 							{
                 								offerData = purchasedItem.get("applied_offer");
                 								if(offerData.get("is_applied"))
                 								{
                 									offerAppliedID = offerData.get("offer_id").toLong();
                 								}
                 								else
                 								{
                 									offerAppliedID = null;
                 								}
                 							}
                 							else
                 							{
                 								offerAppliedID = null;
                 							}
                 							lineItems = insert into Order_Line_Items
                 							[
                 								Added_User=zoho.loginuser
                 								Transaction_ID=transactionEarned
                 								Product_Name=product.Product_From_Catalog
                 								Qty=purchasedItem.get("quantity")
                 								Discount=purchasedItem.get("discount_amount")
                 								Price=purchasedItem.get("price").toDecimal()
                 								Total=purchasedItem.get("net_total").toDecimal()
                 								Applied_Offers=offerAppliedID
                 							];
                 						}
                 					}
                 					customerLoysltyPointSystem.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned + receivedPoints;
                 					customerLoysltyPointSystem.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned + burnedPoints;
                 					customerLoysltyPointSystem.Available_Points=customerLoysltyPointSystem.Available_Points + receivedPoints - burnedPoints;
                 					return thisapp.loyaltyEngine.getLoyaltyData(customer,customerLoysltyPointSystem,getTransaction);
                 				}
                 				catch (e)
                 				{
                 					log = insert into ncr_logs
                 					[
                 						Added_User=zoho.loginuser
                 						Title="Function - loyaltyEngine.updateLoyaltyPoints (Inside)"
                 						error=e
                 					];
                 				}
                 			}
                 		}
                 		return {"message":"Flag not approved","is_approved":false};
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.updateLoyaltyPoints",e);
                 	}
                 	return null;
                 }
				 map loyaltyEngine.updateMembershipLevel(String loginUserNumber)
                 {
                 	loyaltyDetails = Customer_Points_System[Customer.Phone_Number == loginUserNumber];
                 	if(loyaltyDetails.count() > 0)
                 	{
                 		currentLevel = loyaltyDetails.Membership_Level;
                 		if(currentLevel == "Silver" && loyaltyDetails.Available_Points > 2999)
                 		{
                 			loyaltyDetails.Membership_Level="Gold";
                 		}
                 		else if(currentLevel == "Gold" && loyaltyDetails.Available_Points > 7499)
                 		{
                 			loyaltyDetails.Membership_Level="Platinum";
                 		}
                 		return {"request_status":"success","current_level":loyaltyDetails.Membership_Level};
                 	}
                 	return {"request_status":"failed"};
                 }
				 int loyaltyEngine.updatePointsUtlizationHistory(int transactionID, int usedTransactionID, float redeemablePoints, float redeemedPoints, float remainingPoints)
                 {
                 	pointsUtlizationHistory = insert into Points_Utilisation_History
                 	[
                 		Added_User=zoho.loginuser
                 		Transaction_ID=transactionID
                 		Transaction_Utilised_For=usedTransactionID
                 		Redeemable_Points=redeemablePoints
                 		Redeemed_Points=redeemedPoints
                 		Remaining_Points=remainingPoints
                 	];
                 	return pointsUtlizationHistory;
                 }
				 void loyaltyEngine.updateRemainingPointsInTransaction(int customerID, int transactionID, int burnedPoints)
                 {
                 	try 
                 	{
                 		if(burnedPoints > 0)
                 		{
                 			transaction = Transaction[Status in {"Not Utilized","Partially Utilized"} && Customer == customerID] sort by Transaction_Time asc;
                 			retrivedPoints = 0;
                 			for each  thisRecord in transaction
                 			{
                 				if(retrivedPoints <= burnedPoints)
                 				{
                 					thisTransactionPoints = thisRecord.Remaining_Points;
                 					retrivedPoints = retrivedPoints + thisTransactionPoints;
                 					thisRecord.Transaction_Used_For=transactionID;
                 					if(retrivedPoints >= burnedPoints)
                 					{
                 						if(retrivedPoints > burnedPoints)
                 						{
                 							remainingPoints = retrivedPoints - burnedPoints;
                 							thisRecord.Remaining_Points=remainingPoints;
                 							lastUtilisedPoints = thisRecord.Utilized_Points;
                 							thisRecord.Utilized_Points=thisRecord.Earned_Loyalty_Points - remainingPoints;
                 							thisRecord.Last_Used_Points=thisRecord.Utilized_Points - lastUtilisedPoints;
                 							thisRecord.Status="Partially Utilized";
                 							thisapp.loyaltyEngine.updatePointsUtlizationHistory(thisRecord.ID,transactionID,thisTransactionPoints,thisRecord.Last_Used_Points,remainingPoints);
                 						}
                 						else
                 						{
                 							thisRecord.Status="Utilized";
                 							thisRecord.Utilized_Points=thisRecord.Utilized_Points + thisRecord.Remaining_Points;
                 							thisRecord.Remaining_Points=0;
                 							thisRecord.Last_Used_Points=thisTransactionPoints;
                 							thisapp.loyaltyEngine.updatePointsUtlizationHistory(thisRecord.ID,transactionID,thisTransactionPoints,thisTransactionPoints,0);
                 						}
                 						break;
                 					}
                 					else
                 					{
                 						thisRecord.Status="Utilized";
                 						thisapp.loyaltyEngine.updatePointsUtlizationHistory(thisRecord.ID,transactionID,thisTransactionPoints,thisTransactionPoints,0);
                 					}
                 					thisRecord.Utilized_Points=thisRecord.Utilized_Points + thisRecord.Remaining_Points;
                 					thisRecord.Remaining_Points=0;
                 					thisRecord.Last_Used_Points=thisTransactionPoints;
                 				}
                 			}
                 		}
                 	}
                 	catch (e)
                 	{
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="loyaltyEngine.updateRemainingPointsInTransaction"
                 			error=e
                 		];
                 	}
                 }
				 string loyaltyEngineCSS.createContent(int selectedTab)
                 {
                 	marketList = thisapp.loyaltyEngineCSS.getMarkets();
                 	contentText = "";
                 	if(selectedTab == 1)
                 	{
                 		for each  market in marketList
                 		{
                 			contentText = contentText + "<div class=\"rules_container\"><div class=\"container_country_sec\"><span class=\"country_name_div\">" + market + "</span><a class=\"add_new_ic\" href=\"#Form:Joining_Rules?Market=" + market + "&zc_LoadIn=dialog\">+</a></div><div class=\"country_based_rules_list\"> ";
                 			for each  joiningRule in Joining_Rules[Market == market] sort by Mark_as_Active desc
                 			{
                 				if(joiningRule.Joining_Benefit == "Joining Points")
                 				{
                 					contentText = contentText + thisapp.loyaltyEngineCSS.getFreePointsPanelTemplate(joiningRule.ID,joiningRule.Rule_Name,if(joiningRule.Mark_as_Active,true,false),joiningRule.Joining_Points.toLong(),joiningRule.Description);
                 				}
                 				// 				else if(joiningRule.Joining_Benefit in {"Free Product / Drink","Joining Drink","Both"})
                 				// 				{
                 				// 					contentText = contentText + thisapp.loyaltyEngineCSS.getFreeProductTemplate(joiningRule.ID,if(joiningRule.Joining_Benefit == "Both","Free Drink (+) Joining Drink",joiningRule.Joining_Benefit),if(joiningRule.Mark_as_Active,true,false),joiningRule.Product.Product_Name + " - " + joiningRule.Product.ID_Link,joiningRule.Description);
                 				// 				}
                 			}
                 			contentText = contentText + "</div></div>";
                 		}
                 		contentText = contentText + "</div>";
                 		return contentText;
                 	}
                 	else if(selectedTab == 2)
                 	{
                 		for each  market in marketList
                 		{
                 			contentText = contentText + "<div class=\"rules_container\"><div class=\"container_country_sec\"><span class=\"country_name_div\">" + market + "</span><a class=\"add_new_ic\" href=\"#Form:Loyalty_Rules?Market=" + market + "&zc_LoadIn=dialog\">+</a></div><div class=\"country_based_rules_list\"> ";
                 			for each  loyaltyRule in Loyalty_Rules[Market_From_Catalog.Code == market]
