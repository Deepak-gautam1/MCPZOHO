				 int stores.syncStores(int restaurantID)
                 {
                 	getStores = Stores[Restaurant_Management == restaurantID];
                 	if(getStores.count() == 0)
                 	{
                 		store = insert into Stores
                 		[
                 			Added_User=zoho.loginuser
                 			Restaurant_Management=restaurantID
                 		];
                 		return store;
                 	}
                 	return null;
                 }
				 void testEnvironment.checkDuplicates()
                 {
                 	// 	fet_customer = Customer [ ID != null];
                 	// 	info fet_customer.count(ID); //31505
                 	// 	info fet_customer.distinct(Phone_Number).size(); //31500
                 	// 	myList = List();
                 	// 	duplicateList = List();
                 	// 	for each  c in Customer[ID != null] range from 30001 to 40000
                 	// 	{
                 	// 		if(!myList.contains(c.Phone_Number))
                 	// 		{
                 	// 			myList.add(c.Phone_Number);
                 	// 		}
                 	// 		else
                 	// 		{
                 	// 			duplicateList.add(c.Phone_Number);
                 	// 		}
                 	// 	}
                 	// 	info duplicateList;
                 	myList = List();
                 	duplicateList = List();
                 	for each  c in Customer_Points_System[ID != null] range from 30001 to 40000
                 	{
                 		// 		info c.Customer.Phone_Number;
                 		if(!myList.contains(c.Customer.Phone_Number))
                 		{
                 			myList.add(c.Customer.Phone_Number);
                 		}
                 		else
                 		{
                 			duplicateList.add(c.Customer.Phone_Number);
                 		}
                 	}
                 	info duplicateList;
                 }
				 map testEnvironment.checkHomeScreenResponse(String phone)
                 {
                 	response = Map();
                 	loginUser = Customer[Phone_Number == phone];
                 	if(loginUser.count() == 0)
                 	{
                 		response.put("message","No user found");
                 		return response;
                 	}
                 	else
                 	{
                 		response.put("user_type",2);
                 		if(loginUser.Status == "In Active")
                 		{
                 			loginUser.Status="Active";
                 			History = insert into Member_History
                 			[
                 				Added_User=zoho.loginuser
                 				Customer=loginUser.ID
                 				Start_Time=zoho.currenttime
                 			];
                 		}
                 	}
                 	customerPointsSystem = Customer_Points_System[Customer == loginUser.ID];
                 	response.put("customer",thisapp.fetchRecords.getCustomerDetails(loginUser,customerPointsSystem));
                 	brand = thisapp.americana_brands.getBrand(21);
                 	if(brand != null)
                 	{
                 		itemTypes = copy_of_product_catalogue_management.allItemTypeManagement.getAllItemType(brand.get("uid"),1,loginUser.Market);
                 		response.put("item_types",itemTypes);
                 	}
                 	response.put("loyalty_points",thisapp.loyaltyData.getLoyaltyPoints(customerPointsSystem));
                 	loyaltyPanelImage = Map();
                 	getAssetImage = Assets[Type_field == 2];
                 	loyaltyPanelImage.put("report_name","All_Assets");
                 	loyaltyPanelImage.put("field_name","Image");
                 	loyaltyPanelImage.put("image_src",thisapp.FileManagement.processImageUrl(getAssetImage.Image));
                 	loyaltyPanelImage.put("image_refernce_id",getAssetImage.ID.toString());
                 	response.put("loylaty_panel_public_img",thisapp.PublicUrl.assets(getAssetImage.ID,thisapp.FileManagement.processImageUrl(getAssetImage.Image)));
                 	response.put("loyalty_panel_image",loyaltyPanelImage);
                 	getCatalogOffers = Catalog_Offer[Points_threshold <= customerPointsSystem.Available_Points.toLong()];
                 	response.put("loylaty_rewards_text","Rewards x " + getCatalogOffers.count());
                 	response.put("rewards",thisapp.fetchRecords.getLetsGetReward(loginUser.Market));
                 	response.put("deals",thisapp.Offers.getDeals(loginUser.Market));
                 	return response;
                 }
				 map testEnvironment.checkOfferResponse(String phone)
                 {
                 	try 
                 	{
                 		offers = Map();
                 		customerPointsSystem = Customer_Points_System[Customer.Phone_Number == phone];
                 		if(customerPointsSystem.count() == 0)
                 		{
                 			return {"message":"No user found"};
                 		}
                 		offers.put("loyalty_points",thisapp.loyaltyData.getLoyaltyPoints(customerPointsSystem));
                 		catalogOffersList = List();
                 		catalogOffers = Catalog_Offer[ID != 0 && Market == customerPointsSystem.Customer.Market] sort by Points_threshold asc;
                 		if(catalogOffers.count() > 0)
                 		{
                 			for each  offer in catalogOffers
                 			{
                 				offerData = Map();
                 				offerData.put("record_id",offer.ID.toString());
                 				offerData.put("promotion_title",offer.Promotion_Title);
                 				offerData.put("promotion_code",offer.Promotion_Code);
                 				offerData.put("points_threshold",offer.Points_threshold);
                 				offerData.put("points_text",'Points');
                 				offerData.put("available_groups",offer.Available_Groups.toList());
                 				offerData.put("public_image",thisapp.PublicUrl.catalogOffer(offer.ID,thisapp.FileManagement.processImageUrl(offer.Offer_Image)));
                 				offerData.put("redemable_items_text","Redeemable Items");
                 				offerData.put("unlock_text","Unlocked");
                 				offerData.put("lock_text","Locked");
                 				imageData = Map();
                 				imageData.put("report_name","All_Catalog_Offers");
                 				imageData.put("image_refernce_id",offer.ID.toString());
                 				imageData.put("field_name","Offer_Image");
                 				imageData.put("image_src",thisapp.FileManagement.processImageUrl(offer.Offer_Image));
                 				offerData.put("image",imageData);
                 				reedeemableItemsList = Map();
                 				/* 				for each  item in offer.Items
                 				{
                 					rededmableItem = Map();
                 					rededmableItem.put("name",item.Item.Name);
                 				} */
                 				catalogOffersList.add(offerData);
                 			}
                 			offers.put("offers",catalogOffersList);
                 		}
                 		else
                 		{
                 			offers.put("offers",{});
                 		}
                 	}
                 	catch (exception)
                 	{
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="KK : Function - offers.getCatalogOffres"
                 			error=exception
                 		];
                 	}
                 	return offers;
                 }
				 list testEnvironment.checkProductCatalogResponse(string marketId, string channelId)
                 {
                 	allProducts = copy_of_product_catalogue_management.productManagement.getAllProducts("4661594000001750007",marketId,input.channelId,"4661594000002096381");
                 	//All_Assets
                 	allCategory = Map();
                 	allCategory.put("category_name","All Categories");
                 	allCategory.put("category_id","all_items");
                 	categoryData = Map();
                 	categoryData.put("category_name","All Categories");
                 	categoryData.put("category_id","all_items");
                 	categoryData.put("public_image","");
                 	categoryImageData = Map();
                 	getAssetImage = Assets[Type_field == 1];
                 	if(getAssetImage.count() > 0)
                 	{
                 		categoryData.put("category_id","all_items");
                 		categoryData.put("public_image",thisapp.PublicUrl.assets(getAssetImage.ID,thisapp.FileManagement.processImageUrl(getAssetImage.Image)));
                 		categoryImageData.put("report_name","All_Assets");
                 		categoryImageData.put("field_name","Image");
                 		categoryImageData.put("image_src",thisapp.FileManagement.processImageUrl(getAssetImage.Image));
                 		categoryImageData.put("image_refernce_id",getAssetImage.ID.toString());
                 	}
                 	else
                 	{
                 		categoryImageData.put("report_name","");
                 		categoryImageData.put("field_name","");
                 		categoryImageData.put("image_src","");
                 		categoryImageData.put("image_refernce_id","");
                 	}
                 	categoryData.put("image",categoryImageData);
                 	allCategory.put("category_data",categoryData);
                 	allCategory.put("menu_list",{});
                 	allCategoryList = {allCategory};
                 	allCategoryList.addAll(allProducts);
                 	return allCategoryList;
                 }
				 map testEnvironment.KKCRIntegration()
                 {
                 	//type 1 || type 2
