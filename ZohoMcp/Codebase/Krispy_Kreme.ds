			On_Edit as "On Edit"
			{
				type =  form
				form = Customer

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											try 
										{
											input.Email_Encrypted = input.Email;
											contactID = input.Customer_Points_System_Total_Points_Earned.Related_CRM_ID;
											if(contactID != null && contactID != "")
											{
												param = {"Last_Name":input.Name,"Email":input.Email,"Date_of_Birth":input.Date_Of_Birth};
												response = zoho.crm.updateRecord("Contacts",contactID.toLong(),param);
											}
											phoneNumber = input.Phone_Number;
											countryCode = phoneNumber.subString(0,4);
											if(countryCode != "+971")
											{
												country = Market[Market_Name == "KSA"];
												if(country.count() > 0)
												{
													input.Country = country.ID;
												}
											}
											else
											{
												country = Market[Market_Name == "UAE"];
												if(country.count() > 0)
												{
													input.Country = country.ID;
												}
											}
										}
										catch (e)
										{
											thisapp.ErrorHandling.catchCall("Customer Form - On Edit",e);
										}
						)
					}
				}

			}
