				 string ErrorMonitor.getPossibleErrors()
                 {
                 	message = "";
                 	markets = Market[ID != 0];
                 	if(markets.count() == 0)
                 	{
                 		message = message + "There is no market available in the Market report in Setup section$";
                 	}
                 	else if(markets.count() > 0)
                 	{
                 		isUAEAvailable = false;
                 		isKSAAvailable = false;
                 		for each  market in markets
                 		{
                 			if(isUAEAvailable && isKSAAvailable)
                 			{
                 				break;
                 			}
                 			if(market.Market_Name == "UAE")
                 			{
                 				isUAEAvailable = true;
                 			}
                 			else if(market.Market_Name == "KSA")
                 			{
                 				isKSAAvailable = true;
                 			}
                 		}
                 		if(isUAEAvailable && isKSAAvailable)
                 		{
                 			joiningDrinkAvailabilityUAE = false;
                 			joiningDrinkAvailabilityKSA = false;
                 			redeemDrinkAvailabilityUAE = false;
                 			redeemDrinkAvailabilityKSA = false;
                 			for each  marketJR in markets
                 			{
                 				joiningDrink = Joining_Rules[Joining_Benefit == "Joining Drink" && Market == marketJR && Mark_as_Active];
                 				freeDrink = Joining_Rules[Joining_Benefit == "Free Product / Drink" && Market == marketJR && Mark_as_Active];
                 			}
                 		}
                 		else if(!isUAEAvailable && !isKSAAvailable)
                 		{
                 			message = message + "Both UAE and KSA markets not availble in the Market report in Setup section$";
                 		}
                 		else
                 		{
                 			if(!isUAEAvailable)
                 			{
                 				message = message + "UAE market is not availble in the Market report in Setup section$";
                 			}
                 			else if(!isKSAAvailable)
                 			{
                 				message = message + "KSA market is not availble in the Market report in Setup section$";
                 			}
                 		}
                 	}
                 	products = Add_Product[ID != 0];
                 	if(products.count() == 0)
                 	{
                 		message = message + "There is no product available in the Product List report$";
                 	}
                 	return message;
                 }
				 map fetchRecords.getCustomerDetails(Customer getCustomer, Customer_Points_System customerPoints)
                 {
                 	try 
                 	{
                 		if(getCustomer.count() > 0)
                 		{
                 			customerData = Map();
                 			customerData.put("customer_id",getCustomer.ID.toString());
                 			customerData.put("name",getCustomer.Name);
                 			customerData.put("email",getCustomer.Email);
                 			customerData.put("market",thisapp.MarketHandler.getUserMarket(getCustomer));
                 			customerData.put("phone",thisapp.PhoneNumberHandler.getUserPhone(getCustomer));
                 			customerData.put("dob",getCustomer.Date_Of_Birth.toString());
                 			customerData.put("gender",getCustomer.Gender);
                 			if(getCustomer.Image != null && getCustomer.Image.trim() != "")
                 			{
                 				imageData = Map();
                 				imageData.put("image_src",thisapp.FileManagement.processImageUrl(getCustomer.Image));
                 				imageData.put("report_name","My_Profile");
                 				imageData.put("field_name","Image");
                 				imageData.put("image_refernce_id",getCustomer.ID.toString());
                 				customerData.put("image",imageData);
                 			}
                 			customerData.put("has_enabled_email_notifications",getCustomer.Is_Notification_allowed);
                 			customerData.put("has_enabled_push_notifications",true);
                 			return customerData;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("KK Function - fetchRecords.getCustomerDetails",e);
                 	}
                 	return null;
                 }
