                 			}
                 			contentText = contentText + "</div></div>";
                 		}
                 		contentText = contentText + "</div>";
                 		return contentText;
                 	}
                 	/* 	else if(selectedTab == 3)
                 	{
                 		for each  market in marketList
                 		{
                 			contentText = contentText + "<div class=\"rules_container\"><div class=\"container_country_sec\"><span class=\"country_name_div\">" + market + "</span><a class=\"add_new_ic\" href=\"#Form:Membership_Points_System?Market=" + market + "&zc_LoadIn=dialog\">+</a></div><div class=\"country_based_rules_list\"> ";
                 			for each  membershipThreshold in Membership_Points_System[Market == market] sort by Added_Time desc
                 			{
