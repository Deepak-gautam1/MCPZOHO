			On_Input_Action1 as "On Input Action"
			{
				type =  form
				form = Offer_Extension

				record event = on add

				on user input of Days_to_extend
				{
					actions 
					{
						custom deluge script
						(
											daysToExtend = input.Days_to_extend;
										if(daysToExtend != null && Days_to_extend > 0)
										{
											extendedExpiryTime = input.Expires_On.addDay(daysToExtend);
											if(input.Extended_Expiry_Time != extendedExpiryTime)
											{
												input.Extended_Expiry_Time = input.Expires_On.addDay(daysToExtend);
											}
										}
										else if(daysToExtend < 0)
										{
											input.Days_to_extend = null;
											input.Extended_Expiry_Time = null;
										}
						)
					}
				}

			}
			On_Input_Action2 as "On Input Action"
			{
				type =  form
				form = Offer_Extension

				record event = on add

				on user input of Extended_Expiry_Time
				{
					actions 
					{
						custom deluge script
						(
											extendedExpiryTime = input.Extended_Expiry_Time;
										if(extendedExpiryTime > input.Expires_On)
										{
											daysToExtend = input.Expires_On.daysBetween(extendedExpiryTime);
											if(input.Days_to_extend != daysToExtend)
											{
												input.Days_to_extend = input.Expires_On.daysBetween(extendedExpiryTime);
											}
										}
						)
					}
				}

			}
