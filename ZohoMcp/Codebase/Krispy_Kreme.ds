				 int MainAppSync.syncCategory(int ids)
                 {
                 	getRec = Category[Item_Type == ids];
                 	if(getRec.count() == 0)
                 	{
                 		referenceID = insert into Category
                 		[
                 			Added_User=zoho.loginuser
                 			Item_Type=ids
                 		];
                 		return referenceID;
                 	}
                 	return getRec.ID;
                 }
				 int MainAppSync.syncMarket(int marketId)
                 {
                 	market = Market[Market_From_Catalog == marketId];
                 	if(market.count() == 0)
                 	{
                 		referenceID = insert into Market
                 		[
                 			Added_User=zoho.loginuser
                 			Market_From_Catalog=marketId
                 		];
                 		return referenceID;
                 	}
                 	return market.ID;
                 }
				 int MainAppSync.syncProductCatalog(int ids)
                 {
                 	getRec = Add_Product[Product_From_Catalog == ids];
                 	if(getRec.count() == 0)
                 	{
                 		referenceID = insert into Add_Product
                 		[
                 			Added_User=zoho.loginuser
                 			Product_From_Catalog=ids
                 		];
                 		return referenceID;
                 	}
                 	return getRec.ID;
                 }
				 void MarketHandler.changeMarket(String marketCode)
                 {
                 	try 
                 	{
                 		loginUser = Customer[Phone_Number == zoho.loginuser.mobilenumber];
                 		if(loginUser.count() > 0)
                 		{
                 			getMarkets = Market[Market_From_Catalog.Code == marketCode];
                 			loginUser.Market=getMarkets.Market_From_Catalog;
                 		}
                 	}
                 	catch (e)
                 	{
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="KK : Function - MarketHandler.changeMarket"
                 			error=e
                 		];
                 	}
                 }
				 map MarketHandler.createMarketModel(Market marketDetailsData)
                 {
                 	try 
                 	{
                 		marketDetails = Map();
                 		marketDetails.put("code",marketDetailsData.Market_From_Catalog.Code);
                 		marketDetails.put("name",marketDetailsData.Market_From_Catalog.Name);
                 		image = Map();
                 		image.put("report_name","All_Hub_Names");
                 		image.put("image_refernce_id",marketDetailsData.Market_From_Catalog.Loyalty_Reference.toString());
                 		image.put("field_name","Market_From_Catalog.Flag");
                 		image.put("image_src",thisapp.FileManagement.processImageUrl(marketDetailsData.Market_From_Catalog.Flag));
                 		marketDetails.put("image",image);
                 	}
                 	catch (e)
                 	{
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="KK : Function - MarketHandler.createMarketModel - New"
                 			error=e + "<br>"
                 		];
                 	}
                 	return marketDetails;
                 }
				 map MarketHandler.getAllMarkets()
                 {
                 	marketsDataMap = Map();
                 	marketList = List();
                 	allMarkets = Market[ID != 0];
                 	if(allMarkets.count() > 0)
                 	{
                 		for each  market in allMarkets
                 		{
                 			marketData = Map();
                 			marketData.put("code",market.Market_From_Catalog.Code);
                 			marketData.put("name",market.Market_From_Catalog.Name);
                 			marketData.put("market_id",market.Market_From_Catalog.Market_ID);
                 			marketData.put("record_id",market.Market_From_Catalog.toString());
                 			image = Map();
                 			image.put("report_name","All_Hub_Names");
                 			image.put("image_refernce_id",market.Market_From_Catalog.Loyalty_Reference.toString());
                 			image.put("field_name","Market_From_Catalog.Flag");
                 			image.put("image_src",thisapp.FileManagement.processImageUrl(market.Market_From_Catalog.Flag));
                 			marketData.put("image",image);
                 			marketList.add(marketData);
                 		}
                 		marketsDataMap.put("country_list",marketList);
                 		confirmationDialogViewModel = Map();
                 		confirmationDialogViewModel.put("title","Change Country");
                 		confirmationDialogViewModel.put("description","Are you sure you want to change your country?");
                 		confirmationDialogViewModel.put("success_button_text","Yes");
                 		confirmationDialogViewModel.put("failure_button_text","No");
                 		marketsDataMap.put("confirmation_dialog_view_model",confirmationDialogViewModel);
                 		loaderDialogViewModel = Map();
                 		loaderDialogViewModel.put("title","Changing Country!!");
                 		marketsDataMap.put("loader_dialog_view_model",loaderDialogViewModel);
                 		return marketsDataMap;
                 	}
                 	return null;
                 }
				 map MarketHandler.getUserMarket(Customer customer)
                 {
                 	if(customer == null)
                 	{
                 		customer = Customer[Phone_Number == zoho.loginuser.mobilenumber];
                 	}
                 	market = customer.Market;
                 	marketDetails = Map();
                 	marketDetails.put("code",market.Code);
                 	marketDetails.put("name",market.Name);
                 	image = Map();
                 	image.put("report_name","All_Hub_Names");
                 	image.put("image_refernce_id",market.Loyalty_Reference.toString());
                 	image.put("field_name","Market_From_Catalog.Flag");
                 	image.put("image_src",thisapp.FileManagement.processImageUrl(market.Flag));
                 	marketDetails.put("image",image);
                 	return marketDetails;
                 }
				 list Offers.getAvailableRedeemableItems(Customer_Points_System loyaltyPointSystem)
                 {
                 	try 
                 	{
                 		redeemableItems = Redeem_Points[Points_threshold <= loyaltyPointSystem.Available_Points.toLong()];
                 		if(redeemableItems.count() > 0)
                 		{
                 			redeemableItemList = List();
                 			for each  redeemableLineItem in redeemableItems
                 			{
                 				for each  redeemableItemData in redeemableLineItem.Redeemable_Products
                 				{
                 					redeemableItemMap = Map();
                 					redeemableItemMap.put("item",redeemableItemData.Product.Name.toString());
                 					redeemableItemMap.put("item_id",redeemableItemData.Product.toString());
                 					redeemableItemMap.put("price",redeemableItemData.Product.Price.toDecimal());
                 					redeemableItemMap.put("redeemable_points",redeemableLineItem.Points_threshold);
                 					redeemableItemList.add(redeemableItemMap);
                 				}
                 			}
                 		}
                 	}
                 	catch (e)
                 	{
                 		ncr_logs = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="offers.getAvailableRedeemableItems"
                 			error=redeemableItems + "<br>" + e + "<br>" + loyaltyPointSystem.Available_Points
                 		];
                 	}
                 	return redeemableItemList;
                 }
				 list Offers.getCatalogOffres(Customer_Points_System customerPointsSystem)
                 {
                 	try 
                 	{
                 		catalogOffersList = List();
                 		catalogOffers = Catalog_Offer[Points_threshold <= customerPointsSystem.Available_Points.toLong() && Market == customerPointsSystem.Customer.Market];
                 		if(catalogOffers.count() > 0)
                 		{
                 			for each  offer in catalogOffers
                 			{
                 				offerData = Map();
                 				offerData.put("promotion_title",offer.Promotion_Title);
                 				offerData.put("promotion_code",offer.Promotion_Code);
                 				offerData.put("redeemable_points",offer.Points_threshold);
                 				offerData.put("points_text","Points");
                 				offerData.put("no_of_selection",offer.Available_Groups.size());
                 				redeemableItemsList = List();
                 				for each  item in offer.Items
                 				{
                 					rededmableItem = Map();
                 					rededmableItem.put("name",item.Item.Name);
                 					rededmableItem.put("price",item.Item.Price);
                 					rededmableItem.put("product_id",ifnull(item.Item.Link_ID,0).toString());
                 					redeemableItemsList.add(rededmableItem);
                 				}
                 				offerData.put("redeemable_items",redeemableItemsList);
                 				catalogOffersList.add(offerData);
                 			}
                 		}
                 	}
                 	catch (exception)
                 	{
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="KK : Function - offers.getCatalogOffres"
                 			error=exception
                 		];
                 	}
                 	return catalogOffersList;
                 }
				 list Offers.getDeals(int marketID)
                 {
                 	dealsList = List();
                 	if(marketID != null)
                 	{
                 		dealsData = Deals[Market == input.marketID];
                 	}
                 	else
                 	{
                 		dealsData = Deals[Market.Code == "UAE"];
                 	}
                 	for each  deal in dealsData
                 	{
                 		dealData = Map();
                 		dealData.put("deal_name",deal.Deal_Name);
                 		dealImage = Map();
                 		dealData.put("public_image",thisapp.PublicUrl.deals(deal.ID,thisapp.FileManagement.processImageUrl(deal.Image)));
