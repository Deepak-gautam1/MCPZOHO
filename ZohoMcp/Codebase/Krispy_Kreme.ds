			On_Success_Both1 as "On Success - Both"
			{
				type =  form
				form = Joining_Rules

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Mark_as_Active)
										{
											if(input.Joining_Benefit in {"Free Product / Drink","Joining Drink","Both"})
											{
												allJoiningRules = Joining_Rules[ID != input.ID && Market == input.Market && Joining_Benefit not in {"Free Product / Drink","Joining Drink","Both"}];
											}
											else
											{
												allJoiningRules = Joining_Rules[ID != input.ID && Market == input.Market];
											}
											if(allJoiningRules.count() > 0)
											{
												for each  rules in allJoiningRules
												{
													rules.Mark_as_Active=false;
												}
											}
										}
										openUrl("#Script:page.refresh","same window");
						)
					}
				}

			}
