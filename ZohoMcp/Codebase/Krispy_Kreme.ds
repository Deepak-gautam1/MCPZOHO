		list Days_Test_Report
		{
			displayName = "180 Days Test Report"
			show all rows from Transaction    
			(
				Customer
				Transaction_Time as "Transaction Time"
				Type_field as "Type"
				Total_Purchase_Amount as "Purchase Amount"
				Earned_Loyalty_Points as "Earned Loyalty Points"
				Available_Points as "Available Points"
				Order_ID as "Order ID"
				Total_Points_Earned as "Total Points Earned"
				Burned_Points as "Burned Points"
				Total_Discount_Amount as "Discount Amount"
				Total_Points_Earned_Before_Cancellation as "Total Points Earned Before Cancellation"
				Total_Points_Burned_Before_Cancellation as "Total Points Burned Before Cancellation"
				Available_Points_Before_Cancellation as "Points in Hand"
				Status
				Utilized_Points as "Utilized Points"
				Remaining_Points as "Remaining Points"
			)
			group by
			(
				Customer ascending
			)
			sort by
			(
				Transaction_Time descending
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Earned_Loyalty_Points > 0)
				fields = [Earned_Loyalty_Points]
				format = "color:#4ea64c;"
				}
				"New Formatting"
				{
				condition = (Burned_Points > 0)
				fields = [Burned_Points]
				format = "color:#e64d3b;"
				}
				"New Formatting"
				{
				fields = [Available_Points]
				format = "font-weight:bold;"
				}
				"New Formatting"
				{
				condition = (Type_field == "Cancellation")
				fields = [Earned_Loyalty_Points]
				format = "color:#000000;background-color:#f6abab;"
				}
				"New Formatting"
				{
				condition = (Type_field == "Cancellation")
				fields = [Burned_Points]
				format = "color:#000000;background-color:#b6deb5;"
				}
			)
		}
		default list All_Transactions
