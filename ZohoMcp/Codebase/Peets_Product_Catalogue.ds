	pages
	{
		page Approve_Price_Change
		{
			displayname = "Approve"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='15%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#FF4C2F'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='17%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#FF8318'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Request_Status == &quot;Pending&quot;'\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'Request_Status=Pending' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tcolor = '#FF8318'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Pending'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='16%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '10px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#1FBB52'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'ui-2-like'\n\tsize = '16px'\n\tcornerRadius = '26px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#047B33'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Request_Status == &quot;Approved&quot;'\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'Request_Status=Approved' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tcolor = '#047B33'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = '#FFFFFF'\n\n\n\n\n\n\n\t  value = 'Approved'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='14%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '10px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#951FB8'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'emoticons-like-no'\n\tsize = '16px'\n\tcornerRadius = '26px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#CB0038'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Request_Status == &quot;Rejected&quot;'\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'Request_Status=Rejected' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tcolor = '#AA002D'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Rejected'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='38%'\n   \t>\n\t<panel elementName='Panel 4'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\n\t\twidth = '46%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\n\tcolor = '#FFFFFF'\n\tbgColor = '#0ABB51'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'ui-2-like'\n\tsize = '16px'\n\tcornerRadius = '26px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'isDone=true' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tmarginTop = '3px'\n\tcolor = '#0ABB51'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'isDone == true'\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'isDone=true' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tmarginTop = '3px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Done'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '10px'\n\n\t\twidth = '54%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '10px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#FB0048'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'emoticons-like-no'\n\tsize = '16px'\n\tcornerRadius = '26px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'isDone=false' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tcolor = '#AA002D'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'isDone == false'\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#AA002D'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Not Done'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Approve_Price_Change_Report'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Approve_Product_Page
		{
			displayname = "Approve Product"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='31%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '5px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Menu_Mix_Approval_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#0ABB51'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Request_Product.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total Items'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='35%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '5px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tparameters = 'Menu_Mix_Record_Status=Approved' \n\t\tcomponentLinkName = 'Menu_Mix_Approval_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#0ABB51'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'isApproved == true'\n\t  value = 'thisapp.Request_Product.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Approved Item'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='34%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '5px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tparameters = 'Menu_Mix_Record_Status=Pending' \n\t\tcomponentLinkName = 'Menu_Mix_Approval_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#0ABB51'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'isApproved == false'\n\t  value = 'thisapp.Request_Product.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Pending Approval'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Menu_Mix_Approval_Report'\n\t\tcriteriaString = 'isApproved == false'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page View_Menu(int brand_id, string brand_name_var, collection lstBrands, int market_id, string market_name_var)
		{
			displayname = "View Menu"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet5' elementName='Navigation'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet5()\ncontent\n&lt;%{\n\t%&gt;\n&lt;div style=&quot;padding: 10px 16px;display: flex;align-items: center;&quot;&gt;\n\t\n\t&lt;a href=&quot;#Page:View_Menu&quot;&gt;Dashboard&lt;/a&gt;\n&lt;%\n\tif(input.brand_id != null)\n\t{\n\t\tinput.brand_name_var = global_configuration.fetchrecord.getbrandbyid(input.brand_id).getJson(&quot;Brand_Name&quot;);\n\t\t%&gt;\n&lt;span style=&quot;padding: 0 0.5rem;font-size: 0.5rem;font-weight: 900;&quot;&gt;/&lt;/span&gt;&lt;a href=&quot;#Page:View_Menu?brand_id=&lt;%=input.brand_id%&gt;&quot;&gt;&lt;%=input.brand_name_var%&gt;&lt;/a&gt;\n&lt;%\n\t}\n\tif(input.market_id != null)\n\t{\n\t\tinput.market_name_var = global_configuration.fetchrecord.getallmarket(input.market_id);\n\t\t%&gt;\n&lt;span style=&quot;padding: 0 0.5rem;font-size: 0.5rem;font-weight: 900;&quot;&gt;/&lt;/span&gt;&lt;a href=&quot;#Page:View_Menu?brand_id=&lt;%=input.brand_id%&gt;&amp;market_id=&lt;%=input.market_id%&gt;&quot;&gt;&lt;%=input.market_name_var%&gt;&lt;/a&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet2' elementName='Brand Table'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet2()\ncontent\n&lt;%{\n\tif(input.market_id == null)\n\t{\n\t\tif(input.brand_id == null)\n\t\t{\n\t\t\tlstdata = List();\n\t\t\tlstdata = global_configuration.fetchrecord.getallbrands(&quot;63&quot;);\n\t\t\t// \t\t\tbrands_list = Brand[ID != 0];\n\t\t\t%&gt;\n&lt;table&gt;\n  &lt;tr&gt;\n    &lt;th&gt;Brand&lt;/th&gt;\n    &lt;th&gt;Markets&lt;/th&gt;\n    &lt;th&gt;Items&lt;/th&gt;\n  &lt;/tr&gt;\n&lt;%\n\t\t\tfor each  g_brand in lstdata\n\t\t\t{\n\t\t\t\tbrand_id_val = g_brand.get(&quot;ID&quot;);\n\t\t\t\tmarket_count = g_brand.get(&quot;countmarket&quot;);\n\t\t\t\tnmenu_list = Request_Product[ID != 0];\n\t\t\t\t%&gt;\n&lt;tr&gt;\n        &lt;td&gt;\n            &lt;a href=&quot;#Page:View_Menu?brand_id=&lt;%=brand_id_val%&gt;&quot;&gt;\n                &lt;%=g_brand.get(&quot;Brand_Name&quot;)%&gt;\n            &lt;/a&gt;\n        &lt;/td&gt;\n\t\t&lt;td&gt;&lt;%=market_count%&gt;&lt;/td&gt;\n\t\t&lt;td&gt;&lt;%=nmenu_list.count()%&gt;&lt;/td&gt;\n    &lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/table&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t// \t\t\tselected_brand = Brand[ID == input.brand_id];\n\t\t\tselectedbrand = global_configuration.fetchrecord.getbrandbyid(input.brand_id.tolong());\n\t\t\tselectedbrandid = selectedbrand.getJson(&quot;ID&quot;);\n\t\t\tbrandname = selectedbrand.getJson(&quot;Brand_Name&quot;);\n\t\t\tbrandid = selectedbrand.getJson(&quot;ID&quot;);\n\t\t\tlstmarket = selectedbrand.getJson(&quot;Markets&quot;);\n\t\t\tlstmarketid = selectedbrand.getJson(&quot;market&quot;);\n\t\t\t%&gt;\n&lt;table&gt;\n  &lt;tr&gt;\n\n\t &lt;th&gt;Markets - &lt;%=brandname%&gt;&lt;/th&gt;\n    &lt;th&gt;Items&lt;/th&gt;\n  &lt;/tr&gt;\n&lt;%\n\t\t\tfor each  mrkt in lstmarketid\n\t\t\t{\n\t\t\t\tnmenu_list = Request_Product[Market_Global_rp == mrkt];\n\t\t\t\t%&gt;\n&lt;tr&gt;\n    &lt;td&gt;\n\t   &lt;a href=&quot;#Page:View_Menu?brand_id=&lt;%=selectedbrandid%&gt;&amp;market_id=&lt;%=mrkt%&gt;&quot;&gt;\n\t\t&lt;%=global_configuration.fetchrecord.getallmarket(mrkt)%&gt;\n\t&lt;/a&gt;\n\t&lt;/td&gt;\n\t&lt;td&gt;\n\t\t&lt;%=nmenu_list.count()%&gt;\n\t&lt;/td&gt;\n  &lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/table&gt;\n&lt;%\n\t\t}\n\t}\n\tif(input.brand_id != null &amp;&amp; input.market_id != null)\n\t{\n\t\tselectedbrand = global_configuration.fetchrecord.getbrandbyid(input.brand_id.tolong());\n\t\tbrandname = selectedbrand.getJson(&quot;Brand_Name&quot;);\n\t\tm_name = global_configuration.fetchrecord.getallmarket(input.market_id.tolong());\n\t\tbrand_name = brandname;\n\t\tmarket_name = m_name;\n\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; viewLinkName=&apos;Menu_Mix_Report&apos; params=&quot;zc_Header=true&amp;Brand_Global_rp=&lt;%=input.brand_name%&gt;&amp;Market_Global_rp=&lt;%=input.market_name%&gt;&quot;&gt;Loading View...&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;style&gt;\ntable {\n  border-collapse: collapse;\n  width: 100%;\n}\n\ntd, th {\n  border: 1px solid #eeeeee;\n  text-align: left;\n  padding: 8px;\n}\n\ntr:nth-child(even) {\n  background-color: #eeeeee;\n}\n&lt;/style&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
