				 void ErrorHandling.catchCall(String title, String response)
                 {
                 	sendmail
                 	[
                 		from :zoho.adminuserid
                 		to :"om@coginetics.com"
                 		subject :title
                 		message :response
                 	]
                 	log = insert into Functions_Log
                 	[
                 		Added_User=zoho.loginuser
                 		Title=title
                 		error=response
                 	];
                 }
				 string fileManagement.getProductImage(string recordid)
                 {
                 	imageurl = Request_Product[ID == recordid.tolong()];
                 	//var = imageurl.Flow_Image.getSuffix("image/").getprefix("\" lowqual");
                 	var = imageurl.Image_Mobile.getSuffix("image/").getprefix("\" lowqual");
                 	imageUrl = "https://creatorapp.zoho.com/file/rtbidigitalassets_americanafood/copy-of-product-catalogue/All_Request_Product/" + imageurl.ID + "/Image_Mobile/image-download?filepath=/" + var;
                 	return imageUrl;
                 }
				 string fileManagement.processImageUrl(String image)
                 {
                 	try 
                 	{
                 		if(image != null)
                 		{
                 			image = image.getsuffix("downqual = ");
                 			image = image.getsuffix("\"");
                 			image = image.getprefix("\"");
                 			imageSplits = image.toList("/");
                 			image = imageSplits.get(imageSplits.size() - 1);
                 			return image;
                 		}
                 		else
                 		{
                 			log = insert into Functions_Log
                 			[
                 				Added_User=zoho.loginuser
                 				Title="Function - fileManagement.processImageUrl - Empty Image"
                 			];
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fileManagement.processImageUrl - Catch",e);
                 	}
                 	return "";
                 }
