                 			sugarv.put("helper_text","Multiple");
                 			sugarv.put("id",sugar.Modifiers_Sugar_ps.ID.toString());
                 			sugarv.put("price",m_price);
                 			sugarv.put("max_qty",sugar.Max_Allowed_quantity_sugar_ps.toString());
                 			modsugarvalues.add(sugarv);
                 		}
                 		modsugar.put("values",modsugarvalues);
                 		modifiers.add(modsugar);
                 	}
                 	customisation_section.put("modifiers",modifiers);
                 	result.put("customisation_section",customisation_section);
                 	// Modifier 6: Add-Ons
