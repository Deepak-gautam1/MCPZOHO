				 list statusManagement.getAllStatus()
                 {
                 	resp = List();
                 	obj = Status[ID != 0];
                 	for each  item in obj
                 	{
                 		itemMap = Map();
                 		itemMap.put('status',item.Status);
                 		itemMap.put('uid',item.ID);
                 		resp.add(itemMap);
                 	}
                 	return resp;
                 }
