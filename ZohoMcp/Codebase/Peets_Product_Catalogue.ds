                 				product_item.put("fabicon",b_fabicon);
                 				product_item.put("isFavourite",isinfav);
                 				product_item.put("add_to_cart_button_name","+ Add");
                 				product_item.put("image",thisapp.publicUrls.getproductimage(item.ID.toString()));
                 				product_item.put("calorie_value",calories + " kcal.");
                 				product_item.put("calorie_image",cal_image);
                 				menu_list.add(product_item);
                 			}
                 		}
                 	}
                 	if(menu_list.size() > 0)
                 	{
                 		cat.put("menu_list",menu_list);
                 		category_section.add(cat);
                 	}
                 	// ===== FINAL RESPONSE =====
                 	result_map.put("category_section",category_section);
                 	result_map.put("cartid",cartid);
                 	result_map.put("code",3000);
                 	return result_map;
                 }
				 string productManagement.getproductnamebyid(int id)
                 {
                 	return Request_Product[ID == id].Name_rp;
                 }
				 string publicUrls.getproductimage(string recordid)
                 {
                 	//recordid="4661594000007707209";
                 	fet = Request_Product[ID == recordid.tolong()];
                 	if(fet != null)
                 	{
                 		fetPhoto = fet.Image_Mobile.getSuffix("image/").getPrefix("\" lowqual");
                 		imgSrc = "https://creatorapp.zohopublic.com/file/rtbidigitalassets_americanafood/copy-of-product-catalogue/Product_Images/" + fet.ID + "/Image_Mobile/image-download/xW0NKbJbYPhshWG2rKxR1f7ndjkDuP6Fv6PYd5OGTXWaw07pbDPjOfNDFa6Pp84PmT1RV6N0MGPPqD1BhQbegtuKCXN0yVnGkz8q" + "?filepath=/" + encodeUrl(fetPhoto);
                 		return imgSrc;
                 		//return null;
                 	}
                 	else
                 	{
                 		return "Image not found for type: " + recordid;
                 	}
                 }
