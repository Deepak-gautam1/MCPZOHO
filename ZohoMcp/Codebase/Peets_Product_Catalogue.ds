                 	result.put("notes_section",notes_section);
                 	// ---------------- Often Ordered Section ----------------
                 	// Fetch cross-sell IDs for the given item
                 	lstoftenorders = Request_Product[ID == itemid.toLong()].Cross_Selling_Items_rp;
                 	b_fabicon = test_peets_new.publicUrls.getlogoimages("45").get("public_image_url");
                 	if(lstoftenorders == null)
                 	{
                 		lstoftenorders = List();
                 	}
                 	// Build section shell
                 	often_ordered_section = Map();
                 	often_ordered_section.put("title","Often ordered with");
                 	often_ordered_section.put("hidden_text","");
                 	items_list = List();
                 	// Iterate cross-sell items
                 	for each  oftenorder in lstoftenorders
                 	{
                 		prod = Request_Product[ID == oftenorder.toLong()];
                 		isinfav = false;
                 		for each  faborder in lstfavourite
                 		{
                 			isinfav = false;
                 			if(faborder == prod.ID)
                 			{
                 				//info 'this is in fab';
                 				isinfav = true;
                 				b_fabicon = test_peets_new.publicUrls.getlogoimages("48").get("public_image_url");
                 				break;
                 			}
                 			else
                 			{
                 				isinfav = false;
                 				b_fabicon = test_peets_new.publicUrls.getlogoimages("45").get("public_image_url");
                 			}
                 		}
                 		size_priority = List();
                 		size_priority.add("No Size");
                 		size_priority.add("Single");
                 		size_priority.add("Small");
                 		// 		pricedetail = null;
                 		// 		for each  s in size_priority
                 		// 		{
                 		// 			sz = Size[Size == s];
                 		// 			if(sz != null && sz.ID != null)
                 		// 			{
                 		// 				tmp_price_detail = Product_Size[Store_Category_ps_subform.Store_Category_ps == catid && Product_Name_ps == prod.ID && Size_Name == sz];
                 		// 				if(tmp_price_detail != null && tmp_price_detail.Store_Category_ps_subform.Price_st_cat_ps != null)
                 		// 				{
                 		// 					pricedetail = tmp_price_detail;
                 		// 					break;
                 		// 				}
                 		// 			}
                 		// 		}
                 		// 		if(prod.ID != null)
                 		// 		{
                 		// 			price_value = null;
                 		// 			if(pricedetail != null && pricedetail.Store_Category_ps_subform != null && pricedetail.Store_Category_ps_subform.Price_st_cat_ps != null)
                 		// 			{
                 		// 				price_value = pricedetail.Store_Category_ps_subform.Price_st_cat_ps;
                 		// 			}
                 		pricedetail = null;
                 		calories = "";
                 		for each  s in size_priority
                 		{
                 			sz = Size[Size == s];
                 			if(sz != null && sz.ID != null)
                 			{
                 				tmp_price_detail = Product_Size[Store_Category_ps_subform.Store_Category_ps == catid && Product_Name_ps == prod.ID && Size_Name == sz];
                 				if(tmp_price_detail != null && tmp_price_detail.Store_Category_ps_subform.Price_st_cat_ps != null)
                 				{
                 					pricedetail = tmp_price_detail;
                 					calories = tmp_price_detail.Calories_ps;
                 					break;
                 				}
                 			}
                 		}
                 		if(prod.ID != null)
                 		{
                 			price_value = null;
                 			if(pricedetail != null && pricedetail.Store_Category_ps_subform != null && pricedetail.Store_Category_ps_subform.Price_st_cat_ps != null)
                 			{
                 				for each  r_cat in pricedetail.Store_Category_ps_subform
                 				{
                 					if(r_cat.Store_Category_ps == catid)
                 					{
                 						price_value = r_cat.Price_st_cat_ps;
                 						break;
                 					}
                 				}
                 			}
                 			if(price_value != null)
                 			{
                 				product_detail = Map();
                 				product_detail.put("product_image",{"img_url":thisapp.publicUrls.getproductimage(prod.ID.toString())});
                 				product_detail.put("fab_icon",b_fabicon);
                 				product_detail.put("isFavourite",isinfav);
                 				product_detail.put("name",prod.Name_rp);
                 				product_detail.put("id",prod.ID.toString());
                 				product_detail.put("calories",calories + " kcal.");
                 				product_detail.put("calories_image",cal_images);
                 				if(price_value != null)
                 				{
                 					product_detail.put("price",price_value.toString());
                 				}
                 				else
                 				{
                 					product_detail.put("price","");
                 				}
                 				product_detail.put("add_to_cart_button_name","+ Add");
                 				items_list.add({"product":product_detail});
                 			}
                 		}
                 	}
                 	often_ordered_section.put("items",items_list);
                 	often_ordered_section.put("footer_text","Continue");
                 	result.put("often_ordered_section",often_ordered_section);
                 	// ---------------- Footer Section ----------------
                 	footer_section = Map();
                 	footer_section.put("button_text","Add item");
                 	result.put("footer_section",footer_section);
                 	// ---------------- Final Response ----------------
                 	//response.put("result",result);
                 	return result;
                 }
				 map productManagement.getproductdetailbyid_internal()
                 {
                 	// Input Parameters (static for now)
                 	itemid = "4661594000007841043";
