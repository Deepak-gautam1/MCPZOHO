                 			//same in beans
                 			m_price = null;
                 			modifier_size_id = Modifier_Size[Modifier_Type_mod_size == mod_milkid && Sizes == "Small" && Modifiers_mod_size == mlk.Modifiers_Milk_m_ps].ID;
                 			lstrow = Modifier_Size[ID == modifier_size_id];
                 			//lstrow = Modifier_Size[ID == mlk.Modifier_Size_Milk];
                 			for each  price_cat in lstrow.Store_Category_Price
