                 	modifierList = List();
                 	modifierTypes = Modifier_Type[ID != null];
                 	for each  modifier in modifierTypes
                 	{
                 		modifierDetails = Map();
                 		modifierDetails.put('uid',modifier.ID.toString());
                 		modifierDetails.put('market',modifier.Market_mod_type.toString());
