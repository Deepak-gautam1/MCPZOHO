				 list modifiersManagement.getModifiersDetailByid(int uid)
                 {
                 	resp = List();
                 	obj = Modifiers[Modifier_Type_Lookup == uid];
                 	for each  item in obj
                 	{
                 		itemMap = Map();
                 		itemMap.put('uid',item.ID.toString());
                 		itemMap.put('market',item.Market_global_mod);
                 		itemMap.put('modifier_type',item.Modifier_Type_Lookup);
                 		itemMap.put('en_item',item.Name);
                 		itemMap.put('local_item',item.Name_Localized);
                 		resp.add(itemMap);
                 	}
                 	return resp;
                 }
				 map modifiersManagement.getmodifiersizeforcart(int itemid, int itemsize, int modifier, int modifiertype)
                 {
                 	sizeid = null;
                 	sizename = null;
                 	linkid = null;
                 	lstproductsize = Product_Size[Product_Name_ps == itemid && Size_Name == itemsize];
                 	if(lstproductsize != null)
                 	{
                 		if(modifiertype == 2)
                 		{
                 			for each  modzize in lstproductsize.Beans
                 			{
                 				if(modzize.Modifiers_Beans == modifier)
                 				{
                 					sizeid = modzize.Modifier_Size_beans;
                 					sizename = Modifier_Size[ID == sizeid].Sizes;
                 					linkid = Modifier_Size[Modifiers_mod_size == modifier && Sizes == sizename].Linked_ID;
                 					break;
                 				}
                 			}
                 		}
                 		if(modifiertype == 3)
                 		{
                 			for each  milkmodzize in lstproductsize.Milk
                 			{
                 				if(milkmodzize.Modifiers_Milk_m_ps == modifier)
                 				{
                 					sizeid = milkmodzize.Modifier_Size_Milk;
                 					sizename = Modifier_Size[ID == sizeid].Sizes;
                 					linkid = Modifier_Size[ID == sizeid].Linked_ID;
                 					break;
                 				}
                 			}
                 		}
                 		if(modifiertype == 4)
                 		{
                 			for each  sugarmodzize in lstproductsize.Sugar
                 			{
                 				if(sugarmodzize.Modifiers_Sugar_ps == modifier)
                 				{
                 					sizeid = sugarmodzize.Modifier_Size_Sugar;
                 					sizename = Modifier_Size[ID == sizeid].Sizes;
                 					linkid = Modifier_Size[ID == sizeid].Linked_ID;
                 					break;
                 				}
                 			}
                 		}
                 		if(modifiertype == 6)
                 		{
                 			for each  addones in lstproductsize.Addons
                 			{
                 				// future addon mapping
                 			}
                 		}
                 	}
                 	out = Map();
                 	out.put("sizeid",sizeid);
                 	out.put("sizename",sizename);
                 	out.put("linkid",linkid);
                 	return out;
                 }
