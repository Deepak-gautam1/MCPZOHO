			{
				type =  form
				form = Product_Size

				record event = on add

				on user input of Linked_ID_ps
				{
					actions 
					{
						custom deluge script
						(
											objproduct = Product_Size[Linked_ID_ps == input.Linked_ID_ps];
										if(objproduct.count() > 0)
										{
											alert input.Linked_ID_ps + " Is already used ";
