		workflow
		{
		form
		{
			Set_Status as "Set Status"
			{
				type =  form
				form = Request_Product

				record event = on add

				on load
				{
					actions  (Status_Lookup.Status is null)
					{
						custom deluge script
						(
											input.Status_Lookup = Status[Status == "Operational"].ID;
						)
					}
					actions  (Market_Global_rp.ID is null)
					{
						custom deluge script
						(
											clear Channel_Global;
										clear Sub_Channel_Global;
						)
					}
				}

			}
			get_current_price as "get current price"
			{
				type =  form
				form = Price_Change_Request

				record event = on add or edit

				on user input of Item_Name
				{
					actions 
					{
						custom deluge script
						(
											//c_price = Menu_Mix[ID == input.Item_Name].Standard_Price;
										c_currency = Request_Product[ID == input.Item_Name].Currency_Global;
										//c_pricecurrency = c_price.toString();
										//info c_pricecurrency;
										//input.Current_Price = c_pricecurrency;
										//info c_currency;
										input.Currency_Global = c_currency;
						)
					}
				}

			}
			disabled_current_price as "disabled current price"
			{
				type =  form
				form = Price_Change_Request

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Current_Price;
										disable Currency_Global;
										hide isDone;
										hide Source;
										//roleName = thisapp.permissions.roleForUser("shuklaom84@gmail.com");
										//info roleName;
						)
					}
				}

			}
			Send_mail_to_admin as "Send mail to admin"
			{
				type =  form
				form = Price_Change_Request

				record event = on add or edit

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.loginuserid"
							to : "zoho.adminuserid"
							subject : "Record Added or Updated${Item_Name}     Price Change Request Raised"
							message : "<p><b>Dear</b> <i>sir,</i><br></p><p>We hope this message finds you well.<br></p><p>We are writing to inform you that a request has been made to update the pricing of one or more items on your restaurant's menu. Below are the details of the requested price changes:<br></p><div><br><table border=\"1\" cellspacing=\"2\" cellpadding=\"2\" style=\"width: 100%; font-size: 10pt; font-family: DejaVuSans, sans-serif; border: 1px solid black; color: black;\"><tbody><tr><td style=\"width: 63px;\"><div><b>Market Name</b><br></div></td><td style=\"width: 63px;\"><div><b>Brand Name</b><br></div></td><td style=\"width: 63px;\"><div><b>Item Name</b><br></div></td><td style=\"width: 63px;\"><div><b>Current Price</b><br></div></td><td style=\"width: 63px;\"><div><b>New Price</b><br></div></td><td style=\"width: 63px;\"><div><b>Requested By</b><br></div></td><td style=\"width: 63px;\"><div><b>Effective Date</b><br></div></td></tr><tr><td style=\"width: 63px;\"><div>${Market_Global_Req}<br></div></td><td style=\"width: 63px;\"><div>${Brand_Global_Req}<br></div></td><td style=\"width: 63px;\"><div>${Item_Name}<br></div></td><td style=\"width: 63px;\"><div>${Current_Price}<br></div></td><td style=\"width: 63px;\"><div><span style=\"color:rgb(255, 51, 51)\" class=\"colour\">${New_Price}</span><br></div></td><td style=\"width: 63px;\"><div>${Added_User}<br></div></td><td style=\"width: 63px;\"><div><span style=\"color:rgb(255, 51, 51)\" class=\"colour\">${Effective_Date}</span><br></div></td></tr></tbody></table><br><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div>"
						)
					}
				}

			}
			Daycounter as "Daycounter"
			{
				type =  form
				form = Price_Change_Request

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Fetch pending price change requests
										lstrequests = Price_Change_Request[Request_Status == "Pending"];
										// Loop through each request
										for each  req in lstrequests
										{
											// Get the requested date and current date
											requestedDate = req.Added_Time.toDate();
											// Convert to date object, ignoring time
											currentDate = zoho.currentdate.toDate();
											// Convert to date object, ignoring time
											// Calculate the day difference using daysBetween()
											dayDifference = requestedDate.daysBetween(currentDate);
											//info dayDifference;
											// Update the Requested_Day_Count field with the day difference as a string
											req.Requested_Day_Count=dayDifference.toString();
											// Update only the Requested_Day_Count field in the database, using record ID
											//updateMap = Map();
											//updateMap.put("Requested_Day_Count",dayDifference.toString());
											//update(request.ID, updateMap);
										}
						)
					}
				}

			}
