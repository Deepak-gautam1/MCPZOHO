		form Product_Size
		{
			displayname = "Product Size"
			success message = "Product Size Added Successfully"
			Product1
			(
				type = section
				displayname = "Product"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Product_Name_ps
			(
				type = picklist	
				displayname = "Product Name"
				values  = Request_Product.ID
    			displayformat = [Name_rp]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Channel_ps
			(
    			type = text
				displayname = "Channel"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Market_Global_ps
			(
    			type = text
				displayname = "Market Global"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Sub_Channel_ps
			(
    			type = text
				displayname = "Sub Channel"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Size_Details
			(
				type = section
				displayname = "Size Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Size_Name
			(
				type = picklist	
				displayname = "Size Name"
				values  = Size.ID
    			displayformat = [Size]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Linked_ID_ps
			(
				type = number
				displayname = "Linked ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Calories_ps
			(
				type = number
				displayname = "Calories"
	 			row = 2
	 			column = 2   
				width = medium
			)
			unique Size_Name_ref
			(
    			type = text
				displayname = "Size Name Ref"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Store_Category_ps_subform
			(
				type = grid
				displayname = "Store Category"
				Store_Category_ps
				(
					type = picklist	
					displayname = "Store Category"
					values  = peets_restaurant_management.Store_Category.ID
    				displayformat = [Category_Name]
					width = medium
				)
				Price_st_cat_ps
				(
					type = decimal
					displayname = "Price "
					width = medium
				)
				Status
				(
    				type = checkbox
					initial value = false
					width = medium
				)
	 			row = 3
	 			column = 1   
				width = medium
			)
			Beans
			(
				type = grid
				must have Modifiers_Beans
				(
					type = picklist	
					displayname = "Modifiers Beans"
					values  = Modifiers[Modifier_Type_Lookup.Name == "Beans"].ID
    				displayformat = [Name]
					sortorder = ascending
					width = medium
				)
				must have Modifier_Size_beans
				(
					type = picklist	
					displayname = "Modifier Size Beans"
					values  = Modifier_Size[Modifiers_mod_size.ID == input.Modifiers_Beans && Modifier_Type_mod_size.Name == "Beans"].ID
    				displayformat = [Sizes + " - " + Linked_ID]
					sortorder = ascending
					width = medium
				)
				must have Display_seq_beans_ps
				(
					type = number
					displayname = "Display Seq Beans"
					width = medium
				)
				Is_Active_Beans_ps
				(
    				type = checkbox
					displayname = "Is Active Beans"
					initial value = false
					width = medium
				)
				Multiple_Allowed_b_ps
				(
    				type = checkbox
					displayname = "Multiple Allowed Beans"
					initial value = false
					width = medium
				)
	 			row = 4
	 			column = 1   
				width = medium
			)
			Milk
