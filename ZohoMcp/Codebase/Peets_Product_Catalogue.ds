	reports
	{
		default list Menu_Mix_Approval_Report
		{
			displayName = "Menu Mix Approval"
			show all rows from Request_Product    
			(
				Serve_Type_Lookup as "Serve Type"
				Status_Lookup as "Status"
				Name_rp as "Name (EN)"
				Image_Mobile as "Image Quick View"
				(
			dimension = custom
			imagewidth = 100px
			imageheight = 100px
				)
				Tags_Lookup as "Tags"
				Item_Type_Lookup as "Item Type"
				Description_rp as "Description (EN)"
				Name_Localized_rp as "Name"
				Description_Localized_rp as "Description"
				Approved_By1 as "Approved By"
				Approved_On as "Approved On"
				Menu_Mix_Record_Status as "Item Status"
				Rating_rp as "Rating"
				Priority
				Price_rp as "Price"
				custom action "Approve"
				(
	  			workflow = Approve_Menu_Mix_Item
				show action in edit record menu = true
				column header = "Approve"
				confirmation before execution
				(
					message for individual record = "Execute the Approve action for this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				Link_ID as "Link ID"
				Cross_Selling_Items_rp as "Cross Selling Items"
				Market_Global_rp as "Market Global"
				Channel_Global as "Channel Global"
				Sub_Channel_Global as "Sub Channel Global"
				Currency_Global as "Currency Global"
				Auto_Number_Global as "Auto Number Global"
				Image_Detail_View as "Image Detail View"
				Isactive_rp as "Isactive"
			)
			conditional formatting
			(
				"IsApproved"
				{
				condition = (Menu_Mix_Record_Status == "Approved")
				fields = [Name_rp]
				format = "color:#ffffff;background-color:#1bbc9b;"
				}
				"isRejected"
				{
				condition = (Menu_Mix_Record_Status == "Rejected")
				fields = [Name_rp]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		default list Dynamic_Pricing_Report
		{
			displayName = "Dynamic Pricing"
			show all rows from Dynamic_Pricing    
			(
				Menu_Mix_Lookup as "Item"
				Start_Time as "Start Time"
				End_Time as "End Time"
				Start_Date as "Start Date"
				End_Date as "End Date"
				Days
				Dynamic_Price as "Dynamic Price"
				Current_Price as "Current Price"
				Size_Lookup as "Size"
				Market_dy as "Market Global"
				Sub_Channel_Global as "Sub Channel Global"
				Channel_Global as "Channel Global"
			)
		}
		default list Approve_Price_Change_Report
		{
			displayName = "Approve Price Change"
			show all rows from Price_Change_Request    
			(
				Item_Name as "Item Name"
				(
					view = Menu_Mix_Approval_Report
				)
				New_Price as "New Price"
				Comments
				Comments_by_Mentor as "Appro Comm"
				Action_date as "Approved On"
				(
					displayformat = dateonly
				)
				Action_By as "Approved By"
				custom action "Approve"
				(
	  			workflow = Approve
				show action in edit record menu = true
				column header = "Approve"
				condition = (Request_Status == "Pending")
				confirmation before execution
				(
					message for individual record = "Are you sure want to approve this  ${Item_Name.Name_rp} price change from  ${Current_Price}  to  ${New_Price}"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				custom action "Reject"
				(
	  			workflow = Reject
				show action in edit record menu = true
				column header = "Reject"
				condition = (Request_Status == "Pending")
				confirmation before execution
				(
					message for individual record = "Are you sure want to Reject the Request of Item ( ${Item_Name.Name_rp} )  Price Change from ( ${Current_Price} ) to ( ${New_Price} )"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				Item_Name.Name_rp as "Name (EN)"
				Request_Status as "Status"
				Added_User as "Req By"
				Added_Time as "Requested On"
				(
					displayformat = dateonly
				)
				Effective_Date as "Effective Date"
				Requested_Day_Count as "Pending days"
				Current_Price as "Current Price"
				Item_Name.Item_Type_Lookup as "Item Type"
				isDone as "Status"
				(
						displaytrue = "Completed"
						displayfalse = "In progress"
				)
				Source
				Edit_By as "Edit By"
				Size_Lookup as "Size"
			)
			filters
			(
				Request_Status
				Added_Time
				Effective_Date
			)
			sort by
			(
				Added_Time descending
			)
			conditional formatting
			(
				"IsPending"
				{
				condition = (Request_Status == "Pending" && isDone == false)
				fields = [Item_Name, Effective_Date, isDone]
				format = "font-weight:bold;color:#ef8216;background-color:#f3f3f3;"
				}
				"Pending"
				{
				condition = (Request_Status == "Pending")
				fields = [Request_Status]
				format = "color:#ef8216;"
				}
				"Approved"
				{
				condition = (Request_Status == "Approved")
				fields = [Request_Status]
				format = "color:#5dc35a;"
				}
				"Rejected"
				{
				condition = (Request_Status == "Rejected")
				fields = [Request_Status]
				format = "color:#ef1616;"
				}
				"isDone"
				{
				condition = (isDone == true)
				fields = [isDone]
				format = "color:#337131;"
				}
				"isJobDone"
				{
				condition = (Request_Status == "Approved" && isDone == true)
				fields = [Item_Name]
				format = "color:#ffffff;background-color:#337131;"
				}
				"approvedbutnotdone"
				{
				condition = (Request_Status == "Approved" && isDone == false)
				fields = [Item_Name]
				format = "color:#ffffff;background-color:#107c91;"
				}
				"rejected"
				{
				condition = (Request_Status == "Rejected")
				fields = [Item_Name]
				format = "text-decoration:line-through;color:#ffffff;background-color:#bd588b;"
				}
			)
		}
