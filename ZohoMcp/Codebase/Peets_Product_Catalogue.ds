		form Price_Change_Request
		{
			displayname = "Request"
			success message = "Price Change Request Added Successfully"
			Global_Variables
			(
				type = section
				displayname = "Global Variables"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Market_Global_Req
			(
				type = picklist	
				displayname = "Market Global"
				values  = global_configuration.Market.ID
    			displayformat = [Market]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Currency_Global
			(
    			type = text
				displayname = "Currency Global"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Brand_Global_Req
			(
				type = picklist	
				displayname = "Brand Global"
				values  = global_configuration.Brand.ID
    			displayformat = [Brand_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Item_Name
			(
				type = picklist	
				displayname = "Item Name"
				values  = Request_Product[Market_Global_rp.ID == input.Market_Global_Req].ID
    			displayformat = [Name_rp]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = small
			)
			Detail
			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Edit_By
			(
				type = radiobuttons
				displayname = "Edit By"
				maxchar = 100
				values = {"By Base Price","By Size"}
				layout = 2
    			description
    			[
    				type = tooltip
    			 	message = "Price change will be Based on Base price or Size"
    			]
	 			row = 2
	 			column = 1   
				width = medium
