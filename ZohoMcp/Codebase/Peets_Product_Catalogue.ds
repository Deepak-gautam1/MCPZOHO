                 	rewards_section.put("rewards_footer_text","Done");
                 	result.put("rewards_section",rewards_section);
                 	// ---------------- Customisation Section ----------------
                 	sizeCount = 0;
                 	lstsize = Product_Size[Product_Name_ps = objitemdetail.ID];
                 	//info lstsize ;
                 	for each  size in lstsize
                 	{
                 		sizeCount = sizeCount + 1;
                 		if(size.Size_Name.Size == "No Size")
                 		{
                 			isForCustomization = false;
                 			break;
                 		}
                 	}
                 	if(sizeCount == 1 || sizeCount == 0)
                 	{
                 		isForCustomization = false;
                 	}
                 	customisation_section = Map();
