                 	rewards_section = Map();
                 	rewards_section.put("rewards_text","Rewards");
                 	rewards_section.put("rewards_header_text","How it works?");
                 	rewards_list = List();
                 	reward1 = Map();
                 	reward1.put("rewards_image",test_peets_new.imageUrl.getheaderlogo("11"));
                 	reward1.put("description_primary_text","Collect points");
                 	reward1.put("description_secondary_text",earningRuleText);
