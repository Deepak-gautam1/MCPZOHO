                 	cust_info = test_peets_new.customerProfile.getCustomerInfo(customermobile);
                 	cust_id = cust_info.get("customer_id").toLong();
                 	cal_images = test_peets_new.publicUrls.getlogoimages("8");
                 	response = Map();
                 	result = Map();
                 	res_detail = peets_restaurant_management.storemanagement.getstoredetailbyid(restaurantid.tolong());
                 	order_types_list = res_detail.get("order_types");
                 	category_map = res_detail.get("category_detail");
                 	catid = category_map.get("cat_id");
                 	catname = category_map.get("cat_name");
                 	objcustomerinfo = test_peets_new.customerProfile.getCustomerInfo(customermobile);
                 	// objcustomerinfo is your JSON map
                 	// Get earning_rules and expiration_rules
                 	earningRules = objcustomerinfo.get("earning_rules");
                 	expirationRules = objcustomerinfo.get("expiration_rules");
                 	// Since they are list type, directly fetch first element
                 	earningRuleText = "";
                 	if(earningRules.size() > 0)
                 	{
                 		earningRuleText = earningRules.get(0);
                 	}
                 	expirationRuleText = "";
                 	if(expirationRules.size() > 0)
                 	{
                 		expirationRuleText = expirationRules.get(0);
                 	}
                 	lstfavourite = test_peets_new.fetchRecords.getfavouriteorderbyid(cust_id);
                 	//info lstfavourite;
                 	objitemdetail = Request_Product[ID == itemid.tolong()];
                 	b_fabicon = test_peets_new.publicUrls.getlogoimages("45").get("public_image_url");
                 	isinfav = false;
                 	for each  faborder in lstfavourite
                 	{
                 		isinfav = false;
                 		if(faborder == objitemdetail.ID)
                 		{
                 			//info 'this is in fab';
                 			isinfav = true;
                 			b_fabicon = test_peets_new.publicUrls.getlogoimages("48").get("public_image_url");
                 			break;
                 		}
                 		else
                 		{
                 			isinfav = false;
                 			b_fabicon = test_peets_new.publicUrls.getlogoimages("45").get("public_image_url");
                 		}
                 	}
                 	result.put("item_id",objitemdetail.ID.tostring());
