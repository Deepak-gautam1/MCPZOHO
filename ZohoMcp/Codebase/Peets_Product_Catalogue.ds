                 				m_price = null;
                 				//Due to price wrongly coming for modifiers .. basically modifiers picking Milk price and milk picking Sugar price due to loop and size variance //
                 				modifier_size_id = Modifier_Size[Modifier_Type_mod_size == mod_beansid && Sizes == "Small" && Modifiers_mod_size == beans.Modifiers_Beans].ID;
                 				//info modifier_size_id;
