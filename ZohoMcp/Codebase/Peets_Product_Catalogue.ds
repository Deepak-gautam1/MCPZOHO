				 list serveTypesManagement.getAllServeTypes()
                 {
                 	serveTypeList = List();
                 	serveTypes = Serve_Type[ID != null];
                 	for each  serveType in serveTypes
                 	{
                 		serveTypeDetails = Map();
                 		serveTypeDetails.put('serve_type',serveType.Serve_Type);
                 		serveTypeDetails.put('uid',serveType.ID);
                 		serveTypeList.add(serveTypeDetails);
                 	}
                 	return serveTypeList;
                 }
