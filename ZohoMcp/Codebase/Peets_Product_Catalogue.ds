                 		valsize.put("itemprice",price_value.tostring());
                 		valuessize.add(valsize);
                 	}
                 	modsize.put("values",valuessize);
                 	modifiers.add(modsize);
                 	lstbeans = lstsize.Beans;
                 	mod_beansid = Modifier_Type[Name == "Beans" && Status_global == true].ID;
                 	mod_milkid = Modifier_Type[Name == "Milk" && Status_global == true].ID;
