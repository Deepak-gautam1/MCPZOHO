			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Price_Change_Request
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.adminuserid"
							subject : "Product Catalogue : New entry added"
							message : "Hello,<br/><br/>A new entry added in 'Request' form of 'Product Catalogue' application.<br/>"
							attachments : template : _default as inline
						)
					}
				}
			}
