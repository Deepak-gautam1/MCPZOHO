                 			lstrow = Modifier_Size[ID == modifier_size_id];
                 			if(lstrow != null)
                 			{
                 				for each  price_cat in lstrow.Store_Category_Price
                 				{
                 					if(price_cat.Store_Category_mp == catid)
                 					{
