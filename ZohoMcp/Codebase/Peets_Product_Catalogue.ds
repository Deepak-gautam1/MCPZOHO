                 	modsize.put("values",valuessize);
                 	modifiers.add(modsize);
                 	lstbeans = lstsize.Beans;
                 	mod_beansid = Modifier_Type[Name == "Beans"].ID;
                 	mod_milkid = Modifier_Type[Name == "Milk"].ID;
                 	mod_sugarid = Modifier_Type[Name == "Sugar"].ID;
                 	if(lstbeans != null)
                 	{
                 		// Modifier 2 (Beans)
                 		beansmodifiers = Map();
                 		beansmodifiers.put("type",2);
                 		beansmodifiers.put("name","Beans");
                 		//beansmodifiers.put("id","4661594000007556641");
