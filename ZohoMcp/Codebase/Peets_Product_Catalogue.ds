                 			milkmodval.put("id",mlk.Modifiers_Milk_m_ps.ID.tostring());
                 			milkmodval.put("price",m_price);
                 			milkmodval.put("max_qty","1");
                 			modmilkvalues.add(milkmodval);
                 		}
                 		modmilk.put("values",modmilkvalues);
                 		modifiers.add(modmilk);
                 	}
                 	// Modifier 4 (Sugar)
                 	lstsugar = lstsize.Sugar;
                 	if(lstsugar != null)
                 	{
                 		modsugar = Map();
                 		modsugar.put("type",4);
                 		modsugar.put("name","Sugar");
                 		//modsugar.put("id","4661594000007556633");
                 		modsugar.put("id",Modifier_Type[Name == "Sugar"].ID.tostring());
