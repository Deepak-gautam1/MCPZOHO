				}

			}
			getproductdetails as "getproductdetails"
			{
				type =  form
				form = Product_Size

				record event = on add or edit

				on user input of Product_Name_ps
				{
					actions 
					{
						custom deluge script
						(
											objproduct = Request_Product[ID == input.Product_Name_ps];
										input.Market_Global_ps = objproduct.Market_Global_rp.Market;
										input.Channel_ps = objproduct.Channel_Global.Channel;
										input.Sub_Channel_ps = objproduct.Sub_Channel_Global.Sub_Channel;
						)
					}
				}

			}
			readsizedata as "readsizedata"
			{
				type =  form
				form = Bulk_Product_Upload

				record event = on add or edit
					status = inactive

				on success
				{
				}

			}
			Bulk_Product_Upload as "Bulk Product Upload"
			{
				type =  form
				form = Bulk_Product_Upload

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											try 
										{
											// ===== INPUT =====
											fileContent = input.File_upload.content;
											rawLines = fileContent.toList("\n");
											// --- Build LOGICAL CSV records (handles newlines inside quoted fields) ---
											records = List();
											acc = "";
											for each  rl in rawLines
											{
												linePart = ifnull(rl,"");
												if(acc == "")
												{
													acc = linePart;
												}
												else
												{
													acc = acc + "\n" + linePart;
												}
												// Count quotes in 'acc', treating "" (escaped quote) as part of the field.
												// Trick: split by a single quote to count occurrences.
												quoteCount = acc.toList("\"").size() - 1;
												// Balanced when even number of quotes.
												if(quoteCount % 2 == 0)
												{
													records.add(acc);
													acc = "";
												}
											}
											// If anything remains (malformed CSV), still push as one record
											if(acc != "")
											{
												records.add(acc);
											}
											// ===== HEADER =====
											headerLine = ifnull(records.get(0),"").replaceAll("\r","").trim();
											header = headerLine.toList(",");
											// ===== CONFIG =====
											STORE_IDXS = List();
											STORE_IDXS.add(6);
											STORE_IDXS.add(7);
											STORE_IDXS.add(8);
											STORE_IDXS.add(9);
											STORE_IDXS.add(10);
											STORE_IDXS.add(11);
											// Iterate logical records after header
											byLink = Map();
											isHeader = true;
											for each  recLine in records
											{
												if(isHeader)
												{
													isHeader = false;
													continue;
												}
												line = ifnull(recLine,"").replaceAll("\r","").trim();
												if(line == "")
												{
													continue;
												}
												// (keep your existing comma-merge code here, unchanged)
												cells = line.toList(",");
												merged = List();
												inQuote = false;
												buf = "";
												for each  partRaw in cells
												{
													part = ifnull(partRaw,"");
													if(inQuote)
													{
														buf = buf + "," + part;
														withoutQuotes = buf.replaceAll("\"","");
														qcount = buf.length() - withoutQuotes.length();
														if(qcount % 2 == 0)
														{
															merged.add(buf);
															buf = "";
															inQuote = false;
														}
													}
													else
													{
														if(part != "" && part.substring(0,1) == "\"")
														{
															buf = part;
															withoutQuotes = buf.replaceAll("\"","");
															qcount = buf.length() - withoutQuotes.length();
															if(qcount % 2 == 0)
															{
																merged.add(buf);
																buf = "";
																inQuote = false;
															}
															else
															{
																inQuote = true;
															}
														}
														else
														{
															merged.add(part);
														}
													}
												}
												if(inQuote && buf != "")
												{
													merged.add(buf);
												}
												// --- Build row map: {header -> value} with quote cleanup + BOM-safe keys ---
												row = Map();
												jIdx = 0;
												for each  h in header
												{
													key = h;
													if(key != null && key.length() > 0 && key.substring(0,1) == "﻿")
													{
														key = key.substring(1);
													}
													val = "";
													if(jIdx < merged.size())
													{
														val = merged.get(jIdx);
													}
													if(val != null)
													{
														val = val.trim();
													}
													if(val != null && val.length() >= 2 && val.startsWith("\"") && val.endsWith("\""))
													{
														val = val.substring(1,val.length() - 1);
														val = val.replaceAll("\"\"","\"");
													}
													row.put(key,val);
													jIdx = jIdx + 1;
												}
												// ===== GROUP BY: Link ID =====
												linkId = ifnull(row.get("Link ID"),"").trim();
												if(linkId == "")
												{
													continue;
												}
												rec = byLink.get(linkId);
												if(rec == null)
												{
													rec = Map();
													// --- Main (take from first occurrence of Link ID) ---
													rec.put("Product_Name",row.get("Product Name"));
													rec.put("Size_Name",row.get("SIZE"));
													rec.put("Linked_ID",linkId.tolong());
													// Parse calories (e.g., "13 Kcal")
													calNum = null;
													cv = row.get("Calories");
													if(cv != null && cv != "")
													{
														cs = cv.toString().trim();
														cs = cs.replaceAll(",","").replaceAll("Kcal","").replaceAll("kcal","").replaceAll("Cal","").replaceAll("cal","");
														cs = cs.replaceAll(" ","");
														try 
														{
															calNum = cs.toLong();
														}
														catch (e_cal)
														{
															calNum = null;
														}
													}
													rec.put("Calories",calNum);
													// --- Aggregated subform lists + seen maps for de-duplication ---
													rec.put("sc_list",List());
													rec.put("sc_seen",Map());
													// store categories
													rec.put("beans_list",List());
													rec.put("beans_seen",Map());
													rec.put("milk_list",List());
													rec.put("milk_seen",Map());
													rec.put("sugar_list",List());
													rec.put("sugar_seen",Map());
													rec.put("addons_list",List());
													rec.put("addons_seen",Map());
													byLink.put(linkId,rec);
												}
												// ===== MERGE: Store Categories (G..L) once per category =====
												sc_list = rec.get("sc_list");
												sc_seen = rec.get("sc_seen");
												for each  idx in STORE_IDXS
												{
													if(idx >= header.size())
													{
														continue;
													}
													hName = header.get(idx);
													if(hName != null && hName.length() > 0 && hName.substring(0,1) == "﻿")
													{
														hName = hName.substring(1);
													}
													priceRaw = row.get(hName);
													if(priceRaw != null && priceRaw.toString().trim() != "")
													{
														// parse numeric
														s = priceRaw.toString().trim();
														s = s.replaceAll(",","").replaceAll("\\$","").replaceAll("₹","").replaceAll(" ","");
														priceNum = null;
														try 
														{
															priceNum = s.toDecimal();
														}
														catch (e1)
														{
															try 
															{
																priceNum = s.toLong();
															}
															catch (e2)
															{
																priceNum = null;
															}
														}
														// de-dupe by category header
														if(sc_seen.get(hName) == null)
														{
															sc_row = Map();
															sc_row.put("Store_Category",hName);
															sc_row.put("Price",priceNum);
															sc_row.put("Status",true);
															sc_list.add(sc_row);
															sc_seen.put(hName,true);
														}
													}
												}
												// ===== MERGE: Beans (one per CSV row if present, de-duped by Beans ID or name+modifier) =====
												beans_list = rec.get("beans_list");
												beans_seen = rec.get("beans_seen");
												bId = ifnull(row.get("Beans ID"),"").trim();
												bMod = ifnull(row.get("Modifier Size beans"),"").trim();
												bName = ifnull(row.get("Beans Display Name"),"").trim();
												bSeq = ifnull(row.get("Display Sequence beans"),"").trim();
												// not used unless your subform has a price field
												if(bId != "" || bMod != "" || bName != "" || bSeq != "")
												{
													bKey = "";
													if(bId != "")
													{
														bKey = bId;
													}
													else
													{
														bKey = bName + "|" + bMod;
													}
													if(beans_seen.get(bKey) == null)
													{
														bRow = Map();
														display = "";
														if(bName != "")
														{
															display = bName;
														}
														else
														{
															display = bMod;
														}
														bRow.put("Modifiers_Beans",display);
														bRow.put("Modifier_Size_Beans",bMod);
														bRow.put("Display_Seq_Beans",bSeq);
														bRow.put("Is_Active_Beans",true);
														bRow.put("Multiple_Allowed_Beans",false);
														// If your Beans subform has Price, parse bPrice and add here.
														beans_list.add(bRow);
														beans_seen.put(bKey,true);
													}
												}
												//         ===== MERGE: Milk =====
												milk_list = rec.get("milk_list");
												milk_seen = rec.get("milk_seen");
												mId = ifnull(row.get("Milk ID"),"").trim();
												mMod = ifnull(row.get("Modifier 2(Milk)"),"").trim();
												mName = ifnull(row.get("Milk Display Name"),"").trim();
												mSize = ifnull(row.get("Modifier Size Milk"),"").trim();
												mSeq = ifnull(row.get("Display Sequence Milk"),"").trim();
												if(mId != "" || mMod != "" || mName != "" || mSeq != "")
												{
													mKey = "";
													if(mId != "")
													{
														mKey = mId;
													}
													else
													{
														mKey = mName + "|" + mMod;
													}
													if(milk_seen.get(mKey) == null)
													{
														mRow = Map();
														mDisplay = "";
														if(mName != "")
														{
															mDisplay = mName;
														}
														else
														{
															mDisplay = mMod;
														}
														mRow.put("Modifiers_Milk",mDisplay);
														mRow.put("Modifier_Size_Milk",mSize);
														mRow.put("Display_Seq_milk",mSeq);
														//mRow.put("Display_Seq_milk",1);
														mRow.put("Is_Active_Milk",true);
														// If your link name is Multiple_Allowed_Milk, change the key below:
														mRow.put("Multiple_Allowed_Beans",false);
														milk_list.add(mRow);
														milk_seen.put(mKey,true);
													}
												}
												// ===== MERGE: Addons =====
												addons_list = rec.get("addons_list");
												addons_seen = rec.get("addons_seen");
												aId = ifnull(row.get("Add Ons ID"),"").trim();
												aName = ifnull(row.get("Add  Ons"),"").trim();
												// 		info "aname"+aName;
												aPrice = ifnull(row.get("Add Ons Price"),"").trim();
												if(aId != "" || aName != "" || aPrice != "")
												{
													aKey = "";
													if(aId != "")
													{
														aKey = aId;
													}
													else
													{
														aKey = aName;
													}
													if(addons_seen.get(aKey) == null)
													{
														aRow = Map();
														aRow.put("Addon_Type",aName);
														// set if you have a type column
														aRow.put("Addons","");
														aRow.put("Max_Allowed_Quantity",null);
														aRow.put("Display_Seq_Priority_Addons",null);
														aRow.put("Is_Active_Addons",true);
														aRow.put("Multiple_Allowed_Addons",false);
														// If you store price in the Addons subform, parse aPrice and add.
														addons_list.add(aRow);
														addons_seen.put(aKey,true);
													}
												}
												// ===== MERGE: Sugar =====
												sugar_list = rec.get("sugar_list");
												sugar_seen = rec.get("sugar_seen");
												sId = ifnull(row.get("Sugar ID"),"").trim();
												sName = ifnull(row.get("Sugar"),"").trim();
												sSeq = ifnull(row.get("Seq Sugar"),"").trim();
												sMax = ifnull(row.get("Max Sugar"),"").trim();
												if(sId != "" || sName != "")
												{
													sKey = "";
													if(sId != "")
													{
														sKey = sId;
													}
													else
													{
														sKey = sName;
													}
													if(sugar_seen.get(sKey) == null)
													{
														sRow = Map();
														sRow.put("Modifiers_Sugar",sName);
														sRow.put("Modifier_Size_Sugar","Medium");
														sRow.put("Max_Allowed_Quantity",sMax.tolong());
														sRow.put("Display_Seq_sugar",sSeq.tolong());
														sRow.put("Is_Active_Sugar",true);
														sRow.put("Multiple_Allowed_Sugar",false);
														sugar_list.add(sRow);
														sugar_seen.put(sKey,true);
													}
												}
											}
											// ===== ONE INSERT PER LINK ID =====
											COUNT = 0;
											keys = byLink.keys();
											failed = List();
											processed = List();
											for each  k in keys
											{
												rec = byLink.get(k);
												// 			info rec;
												try 
												{
													mainRow = insert into Product_Size
													[
														Product_Name_ps=Request_Product[Name_rp == rec.GET("Product_Name").trim()].ID
														Size_Name=Size[Size == rec.GET("Size_Name").trim()].ID
														Calories_ps=rec.GET("Calories").tolong()
														Linked_ID_ps=rec.GET("Linked_ID").tolong()
														Added_User=zoho.loginuser
													];
													mainorderrow = Product_Size[ID == mainRow];
													modifierRows = Collection();
													// 									info "record "+rec.get("sc_list");
													for each  obj in rec.get("sc_list")
													{
														modsc = Product_Size.Store_Category_ps_subform();
														modsc.Store_Category_ps=peets_restaurant_management.storemanagement.getcategoryidbyname(obj.get("Store_Category").trim());
														// 										info "here: " + modsc.Store_Category_ps;
														modsc.Price_st_cat_ps=obj.get("Price");
														modsc.Status=obj.get("Status");
														modifierRows.insert(modsc);
													}
													mainorderrow.Store_Category_ps_subform.insert(modifierRows);
													modifierRows = Collection();
													for each  obj in rec.get("beans_list")
													{
														if(obj.get("Modifiers_Beans").trim() != "")
														{
															modBeans = Product_Size.Beans();
															modBeans.Modifiers_Beans=Modifiers[Name == obj.get("Modifiers_Beans").trim()].ID;
															modBeans.Modifier_Size_beans=Modifier_Size[Sizes == obj.get("Modifier_Size_Beans").trim()].ID;
															modBeans.Display_seq_beans_ps=obj.get("Display_Seq_Beans").tolong();
															modBeans.Multiple_Allowed_b_ps=false;
															modBeans.Is_Active_Beans_ps=true;
															modifierRows.insert(modBeans);
														}
													}
													mainorderrow.Beans.insert(modifierRows);
													modifierRows = Collection();
													for each  obj in rec.get("milk_list")
													{
														info "Milk" + obj.get("Modifiers_Milk").trim();
														if(obj.get("Modifiers_Milk").trim() != "")
														{
															modMilk = Product_Size.Milk();
															modMilk.Modifiers_Milk_m_ps=Modifiers[Name == obj.get("Modifiers_Milk").trim()].ID;
															modMilk.Modifier_Size_Milk=Modifier_Size[Sizes == obj.get("Modifier_Size_Milk").trim()].ID;
															modMilk.Display_seq_milk_ps=obj.get("Display_Seq_milk").tolong();
															modMilk.Is_Active_Milk_ps=true;
															modMilk.Multiple_Allowed_milk_ps=false;
															modifierRows.insert(modMilk);
														}
													}
													mainorderrow.Milk.insert(modifierRows);
													modifierRows = Collection();
													for each  obj in rec.get("sugar_list")
													{
														if(obj.get("Modifiers_Sugar").trim() != "")
														{
															info "Sugar " + obj.get("Modifiers_Sugar").trim();
															modSugar = Product_Size.Sugar();
															modSugar.Modifiers_Sugar_ps=Modifiers[Name == obj.get("Modifiers_Sugar").trim()].ID;
															modSugar.Modifier_Size_Sugar=Modifier_Size[Sizes == obj.get("Modifier_Size_Sugar").trim()].ID;
															modSugar.Max_Allowed_quantity_sugar_ps=3;
															modSugar.Display_seq_sugar_ps=obj.get("Display_Seq_sugar");
															modSugar.Is_Active_Sugar_ps=true;
															modSugar.Multiple_Allowed=false;
															modifierRows.insert(modSugar);
														}
													}
													mainorderrow.Sugar.insert(modifierRows);
													modifierRows = Collection();
													for each  obj in rec.get("addons_list")
													{
														if(obj.get("Addon_Type").trim() != "")
														{
															// 				info obj.get("Addon_Type").trim() + " " + Addons1[Name_addons == obj.get("Addon_Type").trim()].ID;
															modAddons = Product_Size.Addons();
															modAddons.Addons_ps=Addons1[Name_addons == obj.get("Addon_Type").trim()].ID;
															type = Addons1[Name_addons == obj.get("Addon_Type").trim()].Addon_Type_addons;
															// 											info type + "type";
															modAddons.Addon_Type_ps=type;
															modAddons.Max_Allowed_Quantity=1;
															modAddons.Is_Active_Addons=true;
															modAddons.Multiple_Allowed_Addons_ps=false;
															modifierRows.insert(modAddons);
														}
													}
													mainorderrow.Addons.insert(modifierRows);
													COUNT = COUNT + 1;
													processed.add(k);
												}
												catch (E_INS)
												{
													info "INSERT FAILED FOR LINK ID " + k + " | " + E_INS;
												}
											}
											info "processed: " + processed.size() + " " + processed;
										}
										catch (e)
										{
											info "An error occurred: " + e;
										}
						)
					}
				}

			}
			checkproductcombination as "checkproductcombination"
			{
				type =  form
				form = Product_Size

				record event = on add

				on user input of Size_Name
				{
					actions 
					{
						custom deluge script
						(
											objectproduct = Product_Size[Product_Name_ps == input.Product_Name_ps && Size_Name == input.Size_Name];
										if(objectproduct.count() > 0)
										{
											alert input.Product_Name_ps.Name_rp + "  is already present with the " + input.Size_Name.Size;
											// input.Product_Name_ps = null;
											input.Size_Name = null;
											return;
										}
						)
					}
				}

			}
