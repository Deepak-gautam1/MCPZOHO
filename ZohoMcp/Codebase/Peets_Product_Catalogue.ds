                 	addon.put("name","Add Ones");
                 	addon.put("required",false);
                 	addon.put("description","Select your Add-Ons");
                 	addon_values = List();
                 	for each  _a in lstaddones
                 	{
                 		a = Map();
                 		a.put("name",_a.Addons_ps.Name_addons);
                 		a.put("helper_text","");
                 		a.put("id",_a.ID.tostring());
                 		addon_values.add(a);
                 	}
                 	addon.put("values",addon_values);
                 	addon_modifiers.add(addon);
