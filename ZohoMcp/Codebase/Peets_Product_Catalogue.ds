				(
					type = picklist	
					displayname = "Modifiers Sugar"
					values  = Modifiers[Modifier_Type_Lookup.Name == "Sugar"].ID
    				displayformat = [Name]
					sortorder = ascending
					width = medium
				)
				must have Modifier_Size_Sugar
				(
