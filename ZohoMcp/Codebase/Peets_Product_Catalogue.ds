						custom deluge script
						(
											hide Comments_by_Mentor;
										hide Action_By;
										hide Action_date;
										hide Request_Status;
										hide Requested_Day_Count;
										hide Size_Lookup;
										clear Size_Lookup;
						)
					}
				}

			}
