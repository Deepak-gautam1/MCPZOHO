				 map productManagement.getproductlist(string r_id, string cust_mobileno, string m_id, string cartid)
                 {
                 	// 		restaurantid = 4661594000009609221;
                 	// 				marketid = 4661594000008171931;
                 	// 		cust_mobileno = "+971555534010";
                 	// 		cartid = 0;
                 	restaurantid = r_id.tolong();
                 	//marketid = m_id.tolong();
                 	cust_info = test_peets_new.customerProfile.getCustomerInfo(cust_mobileno);
                 	lstbestseller = thisapp.productManagement.bestsellermenu();
                 	cust_id = cust_info.get("customer_id").toLong();
                 	marketid = cust_info.get("customer_market").tolong();
                 	//info marketid;
                 	response_map = Map();
                 	result_map = Map();
                 	// ===== HEADER SECTION =====
                 	header_map = Map();
                 	header_map.put("header_title","Our Menu");
                 	// Header search image
                 	header_search_image = Map();
                 	header_map.put("header_search_image",test_peets_new.publicUrls.getlogoimages("31"));
                 	// Header options list
                 	res_detail = peets_restaurant_management.storemanagement.getstoredetailbyid(restaurantid);
                 	order_types_list = res_detail.get("order_types");
                 	category_map = res_detail.get("category_detail");
                 	catid = category_map.get("cat_id");
                 	catname = category_map.get("cat_name");
                 	header_options = List();
                 	for each  order_map in order_types_list
                 	{
                 		orderTypeID = order_map.get("order_typeID");
                 		orderType = order_map.get("order_type");
                 		opt = Map();
                 		opt.put("option_title",orderType);
                 		opt.put("option_id",orderTypeID.tostring());
                 		header_options.add(opt);
                 		header_map.put("header_options",header_options);
                 	}
                 	result_map.put("header",header_map);
                 	// ===== CATEGORY SECTION =====
                 	category_section = List();
                 	lstitemtype = Item_Type[ID != 0 && Market_item_type == marketid && Priority != 0 && Isactive == true] sort by Priority asc;
                 	info lstitemtype.count();
                 	// 		for each litem in lstitemtype
                 	// 	    {
                 	// 			info litem.Item_Type + '' + litem.Priority;
                 	// 	    } 
                 	//info lstitemtype.Item_Type + '   '+  lstitemtype.Priority;
                 	//b_seller = copy_of_product_catalogue.productManagement.getBestseller(marketId,brand);
                 	lstfavourite = test_peets_new.fetchRecords.getfavouriteorderbyid(cust_id);
                 	b_fabicon = test_peets_new.publicUrls.getlogoimages("45").get("public_image_url");
                 	cal_image = test_peets_new.publicUrls.getlogoimages("8").get("public_image_url");
                 	ps_ids = List();
                 	for each  ps in Product_Size[ID != 0]
                 	{
                 		ps_ids.add(ps.Product_Name_ps);
                 	}
                 	ps_ids = ps_ids.distinct();
                 	//info ps_ids;
                 	bs_ids = List();
                 	for each  bs in lstbestseller
                 	{
                 		//info bs;
                 		bs_ids.add(bs);
                 	}
                 	bs_ids = bs_ids.distinct();
                 	//info bs_ids;
                 	counter = 0;
                 	for each  category in lstitemtype
                 	{
                 		info category.Item_Type;
                 		cat = Map();
                 		cat.put("category_name",category.Item_Type);
                 		cat.put("category_id",category.ID.tostring());
                 		menu_list = List();
                 		lstproduct = Request_Product[Item_Type_Lookup == category.ID && Market_Global_rp = marketid && ID in ps_ids && Isactive_rp == true];
                 		//lstproduct = Request_Product[Item_Type_Lookup == category.ID && Market_Global_rp = marketid ];
                 		//info lstproduct.count();
                 		for each  item in lstproduct
                 		{
                 			for each  faborder in lstfavourite
                 			{
                 				isinfav = false;
                 				if(faborder == item.ID)
                 				{
                 					//info 'this is in fab';
                 					isinfav = true;
                 					b_fabicon = test_peets_new.publicUrls.getlogoimages("48").get("public_image_url");
                 					break;
                 				}
                 				else
                 				{
                 					isinfav = false;
                 					b_fabicon = test_peets_new.publicUrls.getlogoimages("45").get("public_image_url");
                 					//break;
                 				}
                 			}
                 			objproductsizedetail = Product_Size[Product_Name_ps == item.ID];
                 			size_name = Size[ID == objproductsizedetail.Size_Name].Size;
                 			linkid = objproductsizedetail.Linked_ID_ps;
                 			caleroies = objproductsizedetail.Calories_ps;
                 			//objdetailpricedetail =  Product_Size[Product_Name_ps == item.ID && Size_Name == sizeid];
                 			size_priority = List();
                 			size_priority.add("No Size");
                 			size_priority.add("Single");
                 			size_priority.add("Small");
                 			pricedetail = null;
                 			for each  s in size_priority
                 			{
                 				sz = Size[Size == s];
                 				if(sz != null && sz.ID != null)
                 				{
                 					tmp_price_detail = Product_Size[Store_Category_ps_subform.Store_Category_ps == catid && Product_Name_ps == item.ID && Size_Name == sz];
                 					if(tmp_price_detail != null && tmp_price_detail.Store_Category_ps_subform.Price_st_cat_ps != null)
                 					{
                 						pricedetail = tmp_price_detail;
                 						calories = tmp_price_detail.Calories_ps;
                 						break;
                 					}
                 				}
                 			}
                 			price_value = null;
                 			if(pricedetail != null && pricedetail.Store_Category_ps_subform != null && pricedetail.Store_Category_ps_subform.Price_st_cat_ps != null)
                 			{
                 				for each  r_cat in pricedetail.Store_Category_ps_subform
                 				{
                 					if(r_cat.Store_Category_ps == catid)
                 					{
                 						price_value = r_cat.Price_st_cat_ps;
                 						break;
                 					}
                 				}
                 			}
                 			if(pricedetail != null && pricedetail.Store_Category_ps_subform.Price_st_cat_ps != null)
                 			{
                 				product_item = Map();
                 				product_item.put("id",item.ID.tostring());
                 				product_item.put("name",item.Name_rp);
                 				product_item.put("price",price_value.tostring());
                 				product_item.put("currency",global_configuration.fetchrecord.getcurrencybymarketid(marketid));
                 				product_item.put("link_id",linkid);
                 				product_item.put("description",item.Description_rp);
                 				product_item.put("loyalty_reference",item.Loyalty_Reference);
                 				product_item.put("fabicon",b_fabicon);
                 				product_item.put("isFavourite",isinfav);
                 				product_item.put("add_to_cart_button_name","+ Add");
                 				img_obj = thisapp.publicUrls.getproductimage(item.ID.toString());
                 				product_item.put("image",img_obj);
                 				product_item.put("calorie_value",calories.tostring() + " kcal.");
                 				product_item.put("calorie_image",cal_image);
                 				menu_list.add(product_item);
                 			}
                 		}
                 		if(menu_list.size() > 0)
                 		{
                 			cat.put("menu_list",menu_list);
                 			category_section.add(cat);
                 		}
                 	}
                 	lstproductb_seller = Request_Product[Market_Global_rp = marketid && ID in bs_ids && Isactive_rp == true];
                 	//info lstproductb_seller;
                 	cat.put("category_name","Best Seller");
                 	cat.put("category_id","0");
                 	for each  item in lstproductb_seller
                 	{
                 		for each  faborder in lstfavourite
                 		{
                 			isinfav = false;
                 			if(faborder == item.ID)
                 			{
                 				isinfav = true;
                 				b_fabicon = test_peets_new.publicUrls.getlogoimages("48").get("public_image_url");
                 				break;
                 			}
                 			else
                 			{
                 				isinfav = false;
                 				b_fabicon = test_peets_new.publicUrls.getlogoimages("45").get("public_image_url");
                 				//break;
                 			}
                 		}
                 		objproductsizedetail = Product_Size[Product_Name_ps == item.ID];
                 		size_name = Size[ID == objproductsizedetail.Size_Name].Size;
                 		linkid = objproductsizedetail.Linked_ID_ps;
                 		caleroies = objproductsizedetail.Calories_ps;
                 		//objdetailpricedetail =  Product_Size[Product_Name_ps == item.ID && Size_Name == sizeid];
                 		size_priority = List();
                 		size_priority.add("No Size");
                 		size_priority.add("Single");
                 		size_priority.add("Small");
                 		pricedetail = null;
                 		for each  s in size_priority
                 		{
                 			sz = Size[Size == s];
                 			if(sz != null && sz.ID != null)
                 			{
                 				tmp_price_detail = Product_Size[Store_Category_ps_subform.Store_Category_ps == catid && Product_Name_ps == item.ID && Size_Name == sz];
                 				if(tmp_price_detail != null && tmp_price_detail.Store_Category_ps_subform.Price_st_cat_ps != null)
                 				{
                 					pricedetail = tmp_price_detail;
                 					calories = tmp_price_detail.Calories_ps;
                 					break;
                 				}
                 			}
                 		}
                 		price_value = null;
                 		if(pricedetail != null && pricedetail.Store_Category_ps_subform != null && pricedetail.Store_Category_ps_subform.Price_st_cat_ps != null)
                 		{
                 			for each  r_cat in pricedetail.Store_Category_ps_subform
                 			{
                 				if(r_cat.Store_Category_ps == catid)
                 				{
                 					price_value = r_cat.Price_st_cat_ps;
                 					break;
                 				}
                 			}
                 		}
                 		if(pricedetail != null && pricedetail.Store_Category_ps_subform.Price_st_cat_ps != null)
                 		{
                 			product_item = Map();
                 			product_item.put("id",item.ID.tostring());
                 			product_item.put("name",item.Name_rp);
                 			p_price = pricedetail.Store_Category_ps_subform.Price_st_cat_ps;
                 			product_item.put("price",price_value);
                 			product_item.put("currency",global_configuration.fetchrecord.getcurrencybymarketid(marketid));
                 			product_item.put("link_id",linkid);
                 			product_item.put("description",item.Description_rp);
                 			product_item.put("loyalty_reference",item.Loyalty_Reference);
                 			product_item.put("fabicon",b_fabicon);
                 			product_item.put("isFavourite",isinfav);
                 			product_item.put("add_to_cart_button_name","+ Add");
                 			img_obj = thisapp.publicUrls.getproductimage(item.ID.toString());
                 			product_item.put("image",img_obj);
                 			product_item.put("calorie_value",caleroies + " kcal.");
                 			product_item.put("calorie_image",cal_image);
                 			menu_list.add(product_item);
                 		}
                 		//	info menu_list;
                 	}
                 	// ✅ Only add category if menu_list is not empty
                 	if(menu_list.size() > 0)
                 	{
                 		cat.put("menu_list",menu_list);
                 		category_section.add(cat);
                 	}
                 	//info category_section;
                 	result_map.put("category_section",category_section);
                 	result_map.put("cartid",cartid);
                 	// ===== FINAL RESPONSE =====
                 	response_map.put("result",result_map);
                 	result_map.put("code",3000);
                 	return result_map;
                 }
