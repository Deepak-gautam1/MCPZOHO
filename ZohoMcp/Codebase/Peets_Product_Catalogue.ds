		default list Price_History_Report
		{
			displayName = "Price History"
			print template = Inv
			show all rows from Price_History    
			(
				Record_ID as "Record ID"
				Old_Price as "Old Price"
				New_Price as "New Price"
				Changed_By as "Changed By"
				Changed_On as "Changed On"
				Item_Name as "Item Name"
				Status
				Effective_date as "Effective date"
				Requested_Day_Count as "Requested Day Count"
				Market
				Brand
				Requested_date as "Requested Date"
				Requested_by as "Requested By"
				Channel
				Subchannel
				Size
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Item_Name ascending
				Brand ascending
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Layout 1"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '0px'\n	bgColor = '#F9F9F9'\n\n		width = '100%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '17px'\n	paddingLeft = '17px'\n	paddingRight = '0px'\n	paddingBottom = '17px'\n\n		width = '16%'\n		hAlign = 'center'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<image  \n	\n	color = '#0ABB51'\n	bgColor = '#FFFFFF'\n	width = '24px'\n	height = '24px'\n	type = 'icon'\n	value = 'ui-1-check-bold'\n	size = '22px'\n	cornerRadius = '12px'\n	iconType = 'outline'\n/>\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '5px'\n	paddingLeft = '17px'\n	paddingRight = '5px'\n	paddingBottom = '5px'\n\n		width = '7%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	color = '#000000'\n	size = '16px'\n	type = 'field'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Item_Name'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '5px'\n\n		width = '10%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	color = '#000000'\n	size = '16px'\n	type = 'field'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Status'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '5px'\n\n		width = '7%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	color = '#000000'\n	size = '16px'\n	type = 'field'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Brand'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '5px'\n\n		width = '11%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	color = '#000000'\n	size = '16px'\n	type = 'field'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Market'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '17px'\n	paddingLeft = '0px'\n	paddingRight = '17px'\n	paddingBottom = '17px'\n\n		width = '11%'\n		hAlign = 'center'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	color = '#000000'\n	size = '16px'\n	type = 'field'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Effective_date'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '17px'\n	paddingLeft = '0px'\n	paddingRight = '17px'\n	paddingBottom = '17px'\n\n		width = '11%'\n		hAlign = 'center'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	color = '#000000'\n	size = '16px'\n	type = 'field'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Size'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '17px'\n	paddingLeft = '0px'\n	paddingRight = '17px'\n	paddingBottom = '17px'\n\n		width = '13%'\n		hAlign = 'center'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	color = '#000000'\n	size = '16px'\n	type = 'field'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'Old_Price'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '17px'\n	paddingLeft = '0px'\n	paddingRight = '17px'\n	paddingBottom = '17px'\n\n		width = '14%'\n		hAlign = 'center'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	color = '#000000'\n	size = '16px'\n	type = 'field'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n	  value = 'New_Price'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
			)
		}
