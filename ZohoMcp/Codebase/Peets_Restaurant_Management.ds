		form Items_list
		{
			displayname = "Exclude"
			success message = "Data Added Successfully!"
			Details
			(
				type = section
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Market_Global_exclude
			(
				type = picklist	
				displayname = "Market Global"
				values  = global_configuration.Market.ID
