				 string timeConvert_timeTo24HourFormat(string inputTime)
                 {
                 	try 
                 	{
                 		// Check if inputTime is not empty or null
                 		if(inputTime != null && inputTime != "")
                 		{
                 			inputTime = inputTime.trim().toUpperCase();
                 			// Clean and standardize the input
                 			// Check if the time has AM/PM
                 			if(inputTime.contains("AM") || inputTime.contains("PM"))
                 			{
                 				return "hello";
                 			}
                 			else
                 			{
                 				return inputTime.trim();
                 				// Return the time as it is if no AM/PM
                 			}
                 		}
                 		else
                 		{
                 			return "";
                 			// Return empty string if inputTime is empty or null
                 		}
                 	}
                 	catch (e)
                 	{
                 		// Return error message if an exception occurs
                 		return "Error processing time: " + e;
                 	}
                 }
				 map Address.getAddressFromLatLong(string lat, string long)
                 {
                 	address_result = Map();
                 	apiUrl = "https://nominatim.openstreetmap.org/reverse?format=json&lat=" + lat + "&lon=" + long + "&accept-language=en";
                 	response = getUrl(apiUrl).toMap();
                 	if(response.get("address") != null)
                 	{
                 		address_result.put("address",response.get("display_name"));
                 		address_result.put("status","success");
                 	}
                 	else
                 	{
                 		address_result.put("address","No address found");
                 		address_result.put("status","failed");
                 	}
                 	return address_result;
                 }
				 map Address.getDistanceAndTimeWithBing(string store_lat, string store_lng, string customer_lat, string customer_lng)
                 {
                 	distance_result = Map();
                 	api_key = ""; // Bing Maps API key removed - set via secure config
                 	url = "https://dev.virtualearth.net/REST/v1/Routes/DistanceMatrix?" + "origins=" + customer_lat + "," + customer_lng + "&destinations=" + store_lat + "," + store_lng + "&travelMode=driving" + "&key=" + api_key;
                 	response = getUrl(url).toMap();
                 	if(response.get("statusCode") == 200)
                 	{
                 		results = response.get("resourceSets").toJSONList();
                 		if(results.size() > 0)
                 		{
                 			resources = results.get(0).get("resources").toJSONList();
                 			if(resources.size() > 0)
                 			{
                 				results_list = resources.get(0).get("results").toJSONList();
                 				if(results_list.size() > 0)
                 				{
                 					element = results_list.get(0);
                 					travelDistance = element.get("travelDistance");
                 					// in km
                 					travelDuration = element.get("travelDuration");
                 					// in seconds
                 					distance_result.put("distance_km",travelDistance.toDecimal().round(2) + " km");
                 					duration_min = (travelDuration.toDecimal() / 60).round(0);
                 					distance_result.put("duration_min",duration_min.toLong() + " mins");
                 					distance_result.put("status","success");
                 				}
                 			}
                 		}
                 	}
                 	else
                 	{
                 		distance_result.put("distance_km","N/A");
                 		distance_result.put("duration_min","N/A");
                 		distance_result.put("status","failed");
                 	}
                 	return distance_result;
                 }
