				 map storemanagement.getstoredetailbyid(int storeid)
                 {
                 	res_detail = Map();
                 	facilities_list = List();
                 	// to store all order type maps
                 	objectresdetail = New_Restaurant[ID == storeid];
                 	for each  order in objectresdetail.Facilities
                 	{
                 		o_type = Map();
                 		o_type.put("order_typeID",order.ID);
                 		o_type.put("order_type",order.Facility_Type);
                 		facilities_list.add(o_type);
                 	}
                 	category_map = Map();
                 	category_map.put("cat_id",objectresdetail.Store_Type1);
                 	category_map.put("cat_name",Store_Category[ID == objectresdetail.Store_Type1].Category_Name);
                 	// store the list in res_detail
                 	res_detail.put("order_types",facilities_list);
                 	res_detail.put("category_detail",category_map);
                 	res_detail.put("store_id",objectresdetail.Store_ID);
                 	res_detail.put("res_id",objectresdetail.Restaurant_ID);
                 	return res_detail;
                 }
				 list storemanagement.getStoreExcludeItems(string storeid)
                 {
                 	exclude_list = List();
                 	curr_date = now;
                 	for each  item in Items_list[Restaurant_Name.Store_ID == storeid && RecStatus == true]
                 	{
                 		if(item.Status == "Permanently Unavailable")
                 		{
                 			exclude_list.addAll(item.Items_to_be_exclude);
                 		}
                 		if(item.Status == "Remove from Active Sales" && item.from_date < curr_date && item.to_date > curr_date)
                 		{
                 			exclude_list.removeAll(item.Items_to_be_exclude);
                 			exclude_list.addAll(item.Items_to_be_exclude);
                 		}
                 	}
                 	return exclude_list;
                 }
