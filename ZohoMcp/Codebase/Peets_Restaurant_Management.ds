				 map azurefunction.azurepostfunction(map order_data)
                 {
                 	final_out = Map();
                 	// <-- always returned at the end
                 	url = "https://apporders-uat.azurewebsites.net/api/AppOrder";
                 	// Headers
                 	headers = Map();
                 	headers.put("Accept","application/json");
                 	// headers.put("Authorization","Bearer <YOUR_TOKEN>"); // if needed
                 	try 
                 	{
                 		// Ensure JSON string body
                 		payload = if(order_data != null,order_data.toString(),"{}");
                 		resp = invokeurl
                 		[
                 			url :url
                 			type :POST
                 			parameters:payload
                 			headers:headers
                 			content-type:"application/json"
                 		];
                 		// Normalize resp -> resp_map
                 		resp_map = Map();
                 		is_map = false;
                 		// Try a Map access to detect if resp is already a Map
                 		try 
                 		{
                 			dummy = resp.get("code");
                 			is_map = true;
                 		}
                 		catch (ie)
                 		{
                 			is_map = false;
                 		}
                 		if(is_map == true)
                 		{
                 			resp_map = resp;
                 		}
                 		else
                 		{
                 			// Try to parse JSON string into Map
                 			try 
                 			{
                 				resp_map = resp.toString().toMap();
                 			}
                 			catch (pe)
                 			{
                 				// Fallback: keep raw string under "raw"
                 				resp_map.put("raw",resp.toString());
                 			}
                 		}
                 		// Build unified output
                 		final_out.put("code",if(resp_map.containsKey("code"),resp_map.get("code"),null));
                 		final_out.put("status",if(resp_map.containsKey("status"),resp_map.get("status"),null));
                 		final_out.put("message",if(resp_map.containsKey("message"),resp_map.get("message"),null));
                 		final_out.put("data",if(resp_map.containsKey("data"),resp_map.get("data"),null));
                 	}
                 	catch (e)
                 	{
                 		final_out.put("code",5000);
                 		final_out.put("status","FAILED");
                 		final_out.put("message","Error posting order: " + e.toString());
                 		final_out.put("data",null);
                 	}
                 	return final_out;
                 	// <-- explicit return at end
                 }
