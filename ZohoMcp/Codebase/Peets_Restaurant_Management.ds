		default list Items_eport
		{
			displayName = "Status"
			show all rows from Items_list  [RecStatus == true]  
			(
				Restaurant_Name as "Name"
				Items_to_be_exclude as "Items"
				(
					delimiter = newline
				)
				Status as "Detail"
				to_date as "To"
				from_date as "From"
				custom action "Mark Available"
				(
	  			workflow = deleterecord
				show action in edit record menu = true
				column header = "Mark Available"
				condition = (RecStatus == true)
				confirmation before execution
				(
					message for individual record = "Are you sure you want to proceed with this action?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				Added_User as "Added By"
				Added_Time as "Added On"
				(
					displayformat = dateonly
				)
				RecStatus as "Status"
				(
						displaytrue = "Unavailable"
						displayfalse = "Available"
				)
				UpdatedBy as "Updated by"
				UpdatedOn as "Updated on"
				Market_Global_exclude as "Market Global"
			)
			filters
			(
				Restaurant_Name
			)
			group by
			(
				Restaurant_Name ascending
			)
