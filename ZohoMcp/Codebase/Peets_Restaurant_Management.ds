				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Restaurant_Name
			(
				type = picklist	
				displayname = "Restaurant Name"
				values  = New_Restaurant[Market_Global_new.ID == input.Market_Global_exclude].ID
    			displayformat = [Restaurant_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Items_to_be_exclude
			(
				type = list	
				displayname = "Select Items"
				values  = copy_of_product_catalogue_management.Request_Product.ID
    			displayformat = [Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Status
			(
				type = radiobuttons
				displayname = "Product Status"
				maxchar = 100
				values = {"Permanently Unavailable","Remove from Active Sales"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Exclusion_Periods
			(
				type = section
				displayname = "Exclusion Period"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
