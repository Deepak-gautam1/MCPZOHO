				 map timedistance.getDistanceAndTime(string store_lat, string store_lng, string customer_lat, string customer_lng)
                 {
                 	api_key = ""; // Google Maps API key removed - set via secure config
                 	// Replace with your API key
                 	result = Map();
                 	dist_url = "https://maps.googleapis.com/maps/api/distancematrix/json?origins=" + customer_lat + "," + customer_lng + "&destinations=" + store_lat + "," + store_lng + "&key=" + api_key;
                 	dist_response = getUrl(dist_url).toMap();
                 	if(dist_response.get("status") == "OK")
                 	{
                 		rows = dist_response.get("rows").toJSONList();
                 		elements = rows.get(0).get("elements").toJSONList();
                 		if(elements.get(0).get("status") == "OK")
                 		{
                 			result.put("distance_km",elements.get(0).get("distance").get("text"));
                 			result.put("duration_min",elements.get(0).get("duration").get("text"));
                 		}
                 		else
                 		{
                 			result.put("distance_km","N/A");
                 			result.put("duration_min","N/A");
                 		}
                 	}
                 	else
                 	{
                 		result.put("distance_km","Distance error: " + dist_response.get("status"));
                 		result.put("duration_min","Distance error");
                 	}
                 	return result;
                 }
			 }
		 }


