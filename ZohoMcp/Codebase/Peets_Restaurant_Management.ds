                 			else
                 			{
                 				overview.put("phone",appIcons.get("2"));
                 			}
                 			overview.put("phone_icon",appIcons.get("2"));
                 			overview.put("direction_text","Get directions");
                 			overview.put("direction_icon",appIcons.get("3"));
                 			overview.put("duration","");
                 			overview.put("destination","");
                 			overview.put("latitude",latitude);
                 			overview.put("longitude",longitude);
                 			// ------------------ Hours ------------------
                 			isOpened = false;
                 			isAlwaysOpen = true;
                 			todayOpening = null;
                 			todayClosing = null;
                 			for each  t in storeRow.Operating_Hourse
                 			{
                 				openHr = t.Opening_Hrs.toString();
                 				closeHr = t.Closing_Hourse.toString();
                 				if(!(openHr == "12:00 AM" || openHr == "00:00:00" || closeHr == "11:59 PM" || closeHr == "11:59:59 PM" || closeHr == "23:59:59"))
                 				{
                 					isAlwaysOpen = false;
                 				}
                 				if(t.Days == today)
                 				{
                 					todayOpening = openHr;
                 					todayClosing = closeHr;
                 				}
                 			}
                 			if(isAlwaysOpen)
                 			{
                 				isOpened = true;
                 				storeStatusString = "Open 24/7";
                 			}
                 			else if(todayOpening != null)
                 			{
                 				fromTime = (currentDateString + " " + todayOpening).toTime();
                 				toTime = (currentDateString + " " + todayClosing).toTime();
                 				parsedLocalTime = localTime.toTime();
                 				if(fromTime > toTime)
                 				{
                 					toTime = toTime.addHour(24);
                 					if(parsedLocalTime < fromTime)
                 					{
                 						parsedLocalTime = parsedLocalTime.addHour(24);
                 					}
                 				}
                 				if(parsedLocalTime < fromTime || parsedLocalTime > toTime)
                 				{
                 					fh = fromTime.getHour();
                 					fm = fromTime.getMinutes();
                 					fs = if(fh >= 12,"PM","AM");
                 					fh = if(fh > 12,fh - 12,fh);
                 					fm = if(fm < 10,"0" + fm,fm);
                 					storeStatusString = "Closed (Opens at " + fh + ":" + fm + " " + fs + ")";
                 				}
                 				else
                 				{
                 					isOpened = true;
                 					th = toTime.getHour();
                 					tm = toTime.getMinutes();
                 					ts = if(th >= 12,"PM","AM");
                 					th = if(th > 12,th - 12,if(th == 0,12,th));
                 					tm = if(tm < 10,"0" + tm,tm);
                 					storeStatusString = "Open (Closes at " + th + ":" + tm + " " + ts + ")";
                 				}
                 			}
                 			else
                 			{
                 				storeStatusString = "Closed";
                 			}
                 			overview.put("operating_status",storeStatusString);
                 			overview.put("is_open",isOpened);
                 			overview.put("is_open_always",isAlwaysOpen);
                 			// ------------------ Detail ------------------
                 			detail = Map();
                 			header = Map();
                 			header.put("title",storeRow.Restaurant_Name);
                 			header.put("image_src",thisapp.imageUrl.getstoreimageurl(storeRow.ID.toString()));
                 			detail.put("header",header);
                 			basic = Map();
                 			for each  k in overview.keys()
                 			{
                 				basic.put(k,overview.get(k));
                 			}
                 			basic.put("timing_text",overview.get("operating_status"));
                 			detail.put("basic_section",basic);
                 			// ------------------ Timings ------------------
                 			timingMap = Map();
                 			for each  t in storeRow.Operating_Hourse
                 			{
                 				// 				open = t.Opening_Hrs.toString();
                 				// 				close = t.Closing_Hourse.toString();
                 				open = "";
                 				close = "";
                 				if(t.Opening_Hrs != null)
                 				{
                 					oh = t.Opening_Hrs.getHour();
                 					om = t.Opening_Hrs.getMinutes();
                 					oampm = if(oh >= 12,"PM","AM");
                 					if(oh > 12)
                 					{
                 						oh = oh - 12;
                 					}
                 					else if(oh == 0)
                 					{
                 						oh = 12;
                 					}
                 					if(om < 10)
                 					{
                 						om = "0" + om;
                 					}
                 					open = oh + ":" + om + " " + oampm;
                 				}
                 				if(t.Closing_Hourse != null)
                 				{
                 					ch = t.Closing_Hourse.getHour();
                 					cm = t.Closing_Hourse.getMinutes();
                 					campm = if(ch >= 12,"PM","AM");
                 					if(ch > 12)
                 					{
                 						ch = ch - 12;
                 					}
                 					else if(ch == 0)
                 					{
                 						ch = 12;
                 					}
                 					if(cm < 10)
                 					{
                 						cm = "0" + cm;
                 					}
                 					close = ch + ":" + cm + " " + campm;
                 				}
                 				// // -------- DEBUG LOGS --------
                 				// info t.Opening_Hrs;
                 				// info open;
                 				// info "---------";
                 				// info t.Closing_Hourse;
                 				// info close;
                 				for each  d in t.Days
                 				{
                 					entry = Map();
                 					entry.put("day",d);
                 					entry.put("opening_time",open);
                 					entry.put("closing_time",close);
                 					timingMap.put(d,entry);
                 				}
                 			}
                 			ordered_days = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"};
                 			timing_list = {};
                 			for each  d in ordered_days
                 			{
                 				if(timingMap.containKey(d))
                 				{
                 					timing_list.add(timingMap.get(d));
                 				}
                 			}
                 			timing_section = Map();
                 			timing_section.put("title","Timings");
                 			timing_section.put("timings_list",timing_list);
                 			detail.put("timing_section",timing_section);
                 			// ------------------ Amenities ------------------
                 			amenity_list = {};
                 			allamenity_map = Map();
                 			// KEY = ID, VALUE = amenity details map
                 			for each  am in allAmenities
                 			{
                 				amMap = Map();
                 				amMap.put("a_type",am.Amenity_Type);
                 				amMap.put("ID",am.ID);
                 				allamenity_map.put(am.ID.toString(),amMap);
                 			}
                 			for each  amenityID in storeRow.Amenities1
                 			{
                 				aid = amenityID.toString();
                 				// KEY must be string
                 				activeamn = allamenity_map.get(aid);
                 				if(activeamn != null)
                 				{
                 					a = Map();
                 					a.put("amenity_name",activeamn.get("a_type"));
                 					a.put("amenity_icon",thisapp.imageUrl.getammenitiesImageurl(activeamn.get("ID").tostring()));
                 					amenity_list.add(a);
                 				}
                 			}
                 			amenities = Map();
                 			amenities.put("title","Amenities");
                 			amenities.put("amenities_list",amenity_list);
                 			detail.put("amenities_section",amenities);
                 			store.put("store_overview",overview);
                 			store.put("store_detail_view",detail);
                 			storeList.add(store);
                 		}
                 	}
                 	// ---------- Filter Section ----------
                 	filter_list = {};
                 	filterOption = Map();
                 	filterOption.put("filter_option_title","Store hours");
                 	filterOptionList = {};
                 	filterOptionList.add("Open 24/7");
                 	filterOptionList.add("Open now");
                 	filterOption.put("filter_option_list",filterOptionList);
                 	filter_list.add(filterOption);
                 	headerMap = Map();
                 	headerMap.put("title","Filter Stores");
                 	footerMap = Map();
                 	footerMap.put("reset_button_name","Reset all");
                 	footerMap.put("apply_button_name","Apply filter");
                 	filter = Map();
                 	filter.put("header",headerMap);
                 	filter.put("filter_list",filter_list);
                 	filter.put("footer",footerMap);
                 	result.put("store_view_title","Our Stores");
                 	result.put("search_hint_text","Search stores, area or street name");
                 	result.put("search_store_not_found_string","No stores found");
                 	result.put("stores",storeList);
                 	result.put("filter_section",filter);
                 	response.put("result",result);
                 	response.put("code",3000);
                 	return result;
                 }
