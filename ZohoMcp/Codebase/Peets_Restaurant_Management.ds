			readexcel as "readexcel"
			{
				type =  form
				form = UploadOpeningClosingTime

				record event = on add or edit

				on user input of File_upload
				{
				}

			}
			getopeningtime as "getopeningtime"
			{
				type =  form
				form = UploadOpeningClosingTime

				record event = on add or edit

				on user input of File_upload
				{
					actions 
					{
						custom deluge script
						(
											try 
										{
											fileContent = input.File_upload.content;
											lines = fileContent.toList("\n");
											if(lines.size() > 1)
											{
												header = lines.get(0).toList(",");
												if(header.get(0).trim() != "StoreId")
												{
													info "missing header: " + header.get(0);
												}
												if(header.get(1).trim() != "OpeningTime")
												{
													info "missing header: " + header.get(1);
												}
												if(header.get(2).trim() != "ClosingTime")
												{
													info "missing header: " + header.get(2);
												}
												for each  line in lines.subList(1,lines.size())
												{
													if(line != "")
													{
														try 
														{
															row = line.toList(",");
															if(row.size() == header.size())
															{
																storeId = row.get(0).trim();
																openingTime = row.get(1).trim();
																closingTime = row.get(2).trim();
																//info storeId + " | " + openingTime + " | " + closingTime;
																store_record = New_Restaurant[Store_ID == storeId];
																if(store_record != null)
																{
																	try 
																	{
																		if(input.optclear == true)
																		{
																			store_record.Operating_Hourse.clear();
																		}
																		rows_collection = Collection();
																		r1 = New_Restaurant.Operating_Hourse();
																		r1.Opening_Hrs=openingTime;
																		r1.Closing_Hourse=closingTime;
																		if(input.rdDays == "Weekdays(Mon-Fri)")
																		{
																			r1.Days={"Monday","Tuesday","Wednesday","Thursday","Friday"};
																		}
																		if(input.rdDays == "Weekend(Sat-Sun)")
																		{
																			r1.Days={"Saturday","Sunday"};
																		}
																		rows_collection.insert(r1);
																		store_record.Operating_Hourse.insert(rows_collection);
																	}
																	catch (e)
																	{
																		info "Error inserting into subform: " + e;
																	}
																}
																else
																{
																	info "No matching StoreId found for " + storeId;
																}
															}
														}
														catch (e)
														{
															info "Error processing row: " + line + " | Error: " + e;
														}
													}
												}
											}
										}
										catch (e)
										{
											info "An error occurred: " + e;
										}
						)
					}
				}

			}
			showhideduration as "showhideduration"
