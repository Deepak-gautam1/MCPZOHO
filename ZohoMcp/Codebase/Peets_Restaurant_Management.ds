		{
			updatestorerateandreview as "updatestorerateandreview"
			{
				type =  schedule
				start = "2025-12-17 00:00:46"
				frequency = weekly
				time zone = "Asia/Dubai"
				on start
				{
					actions 
					{
					on load
					(
						lstrestaurant = New_Restaurant[ID != 0];
										for each  restaurant in lstrestaurant
										{
											if(restaurant.Lat != null && restaurant.Long != null)
											{
												//thisapp.googleapi.updateAllRestaurantRatings(restaurant.ID.tostring(),restaurant.Lat,restaurant.Long);
											}
										}
					)
					}
				}
			}
		}




		functions
		{
			Add_polygon as "Add polygon"
			{
				type =  functions
				form = New_Restaurant
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("https://www.google.com/maps/d/u/0/","popup window");
					)
					}
				}
			}
			uploadcoordinates as "uploadcoordinates"
			{
				type =  functions
				form = New_Restaurant
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Upload_Delivery_Coordinates?R_id=" + input.ID,"popup window");
					)
					}
				}
			}
			deleterecord as "deleterecord"
			{
				type =  functions
				form = Items_list
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						//delete from Items_list [ ID == input.ID  ];
										lstitems = Items_list[ID == input.ID];
										for each  item in lstitems
										{
											item.RecStatus=false;
											item.UpdatedBy=zoho.loginuser;
											item.UpdatedOn=zoho.currentdate.toString();
										}
					)
					}
				}
			}
		}
	}
