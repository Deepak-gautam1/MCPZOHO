			hideexclusionpanel as "hideexclusionpanel"
			{
				type =  form
				form = Items_list

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide from_date;
										hide to_date;
										hide Exclusion_Periods;
										if(Status == "Permanently Unavailable")
										{
											hide from_date;
											hide to_date;
											hide Exclusion_Periods;
										}
										if(Status == "Remove from Active Sales")
										{
											show from_date;
											show to_date;
											show Exclusion_Periods;
										}
						)
					}
				}

			}
			durationdisplay as "durationdisplay"
			{
				type =  form
				form = Items_list

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(Status == "Permanently Unavailable")
										{
											hide from_date;
											hide to_date;
										}
										if(Status == "Remove from Active Sales")
										{
											show from_date;
											show to_date;
										}
						)
					}
				}

			}
			finduniqueedays as "finduniqueedays"
			{
				type =  form
				form = New_Restaurant

				record event = on add or edit

				on add row of Operating_Hourse
				{
					actions 
					{
						custom deluge script
						(
											existing_days = List();
										available_days = List();
										for each  n_row in input.Operating_Hourse
										{
											existing_days.add(n_row.Days);
											// Assuming 'Day' is the field for day selection
										}
										//info existing_days;
										// days_list = List();
										// days_list.add("Monday");
										// days_list.add("Tuesday");
										// days_list.add("Wednesday");
										// days_list.add("Thursday");
										// days_list.add("Friday");
										// days_list.add("Saturday");
										// days_list.add("Sunday");
										lis = {"Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"};
										lis.removeAll(existing_days.get(0));
										//info lis;
										clear row.Days;
										row.Days:ui.add(lis);
						)
					}
				}

			}
			getaddressonlat as "getaddressonlat"
			{
				type =  form
				form = New_Restaurant

				record event = on add or edit
					status = inactive

				on user input of Lat
				{
					actions 
					{
						custom deluge script
						(
											input.Address.latitude = input.Lat;
										input.Address.longitude = input.Long;
										info input.Address;
						)
					}
				}

			}
			getaddressonlong as "getaddressonlong"
			{
				type =  form
				form = New_Restaurant

				record event = on add or edit
					status = inactive

				on user input of Long
				{
					actions 
					{
						custom deluge script
						(
											input.Address.latitude = input.Lat;
										input.Address.longitude = input.Long;
										info input.Address;
						)
					}
				}

			}
			getimagedimension as "getimagedimension"
			{
				type =  form
				form = New_Restaurant

				record event = on add or edit

				on user input of Store_Preview
				{
				}

			}
		}

