		list Exclusion_History
		{
			displayName = "History"
			show all rows from Items_list  [RecStatus == false]  
			(
				Restaurant_Name as "Name"
				Status as "Detail"
				Items_to_be_exclude as "Items"
				(
					delimiter = newline
				)
				from_date as "From"
				to_date as "To"
				RecStatus as "Status"
				(
						displaytrue = "Unavailable"
						displayfalse = "Available"
				)
				Added_User as "Added By"
				Added_Time as "Added on"
				(
					displayformat = dateonly
				)
				UpdatedBy as "Updated by"
				UpdatedOn as "Updated on"
				Market_Global_exclude as "Market Global"
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (RecStatus == true)
				fields = [Items_to_be_exclude]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting"
				{
				condition = (RecStatus == false)
				fields = [Items_to_be_exclude]
				format = "color:#ffffff;background-color:#1bbc9b;"
				}
			)
		}
