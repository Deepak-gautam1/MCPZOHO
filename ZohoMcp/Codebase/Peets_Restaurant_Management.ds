		form Upload_Delivery_Coordinates
		{
			displayname = "Delivery Coordinates"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			unique R_id
			(
    			type = text
