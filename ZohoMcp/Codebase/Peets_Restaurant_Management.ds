				 string formater.Format_Phone(string phone_input)
                 {
                 	if(phone_input.getAlphaNumeric().length() < 6)
                 	{
                 		phone_output = "error";
                 	}
                 	else
                 	{
                 		phone_output = phone_input.getAlphaNumeric().subString(0,3) + " " + phone_input.getAlphaNumeric().subString(3,5) + " " + phone_input.getAlphaNumeric().subString(5,8) + " " + phone_input.getAlphaNumeric().subString(8);
                 	}
                 	return '+' + phone_output;
                 }
				 map googleapi.getFormattedAddress(string lat, string lng)
                 {
                 	api_key = "";
                 	// Replace with your API key
                 	result = Map();
                 	geo_url = "https://maps.googleapis.com/maps/api/geocode/json?latlng=" + lat + "," + lng + "&key=" + api_key;
                 	geo_response = getUrl(geo_url).toMap();
                 	if(geo_response.get("status") == "OK")
                 	{
                 		geo_results = geo_response.get("results").toJSONList();
                 		if(geo_results.size() > 0)
                 		{
                 			result.put("address",geo_results.get(0).get("formatted_address"));
                 		}
                 		else
                 		{
                 			result.put("address","Address not found");
                 		}
                 	}
                 	else
                 	{
                 		result.put("address","Geocoding error: " + geo_response.get("status"));
                 	}
                 	return result;
                 }
				 void googleapi.updateAllRestaurantRatings()
                 {
                 	//API_KEY = ""; // Google Maps API key removed - set via secure config
                 	API_KEY = null;
                 	try 
                 	{
                 		lstrestaurant = New_Restaurant[ID != 0];
                 		for each  restaurant in lstrestaurant
                 		{
                 			if(restaurant.Lat == null || restaurant.Long == null)
                 			{
                 				continue;
                 			}
                 			lat = restaurant.Lat.toString();
                 			lng = restaurant.Long.toString();
                 			placeId = "";
                 			placeAddress = "";
                 			usedMethod = "";
                 			// ---------- STEP 1: NEARBY SEARCH ----------
                 			radiusSteps = {150};
                 			for each  rStep in radiusSteps
                 			{
                 				params1 = Map();
                 				params1.put("location",lat + "," + lng);
                 				params1.put("radius",rStep);
                 				params1.put("type","cafe");
                 				params1.put("keyword","Peet's Coffee");
                 				params1.put("key",API_KEY);
                 				resp = invokeurl
                 				[
                 					url :"https://maps.googleapis.com/maps/api/place/nearbysearch/json"
                 					type :GET
                 					parameters:params1
                 				];
                 				if(resp.get("status") == "OK")
                 				{
                 					for each  p in resp.get("results")
                 					{
                 						name = ifnull(p.get("name"),"").toLowerCase();
                 						if(name.contains("peet"))
                 						{
                 							placeId = p.get("place_id");
                 							placeAddress = p.get("vicinity");
                 							usedMethod = "nearbysearch";
                 							break;
                 						}
                 					}
                 				}
                 				if(placeId != "")
                 				{
                 					break;
                 				}
                 			}
                 			// ---------- STEP 2: TEXT SEARCH (FALLBACK) ----------
                 			if(placeId == "")
                 			{
                 				paramsTS = Map();
                 				paramsTS.put("query","Peet's Coffee");
                 				paramsTS.put("location",lat + "," + lng);
                 				paramsTS.put("radius","2000");
                 				paramsTS.put("key",API_KEY);
                 				resp = invokeurl
                 				[
                 					url :"https://maps.googleapis.com/maps/api/place/textsearch/json"
                 					type :GET
                 					parameters:paramsTS
                 				];
                 				if(resp.get("status") == "OK" && resp.get("results") != null && resp.get("results").size() > 0)
                 				{
                 					p = resp.get("results").get(0);
                 					placeId = p.get("place_id");
                 					placeAddress = p.get("formatted_address");
                 					usedMethod = "textsearch";
                 				}
                 			}
                 			if(placeId == "")
                 			{
                 				info "Peet's Coffee not found for Restaurant ID : " + restaurant.ID;
                 				continue;
                 			}
                 			// ---------- STEP 3: PLACE DETAILS ----------
                 			params2 = Map();
                 			params2.put("place_id",placeId);
                 			params2.put("fields","rating,user_ratings_total");
                 			params2.put("key",API_KEY);
                 			resp2 = invokeurl
                 			[
                 				url :"https://maps.googleapis.com/maps/api/place/details/json"
                 				type :GET
                 				parameters:params2
                 			];
                 			if(resp2.get("status") != "OK")
                 			{
                 				info "PlaceDetails failed for Restaurant ID : " + restaurant.ID;
                 				continue;
                 			}
                 			r = resp2.get("result");
                 			restaurant.Store_Rating=ifnull(r.get("rating"),0);
                 			restaurant.Count_of_Reviews=ifnull(r.get("user_ratings_total"),0);
                 			info " Restaurant Name : " + restaurant.Restaurant_Name + "Ratings " + ifnull(r.get("rating"),0) + "Reviews " + ifnull(r.get("user_ratings_total"),0);
                 		}
                 	}
                 	catch (e)
                 	{
                 		info "Google Rating Update Error : " + e.toString();
                 	}
                 }
