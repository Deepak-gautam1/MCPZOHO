	pages
	{
		page Polygon_Page
		{
			displayname = "Polygon Page"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\t%&gt;\n&lt;iframe name=&apos;zohoview&apos; height=&apos;400&apos; width=&apos;100%&apos; frameborder=&apos;0&apos; scrolling=&apos;Auto&apos; src=&apos;https://www.google.com/maps/d/u/0/&apos; &gt;&lt;/iframe&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page MapWidget(string widgetParams)
		{
			displayname = "MapWidget"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t\n</layout>\n</zml>"
			script
			{
				/* Write your script logic here. You can assign values to the page variables you've created in the previous tab. Enter 'input.' to list the created page variables. */
				info input.widgetParams;
			}
		}
		page Restaurant_Page(int brand_id, string brand_name_var, int market_id, string market_name_var)
		{
			displayname = "All Restaurant"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet1' elementName='Navigation'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet1()\ncontent\n&lt;%{\n\t%&gt;\n&lt;div style=&quot;padding: 10px 16px;display: flex;align-items: center;&quot;&gt;\n\t\n\t&lt;a href=&quot;#Page:Restaurant_Page&quot;&gt;Dashboard&lt;/a&gt;\n&lt;%\n\tif(input.brand_id != null)\n\t{\n\t\tinput.brand_name_var = global_configuration.fetchrecord.getbrandbyid(input.brand_id).getJson(&quot;Brand_Name&quot;);\n\t\t%&gt;\n&lt;span style=&quot;padding: 0 0.5rem;font-size: 0.5rem;font-weight: 900;&quot;&gt;/&lt;/span&gt;&lt;a href=&quot;#Page:Restaurant_Page?brand_id=&lt;%=input.brand_id%&gt;&quot;&gt;&lt;%=input.brand_name_var%&gt;&lt;/a&gt;\n&lt;%\n\t}\n\tif(input.market_id != null)\n\t{\n\t\tinput.market_name_var = global_configuration.fetchrecord.getallmarket(input.market_id);\n\t\t%&gt;\n&lt;span style=&quot;padding: 0 0.5rem;font-size: 0.5rem;font-weight: 900;&quot;&gt;/&lt;/span&gt;&lt;a href=&quot;#Page:Restaurant_Page?brand_id=&lt;%=input.brand_id%&gt;&amp;market_id=&lt;%=input.market_id%&gt;&quot;&gt;&lt;%=input.market_name_var%&gt;&lt;/a&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet2' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet2()\ncontent\n&lt;%{\n\tif(input.market_id == null)\n\t{\n\t\tif(input.brand_id == null)\n\t\t{\n\t\t\tlstdata = List();\n\t\t\tlstdata = global_configuration.fetchrecord.getallbrands(&quot;63&quot;);\n\t\t\t//brands_list = Brand[ID != 0];\n\t\t\t%&gt;\n&lt;table&gt;\n  \t\t\t\t&lt;tr&gt;\n\t\t\t\t    &lt;th&gt;Brand&lt;/th&gt;\n\t\t\t\t    &lt;th&gt;Markets&lt;/th&gt;\n\t\t\t\t    &lt;th&gt;Restaurants&lt;/th&gt;\n\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\tfor each  g_brand in lstdata\n\t\t\t{\n\t\t\t\tbrand_id_val = g_brand.get