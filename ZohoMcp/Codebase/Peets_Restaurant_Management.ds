\n\t\tm_name = global_configuration.fetchrecord.getallmarket(input.market_id.tolong());\n\t\tbrand_name = brandname;\n\t\tmarket_name = m_name;\n\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; viewLinkName=&apos;Restaurants_Report&apos; params=&quot;zc_Header=true&amp;Brand_Lookup=&lt;%=brand_name%&gt;&amp;Market_Lookup=&lt;%=market_name%&gt;&quot;&gt;Loading View...&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;style&gt;\ntable {\n  border-collapse: collapse;\n  width: 100%;\n}\n\ntd, th {\n  border: 1px solid #eeeeee;\n  text-align: left;\n  padding: 8px;\n}\n\ntr:nth-child(even) {\n  background-color: #eeeeee;\n}\n&lt;/style&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
