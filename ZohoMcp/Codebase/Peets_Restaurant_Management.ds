				 map storemanagement.getAllStore(string brandid, string marketid, string localTime)
                 {
                 	allStores = Map();
                 	days = {"Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"};
                 	today = days.get(localTime.toTime().getDayOfWeek() - 1);
                 	getStores = New_Restaurant[Market_Global_new == marketid.trim().tolong() && isActive == true];
                 	//info getStores;
                 	if(getStores.count() > 0)
                 	{
                 		allStores.put("nearby_stores_text","Nearby Stores");
                 		allStores.put("store_view_title","Our Stores");
                 		allStores.put("directions_text","Directions");
                 		allStores.put("search_hint_text","Search stores");
                 		allStores.put("search_store_not_found_string","No stores found");
                 		storeLocationList = List();
                 		for each  store in getStores
                 		{
                 			imgSrc = thisapp.fileManagement.processImageUrl(store.Store_Preview);
                 			id = toString(store.ID);
                 			storeDetail = Map();
                 			basicStore = Map();
                 			basicStore.put("id",store.ID.toString());
                 			basicStore.put("restaurant_name",store.Restaurant_Name.toUpperCase());
                 			basicStore.put("public_image",thisapp.fileManagement.getstoreImagebyid(store.ID.toString()));
                 			basicStore.put("address",store.Address);
                 			basicStore.put("menu_description","Donuts, Desserts, Coffee");
                 			storeImageBasic = Map();
                 			storeImageBasic.put("report_name","All_Stores");
                 			storeImageBasic.put("field_name","Restaurant_Management.Home_Image");
                 			storeImageBasic.put("image_refernce_id",store.Loyalty_Reference.toString());
                 			storeImageBasic.put("image_src",thisapp.fileManagement.getstoreImagebyid(store.ID.toString()));
                 			basicStore.put("image",storeImageBasic);
                 			storeDetail.put("basic_store",basicStore);
                 			storeDetail.put("store_id",toString(store.Store_ID));
                 			storeDetail.put("restaurant_code",toString(store.Restaurant_ID));
                 			storeDetail.put("restaurant_name",store.Restaurant_Name);
                 			storeDetail.put("star_rating",ifnull(store.Store_Rating,0.0));
                 			storeDetail.put("reviews_count",ifnull(store.Count_of_Reviews,0.0));
                 			storeDetail.put("address",store.Address);
                 			market = Map();
                 			//market.put("market_name",store.Market_Lookup.Name);
                 			market.put("market_name",store.Market_Global_new.Market);
                 			market.put("market_id",toString(store.Market_Global_new.ID));
                 			storeDetail.put("market",market);
                 			area = Map();
                 			area.put("area_name",store.Area_Lookup.Area_Name);
                 			area.put("area_id",store.Area_Lookup.ID);
                 			storeDetail.put("area_data",area);
                 			storeDetail.put("latitude",toString(store.Lat));
                 			storeDetail.put("longitude",toString(store.Long));
                 			if(store.Phone_Number != null)
                 			{
                 				storeDetail.put("phone",toString(thisapp.formater.Format_Phone(toString(store.Phone_Number))));
                 				basicStore.put("phone",toString(thisapp.formater.Format_Phone(toString(store.Phone_Number))));
                 			}
                 			else
                 			{
                 				storeDetail.put("phone",toString(store.Phone_Number));
                 				basicStore.put("phone",toString(store.Phone_Number));
                 			}
                 			for each  timing in store.Operating_Hourse
                 			{
                 				storeDetail.put("opening_time",timing.Opening_Hrs);
                 				storeDetail.put("closing_time",timing.Closing_Hourse);
                 			}
                 			storeImage = Map();
                 			storeImage.put("report_name","All_Stores");
                 			storeImage.put("field_name","Restaurant_Management.Home_Image");
                 			storeImage.put("image_refernce_id",store.Loyalty_Reference.toString());
                 			storeImage.put("image_src",imgSrc);
                 			storeDetail.put("image",storeImage);
                 			storeDetail.put("id",store.ID.toString());
                 			// Initialize store status and is_opened
                 			//storeDetail.put("id", toString(id));
                 			//storeDetail.put("store_status", "Closed");
                 			//storeDetail.put("is_opened", false);
                 			for each  timing in store.Operating_Hourse
                 			{
                 				if(timing.Days == today)
                 				{
                 					storeStatusString = "";
                 					isOpened = false;
                 					storeDetail.put("opening_time",timing.Opening_Hrs);
                 					storeDetail.put("closing_time",timing.Closing_Hourse);
                 					fromTime = (zoho.currentdate.toString() + " " + timing.Opening_Hrs.toString()).toTime();
                 					toTime = (zoho.currentdate.toString() + " " + timing.Closing_Hourse.toString()).toTime();
                 					parsedLocalTime = localTime.toTime();
                 					if(fromTime > toTime)
                 					{
                 						toTime = toTime.addHour(24);
                 						if(parsedLocalTime < fromTime)
                 						{
                 							parsedLocalTime = parsedLocalTime.addHour(24);
                 						}
                 					}
                 					if(fromTime > parsedLocalTime || toTime < parsedLocalTime)
                 					{
                 						fromTimeString = "";
                 						fromSuffixString = "AM";
                 						if(fromTime.getHour() > 12)
                 						{
                 							fromTimeString = fromTime.getHour() - 12;
                 							fromSuffixString = "PM";
                 						}
                 						else
                 						{
                 							fromTimeString = fromTime.getHour();
                 						}
                 						storeStatusString = "Closed (Opens at " + fromTimeString + ":" + if(fromTime.getMinutes() < 10,fromTime.getMinutes() + "0",fromTime.getMinutes()) + " " + fromSuffixString + ")";
                 					}
                 					else if(fromTime <= parsedLocalTime && toTime >= parsedLocalTime)
                 					{
                 						isOpened = true;
                 						toTimeString = "";
                 						toSuffixString = "AM";
                 						if(toTime.getHour() > 12)
                 						{
                 							toTimeString = toTime.getHour() - 12;
                 							toSuffixString = "PM";
                 						}
                 						else if(toTime.getHour() <= 0)
                 						{
                 							toTimeString = "12";
                 						}
                 						else
                 						{
                 							toTimeString = toTime.getHour();
                 						}
                 						storeStatusString = "Open (Closes at " + toTimeString + ":" + if(toTime.getMinutes() < 10,toTime.getMinutes() + "0",toTime.getMinutes()) + " " + toSuffixString + ")";
                 					}
                 					storeDetail.put("operating_status",storeStatusString);
                 					storeDetail.put("is_open",isOpened);
                 					break;
                 				}
                 			}
                 			storeLocationList.add(storeDetail);
                 		}
                 		allStores.put("stores",storeLocationList);
                 	}
                 	allStores.put("no_store_available_string","No stores for the selected market");
                 	return allStores;
                 }
