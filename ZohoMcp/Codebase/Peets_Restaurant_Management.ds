		form New_Restaurant
		{
			displayname = "New"
			success message = "Restaurant Added Successfully"
			Market_Channel
			(
				type = section
				displayname = "Market & Channel"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Market_Global_new
			(
				type = picklist	
				displayname = "Market Global"
				values  = global_configuration.Market.ID
    			displayformat = [Market]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = small
			)
			Area_Lookup
			(
				type = picklist	
				displayname = "Area"
				values  = Area[Market_Global_area.ID == input.Market_Global_new].ID
    			displayformat = [Area_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = small
			)
			Channel
			(
				type = picklist	
				values  = copy_of_product_catalogue_management.Channel.ID
    			displayformat = [Channel]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = small
			)
			Loyalty_Reference
			(
				type = picklist	
				displayname = "Loyalty Reference"
				values  = krispy_kreme.Stores.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 2   
				width = small
			)
			Section3
			(
				type = section
				displayname = "Restaurant "
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Restaurant_Name
			(
    			type = text
				displayname = "Restaurant Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Restaurant_ID
			(
    			type = text
				displayname = "Restaurant ID"
	 			row = 2
	 			column = 1   
				width = small
			)
			Store_Type1
			(
				type = picklist	
				displayname = "Store Category"
				values  = Store_Category.ID
    			displayformat = [Category_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = small
			)
			Store_Preview
			(
    			type = image
				displayname = "Store Preview"
				compression = true
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 2
	 			column = 1   
				width = small
			)
			Facilities
			(
				type = list	
				values  = Facilities.ID
    			displayformat = [Facility_Type]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = small
			)
			Store_Name
			(
    			type = text
				displayname = "Store Name"
	 			row = 2
	 			column = 2   
				width = small
			)
			must have unique Store_ID
			(
    			type = text
				displayname = "Store ID"
	 			row = 2
	 			column = 2   
				width = small
			)
			Property_Type_Lookup
			(
				type = picklist	
				displayname = "Property Type"
				values  = Property_Type.ID
    			displayformat = [Property_Type]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = small
			)
			Quick_View
			(
    			type = image
				displayname = "Quick View"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 2
	 			column = 2   
				width = medium
			)
			isActive
			(
    			type = checkbox
				initial value = true
	 			row = 2
	 			column = 2   
				width = medium
			)
			Details
			(
				type = section
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			unique Lat
			(
    			type = text
				displayname = "Latitude"
	 			row = 3
	 			column = 1   
				width = small
			)
			Google_Location
			(
    			type = url
				displayname = "Google Location"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
    			allowedcountries={ae,sa,lb,ma,om,qa,bh,eg,iq,jo,kz,kw}
    			defaultcountry="ae"
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Store_Rating
			(
				type = decimal
				displayname = "Store Rating"
				decimalplace = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Rating
			(
				type = number
	 			row = 3
	 			column = 1   
				width = medium
			)
			Count_of_Reviews
			(
				type = number
				displayname = "Count of Reviews"
	 			row = 3
	 			column = 1   
				width = medium
			)
			unique Long
			(
    			type = text
				displayname = "Longitude"
	 			row = 3
	 			column = 2   
				width = small
			)
			Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 3
	 			column = 2   
				width = medium
				personal data = true
			)
			Store_Opening_Date
			(
    			type = date
				displayname = "Open Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			Image_Dimension
			(
    			type = text
				displayname = "Image Dimension"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Operating_Hourse
			(
				type = grid
				displayname = "Operating Hours"
				Days
				(
					type = list	
					values = {"a","Monday","Sunday","Tuesday","Wednesday","Thursday","Friday","Saturday"}
					sortorder = ascending
					height = 60px
					width = medium
				)
				Opening_Hrs
				(
    				type = time
					displayname = "Opening Time"
					timedisplayoptions = "hh:mm:ss" 
					width = medium
				)
				Closing_Hourse
				(
    				type = time
					displayname = "Closing Time"
					timedisplayoptions = "hh:mm:ss" 
					width = medium
				)
	 			row = 4
	 			column = 1   
				width = medium
			)
			Amenities
			(
				type = section
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Amenities1
			(
				type = checkboxes	
				displayname = "Amenities"
				values  = Amenities.ID
    			displayformat = [Amenity_Type]
				searchable = true
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Google_Place_ID_section
			(
				type = section
				displayname = "Google Place ID"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Google_Place_ID
			(
    			type = text
				displayname = "Google Place ID"
	 			row = 6
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
