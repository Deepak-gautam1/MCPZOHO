					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form UploadOpeningClosingTime
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have File_upload
			(
    			type = upload file
				displayname = "File upload"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have rdDays
			(
				type = radiobuttons
				displayname = "Days"
				maxchar = 100
				values = {"Weekdays(Mon-Fri)","Weekend(Sat-Sun)"}
				layout = 2
    			description
    			[
    				type = tooltip
    			 	message = "Weekdays (Monday to Friday) Weekends (Saturday and Sunday)"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			optclear
			(
    			type = checkbox
				displayname = "Clear Previous Operating Hours"
				initial value = false
    			description
    			[
    				type = tooltip
    			 	message = "This option will remove all previously saved operating hours. Are you sure you want to select this option?"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Restaurants_Report
		{
			displayName = "Restaurants Report"
			show all rows from New_Restaurant    
			(
				Restaurant_Name as "Restaurant"
				Property_Type_Lookup as "Property Type"
				Channel
				Store_Preview as "Store Preview"
				Store_ID as "Store ID"
				Store_Name as "Store Name"
				custom action "Open Polygon"
				(
	  			workflow = Add_polygon
				show action in edit record menu = true
				column header = "Open Polygon"
				)
				custom action "Upload Coordinates"
				(
	  			workflow = uploadcoordinates
				show action in edit record menu = true
				column header = "Upload Coordinates"
				)
				Restaurant_ID as "Restaurant ID"
				Lat as "Latitude"
				Long as "Longitude"
				Google_Location as "Google Location"
				Store_Opening_Date as "Open Date"
				Operating_Hourse as "Operating Hours"
				(
					field = Operating_Hourse.Days + " " + Operating_Hourse.Opening_Hrs + " " + Operating_Hourse.Closing_Hourse
				)
				Area_Lookup as "Area"
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Rating
				Phone_Number as "Phone"
				(
					displayformat = formattednumber 
					linktodial = disable
				)
				isActive
				Image_Dimension as "Image Dimension"
				Store_Type1 as "Store Category"
				Amenities1 as "Amenities"
				Facilities
				Market_Global_new as "Market Global"
				Quick_View as "Quick View"
				ID
				Count_of_Reviews as "Count of Reviews"
				Store_Rating as "Store Rating"
				Google_Place_ID as "Google Place ID"
			)
			sort by
			(
				Store_ID ascending
			)
		}
