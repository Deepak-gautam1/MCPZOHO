				 map storemanagement.getAllStorePeetsbystoreid(int storeid, string localTime)
                 {
                 	// DO NOT override inputs in production (keep below only for ad-hoc tests)
                 	// 	storeid = 4661594000009609221;
                 	// 	localTime = "20-06-2025 09:30:00 AM";
                 	response = Map();
                 	result = Map();
                 	storeList = List();
                 	// Derive today's full day name from localTime safely (e.g., "Monday")
                 	today = "";
                 	try 
                 	{
                 		today = localTime.toTime().toString("EEEE");
                 	}
                 	catch (e)
                 	{
                 		// Fallback to current time if parsing fails
                 		today = zoho.currenttime.toString("EEEE");
                 	}
                 	getStores = New_Restaurant[ID == storeid && isActive == true];
                 	if(getStores.count() > 0)
                 	{
                 		for each  storeRow in getStores
                 		{
                 			imgSrc = thisapp.fileManagement.processImageUrl(storeRow.Store_Preview);
                 			country_name = global_configuration.fetchrecord.getmarketshortbyid(storeRow.Market_Global_new).get("market_short");
                 			//info country_name;
                 			// -----------------------------
                 			// Store Overview
                 			// -----------------------------
                 			overview = Map();
                 			overview.put("id",storeRow.ID.toString());
                 			overview.put("store_id",storeRow.Store_ID.tostring());
                 			overview.put("location_name",storeRow.Restaurant_Name);
                 			overview.put("country_name",country_name);
                 			overview.put("location_icon",thisapp.imageUrl.getappiconsbytype("1"));
                 			overview.put("review_value",storeRow.Rating);
                 			overview.put("review_count","0");
                 			// Phone (keep as text; icon stays in phone_icon)
                 			if(storeRow.Phone_Number != null)
                 			{
                 				formattedPhone = thisapp.formater.Format_Phone(toString(storeRow.Phone_Number));
                 				overview.put("phone",formattedPhone);
                 			}
                 			else
                 			{
                 				overview.put("phone","");
                 			}
                 			overview.put("phone_icon",thisapp.imageUrl.getappiconsbytype("2"));
                 			overview.put("direction_text","Get directions");
                 			overview.put("direction_icon",thisapp.imageUrl.getappiconsbytype("3"));
                 			overview.put("duration","");
                 			overview.put("destination","");
                 			// -----------------------------
                 			// Open/Close Status (robust)
                 			// -----------------------------
                 			storeStatusString = "";
                 			isOpened = false;
                 			parsedLocalTime = localTime.toTime();
                 			// user provided local time
                 			for each  timing in storeRow.Operating_Hourse
                 			{
                 				// timing.Days might be a list (Mon..Sun) or a single value
                 				isTodaySlot = false;
                 				try 
                 				{
                 					for each  d in timing.Days
                 					{
                 						if(d == today)
                 						{
                 							isTodaySlot = true;
                 							break;
                 						}
                 					}
                 				}
                 				catch (e)
                 				{
                 					// If not iterable, compare directly
                 					try 
                 					{
                 						if(timing.Days == today)
                 						{
                 							isTodaySlot = true;
                 						}
                 					}
                 					catch (ee)
                 					{
                 					}
                 				}
                 				if(!isTodaySlot)
                 				{
                 					continue;
                 				}
                 				fromTime = (zoho.currentdate.toString() + " " + timing.Opening_Hrs.toString()).toTime();
                 				toTime = (zoho.currentdate.toString() + " " + timing.Closing_Hourse.toString()).toTime();
                 				// Handle overnight (closing past midnight)
                 				parsedCheck = parsedLocalTime;
                 				if(fromTime > toTime)
                 				{
                 					toTime = toTime.addHour(24);
                 					if(parsedCheck < fromTime)
                 					{
                 						parsedCheck = parsedCheck.addHour(24);
                 					}
                 				}
                 				if(parsedCheck < fromTime || parsedCheck > toTime)
                 				{
                 					fromHour = if(fromTime.getHour() > 12,fromTime.getHour() - 12,if(fromTime.getHour() == 0,12,fromTime.getHour()));
                 					fromSuffix = if(fromTime.getHour() >= 12,"PM","AM");
                 					fromMin = if(fromTime.getMinutes() < 10,"0" + fromTime.getMinutes(),fromTime.getMinutes());
                 					storeStatusString = "Closed (Opens at " + fromHour + ":" + fromMin + " " + fromSuffix + ")";
                 				}
                 				else
                 				{
                 					isOpened = true;
                 					toHour = if(toTime.getHour() > 12,toTime.getHour() - 12,if(toTime.getHour() == 0,12,toTime.getHour()));
                 					toSuffix = if(toTime.getHour() >= 12,"PM","AM");
                 					toMin = if(toTime.getMinutes() < 10,"0" + toTime.getMinutes(),toTime.getMinutes());
                 					storeStatusString = "Open (Closes at " + toHour + ":" + toMin + " " + toSuffix + ")";
                 				}
                 				// Once matched & computed, stop
                 				break;
                 			}
                 			overview.put("operating_status",storeStatusString);
                 			overview.put("is_open",isOpened);
                 			overview.put("latitude",storeRow.Lat);
                 			overview.put("longitude",storeRow.Long);
                 			// -----------------------------
                 			// Store Detail View
                 			// -----------------------------
                 			detail = Map();
                 			// Header
                 			header = Map();
                 			header.put("title",storeRow.Restaurant_Name);
                 			header.put("image_src",thisapp.imageUrl.getstoreimageurl(storeRow.ID.toString()));
                 			detail.put("header",header);
                 			// Basic Section
                 			basic = Map();
                 			basic.put("location_name",overview.get("location_name"));
                 			basic.put("location_icon",overview.get("location_icon"));
                 			basic.put("review_value",overview.get("review_value"));
                 			basic.put("review_count",overview.get("review_count"));
                 			basic.put("phone",overview.get("phone"));
                 			basic.put("phone_icon",overview.get("phone_icon"));
                 			basic.put("direction_text",overview.get("direction_text"));
                 			basic.put("direction_icon",overview.get("direction_icon"));
                 			basic.put("duration",overview.get("duration"));
                 			basic.put("destination",overview.get("destination"));
                 			basic.put("timing_text",overview.get("operating_status"));
                 			detail.put("basic_section",basic);
                 			// Timings Section
                 			timing_section = Map();
                 			timing_section.put("title","Timings");
                 			unsorted_timing_list = list();
                 			for each  t in storeRow.Operating_Hourse
                 			{
                 				openTime = t.Opening_Hrs.toString();
                 				closeTime = t.Closing_Hourse.toString();
                 				// t.Days could be list or single value
                 				try 
                 				{
                 					for each  day in t.Days
                 					{
                 						timingEntry = Map();
                 						timingEntry.put("day",day);
                 						timingEntry.put("opening_time",openTime);
                 						timingEntry.put("closing_time",closeTime);
                 						unsorted_timing_list.add(timingEntry);
                 					}
                 				}
                 				catch (e)
                 				{
                 					day = "";
                 					try 
                 					{
                 						day = t.Days;
                 					}
                 					catch (ee)
                 					{
                 					}
                 					if(day != "")
                 					{
                 						timingEntry2 = Map();
                 						timingEntry2.put("day",day);
                 						timingEntry2.put("opening_time",openTime);
                 						timingEntry2.put("closing_time",closeTime);
                 						unsorted_timing_list.add(timingEntry2);
                 					}
                 				}
                 			}
                 			ordered_days = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"};
                 			timing_list = list();
                 			for each  dname in ordered_days
                 			{
                 				for each  tentry in unsorted_timing_list
                 				{
                 					if(tentry.get("day") == dname)
                 					{
                 						timing_list.add(tentry);
                 					}
                 				}
                 			}
                 			timing_section.put("timings_list",timing_list);
                 			detail.put("timing_section",timing_section);
                 			// Amenities Section
                 			amenities = Map();
                 			amenities.put("title","Amenities");
                 			amenity_list = list();
                 			for each  amenity in storeRow.Amenities1
                 			{
                 				activeamn = Amenities[ID == amenity];
                 				a = Map();
                 				a.put("amenity_name",activeamn.Amenity_Type);
                 				a.put("amenity_icon",thisapp.imageUrl.getammenitiesImageurl(activeamn.ID.toString()));
                 				amenity_list.add(a);
                 			}
                 			amenities.put("amenities_list",amenity_list);
                 			detail.put("amenities_section",amenities);
                 			// Assemble one-store block
                 			store = Map();
                 			store.put("store_overview",overview);
                 			store.put("store_detail_view",detail);
                 			storeList.add(store);
                 		}
                 	}
                 	// -----------------------------
                 	// Filter Section (unchanged)
                 	// -----------------------------
                 	filter = Map();
                 	filterHeader = Map();
                 	filterHeader.put("title","Filter Stores");
                 	filter.put("header",filterHeader);
                 	filter_list = list();
                 	filter1 = Map();
                 	filter1.put("filter_option_title","Store hours");
                 	storeHoursList = list();
                 	storeHoursList.add("Open 24/7");
                 	storeHoursList.add("Open now");
                 	filter1.put("filter_option_list",storeHoursList);
                 	filter_list.add(filter1);
                 	filter.put("filter_list",filter_list);
                 	footer = Map();
                 	footer.put("reset_button_name","Reset all");
                 	footer.put("apply_button_name","Apply filter");
                 	filter.put("footer",footer);
                 	// Final response
                 	result.put("store_view_title","Our Stores");
                 	result.put("search_hint_text","Search stores, area or street name");
                 	result.put("search_store_not_found_string","No stores found");
                 	result.put("stores",storeList);
                 	result.put("filter_section",filter);
                 	response.put("result",result);
                 	response.put("code",3000);
                 	// IMPORTANT: return the built response (not an empty map)
                 	return response;
                 }
				 map storemanagement.getAllStorepeets_V2(string brandid, string marketid, string localTime)
                 {
                 	// 	brandid = "4661594000008183591";
                 	// 	marketid = "4661594000008171931";
                 	// 	localTime = "22-10-2025 09:30:00 AM";
                 	localTime = localTime.toDate("dd-MM-yyyy hh:mm:ss a");
                 	response = Map();
                 	result = Map();
                 	storeList = list();
                 	days = {"Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"};
                 	today = days.get(localTime.toTime().getDayOfWeek() - 1);
                 	getStores = New_Restaurant[Market_Global_new == toNumber(marketid) && isActive == true];
                 	if(getStores.count() > 0)
                 	{
                 		for each  storeRow in getStores
                 		{
                 			imgSrc = thisapp.fileManagement.processImageUrl(storeRow.Store_Preview);
                 			store = Map();
                 			overview = Map();
                 			overview.put("id",storeRow.ID.tostring());
                 			overview.put("location_name",storeRow.Restaurant_Name);
                 			overview.put("location_icon",thisapp.imageUrl.getappiconsbytype("1"));
                 			overview.put("review_value",storeRow.Rating);
                 			overview.put("rating_count",storeRow.Store_Rating.tostring());
                 			overview.put("review_count",storeRow.Count_of_Reviews.tostring());
                 			if(storeRow.Phone_Number != null)
                 			{
                 				formattedPhone = thisapp.formater.Format_Phone(toString(storeRow.Phone_Number));
                 				overview.put("phone",formattedPhone);
                 			}
                 			else
                 			{
                 				overview.put("phone",thisapp.imageUrl.getappiconsbytype("2"));
                 			}
                 			overview.put("phone_icon",thisapp.imageUrl.getappiconsbytype("2"));
                 			overview.put("direction_text","Get directions");
                 			overview.put("direction_icon",thisapp.imageUrl.getappiconsbytype("3"));
                 			overview.put("duration","");
                 			overview.put("destination","");
                 			// ---------- Open/Close Status ----------
                 			storeStatusString = "";
                 			isOpened = false;
                 			isAlwaysOpen = true;
                 			for each  t in storeRow.Operating_Hourse
                 			{
                 				openHr = t.Opening_Hrs.toString();
                 				closeHr = t.Closing_Hourse.toString();
                 				//	info openHr +'-'+ closeHr;
                 				if(!(openHr == "12:00 AM" || openHr == "00:00:00" && closeHr == "11:59 PM" || closeHr == "11:59:59 PM" || closeHr == "23:59:59"))
                 				{
                 					isAlwaysOpen = false;
                 					break;
                 				}
                 			}
                 			for each  timing in storeRow.Operating_Hourse
                 			{
                 				if(timing.Days == today)
                 				{
                 					if(isAlwaysOpen)
                 					{
                 						isOpened = true;
                 						storeStatusString = "Open 24/7";
                 						break;
                 					}
                 					fromTime = (zoho.currentdate.toString() + " " + timing.Opening_Hrs.toString()).toTime();
                 					toTime = (zoho.currentdate.toString() + " " + timing.Closing_Hourse.toString()).toTime();
                 					parsedLocalTime = localTime.toTime();
                 					if(fromTime > toTime)
                 					{
                 						toTime = toTime.addHour(24);
                 						if(parsedLocalTime < fromTime)
                 						{
                 							parsedLocalTime = parsedLocalTime.addHour(24);
                 						}
                 					}
                 					if(parsedLocalTime < fromTime || parsedLocalTime > toTime)
                 					{
                 						fromHour = if(fromTime.getHour() > 12,fromTime.getHour() - 12,fromTime.getHour());
                 						fromSuffix = if(fromTime.getHour() >= 12,"PM","AM");
                 						fromMin = if(fromTime.getMinutes() < 10,"0" + fromTime.getMinutes(),fromTime.getMinutes());
                 						storeStatusString = "Closed (Opens at " + fromHour + ":" + fromMin + " " + fromSuffix + ")";
                 					}
                 					else
                 					{
                 						isOpened = true;
                 						toHour = if(toTime.getHour() > 12,toTime.getHour() - 12,if(toTime.getHour() == 0,12,toTime.getHour()));
                 						toSuffix = if(toTime.getHour() >= 12,"PM","AM");
                 						toMin = if(toTime.getMinutes() < 10,"0" + toTime.getMinutes(),toTime.getMinutes());
                 						storeStatusString = "Open (Closes at " + toHour + ":" + toMin + " " + toSuffix + ")";
                 					}
                 					break;
                 				}
                 			}
                 			overview.put("operating_status",storeStatusString);
                 			overview.put("is_open",isOpened);
                 			overview.put("is_open_always",isAlwaysOpen);
                 			// ✅ Now always has true/false
                 			overview.put("latitude",storeRow.Lat);
                 			overview.put("longitude",storeRow.Long);
                 			// ---------- Store Detail View ----------
                 			detail = Map();
                 			header = Map();
                 			header.put("title",storeRow.Restaurant_Name);
                 			header.put("image_src",thisapp.imageUrl.getstoreimageurl(storeRow.ID.tostring()));
                 			detail.put("header",header);
                 			basic = Map();
                 			basic.put("location_name",overview.get("location_name"));
                 			basic.put("location_icon",overview.get("location_icon"));
                 			basic.put("review_value",overview.get("review_value"));
                 			basic.put("review_count",overview.get("review_count"));
                 			basic.put("phone",overview.get("phone"));
                 			basic.put("phone_icon",overview.get("phone_icon"));
                 			basic.put("direction_text",overview.get("direction_text"));
                 			basic.put("direction_icon",overview.get("direction_icon"));
                 			basic.put("duration",overview.get("duration"));
                 			basic.put("destination",overview.get("destination"));
                 			basic.put("timing_text",overview.get("operating_status"));
                 			detail.put("basic_section",basic);
                 			// ---------- Timings Section ----------
                 			timing_section = Map();
                 			timing_section.put("title","Timings");
                 			unsorted_timing_list = list();
                 			for each  t in storeRow.Operating_Hourse
                 			{
                 				days_list = t.Days;
                 				openTime = t.Opening_Hrs.toString();
                 				closeTime = t.Closing_Hourse.toString();
                 				for each  day in days_list
                 				{
                 					timingEntry = Map();
                 					timingEntry.put("day",day);
                 					timingEntry.put("opening_time",openTime);
                 					timingEntry.put("closing_time",closeTime);
                 					unsorted_timing_list.add(timingEntry);
                 				}
                 			}
                 			ordered_days = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"};
                 			timing_list = list();
                 			for each  day in ordered_days
                 			{
                 				for each  t in unsorted_timing_list
                 				{
                 					if(t.get("day") == day)
                 					{
                 						timing_list.add(t);
                 					}
                 				}
                 			}
                 			timing_section.put("timings_list",timing_list);
                 			detail.put("timing_section",timing_section);
                 			// ---------- Amenities Section ----------
                 			amenities = Map();
                 			amenities.put("title","Amenities");
                 			amenity_list = list();
                 			for each  amenity in storeRow.Amenities1
                 			{
                 				activeamn = Amenities[ID == amenity];
                 				a = Map();
                 				a.put("amenity_name",activeamn.Amenity_Type);
                 				a.put("amenity_icon",thisapp.imageUrl.getammenitiesImageurl(activeamn.ID.tostring()));
                 				amenity_list.add(a);
                 			}
                 			amenities.put("amenities_list",amenity_list);
                 			detail.put("amenities_section",amenities);
                 			store.put("store_overview",overview);
                 			store.put("store_detail_view",detail);
                 			storeList.add(store);
                 		}
                 	}
                 	// ---------- Filter Section ----------
                 	filter = Map();
                 	filterHeader = Map();
                 	filterHeader.put("title","Filter Stores");
                 	filter.put("header",filterHeader);
                 	filter_list = list();
                 	filter1 = Map();
                 	filter1.put("filter_option_title","Store hours");
                 	storeHoursList = list();
                 	storeHoursList.add("Open 24/7");
                 	storeHoursList.add("Open now");
                 	filter1.put("filter_option_list",storeHoursList);
                 	filter_list.add(filter1);
                 	filter.put("filter_list",filter_list);
                 	footer = Map();
                 	footer.put("reset_button_name","Reset all");
                 	footer.put("apply_button_name","Apply filter");
                 	filter.put("footer",footer);
                 	// ---------- Final Response ----------
                 	result.put("store_view_title","Our Stores");
                 	result.put("search_hint_text","Search stores, area or street name");
                 	result.put("search_store_not_found_string","No stores found");
                 	result.put("stores",storeList);
                 	result.put("filter_section",filter);
                 	response.put("result",result);
                 	response.put("code",3000);
                 	return result;
                 }
				 map storemanagement.getAllStorepeets_V3(string brandid, string marketid, string localTime)
                 {
                 	// 	brandid = "4661594000008183591";
                 	// 	marketid = "4661594000008171931";
                 	// 	localTime = "22-12-2025 09:30:00 AM".toDate("dd-MM-yyyy hh:mm:ss a");
                 	localTime = localTime;
                 	//.toDate("dd-MM-yyyy hh:mm:ss a");
                 	response = Map();
                 	result = Map();
                 	storeList = List();
                 	// Preload icons
                 	appIcons = Map();
                 	appIcons.put("1",thisapp.imageUrl.getappiconsbytype("1"));
                 	appIcons.put("2",thisapp.imageUrl.getappiconsbytype("2"));
                 	appIcons.put("3",thisapp.imageUrl.getappiconsbytype("3"));
                 	allAmenities = Amenities[ID != 0];
                 	// days array
                 	days = {"Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"};
                 	today = days.get(localTime.toTime().getDayOfWeek() - 1);
                 	currentDateString = zoho.currentdate.toString();
                 	getStores = New_Restaurant[Market_Global_new == toNumber(marketid) && isActive == true];
                 	if(getStores.count() > 0)
                 	{
                 		for each  storeRow in getStores
                 		{
                 			store = Map();
                 			overview = Map();
                 			latitude = storeRow.Lat;
                 			longitude = storeRow.Long;
                 			overview.put("id",storeRow.ID.toString());
                 			overview.put("location_name",storeRow.Restaurant_Name);
                 			overview.put("location_icon",appIcons.get("1"));
                 			overview.put("review_value",storeRow.Rating);
                 			overview.put("rating_count",storeRow.Store_Rating.toString());
                 			overview.put("review_count",storeRow.Count_of_Reviews.toString());
                 			if(storeRow.Phone_Number != null)
                 			{
                 				overview.put("phone",thisapp.formater.Format_Phone(toString(storeRow.Phone_Number)));
                 			}
                 			else
                 			{
                 				overview.put("phone",appIcons.get("2"));
                 			}
                 			overview.put("phone_icon",appIcons.get("2"));
                 			overview.put("direction_text","Get directions");
                 			overview.put("direction_icon",appIcons.get("3"));
                 			overview.put("duration","");
                 			overview.put("destination","");
                 			overview.put("latitude",latitude);
                 			overview.put("longitude",longitude);
                 			// ------------------ Hours ------------------
                 			isOpened = false;
                 			isAlwaysOpen = true;
                 			todayOpening = null;
                 			todayClosing = null;
                 			for each  t in storeRow.Operating_Hourse
                 			{
                 				openHr = t.Opening_Hrs.toString();
                 				closeHr = t.Closing_Hourse.toString();
                 				if(!(openHr == "12:00 AM" || openHr == "00:00:00" || closeHr == "11:59 PM" || closeHr == "11:59:59 PM" || closeHr == "23:59:59"))
                 				{
                 					isAlwaysOpen = false;
                 				}
                 				if(t.Days == today)
                 				{
                 					todayOpening = openHr;
                 					todayClosing = closeHr;
                 				}
                 			}
                 			if(isAlwaysOpen)
                 			{
                 				isOpened = true;
                 				storeStatusString = "Open 24/7";
                 			}
                 			else if(todayOpening != null)
                 			{
                 				fromTime = (currentDateString + " " + todayOpening).toTime();
                 				toTime = (currentDateString + " " + todayClosing).toTime();
                 				parsedLocalTime = localTime.toTime();
                 				if(fromTime > toTime)
                 				{
                 					toTime = toTime.addHour(24);
                 					if(parsedLocalTime < fromTime)
                 					{
                 						parsedLocalTime = parsedLocalTime.addHour(24);
                 					}
                 				}
                 				if(parsedLocalTime < fromTime || parsedLocalTime > toTime)
                 				{
                 					fh = fromTime.getHour();
                 					fm = fromTime.getMinutes();
                 					fs = if(fh >= 12,"PM","AM");
                 					fh = if(fh > 12,fh - 12,fh);
                 					fm = if(fm < 10,"0" + fm,fm);
                 					storeStatusString = "Closed (Opens at " + fh + ":" + fm + " " + fs + ")";
                 				}
                 				else
                 				{
                 					isOpened = true;
                 					th = toTime.getHour();
                 					tm = toTime.getMinutes();
                 					ts = if(th >= 12,"PM","AM");
                 					th = if(th > 12,th - 12,if(th == 0,12,th));
                 					tm = if(tm < 10,"0" + tm,tm);
                 					storeStatusString = "Open (Closes at " + th + ":" + tm + " " + ts + ")";
                 				}
                 			}
                 			else
                 			{
                 				storeStatusString = "Closed";
                 			}
                 			overview.put("operating_status",storeStatusString);
                 			overview.put("is_open",isOpened);
                 			overview.put("is_open_always",isAlwaysOpen);
                 			// ------------------ Detail ------------------
                 			detail = Map();
                 			header = Map();
                 			header.put("title",storeRow.Restaurant_Name);
                 			header.put("image_src",thisapp.imageUrl.getstoreimageurl(storeRow.ID.toString()));
                 			detail.put("header",header);
                 			basic = Map();
                 			for each  k in overview.keys()
                 			{
                 				basic.put(k,overview.get(k));
                 			}
                 			basic.put("timing_text",overview.get("operating_status"));
                 			detail.put("basic_section",basic);
                 			// ------------------ Timings ------------------
                 			timingMap = Map();
                 			for each  t in storeRow.Operating_Hourse
                 			{
                 				// 				open = t.Opening_Hrs.toString();
                 				// 				close = t.Closing_Hourse.toString();
                 				open = "";
                 				close = "";
                 				if(t.Opening_Hrs != null)
                 				{
                 					oh = t.Opening_Hrs.getHour();
                 					om = t.Opening_Hrs.getMinutes();
                 					oampm = if(oh >= 12,"PM","AM");
                 					if(oh > 12)
                 					{
                 						oh = oh - 12;
                 					}
                 					else if(oh == 0)
                 					{
                 						oh = 12;
                 					}
                 					if(om < 10)
                 					{
                 						om = "0" + om;
                 					}
                 					open = oh + ":" + om + " " + oampm;
                 				}
                 				if(t.Closing_Hourse != null)
                 				{
                 					ch = t.Closing_Hourse.getHour();
                 					cm = t.Closing_Hourse.getMinutes();
                 					campm = if(ch >= 12,"PM","AM");
                 					if(ch > 12)
                 					{
                 						ch = ch - 12;
                 					}
                 					else if(ch == 0)
                 					{
                 						ch = 12;
                 					}
                 					if(cm < 10)
                 					{
                 						cm = "0" + cm;
                 					}
                 					close = ch + ":" + cm + " " + campm;
                 				}
                 				// // -------- DEBUG LOGS --------
                 				// info t.Opening_Hrs;
                 				// info open;
                 				// info "---------";
                 				// info t.Closing_Hourse;
                 				// info close;
                 				for each  d in t.Days
                 				{
                 					entry = Map();
                 					entry.put("day",d);
                 					entry.put("opening_time",open);
                 					entry.put("closing_time",close);
                 					timingMap.put(d,entry);
                 				}
                 			}
                 			ordered_days = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"};
                 			timing_list = {};
                 			for each  d in ordered_days
                 			{
                 				if(timingMap.containKey(d))
                 				{
                 					timing_list.add(timingMap.get(d));
                 				}
                 			}
                 			timing_section = Map();
                 			timing_section.put("title","Timings");
                 			timing_section.put("timings_list",timing_list);
                 			detail.put("timing_section",timing_section);
                 			// ------------------ Amenities ------------------
                 			amenity_list = {};
                 			allamenity_map = Map();
                 			// KEY = ID, VALUE = amenity details map
                 			for each  am in allAmenities
                 			{
                 				amMap = Map();
                 				amMap.put("a_type",am.Amenity_Type);
                 				amMap.put("ID",am.ID);
                 				allamenity_map.put(am.ID.toString(),amMap);
                 			}
                 			for each  amenityID in storeRow.Amenities1
                 			{
                 				aid = amenityID.toString();
                 				// KEY must be string
                 				activeamn = allamenity_map.get(aid);
                 				if(activeamn != null)
                 				{
                 					a = Map();
                 					a.put("amenity_name",activeamn.get("a_type"));
                 					a.put("amenity_icon",thisapp.imageUrl.getammenitiesImageurl(activeamn.get("ID").tostring()));
                 					amenity_list.add(a);
                 				}
                 			}
                 			amenities = Map();
                 			amenities.put("title","Amenities");
                 			amenities.put("amenities_list",amenity_list);
                 			detail.put("amenities_section",amenities);
                 			store.put("store_overview",overview);
                 			store.put("store_detail_view",detail);
                 			storeList.add(store);
                 		}
                 	}
                 	// ---------- Filter Section ----------
                 	filter_list = {};
                 	filterOption = Map();
                 	filterOption.put("filter_option_title","Store hours");
                 	filterOptionList = {};
                 	filterOptionList.add("Open 24/7");
                 	filterOptionList.add("Open now");
                 	filterOption.put("filter_option_list",filterOptionList);
                 	filter_list.add(filterOption);
                 	headerMap = Map();
                 	headerMap.put("title","Filter Stores");
                 	footerMap = Map();
                 	footerMap.put("reset_button_name","Reset all");
                 	footerMap.put("apply_button_name","Apply filter");
                 	filter = Map();
                 	filter.put("header",headerMap);
                 	filter.put("filter_list",filter_list);
                 	filter.put("footer",footerMap);
                 	result.put("store_view_title","Our Stores");
                 	result.put("search_hint_text","Search stores, area or street name");
                 	result.put("search_store_not_found_string","No stores found");
                 	result.put("stores",storeList);
                 	result.put("filter_section",filter);
                 	response.put("result",result);
                 	response.put("code",3000);
                 	return result;
                 }
