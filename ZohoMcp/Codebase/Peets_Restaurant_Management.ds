				 list internal.sortListByNumericField(list itemTypeList, string fieldName)
                 {
                 	listSize = itemTypeList.size();
                 	if(listSize > 1)
                 	{
                 		for each  index1 in itemTypeList
                 		{
                 			for each  index2 in itemTypeList
                 			{
                 				priority1 = index1.get(fieldName).toNumber();
                 				priority2 = index2.get(fieldName).toNumber();
                 				if(priority1 < priority2)
                 				{
                 					temp = index1;
                 					index1.putAll(index2);
                 					index2.putAll(temp);
                 				}
                 			}
                 		}
                 	}
                 	return itemTypeList;
                 }
				 string latlongfromcsv.getLatlongFromCSV(String fileContent)
                 {
                 	//fileContent = input.File_Upload.content;
                 	startIndex = fileContent.indexOf("((") + 2;
                 	endIndex = fileContent.indexOf("))");
                 	if(startIndex > 1 && endIndex > startIndex)
                 	{
                 		coords = fileContent.subString(startIndex,endIndex);
                 		coords_list = coords.toList(", ");
                 		coordinates_json = List();
                 		for each  coord in coords_list
                 		{
                 			v = coord.toList(" ");
                 			if(v.size() == 2)
                 			{
                 				latitude = v.get(0);
                 				longitude = v.get(1);
                 				//info "Latitude: " + latitude + ", Longitude: " + longitude;
                 				coord_json = Map();
                 				coord_json.put("lat",latitude);
                 				coord_json.put("long",longitude);
                 				coordinates_json.add(coord_json);
                 			}
                 		}
                 	}
                 	return coordinates_json.toString();
                 }
