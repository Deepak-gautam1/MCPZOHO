		 functions
		 {
			 Deluge
			 {
				 list fetchrecord.getallbrands(string brandid)
                 {
                 	lstbrand = List();
                 	allbrands = Brand[Brand_ID == brandid];
                 	for each  b in allbrands
                 	{
                 		m = Map();
                 		m.put("ID",b.ID);
                 		m.put("Brand_Name",b.Brand_Name);
                 		// Add all necessary fields
                 		m.put("Brand_ID",b.Brand_ID);
                 		m.put("Brand_Short",b.Brand_Short);
                 		m.put("market",b.Market_Brand1);
                 		m.put("countmarket",b.Market_Brand1.size());
                 		// Add other fields as needed
                 		lstbrand.add(m);
                 	}
                 	return lstbrand;
                 }
				 string fetchrecord.getallmarket(int marketid)
                 {
                 	return Market[ID == marketid].Market;
                 }
				 list fetchrecord.getbrandbyid(int brandid)
                 {
                 	lstbrand = List();
                 	allbrands = Brand[ID == brandid];
                 	for each  b in allbrands
                 	{
                 		m = Map();
                 		m.put("ID",b.ID);
                 		m.put("Brand_Name",b.Brand_Name);
                 		m.put("Brand_ID",b.Brand_ID);
                 		m.put("Brand_Short",b.Brand_Short);
                 		m.put("market",b.Market_Brand1);
                 		market_list = List();
                 		for each  market in b.Market_Brand1
                 		{
                 			objmarket = Market[ID == market.ID];
                 			market_map = Map();
                 			market_map.put("ID",objmarket.ID);
                 			market_map.put("Market_Name",objmarket.Market);
                 			// Adjust field name if different
                 			market_list.add(market_map);
                 		}
                 		m.put("Markets",market_list);
                 		m.put("countmarket",market_list.size());
                 		lstbrand.add(m);
                 	}
                 	return lstbrand;
                 }
				 string fetchrecord.getcurrencybymarketid(int marketid)
                 {
                 	return Market[ID == marketid].Currency_Market;
                 }
				 list fetchrecord.getlstNationality()
                 {
                 	lstResponse = List();
                 	lstOfNationality = Nationality[ID != 0 && isActive == true];
                 	info lstOfNationality;
                 	for each  nationality in lstOfNationality
                 	{
                 		resMap = Map();
                 		resMap.put("ID",nationality.ID.tostring());
                 		resMap.put("name",nationality.Name);
                 		resMap.put("short_name",nationality.Short_Name);
                 		lstResponse.add(resMap);
                 		// Add map into list
                 	}
                 	return lstResponse;
                 }
				 map fetchrecord.getmarketbydialingcode(string code)
                 {
                 	lstmarket = Market[International_Dialling_Code == code];
                 	response = Map();
                 	response.put("ID",lstmarket.ID);
                 	response.put("market_full_name",lstmarket.Market);
                 	response.put("market_short_name",lstmarket.Market_Short);
                 	response.put("currency",lstmarket.Currency_Market);
                 	response.put("market_id",lstmarket.Market_ID);
                 	return response;
                 }
				 map fetchrecord.getmarketshortbyid(int id)
                 {
                 	result = Map();
                 	m = Market[ID == id];
                 	result.put("flag",ifnull(m.Flag,""));
                 	result.put("international_dialling_code",ifnull(m.International_Dialling_Code,""));
                 	result.put("market_short",ifnull(m.Market_Short,""));
                 	return result;
                 }
				 map fetchrecord.getnationalitybyid(string id)
                 {
                 	lstResponse = List();
                 	resMap = Map();
                 	lstOfNationality = Nationality[ID == id.tolong()];
                 	info lstOfNationality;
                 	for each  nationality in lstOfNationality
                 	{
                 		resMap.put("ID",nationality.ID.tostring());
                 		resMap.put("name",nationality.Name);
                 		resMap.put("short_name",nationality.Short_Name);
                 		//lstResponse.add(resMap);
                 		// Add map into list
                 	}
                 	return resMap;
                 }
				 void signupmanagement.signupbonussettlement(int customer_id)
                 {
                 }
			 }
