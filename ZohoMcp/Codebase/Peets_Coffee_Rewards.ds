			Delete_Logs_Older_7_days as "Delete Logs Older 7 days"
			{
				type =  schedule
				start = "2026-04-18 05:00:34"
				frequency = daily
				time zone = "Asia/Dubai"
				on start
				{
					actions 
					{
					on load
					(
						// API Logs | Delete records older than 7 days
										delete from ApiLog[Modified_Time < zoho.currenttime.addDay(-3)];
										// NCR Logs |  | Delete records older than 7 days
										delete from ncr_logs[Added_Time < zoho.currenttime.addDay(-3)];
					)
					}
				}
			}
