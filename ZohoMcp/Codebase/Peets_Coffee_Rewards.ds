				 list fetchRecords.getpromotionforhomepage()
                 {
                 	try 
                 	{
                 		validPromotions = List();
                 		allPromotions = Promotions_Home[ID != 0] sort by Display_Seq_Priority asc;
                 		//info "Total Promotions Fetched: " + allPromotions.count().toString();
                 		for each  promotion in allPromotions
                 		{
                 			isActive = ifnull(promotion.Activity_Status,"false") == "true";
                 			fromDate = ifnull(promotion.From,zoho.currentdate);
                 			toDate = ifnull(promotion.To,zoho.currentdate);
                 			if(isActive && zoho.currentdate >= fromDate && zoho.currentdate <= toDate)
                 			{
                 				promoMap = Map();
                 				promoMap.put("id",promotion.ID.toString());
                 				promoMap.put("title",promotion.Promotion_Title);
                 				promoMap.put("type",promotion.Type_of_Promotion);
                 				promoMap.put("market",promotion.Market_Global_pro);
                 				promoMap.put("from_date",fromDate.toString("yyyy-MM-dd"));
                 				promoMap.put("to_date",toDate.toString("yyyy-MM-dd"));
                 				promoMap.put("display_seq_priority",promotion.Display_Seq_Priority.toString());
                 				promoMap.put("status",promotion.Activity_Status.toString());
                 				promoMap.put("image",thisapp.publicUrls.getpromotionimages(promotion.ID.toString()));
                 				validPromotions.add(promoMap);
                 			}
                 		}
                 		//	info validPromotions;
                 		return validPromotions;
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getPromotions_V2",e);
                 	}
                 	return List();
                 	// return empty list if error
                 }
				 list fetchRecords.getPromotions(Customer_Points_System pointSystem)
                 {
                 	try 
                 	{
                 		// 		getOverview = Home_Overview[Membership_Level == pointSystem.Membership_Level];
                 		getOverview = Home_Overview[ID != 0];
                 		if(getOverview.count() > 0)
                 		{
