				 map loyaltyEngine.creditrefundbonustrans_FINAL()
                 {
                 	orderid = "4661594000016230026";
                 	mapres = Map();
                 	mapres.put("id","0");
                 	mapres.put("is_done",false);
                 	trans = Transaction[Order_ID == orderid] range from 0 to 0;
                 	if(trans.count() == 0)
                 	{
                 		info "No transaction found";
                 		return mapres;
                 	}
                 	customer = Customer[ID == trans.Customer] range from 0 to 1;
                 	transactionType = "Bonus";
                 	b_type = "Refund";
                 	b_point = Bonus_Points[Bonus_Type == b_type.trim() && Status == "Active"];
                 	// ===== ORIGINAL VALUES =====
                 	previouse_earrn = ifnull(trans.Earned_Loyalty_Points,0);
                 	previouse_burned_points = ifnull(trans.Burned_Points,0);
                 	previouse_burned_bonus = ifnull(trans.Bonus_Points_Burned,0);
                 	total_invoice = ifnull(trans.Total_Invoice_Amount,0);
                 	total_discount = ifnull(trans.Total_Discount_Amount,0);
                 	total_purchase = ifnull(trans.Total_Purchase_Amount,0);
                 	// ===== CUSTOMER CURRENT BALANCE =====
                 	customer_points = Customer_Points_System[Customer == customer] range from 0 to 1;
                 	previousBonus = customer_points.Bonus_Points;
                 	previousAvailable = customer_points.Available_Points;
                 	available_before = 0;
                 	bonus_before = 0;
                 	if(customer_points != null)
                 	{
                 		available_before = ifnull(customer_points.Available_Points,0);
                 		bonus_before = ifnull(customer_points.Bonus_Points,0);
                 	}
                 	// ===== REFUND CALCULATION =====
                 	refund_earned_points = previouse_earrn;
                 	points_refund = previouse_burned_points;
                 	bonus_refund = previouse_burned_bonus;
                 	new_available = available_before - refund_earned_points + points_refund;
                 	new_bonus = bonus_before + bonus_refund;
                 	info "Available Before  : " + available_before;
                 	info "Bonus Before      : " + bonus_before;
                 	info "New Available     : " + new_available;
                 	info "New Bonus         : " + new_bonus;
                 	// ===== PREVIOUS TOTAL BONUS + AVAILABLE =====
                 	previouse_available_bonus_balance = ifnull(trans.Bonus_Available,0) + ifnull(trans.Available_Points,0);
                 	// ===== BONUS VALIDITY SAFE =====
                 	expiryDays = 0;
                 	if(b_point != null)
                 	{
                 		expiryDays = ifnull(b_point.Bonus_Expiration_Days,0);
                 	}
                 	bonusValidity = zoho.currenttime.addDay(expiryDays);
                 	if(trans.count() > 0)
                 	{
                 		bonus_balance = ifnull(trans.Bonus_Available,0);
                 		previouse_available_bonus_balance = ifnull(ifnull(bonus_balance.tolong(),0) + ifnull(trans.Available_Points.tolong(),0),0);
                 	}
                 	else
                 	{
                 		bonus_balance = 0;
                 		previouse_available_bonus_balance = 0;
                 	}
                 	bonus_available = bonus_refund.tolong() + bonus_balance.tolong();
                 	order_id = orderid + "-R";
                 	// ===== INSERT REFUND TRANSACTION =====
                 	transactionEarned = insert into Transaction
                 	[
                 		Added_User=zoho.loginuser
                 		Customer=customer
                 		Market_Global_txn=customer.Market_Global
                 		Type_field=transactionType
                 		Bonus_Type=b_type
                 		Previous_Total_Bonus_Available=previouse_available_bonus_balance
                 		Bonus_Points_earned=bonus_refund
                 		Bonus_Available=bonus_available
                 		BonusValidity=bonusValidity
                 		Remaining_Bonus_Points=bonus_refund
                 		Order_ID=order_id
                 		Total_Purchase_Amount=total_purchase * -1
                 		Total_Discount_Amount=total_discount * -1
                 		Total_Invoice_Amount=total_invoice * -1
                 		Available_Points=new_available
                 		Earned_Loyalty_Points=0
                 		Expired_Points=0
                 		Burned_Points=refund_earned_points
                 		Utilized_Points=0
                 		Transaction_Time=zoho.currenttime
                 		Status="Refunded"
                 		Available_Points_Before_Cancellation=available_before
                 	];
                 	// ===== UPDATE CUSTOMER POINT SYSTEM =====
                 	//transactionEarned = null;
                 	if(transactionEarned != null)
                 	{
                 		// 		getTransaction = Transaction[ID == transactionEarned];
                 		// 	getTransaction.Available_Points=customer_points.Available_Points.toLong() + refund_earned_points.toLong()*-1;
                 		// 	getTransaction.Burned_Points=refund_earned_points;
                 		// 	getTransaction.Bonus_Points_Burned=0;
                 		// 	getTransaction.Bonus_Available=ifnull(previousBonus,0) - 0;
                 		// 	getTransaction.Total_Points_Earned=ifnull(customer_points.Total_Points_Earned,0) + ifnull((refund_earned_points*-1),0).toLong();
                 		// 	getTransaction.Total_Points_Burned=customer_points.Total_Points_Burned +refund_earned_points;
                 		// 	getTransaction.Previous_Total_Bonus_Available=ifnull(previousBonus,0).tolong() + ifnull(previousAvailable,0).tolong();
                 		customer_points.Total_Points_Earned=ifnull(customer_points.Total_Points_Earned,0) + ifnull(refund_earned_points * -1,0).toLong();
                 		customer_points.Total_Points_Burned=ifnull(customer_points.Total_Points_Burned,0) + ifnull(refund_earned_points,0).toLong();
                 		customer_points.Available_Points=customer_points.Available_Points + 0 - refund_earned_points.tolong();
                 		customer_points.Bonus_Points_Burned=ifnull(customer_points.Bonus_Points_Burned,0) + 0;
                 		customer_points.Bonus_Points_Expired=ifnull(customer_points.Bonus_Points_Expired,0);
                 		mapres.put("id",transactionEarned.tostring());
                 		mapres.put("is_done",true);
                 		info "Refund block executed successfully";
                 		thisapp.loyaltyEngine.updateMembershipLevelv2(customer.Phone_Number);
                 	}
                 	return mapres;
                 }
				 map loyaltyEngine.executeLoyaltyProgramme(Map requestParams)
                 {
                 	// 	data = insert into ApiLog
                 	// 	[
                 	// 		Added_User=zoho.loginuser
                 	// 		Request_Pay_load=requestParams
                 	// 		Api_Type=-00
                 	// 	];
                 	//Map requestParams
                 	//ncrInput ={"requestParams":{"type":5,"phone_number":"+971555534010","loyalty_brand":0,"transaction":{"order_id":"65acc1d56fc140948f3175e7a0be75f6","restaurant_id":"135113","country":1,"items":[{"product_name":"S Espresso","product_id":"641100","quantity":1.0,"price":"16"},{"product_name":"Espresso Forte Small","product_id":"840155","quantity":1.0,"price":"0"},{"product_name":"S Espresso","product_id":"641100","quantity":1.0,"price":"16"},{"product_name":"Espresso Forte Small","product_id":"840155","quantity":1.0,"price":"0"},{"product_name":"S Espresso","product_id":"641100","quantity":1.0,"price":"16"},{"product_name":"Espresso Forte Small","product_id":"840155","quantity":1.0,"price":"0"},{"product_name":"Peets Loyalty","product_id":"99999","quantity":1.0,"price":"0"}],"rewards":{"free_drink":null,"membership_discount":null,"catalog_offer":null,"redeemable_points":400},"total_invoice_amount":"48.0","type":0}}};
                 	try 
                 	{
                 		//requestParams = ncrInput.toMap().get("requestParams");
                 		brandID = requestParams.get("loyalty_brand");
                 		customerPhone = requestParams.get("phone_number");
                 		if(brandID == 2)
                 		{
                 			//this if for KK only
                 			return loyalty_engine_handler.loyaltyEngineExecutionCall(requestParams);
                 		}
                 		else
                 		{
                 			if(customerPhone != null)
                 			{
                 				customer = Customer[Phone_Number == customerPhone];
                 				isExistingUser = thisapp.loyaltyEngine.isUserExist(customer);
                 				if(!isExistingUser)
                 				{
                 					customer = Customer[Phone_Number == thisapp.loyaltyEngine.addZeroPrefix(customerPhone)];
                 					isExistingUser = thisapp.loyaltyEngine.isUserExist(customer);
                 				}
                 				if(isExistingUser)
                 				{
                 					loyaltyPoints = Customer_Points_System[Customer == customer.ID];
                 					transactionHistory = Transaction[Customer == customer.ID];
                 					ncrCallType = requestParams.get("type");
                 					if(ncrCallType != null)
                 					{
                 						if(ncrCallType == 3 || ncrCallType == 4 || ncrCallType == 5)
                 						{
                 							transactionData = requestParams.get("transaction");
                 							if(transactionData != null)
                 							{
                 								totalPurchaseAmount = transactionData.get("total_purchase_amount");
                 								totalPointsRedeemed = transactionData.get("total_points_redeemed");
                 								if(ncrCallType == 3)
                 								{
                 									transactionData.put("transaction_type","purchase");
                 									return thisapp.loyaltyEngine.updateLoyaltyPoints(transactionData,customer,loyaltyPoints,transactionHistory);
                 								}
                 								else if(ncrCallType == 5)
                 								{
                 									return thisapp.loyaltyEngine.preOrderApproval(transactionData,customer,loyaltyPoints,transactionHistory);
                 								}
                 								else if(ncrCallType == 4)
                 								{
                 									// 							return thisapp.loyaltyEngine.refundAction(transactionData,customer,loyaltyPoints);
                 									return thisapp.loyaltyEngine.refund_2_0(transactionData,customer,loyaltyPoints);
                 								}
                 							}
                 						}
                 						else if(ncrCallType == 1 || ncrCallType == 2)
                 						{
                 							authorizationResponse = thisapp.loyaltyEngine.getLoyaltyData(customer,loyaltyPoints,transactionHistory);
                 							rewards = authorizationResponse.get("loyalty_details").get("rewards");
                 							//rewards.put("membership_discount",thisapp.loyaltyEngine.getMembershipDiscount(loyaltyPoints.Old_Membership_Level,customer.Country,"-1"));
                 							rewards.put("membership_discount",thisapp.loyaltyEngine.getMembershipDiscount(loyaltyPoints.Membership_Level_System.Membership_Level,customer.Country,"-1"));
                 							return authorizationResponse;
                 						}
                 					}
                 				}
                 				else
                 				{
                 					response = Map();
                 					response.put("authorized",false);
                 					return response;
                 				}
                 			}
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.executeLoyaltyProgramme",e);
                 	}
                 	return null;
                 }
				 map loyaltyEngine.executeLoyaltyProgramme_V2(Map requestParams)
                 {
                 	//Map requestParams
                 	//	info ncrInput;
                 	data = insert into ApiLog
                 	[
                 		Added_User=zoho.loginuser
                 		Request_Pay_load=requestParams
                 		Api_Type=-0
                 		Device_Type=zoho.device.type
                 		Ip_Address=zoho.ipaddress.tostring()
                 		Login_User=zoho.loginuser
                 		Login_User_Mobile=(zoho.loginuser.mobilenumber).tostring()
                 	];
                 	//ncrInput = {loyalty_brand=null, phone_number=+971555534010, type=1};
                 	//Map requestParams
                 	//ncrInput ={"requestParams":{"type":1,"phone_number":"+971555534010","loyalty_brand":null}};
                 	//ncrInput ={"requestParams":{"type":5,"phone_number":"+971555534010","loyalty_brand":0,"transaction":{"order_id":"1122","restaurant_id":"135113","country":1,"items":[{"product_name":"S Espresso","product_id":"641100","quantity":1.0,"price":"16"},{"product_name":"Espresso Forte Small","product_id":"840155","quantity":1.0,"price":"0"},{"product_name":"S Espresso","product_id":"641100","quantity":1.0,"price":"16"},{"product_name":"Espresso Forte Small","product_id":"840155","quantity":1.0,"price":"0"},{"product_name":"S Espresso","product_id":"641100","quantity":1.0,"price":"16"},{"product_name":"Espresso Forte Small","product_id":"840155","quantity":1.0,"price":"0"},{"product_name":"Peets Loyalty","product_id":"99999","quantity":1.0,"price":"0"}],"rewards":{"free_drink":null,"membership_discount":null,"catalog_offer":null,"redeemable_points":400},"total_invoice_amount":"48.0","type":0}}};
                 	try 
                 	{
                 		///this line added due to multiple request type format received from server 24-2-2026 ///////
                 		//requestParams = requestParams.toMap().get("requestParams");
                 		requestParams = requestParams.toMap();
                 		//.get("requestParams");
                 		if(requestParams == null)
                 		{
                 			requestParams = requestParams.toMap();
                 		}
                 		//info requestParams;
                 		// requestParams = ncrInput.toMap().get("requestParams");
                 		brandID = requestParams.get("loyalty_brand");
                 		customerPhone = requestParams.get("phone_number");
                 		//info customerPhone;
                 		if(brandID == 2)
                 		{
                 			//this if for KK only
                 			return loyalty_engine_handler.loyaltyEngineExecutionCall(requestParams);
                 		}
                 		else
                 		{
                 			if(customerPhone != null)
                 			{
                 				customer = Customer[Phone_Number == customerPhone];
                 				isExistingUser = thisapp.loyaltyEngine.isUserExist(customer);
                 				if(!isExistingUser)
                 				{
                 					customer = Customer[Phone_Number == thisapp.loyaltyEngine.addZeroPrefix(customerPhone)];
                 					isExistingUser = thisapp.loyaltyEngine.isUserExist(customer);
                 				}
                 				if(isExistingUser)
                 				{
                 					loyaltyPoints = Customer_Points_System[Customer == customer.ID];
                 					transactionHistory = Transaction[Customer == customer.ID];
                 					ncrCallType = requestParams.get("type");
                 					if(ncrCallType != null)
                 					{
                 						if(ncrCallType == 3 || ncrCallType == 4 || ncrCallType == 5)
                 						{
                 							transactionData = requestParams.get("transaction");
                 							if(transactionData != null)
                 							{
                 								totalPurchaseAmount = transactionData.get("total_purchase_amount");
                 								totalPointsRedeemed = transactionData.get("total_points_redeemed");
                 								if(ncrCallType == 3)
                 								{
                 									// 									info transactionData;
                 									// 									info customer;
                 									// 									info loyaltyPoints;
                 									// 									info transactionHistory;
                 									transactionData.put("transaction_type","purchase");
                 									return thisapp.loyaltyEngine.updateLoyaltyPoints_V3(transactionData,customer,loyaltyPoints,transactionHistory);
                 								}
                 								else if(ncrCallType == 5)
                 								{
                 									return thisapp.loyaltyEngine.preOrderApproval_V2(transactionData,customer,loyaltyPoints,transactionHistory);
                 									//return thisapp.loyaltyEngine.preOrderApproval_V3(transactionData,customer,loyaltyPoints,transactionHistory);
                 								}
                 								else if(ncrCallType == 4)
                 								{
                 									// 							return thisapp.loyaltyEngine.refundAction(transactionData,customer,loyaltyPoints);
                 									return thisapp.loyaltyEngine.refund_2_0_V2(transactionData,customer,loyaltyPoints);
                 								}
                 							}
                 						}
                 						else if(ncrCallType == 1 || ncrCallType == 2)
                 						{
                 							authorizationResponse = thisapp.loyaltyEngine.getLoyaltyData_V2(customer,loyaltyPoints,transactionHistory);
                 							rewards = authorizationResponse.get("loyalty_details").get("rewards");
                 							// 					rewards.put("membership_discount",thisapp.loyaltyEngine.getMembershipDiscount(loyaltyPoints.Membership_Level,customer.Country,"-1"));
                 							rewards.put("membership_discount",thisapp.loyaltyEngine.getMembershipDiscount(loyaltyPoints.Membership_Level_System.Membership_Level,customer.Country,"-1"));
                 							//info authorizationResponse;
                 							return authorizationResponse;
                 						}
                 						else if(ncrCallType == 6)
                 						{
                 						}
                 					}
                 				}
                 				else
                 				{
                 					response = Map();
                 					response.put("authorized",false);
                 					return response;
                 				}
                 			}
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.executeLoyaltyProgramme",e);
                 	}
                 	return null;
                 }
