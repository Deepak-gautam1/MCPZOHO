				 map fetchRecords.getMyOrdersResponceItemdetailbyorderid(int order_id)
                 {
                 	//order_id = 4661594000012391160;
                 	response = Map();
                 	result = Map();
                 	order = Cart_Order_Test[ID == order_id.toLong()];
                 	lstitems = Cart_Order_Items[Cart_Order_ID == order_id.toLong()];
                 	if(order != null && lstitems.count() > 0)
                 	{
                 		order_currency = order.Order_Currency.toString() + " ";
                 		order_details_section = Map();
                 		order_details_section.put("section_title","Order Details");
                 		order_details_section.put("order_number","#" + order.ID.toString());
                 		order_details_section.put("order_rating",order.Order_Rating.toString());
                 		order_details_section.put("method_label","Method");
                 		order_details_section.put("method_value",peets_restaurant_management.storemanagement.getdeleverymethodbyid(order.Method_of_Ordering));
                 		order_details_section.put("store_location_label","Store Location");
                 		order_details_section.put("store_location_value",peets_restaurant_management.storemanagement.restaurantnamebyid(order.Restaurant_Name_cart_order_all));
                 		order_summary_section = Map();
                 		order_summary_section.put("title","Order Summary");
                 		products = List();
                 		for each  item in lstitems
                 		{
                 			product_1 = Map();
                 			product_1.put("product_image",copy_of_product_catalogue.publicUrls.getproductimage(item.Product_lookup_items.toString()));
                 			product_1.put("product_name",copy_of_product_catalogue.productManagement.getproductnamebyid(item.Product_lookup_items));
                 			product_1.put("quantity",item.Quantity);
                 			product_1.put("price",item.Product_Price);
                 			product_1.put("customization_label","Customization:");
                 			customizationval = "";
                 			if(item.Product_Size != null && item.Product_Size.Size != null)
                 			{
                 				customizationval = item.Product_Size.Size;
                 			}
                 			for each  modifiers in item.Modifiers_Subform
                 			{
                 				if(modifiers.Modifiers_order != null && modifiers.Modifiers_order.Name != null)
                 				{
                 					if(customizationval != "")
                 					{
                 						customizationval = customizationval + ", ";
                 					}
                 					customizationval = customizationval + modifiers.Modifiers_order.Name;
                 				}
                 			}
                 			product_1.put("customization_value",customizationval);
                 			product_1.put("notes_label","Notes:");
                 			product_1.put("notes_value","Make it strong");
                 			products.add(product_1);
                 		}
                 		order_summary_section.put("products",products);
                 		payment_summary_section = Map();
                 		payment_summary_section.put("title","Payment Summary");
                 		payment_summary_section.put("sub_total_label","Sub total");
                 		payment_summary_section.put("sub_total_value",order_currency + order.Sub_Total.toString());
                 		if(order.Discount_Coupons != null)
                 		{
                 			payment_summary_section.put("coupon_label","Coupon discount (" + Discount_Coupons[ID == order.Discount_Coupons].PROMO_CODE + ")");
                 			payment_summary_section.put("coupon_value",order_currency + order.Payment_Coupon_Discount_s.toString());
                 		}
                 		else
                 		{
                 			payment_summary_section.put("coupon_label","Coupon discount");
                 			payment_summary_section.put("coupon_value",order_currency + "0");
                 		}
                 		payment_summary_section.put("vat_label","Vat 5%");
                 		payment_summary_section.put("vat_value",order_currency + order.Vat_s.toString());
                 		payment_summary_section.put("total_label","Total amount");
                 		payment_summary_section.put("total_value",order_currency + order.Total_Amount_s.toString());
                 		// Combine
                 		order_details_section.put("order_summary_section",order_summary_section);
                 		order_details_section.put("payment_summary_section",payment_summary_section);
                 		order_details_section.put("view_receipt_button_text","View receipt");
                 		result.put("order_details_section",order_details_section);
                 	}
                 	response.put("result",result);
                 	response.put("code","3000");
                 	response.put("type","order_detail");
                 	return response;
                 }
				 map fetchRecords.getMyOrdersResponse(string custmobileno, int page_no)
                 {
                 	response = Map();
                 	result = Map();
                 	// Header
                 	header_section = Map();
                 	header_section.put("back_icon_image",thisapp.publicUrls.getlogoimages("41"));
                 	header_section.put("background_image",thisapp.publicUrls.getlogoimages("29"));
                 	header_section.put("header_name","My Orders");
                 	// Orders
                 	my_orders_section = Map();
                 	my_orders_section.put("section_title","My Orders");
                 	//custmobileno = "+971555534010";
                 	cust = Customer[Phone_Number == custmobileno];
                 	// Fetch all orders as a collection
                 	lstorder = Cart_Order_Test[Customer.ID == cust.ID.tolong() && Type_field == "Order"];
                 	// =========================================
                 	// Pagination added by om  9 sep 2025
                 	// =========================================
                 	per_page = 100;
                 	total_records = lstorder.count();
                 	total_pages = if(total_records % per_page == 0,(total_records / per_page).toLong(),(total_records / per_page).toLong() + 1);
                 	if(page_no == null || page_no < 1)
                 	{
                 		page_no = 1;
                 	}
                 	if(page_no > total_pages)
                 	{
                 		page_no = total_pages;
                 	}
                 	start_index = (page_no - 1) * per_page + 1;
                 	end_index = page_no * per_page;
                 	if(end_index > total_records)
                 	{
                 		end_index = total_records;
                 	}
                 	paged_order_ids = List();
                 	order_index = 0;
                 	for each  order_rec in lstorder
                 	{
                 		order_index = order_index + 1;
                 		if(order_index >= start_index && order_index <= end_index)
                 		{
                 			paged_order_ids.add(order_rec.ID);
                 			// store only IDs
                 		}
                 	}
                 	paged_orders = Cart_Order_Test[ID in paged_order_ids] sort by Order_Scheduler_Time desc;
                 	orders = List();
                 	for each  order in paged_orders
                 	{
                 		lstitems = Cart_Order_Items[Cart_Order_ID == order.ID] sort by Added_Time;
                 		o = Map();
                 		order_currency = order.Order_Currency.toString() + " ";
                 		o.put("order_status",order.Cart_Status.Status.toString());
                 		if(order.Order_Placed_On == null)
                 		{
                 			o.put("order_date_time",order.Order_Scheduler_Time.toString("MMM dd yyyy • h:mm a"));
                 		}
                 		else
                 		{
                 			o.put("order_date_time",order.Order_Placed_On.toString("MMM dd yyyy • h:mm a"));
                 		}
                 		o.put("store_name",peets_restaurant_management.storemanagement.restaurantnamebyid(order.Restaurant_Name_cart_order_all));
                 		o.put("price",order_currency + order.Total_Amount_s.toString());
                 		o.put("view_details_text","View Details");
                 		o.put("order_id_label","Order Id:");
                 		o.put("order_id",order.ID.toString());
                 		o.put("order_rating",order.Order_Rating.toString());
                 		o.put("item_count_label","No. of Items:");
                 		o.put("item_count",lstitems.count());
                 		storeid = order.Restaurant_Name_cart_order_all.tostring();
                 		if(storeid != "")
                 		{
                 			o.put("store_image",peets_restaurant_management.imageUrl.getstoreimageurl(storeid));
                 		}
                 		else
                 		{
                 			o.put("store_image","");
                 		}
                 		o.put("order_again_button_text","Order Again");
                 		o.put("rate_us_label","Rate Us");
                 		// Order Details
                 		order_details_section = Map();
                 		order_details_section.put("section_title","Order Details");
                 		order_details_section.put("order_number","#" + order.ID.toString());
                 		order_details_section.put("method_label","Method");
                 		order_details_section.put("method_value",peets_restaurant_management.storemanagement.getdeleverymethodbyid(order.Method_of_Ordering));
                 		order_details_section.put("store_location_label","Store Location");
                 		order_details_section.put("store_location_value",peets_restaurant_management.storemanagement.restaurantnamebyid(order.Restaurant_Name_cart_order_all));
                 		// Order Summary
                 		order_summary_section = Map();
                 		order_summary_section.put("title","Order Summary");
                 		products = List();
                 		for each  item in lstitems
                 		{
                 			product_1 = Map();
                 			product_1.put("product_image",copy_of_product_catalogue.publicUrls.getproductimage(item.Product_lookup_items.tostring()));
                 			product_1.put("product_name",copy_of_product_catalogue.productManagement.getproductnamebyid(item.Product_lookup_items));
                 			product_1.put("quantity",item.Quantity);
                 			product_1.put("price",item.Product_Price);
                 			product_1.put("customization_label","Customization:");
                 			customizationval = "";
                 			if(item.Product_Size != null && item.Product_Size.Size != null)
                 			{
                 				customizationval = item.Product_Size.Size;
                 			}
                 			for each  modifiers in item.Modifiers_Subform
                 			{
                 				if(modifiers.Modifiers_order != null && modifiers.Modifiers_order.Name != null)
                 				{
                 					if(customizationval != "")
                 					{
                 						customizationval = customizationval + ", ";
                 					}
                 					customizationval = customizationval + modifiers.Modifiers_order.Name;
                 				}
                 			}
                 			product_1.put("customization_value",customizationval);
                 			product_1.put("notes_label","Notes:");
                 			product_1.put("notes_value",order.Order_notes.tostring());
                 			products.add(product_1);
                 		}
                 		order_summary_section.put("products",products);
                 		// Payment Summary
                 		payment_summary_section = Map();
                 		payment_summary_section.put("title","Payment Summary");
                 		payment_summary_section.put("sub_total_label","Sub total");
                 		payment_summary_section.put("sub_total_value",order_currency + order.Sub_Total.toString());
                 		payment_summary_section.put("coupon_label","Coupon discount (" + ifnull(Discount_Coupons[ID == order.Discount_Coupons].PROMO_CODE,"") + ")");
                 		payment_summary_section.put("coupon_value",order_currency + order.Payment_Coupon_Discount_s.toString());
                 		payment_summary_section.put("vat_label","Vat 5%");
                 		payment_summary_section.put("vat_value",order_currency + order.Vat_s.toString());
                 		payment_summary_section.put("total_label","Total amount");
                 		payment_summary_section.put("total_value",order_currency + order.Total_Amount_s.toString());
                 		order_details_section.put("order_summary_section",order_summary_section);
                 		order_details_section.put("curb_side_detail",thisapp.cartmanagement.getcardetailfororder(order.ID.toLong()));
                 		order_details_section.put("payment_summary_section",payment_summary_section);
                 		order_details_section.put("view_receipt_button_text","View receipt");
                 		o.put("order_details_section",order_details_section);
                 		orders.add(o);
                 	}
                 	//info orders;
                 	// 	if(orders!=null){
                 	// 	my_orders_section.put("orders",orders);
                 	// 	}
                 	if(orders != null && orders.size() > 0)
                 	{
                 		my_orders_section.put("orders",orders);
                 		// 	pagination = Map();
                 		// 	pagination.put("current_page",page_no);
                 		// 	pagination.put("total_pages",total_pages);
                 		// 	pagination.put("per_page",per_page);
                 		// 	pagination.put("total_records",total_records);
                 		// 	my_orders_section.put("pagination",pagination);
                 	}
                 	else
                 	{
                 		// Add an empty message
                 		empty_order = Map();
                 		empty_order.put("heading","Ready to Earn Points !");
                 		empty_order.put("message","We can't wait to reward you. Order now and start collecting points !");
                 		empty_order.put("order_now_button_name","Order Now");
                 		my_orders_section.put("empty_order",empty_order);
                 	}
                 	// Add pagination meta
                 	pagination = Map();
                 	pagination.put("current_page",page_no);
                 	pagination.put("total_pages",total_pages);
                 	pagination.put("per_page",per_page);
                 	pagination.put("total_records",total_records);
                 	my_orders_section.put("pagination",pagination);
                 	result.put("header_section",header_section);
                 	result.put("my_orders_section",my_orders_section);
                 	response.put("result",result);
                 	response.put("code","3000");
                 	response.put("type","profile_2");
                 	return response;
                 }
				 map fetchRecords.getOfferCoupon(string mobileno)
                 {
                 	coupon_response = Map();
                 	try 
                 	{
                 		result = Map();
                 		// Header section
                 		header_section = Map();
                 		header_section.put("title","Add Coupon");
                 		header_section.put("input_placeholder","Enter your coupon code here");
                 		header_section.put("apply_button_text","APPLY");
                 		header_section.put("remove_button_text","REMOVE");
                 		header_section.put("error_message","Sorry, this coupon is not valid");
                 		// Offers Section
                 		offers_section = Map();
                 		offers_section.put("title","All offers");
                 		offers_list = List();
                 		// Base T&C line
                 		base_terms_line = {"text":"Peet’s Coffee coupon terms & conditions (dummy version)"};
                 		// Get coupons
                 		currentdate = zoho.currentdate;
                 		lstcoupons = Discount_Coupons[From <= currentdate && To >= currentdate];
                 		for each  coupon in lstcoupons
                 		{
                 			coupon1 = Map();
                 			coupon1.put("coupon_id",coupon.ID.tostring());
                 			coupon1.put("promo_code",coupon.PROMO_CODE.tostring());
                 			// Decide discount_type and discount_amount
                 			if(coupon.Discount_Value_Cash != null)
                 			{
                 				coupon1.put("discount_type","flat");
                 				coupon1.put("discount_amount",coupon.Discount_Value_Cash);
                 			}
                 			else if(coupon.Discount_Percentage != null)
                 			{
                 				coupon1.put("discount_type","percentage");
                 				coupon1.put("discount_amount",coupon.Discount_Percentage);
                 			}
                 			// Offer object
                 			object_offer = Offers_All[ID == coupon.Offer_Name];
                 			coupon1.put("discount_text",object_offer.Offer_Name);
                 			coupon1.put("description",object_offer.Description);
                 			coupon1.put("terms_and_conditions_text","Terms & Conditions");
                 			coupon1.put("apply_button_text","APPLY");
                 			// Build terms_and_conditions (per coupon)
                 			terms_content = List();
                 			terms_content.add(base_terms_line);
                 			if(object_offer.Terms_Conditions != null)
                 			{
                 				terms_content.add({"text":object_offer.Terms_Conditions});
                 			}
                 			terms_map = Map();
                 			terms_map.put("title","Terms & conditions");
                 			terms_map.put("content",terms_content);
                 			coupon1.put("terms_and_conditions",terms_map);
                 			// Add this coupon to list
                 			offers_list.add(coupon1);
                 		}
                 		offers_section.put("offers",offers_list);
                 		// Assemble result
                 		result.put("header_section",header_section);
                 		result.put("offers_section",offers_section);
                 		coupon_response.put("result",result);
                 		coupon_response.put("code","3000");
                 		coupon_response.put("status","SUCCESS");
                 	}
                 	catch (e)
                 	{
                 		coupon_response.put("code","5000");
                 		coupon_response.put("status","FAILED");
                 		coupon_response.put("message","Error while building coupon response: " + e.toString());
                 	}
                 	return coupon_response;
                 }
				 map fetchRecords.getOfferResponse()
                 {
                 	offerResponse = Map();
                 	result = Map();
                 	// --- Header Section ---
                 	headerSection = Map();
                 	backIcon = Map();
                 	backgroundImage = Map();
                 	searchIcon = Map();
                 	backIcon.put("img_url","<img_url>");
                 	backIcon.put("report_name","All_Home_Overviews");
                 	backIcon.put("image_src","1724230804415_Profile.png");
                 	backIcon.put("field_name","Image");
                 	backgroundImage.put("img_url","<img_url>");
                 	backgroundImage.put("report_name","All_Home_Overviews");
                 	backgroundImage.put("image_src","1724230804415_Profile.png");
                 	backgroundImage.put("field_name","Image");
                 	searchIcon.put("img_url","<img_url>");
                 	searchIcon.put("report_name","All_Home_Overviews");
                 	searchIcon.put("image_src","1724230804415_Profile.png");
                 	searchIcon.put("field_name","Image");
                 	headerSection.put("back_icon_image",backIcon);
                 	headerSection.put("background_image",backgroundImage);
                 	headerSection.put("header_name","Offers");
                 	headerSection.put("search_icon",searchIcon);
                 	headerSection.put("search_text","Search");
                 	// --- Offer Section Items ---
                 	offerList = List();
                 	for each  i in {1,2,3}
                 	{
                 		offer = Map();
                 		offerImage = Map();
                 		offerDetailsList = List();
                 		offerImage.put("img_url","<img_url>");
                 		offerImage.put("report_name","All_Home_Overviews");
                 		offerImage.put("image_src","1724230804415_Profile.png");
                 		offerImage.put("field_name","Image");
                 		offer.put("offer_cover_image",offerImage);
                 		offer.put("offer_name","Free Domestic Shipping On Orders $49+");
                 		offer.put("offer_description","Valid for free ground shipping on orders over $49 within the continental US. Discount applied automatically at checkout with qualifying purchase.");
                 		offer.put("shop_button_text","Shop Now");
                 		offer.put("details_button_text","Details");
                 		detail1 = Map();
                 		detail1.put("description","Peet’s Coffee coupon terms & conditions (dummy version)");
                 		detail2 = Map();
                 		detail2.put("description","Eligibility: coupon valid for online purchases only at peet's.com. Not applicable in retail stores or third-party vendors.");
                 		detail3 = Map();
                 		detail3.put("description","Redemption: enter the promo code at checkout. Only one coupon can be applied per order.");
                 		detail4 = Map();
                 		detail4.put("description","Exclusions: cannot be used on subscriptions, gift cards, or limited edition products unless specified. Expiration: coupons have a set expiration date and cannot be extended or reissued.");
                 		offerDetailsList.add(detail1);
                 		offerDetailsList.add(detail2);
                 		offerDetailsList.add(detail3);
                 		offerDetailsList.add(detail4);
                 		offer.put("details",offerDetailsList);
                 		offerList.add(offer);
                 	}
                 	// Assemble final response
                 	result.put("header_section",headerSection);
                 	result.put("offer_section",offerList);
                 	offerResponse.put("result",result);
                 	offerResponse.put("code","3000");
                 	offerResponse.put("type","profile_7");
                 	return offerResponse;
                 }
				 list fetchRecords.getOffers(int loginUserID)
                 {
                 	try 
                 	{
                 		today = zoho.currenttime;
                 		//applicableMembership = if(memberShipLevel == "Silver",{"Silver"},if(memberShipLevel == "Gold",{"Silver","Gold"},{"Silver","Gold","Platinum"}));
                 		fetchOffers = Offers[Does_Expiration_Apply == false || Offer_Ends_On >= zoho.currenttime && Status == "Active" || Selected_Customer == loginUserID] sort by Display_Sequence_Priority asc;
                 		if(fetchOffers.count() > 0)
                 		{
                 			offerListData = List();
                 			for each  offer in fetchOffers
                 			{
                 				isExist = false;
                 				for each  existOffer in offerListData
                 				{
                 					if(existOffer.get("offer_category_id") == ifnull(offer.Offer_Group,0))
                 					{
                 						isExist = true;
                 						offerList = existOffer.get("offer_list");
                 						break;
                 					}
                 				}
                 				if(!isExist)
                 				{
                 					offerData = Map();
                 					offerData.put("offer_category",offer.Offer_Group.Offer_Group);
                 					offerData.put("offer_category_id",offer.Offer_Group.toString());
                 					offerList = List();
                 					offerData.put("offer_list",offerList);
                 					offerListData.add(offerData);
                 				}
                 				imageSrc = thisapp.fileManagement.processImageUrl(offer.Image);
                 				offerDetail = Map();
                 				offerDetail.put("offer_based_on",offer.Offer_Based_On);
                 				//offerDetail.put("membership_level",offer.Old_Membership_Level);
                 				offerDetail.put("membership_level",offer.Membership_Level_System.Membership_Level);
                 				offerCategory = Map();
                 				offerDetail.put("category",offerCategory);
                 				offerCategory.put("category_name",offer.Category.Category_Name);
                 				offerCategory.put("category_id",offer.Category);
                 				offerDetail.put("available_from","From: " + thisapp.formatDate(offer.Offer_Start_From));
                 				offerDetail.put("expires_on",if(offer.Offer_Ends_On != null,"To: " + thisapp.formatDate(offer.Offer_Ends_On),""));
                 				offerDetail.put("does_expiration_applicable",offer.Does_Expiration_Apply);
                 				offerDetail.put("offer_name",offer.Offer_Name);
                 				offerImage = Map();
                 				offerDetail.put("image",offerImage);
                 				offerImage.put("report_name","Offers_Report");
                 				offerImage.put("field_name","Image");
                 				offerImage.put("image_src",imageSrc);
                 				offerImage.put("temp_img_src",thisapp.publicUrls.offer(offer.ID,imageSrc));
                 				offerDetail.put("offer_type",offer.Offer_Type);
                 				offerDetail.put("offer_discount",if(offer.Discount_Percentage != null,offer.Discount_Percentage,0).toLong());
                 				freeProducts = List();
                 				for each  freeProduct in offer.Products
                 				{
                 					freeProductData = Map();
                 					freeProductData.put("product",freeProduct.Product_Name);
                 					freeProductData.put("id",freeProduct.ID);
                 					freeProducts.add(freeProductData);
                 				}
                 				offerDetail.put("free_products",freeProducts);
                 				offerDetail.put("id",offer.ID.toString());
                 				offerList.add(offerDetail);
                 			}
                 			/* 		offerData = Map();
                                  		presentOfferList = List();
                                  		futureOfferList = List();
                                  		offerData.put("present_offers",presentOfferList);
                                  		offerData.put("future_offers",futureOfferList); */
                 			/* 		for each  offer in fetchOffers
                                  		{
                                  			offerDetail = Map();
                                  			
                                  			if(offer.Offer_Start_From < today)
                                  			{
                                  				presentOfferList.add(offerDetail);
                                  			}
                                  			else
                                  			{
                                  				futureOfferList.add(offerDetail);
                                  			}
                                  		} */
                 			return offerListData;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getOffers",e);
                 	}
                 	return null;
                 }
