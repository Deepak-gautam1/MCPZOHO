										else if(input.Api_Type == "2" || input.Api_Type == "3" || input.Api_Type == "4" || input.Api_Type == "8" || input.Api_Type == "9" || input.Api_Type == "10" || input.Api_Type == "11" || input.Api_Type == "12" || input.Api_Type == "13" || input.Api_Type == "14" || input.Api_Type == "15" || input.Api_Type == "20" || input.Api_Type == "25" || input.Api_Type == "19")
										{
											input.API_Response = thisapp.clientSideRepo.customAPIFunc(input.Api_Type.toLong(),"","","","","false");
										}
										else if(input.Api_Type == "21")
										{
											item_id = input.Request_Body.getJSON("item_id");
											input.API_Response = thisapp.clientSideRepo.customAPIFunc(input.Api_Type.toLong(),item_id.toString(),"","","","false");
										}
										else if(input.Api_Type == "22")
										{
											input.API_Response = thisapp.clientSideRepo.customAPIFunc(input.Api_Type.toLong(),"","","","","false");
										}
										else if(input.Api_Type == "26" || input.Api_Type == "27" || input.Api_Type == "35")
										{
											input.API_Response = thisapp.clientSideRepo.customAPIFunc(input.Api_Type.toLong(),"","","","","false");
										}
										else if(input.Api_Type == "30" || input.Api_Type == "24")
										{
											order_id = input.Request_Body.getJSON("order_id");
											input.API_Response = thisapp.clientSideRepo.customAPIFunc(input.Api_Type.toLong(),"","",order_id.toString(),"","false");
										}
										else if(input.Api_Type == "16")
										{
											store_id = input.Request_Body.getJSON("store_id");
											input.API_Response = thisapp.clientSideRepo.customAPIFunc(input.Api_Type.toLong(),"",store_id.toString(),"","","false");
										}
										else if(input.Api_Type == "17")
										{
											store_id = input.Request_Body.getJSON("store_id");
											item_id = input.Request_Body.getJSON("itemid");
											input.API_Response = thisapp.clientSideRepo.customAPIFunc(input.Api_Type.toLong(),item_id.toString(),store_id.toString(),"","","false");
										}
										else if(input.Api_Type == "18" || input.Api_Type == "33")
										{
											request = input.Request_Body.toMap();
											input.API_Response = thisapp.clientSideRepo.customAPIFunc_post(input.Api_Type.toLong(),request);
										}
										else if(input.Api_Type == "34")
										{
											order_id = input.Request_Body.getJSON("order_id");
											rating_val = input.Request_Body.getJSON("rating_val");
											input.API_Response = thisapp.clientSideRepo.customAPIFunc(input.Api_Type.toLong(),"","",order_id.toString(),rating_val.toString(),"false");
										}
						)
					}
				}

			}
			user_input_action as "user input action"
			{
				type =  form
				form = Offers

				record event = on add or edit

				on user input of Offer_Based_On
				{
					actions 
					{
						custom deluge script
						(
											offerBasedOn = input.Offer_Based_On;
										if(offerBasedOn == "Category Level")
										{
											// 	show Category;
											// 	hide Membership_Level;
											// 	hide Customer;
										}
										else if(offerBasedOn == "Membership Level")
										{
											// 	show Membership_Level;
											// 	 Category;
											// 	hide Customer;
											enable Membership_Level_System;
											input.Membership_Level_System = "";
											hide Customers;
										}
										else if(Offer_Based_On == "Individual Offer - Platinum")
										{
											// 	show Customer;
											// 	hide Category;
											// 	hide Membership_Level;
											show Customers;
											userList = List();
											//platinumCus = Customer_Points_System[Old_Membership_Level == "Platinum"];
											platinumCus = Customer_Points_System[Membership_Level_System.Membership_Level == "Platinum"];
											for each  user in platinumCus
											{
												userList.add(user.Customer.Name);
											}
											input.Customers:ui.add(userList);
											disable Membership_Level_System;
											input.Membership_Level_System = "Platinum";
										}
										else
										{
											hide Customers;
											enable Membership_Level_System;
											input.Membership_Level_System = "";
											// 	hide Category;
											// 	hide Membership_Level;
											// 	hide Customer;
										}
						)
					}
				}

			}
