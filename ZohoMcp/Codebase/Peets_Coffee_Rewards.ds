				 map fetchRecords.getlstofStores(string brand, string market, string localtime)
                 {
                 	return peets_restaurant_management.storemanagement.getAllStorepeets_V3(brand,market,localtime);
                 }
				 map fetchRecords.getlstofStores_V2_Testing()
                 {
                 	response = Map();
                 	brand = "4661594000001750003";
                 	market = "4661594000008171931";
                 	localtime = "4-11-2025 05:39:30 PM";
                 	// 1. Clear expired cache
                 	//     expiredRows = Response_Cache[Expired_On <= zoho.currenttime];
                 	//     for each row in expiredRows
                 	//     {
                 	//         delete from Response_Cache[ID == row.ID];
                 	//     }
                 	// 2. Build parameters map
                 	params = Map();
                 	params.put("brand",brand);
                 	params.put("market",market);
                 	// params.put("localtime", localtime);
                 	// 3. Create canonical key
                 	canonical = "";
                 	pkeys = params.keys().sort(true);
                 	for each  k in pkeys
                 	{
                 		canonical = canonical + k + "=" + params.get(k) + "&";
                 	}
                 	if(canonical.endsWith("&"))
                 	{
                 		cacheKey = canonical.left(canonical.length() - 1);
                 	}
                 	else
                 	{
                 		cacheKey = canonical;
                 	}
                 	//objcached = Response_Cache[Params_Value == cacheKey && Expired_On > zoho.currenttime];
                 	objcached = Response_Cache[Params_Value == cacheKey];
                 	if(objcached.count() > 0)
                 	{
                 		// clean = objcached.Response.replaceAll("`", "");
                 		//  info clean;
                 		response.put("result",objcached.Response);
                 		return response;
                 	}
                 	else
                 	{
                 		// 5. Fetch fresh data
                 		objresponse = peets_restaurant_management.storemanagement.getAllStorepeets_V3(brand,market,localtime);
                 		response.put("result",objresponse);
                 		insert into Response_Cache
                 		[
                 			Api_Type=7
                 			Added_User=zoho.loginuser
                 			Params_Value=cacheKey
                 			Response=objresponse.tostring()
                 			Created_Date=zoho.currenttime
                 			Expired_On=zoho.currenttime.addMinutes(10)
                 			User=zoho.loginuser
                 		]
                 		return response;
                 	}
                 	return response;
                 }
				 map fetchRecords.getlstTire(string cust_mobileno, string logintime)
                 {
                 	////string cust_mobileno, string logintime
                 	//cust_mobileno = "+971528012943";
                 	//logintime = "07:35:00 PM";
                 	result = Map();
                 	// ========== Common Image Block ==========
                 	rewardlogo = Logos[Title == "Rewards Logo"];
                 	header = Map();
                 	header.put("back_icon",thisapp.publicUrls.getlogoimages("41"));
                 	header.put("id",rewardlogo.ID.tostring());
                 	header.put("image_src",thisapp.imageUrl.getheaderlogo("2"));
                 	header.put("title","Tier Benefits");
                 	result.put("header",header);
                 	// ========== Rewards Overview Section ==========
                 	rewards = Map();
                 	cust_info = thisapp.customerProfile.getCustomerInfo(cust_mobileno);
                 	//	info cust_info;
                 	rewards.put("subtitle","Your Peet's Rewards Journey");
                 	rewards.put("greeting_message",thisapp.greetings.getGreetingFromLoginTime(logintime));
                 	rewards.put("user_name",cust_info.get("customer_name"));
                 	//	rewards.put("points_earned",cust_info.get("total_points_earned").tolong().tostring());
                 	rewards.put("points_earned",cust_info.get("available_points").tolong().tostring());
                 	rewards.put("tier_name",cust_info.get("current_membership_tier"));
                 	s_info = cust_info.get("membership_slider_info");
                 	//info s_info;
                 	current_tire_val = s_info.getJSON("current_tier_threshold");
                 	next_tire_val = s_info.getJSON("next_tier_threshold");
                 	current_val = s_info.getJSON("points_earned");
                 	tire_val = thisapp.customerslider.getSliderValue(current_tire_val,next_tire_val,current_val);
                 	rewards.put("tier_value",tire_val.tolong().toString());
                 	rewards.put("button_name","View Details");
                 	rewards.put("button_name_point_analysis","Point Analysis");
                 	rewards.put("points_expiration_info",cust_info.get("expiration_rules"));
                 	rewards.put("points_earning_rate",cust_info.get("earning_rules"));
                 	rewards.put("slider_info",s_info);
                 	result.put("rewards_overview_section",rewards);
                 	// ========== Tier Sections (List Format) ==========
                 	tier_sections = List();
                 	lstTiers = Membership_Details_H[ID != 0];
                 	for each  tier in lstTiers
                 	{
                 		mem = Membership_Points_System[ID == tier.Membership_Tier];
                 		if(mem.count() > 0)
                 		{
                 			tier_name = mem.Membership_Level;
                 			if(tier_name != null && tier_name != "")
                 			{
                 				tier_map = Map();
                 				tier_map.put("name",tier_name);
                 				if(tier_name == cust_info.get("current_membership_tier"))
                 				{
                 					tier_map.put("is_current","true");
                 				}
                 				else
                 				{
                 					tier_map.put("is_current","false");
                 				}
                 				if(mem.From.toString() == "" && mem.To.toString() == "")
                 				{
                 					tier_map.put("range",mem.Above.toString() + " + ");
                 				}
                 				else
                 				{
                 					tier_map.put("range",mem.From.toString() + " - " + mem.To.toString());
                 				}
                 				tier_map.put("ID",tier.ID.tostring());
                 				tier_map.put("benefit_list_header",tier.Sub_Heading);
                 				tier_map.put("footer_image",thisapp.publicUrls.getmembershipicons(tier.ID.tostring(),"Icon").getJson("public_image_src"));
                 				benefitsList = List();
                 				for each  bfit in tier.Bullet_points
                 				{
                 					benefit = Map();
                 					benefit.put("value",bfit.Earning_Rules);
                 					benefit.put("tick_icons",thisapp.publicUrls.getmembershipicons(tier.ID.tostring(),"BulletList").getJson("public_image_src"));
                 					benefitsList.add(benefit);
                 				}
                 				tier_map.put("benefit_list",benefitsList);
                 				tier_sections.add(tier_map);
                 			}
                 		}
                 	}
                 	result.put("tier_sections",tier_sections);
                 	// ========== Notes Section (List Format) ==========
                 	note_section = Map();
                 	note_lines = List();
                 	n_prks_list = Membership_Details_Perks[ID != 0];
                 	is_first = true;
                 	for each  n_prks in n_prks_list
                 	{
                 		if(is_first)
                 		{
                 			note_section.put("name",n_prks.Heading);
                 			note_section.put("tick_icons",thisapp.publicUrls.getlogoimages("46"));
                 			for each  n_destext in n_prks.Description_Text
                 			{
                 				note_lines.add(n_destext.Des_text_perks);
                 			}
                 			is_first = false;
                 		}
                 	}
                 	note_section.put("lines",note_lines);
                 	result.put("note_section",note_section);
                 	// ========== Final Output ==========
                 	final_response = Map();
                 	final_response.put("result",result);
                 	final_response.put("code",3000);
                 	return result;
                 }
