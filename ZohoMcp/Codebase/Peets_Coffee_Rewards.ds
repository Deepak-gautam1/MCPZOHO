			On_Success_Creation as "On Success - Creation"
			{
				type =  form
				form = Offers

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.CRM_Customer_Email != null || input.CRM_Customer_Email != "")
										{
