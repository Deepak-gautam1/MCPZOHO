				 list fileManagement.getPromotionImagesData()
                 {
                 	getOverview = Home_Overview[ID != 0];
                 	allPromotionsImageList = List();
                 	for each  overview in getOverview
                 	{
                 		promotionImageData = Map();
                 		promotionImageData.put("report_name","All_Home_Overviews");
                 		promotionImageData.put("field_name","Image");
                 		promotionImageData.put("image_src",thisapp.fileManagement.processImageUrl(overview.Image));
                 		promotionImageData.put("temp_img_src","");
                 		promotionImageData.put("image_id",overview.ID.toString());
                 		allPromotionsImageList.add(promotionImageData);
                 	}
                 	return allPromotionsImageList;
                 }
				 string fileManagement.processImageUrl(String image)
                 {
                 	try 
                 	{
                 		if(image != null)
                 		{
                 			image = image.getsuffix("downqual = ");
                 			image = image.getsuffix("\"");
                 			image = image.getprefix("\"");
                 			imageSplits = image.toList("/");
                 			image = imageSplits.get(imageSplits.size() - 1);
                 			return image;
                 		}
                 		else
                 		{
                 			log = insert into ncr_logs
                 			[
                 				Added_User=zoho.loginuser
                 				Title="Function - fileManagement.processImageUrl - Empty Image"
                 			];
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fileManagement.processImageUrl - Catch",e);
                 	}
                 	return "";
                 }
				 string greetings.getGreetingFromLoginTime(string timeStr)
                 {
                 	greeting = "";
                 	loginTime = timeStr.toTime("hh:mm:ss a");
                 	loginHour = loginTime.getHour();
                 	if(loginHour >= 5 && loginHour < 12)
                 	{
                 		greeting = "Good Morning";
                 	}
                 	else if(loginHour >= 12 && loginHour < 17)
                 	{
                 		greeting = "Good Afternoon";
                 	}
                 	else if(loginHour >= 17 && loginHour < 21)
                 	{
                 		greeting = "Good Evening";
                 	}
                 	else
                 	{
                 		greeting = "Good Night";
                 	}
                 	return greeting;
                 }
				 map guestUser.gestUserResponse(Map requestParams)
                 {
                 	//https://www.zohoapis.com/creator/custom/rtbidigitalassets_americanafood/gestuser_response?publickey=AjSVC0F0sktkAsrRCZXHf8JNB&country=UAE&localAppTime=24-Dec-2024 11:21 AM
                 	info requestParams;
                 	type = requestParams.get("type");
                 	if(type == 1)
                 	{
                 		return thisapp.guestUser.launchScreenResponse();
                 	}
                 	else if(type == 2)
                 	{
                 		return thisapp.guestUser.getGuestHomeResponse(requestParams.get("country"),requestParams.get("local_time"));
                 	}
                 	else if(type == 3)
                 	{
                 		return {"menus":thisapp.fetchRecords.getProductGuest("gestUserDetailMenu",requestParams.get("country"))};
                 	}
                 	else if(type == 4)
                 	{
                 		offerList = thisapp.fetchRecords.getOffers(0);
                 		if(offerList != null)
                 		{
                 			return {"offers":thisapp.fetchRecords.getOffers(0)};
                 		}
                 		else
                 		{
                 			return {"offers":{}};
                 		}
                 	}
                 	else if(type == 5)
                 	{
                 		platform = requestParams.get("platform");
                 		version = requestParams.get("version");
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="App version"
                 			error=version
                 		];
                 		return thisapp.accounts_handler.version_controler(platform,version);
                 	}
                 	return null;
                 }
				 map guestUser.getGuestHomeResponse(String country, String localAppTime)
                 {
                 	gestUserResponse = Map();
                 	try 
                 	{
                 		guestCard = Map();
                 		guestCard.put("sign_in_text","Sign in");
                 		guestCard.put("home_sign_in_text","Sign in now and enjoy your free drink!");
                 		guestCard.put("sign_in_description","Sign in now and enjoy your free drink!");
                 		guestCard.put("guest_display_name","Guest");
                 		gestUserResponse.put("guest_card",guestCard);
                 		promotionSection = Map();
                 		promotionSection.put("title","Let's get rewards");
                 		promotionSection.put("promotion_list",thisapp.fetchRecords.getPromotions(null));
                 		gestUserResponse.put("promotion_section",promotionSection);
                 		menuSection = Map();
                 		menuSection.put("title","Our Menu");
                 		menuSection.put("button_name","View all");
                 		menuSection.put("menu_list",thisapp.fetchRecords.getProductGuest("customMainMenu",country));
                 		gestUserResponse.put("menu_section",menuSection);
                 		offerSection = Map();
                 		offerSection.put("title","Offers for you");
                 		offerData = thisapp.fetchRecords.getOffers(0);
                 		offerList = {};
                 		for each  offerDetail in offerData
                 		{
                 			for each  offer in offerDetail.get("offer_list")
                 			{
                 				offerList.add(offer);
                 			}
                 		}
                 		offerSection.put("offer_list",offerList);
                 		offerSection.put("button_name","View all");
                 		gestUserResponse.put("offer_section",offerSection);
                 		gestUserResponse.put("stores",thisapp.fetchRecords.getStoreLocations(country,localAppTime));
                 		gestUserResponse.put("localisible_app_strings",thisapp.fetchRecords.localisableAppStrings("",country));
                 	}
                 	catch (e)
                 	{
                 	}
                 	return gestUserResponse;
                 }
				 map guestUser.launchScreenResponse()
                 {
                 	response = Map();
                 	response.put("header","Welcome to Peet's Coffee where you get rewarded for drinking great coffee.");
                 	points = List();
                 	points.add({"first_line":"Collect points with every order","second_line":"40 points for every AED 10 spent."});
                 	points.add({"first_line":"Redeem points for your favourite","second_line":"drink, once you get to 1500."});
                 	response.put("points",points);
                 	response.put("footer","Begin your coffee journey with Peet’s");
                 	response.put("user_button","Sign in");
                 	response.put("guest_button","Explore as guest");
                 	return response;
                 }
				 string imageUrl.getheaderlogo(string imagetype)
                 {
                 	fet = Logos[Image_Type == imagetype.tolong()];
                 	fetPhoto = fet.Image.getsuffix("image/").getprefix("\" lowqual");
                 	imgSrc = "https://creatorapp.zohopublic.com/file/rtbidigitalassets_americanafood/test-peets-new/All_Logos/" + fet.ID + "/Image/image-download/DgERu4uqS3y7yMqC7wFT3eyFhnPZBf3dgJVCNMdddJCzGtnum7Sgk88Keya23CVnRnkMujQMxgeuvKrh09GdsmOFWQUaPwj5u7jR?filepath=/" + fetPhoto;
                 	return imgSrc;
                 }
				 string loyaltyEngine.addZeroPrefix(String mobileNumber)
                 {
                 	dialingCodes = {{"country":"UAE","code":"+971"},{"country":"KSA","code":"+966"},{"country":"BHR","code":"+973"},{"country":"EGY","code":"+20"},{"country":"KWT","code":"+965"},{"country":"QAT","code":"+974"},{"country":"KAZ","code":"+7"},{"country":"JOR","code":"+962"}};
                 	for each  rec in dialingCodes
                 	{
                 		code = rec.get("code");
                 		if(mobileNumber.contains(code))
                 		{
                 			codeRemovedNumber = mobileNumber.remove(code);
                 			return code + "0" + codeRemovedNumber;
                 		}
                 	}
                 	return mobileNumber;
                 }
				 float loyaltyEngine.calculateLoyaltyPoints(Loyalty_Rules loyaltyRule, float purchasedAmount)
                 {
                 	try 
                 	{
                 		if(loyaltyRule.count() > 0)
                 		{
                 			purchaseThreshold = loyaltyRule.Purchase_threshold;
                 			pointsPerThreshold = loyaltyRule.Points_Per_threshold;
                 			return pointsPerThreshold * floor(purchasedAmount / purchaseThreshold);
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.calculateLoyaltyPoints",e);
                 	}
                 	return null;
                 }
				 float loyaltyEngine.calculateLoyaltyPoints_V2(Loyalty_Rules loyaltyRule, float purchasedAmount)
                 {
                 	try 
                 	{
                 		if(loyaltyRule.count() > 0)
                 		{
                 			purchaseThreshold = loyaltyRule.Purchase_threshold;
                 			pointsPerThreshold = loyaltyRule.Points_Per_threshold;
                 			return pointsPerThreshold * floor(purchasedAmount / purchaseThreshold);
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.calculateLoyaltyPoints",e);
                 	}
                 	return null;
                 }
				 map loyaltyEngine.convertPointsToAED_Burning(string customerPhone, float pointsToConsume)
                 {
                 	//customerPhone = "+971522917760"; // Example phone number
                 	//pointsToConsume = 200;          // Example points to redeem
                 	// Initialize response map
                 	if(pointsToConsume == null || pointsToConsume == 0)
                 	{
                 		pointsToConsume = 0;
                 	}
                 	resultMap = Map();
                 	resultMap.put("is_authorized",false);
                 	resultMap.put("message","Unauthorized conversion.");
                 	resultMap.put("customer_name","");
                 	resultMap.put("membership_level","");
                 	resultMap.put("points_to_consume",pointsToConsume);
                 	resultMap.put("converted_value_AED",0.0);
                 	resultMap.put("available_points",0.0);
                 	// --------------------------
                 	// Step 2: Validation
                 	// --------------------------
                 	if(pointsToConsume < 0)
                 	{
                 		resultMap.put("message","Invalid point value provided.");
                 		return resultMap;
                 	}
                 	if(pointsToConsume == 0 || pointsToConsume == null)
                 	{
                 		resultMap.put("is_authorized",true);
                 		resultMap.put("message","No points to convert, but authorized.");
                 		resultMap.put("converted_value_AED",0.0);
                 		return resultMap;
                 	}
                 	// --------------------------
                 	// Step 3: Fetch customer record
                 	// --------------------------
                 	customerRec = Customer[Phone_Number == customerPhone];
                 	if(customerRec == null)
                 	{
                 		resultMap.put("message","Customer not found.");
                 		return resultMap;
                 	}
                 	resultMap.put("customer_name",customerRec.Name);
                 	// --------------------------
                 	// Step 4: Fetch customer membership level from Customer_Points_System
                 	// --------------------------
                 	pointsRecord = Customer_Points_System[Customer == customerRec.ID];
                 	if(pointsRecord == null)
                 	{
                 		resultMap.put("message","No points record found for this customer.");
                 		return resultMap;
                 	}
                 	membershipLevel = pointsRecord.Membership_Level_System;
                 	// e.g. "Silver", "Gold", etc.
                 	if(membershipLevel == null || membershipLevel == 0)
                 	{
                 		resultMap.put("message","Membership level missing for this customer.");
                 		return resultMap;
                 	}
                 	totalPoints = pointsRecord.Total_Points;
                 	//info "Total Points " + totalPoints;
                 	resultMap.put("membership_level",membershipLevel);
                 	resultMap.put("available_points",totalPoints);
                 	// --------------------------
                 	// Step 5: Validate available balance
                 	// --------------------------
                 	if(pointsToConsume > totalPoints)
                 	{
                 		resultMap.put("message","Insufficient points. Customer has only " + totalPoints + " points.");
                 		return resultMap;
                 	}
                 	// --------------------------
                 	// Step 6: Fetch burning rule for this membership level
                 	// --------------------------
                 	loyaltyRule = Loyalty_Rules[Membership_Level_System_loy_rul == membershipLevel && Mark_as_Active == true && Type_of_Rule == "Burning"];
                 	if(loyaltyRule == null)
                 	{
                 		resultMap.put("message","No burning rule found for this membership level.");
                 		return resultMap;
                 	}
                 	// --------------------------
                 	// Step 7: Extract conversion rate fields
                 	// --------------------------
                 	pointsPerThreshold = loyaltyRule.Points_Per_threshold;
                 	purchaseThreshold = loyaltyRule.Purchase_threshold;
                 	if(pointsPerThreshold == null || purchaseThreshold == null || purchaseThreshold == 0)
                 	{
                 		resultMap.put("message","Invalid conversion rate in loyalty rules.");
                 		return resultMap;
                 	}
                 	// --------------------------
                 	// Step 8: Perform conversion
                 	// --------------------------
                 	//amountInAED = pointsToConsume / pointsPerThreshold * purchaseThreshold;
                 	fullConversions = floor(pointsToConsume / pointsPerThreshold);
                 	// only full thresholds
                 	amountInAED = fullConversions * purchaseThreshold;
                 	// --------------------------
                 	// Step 9: Mark as authorized & return structured response
                 	// --------------------------
                 	resultMap.put("is_authorized",true);
                 	resultMap.put("message","Conversion authorized.");
                 	resultMap.put("converted_value_AED",amountInAED);
                 	resultMap.put("rule_points_per_threshold",pointsPerThreshold);
                 	resultMap.put("rule_purchase_threshold",purchaseThreshold);
                 	// 	    info "✅ Conversion Authorized:";
                 	// 	    info "Customer: " + customerRec.Name;
                 	// 	    info "Level: " + membershipLevel;
                 	// 	    info "Consume: " + pointsToConsume + " pts";
                 	// 	    info "Conversion Rate: " + pointsPerThreshold + " pts = " + purchaseThreshold + " AED";
                 	// 	    info "Value: AED " + amountInAED;
                 	return resultMap;
                 }
				 map loyaltyEngine.convertRefunds(string customerPhone, float pointsToConsume)
                 {
                 	//customerPhone = "+971522917760"; // Example phone number
                 	//pointsToConsume = 200;          // Example points to redeem
                 	// Initialize response map
                 	if(pointsToConsume == null || pointsToConsume == 0)
                 	{
                 		pointsToConsume = 0;
                 	}
                 	resultMap = Map();
                 	resultMap.put("is_authorized",false);
                 	resultMap.put("message","Unauthorized conversion.");
                 	resultMap.put("customer_name","");
                 	resultMap.put("membership_level","");
                 	resultMap.put("points_to_consume",pointsToConsume);
                 	resultMap.put("converted_value_AED",0.0);
                 	resultMap.put("available_points",0.0);
                 	// --------------------------
                 	// Step 2: Validation
                 	// --------------------------
                 	if(pointsToConsume < 0)
                 	{
                 		resultMap.put("message","Invalid point value provided.");
                 		return resultMap;
                 	}
                 	if(pointsToConsume == 0 || pointsToConsume == null)
                 	{
                 		resultMap.put("is_authorized",true);
                 		resultMap.put("message","No points to convert, but authorized.");
                 		resultMap.put("converted_value_AED",0.0);
                 		return resultMap;
                 	}
                 	// --------------------------
                 	// Step 3: Fetch customer record
                 	// --------------------------
                 	customerRec = Customer[Phone_Number == customerPhone];
                 	if(customerRec == null)
                 	{
                 		resultMap.put("message","Customer not found.");
                 		return resultMap;
                 	}
                 	resultMap.put("customer_name",customerRec.Name);
                 	// --------------------------
                 	// Step 4: Fetch customer membership level from Customer_Points_System
                 	// --------------------------
                 	pointsRecord = Customer_Points_System[Customer == customerRec.ID];
                 	if(pointsRecord == null)
                 	{
                 		resultMap.put("message","No points record found for this customer.");
                 		return resultMap;
                 	}
                 	membershipLevel = pointsRecord.Membership_Level_System;
                 	// e.g. "Silver", "Gold", etc.
                 	if(membershipLevel == null || membershipLevel == 0)
                 	{
                 		resultMap.put("message","Membership level missing for this customer.");
                 		return resultMap;
                 	}
                 	totalPoints = pointsRecord.Total_Points;
                 	//info "Total Points " + totalPoints;
                 	resultMap.put("membership_level",membershipLevel);
                 	resultMap.put("available_points",totalPoints);
                 	// --------------------------
                 	// Step 5: Validate available balance
                 	// --------------------------
                 	if(pointsToConsume > totalPoints)
                 	{
                 		resultMap.put("message","Insufficient points. Customer has only " + totalPoints + " points.");
                 		return resultMap;
                 	}
                 	// --------------------------
                 	// Step 6: Fetch burning rule for this membership level
                 	// --------------------------
                 	loyaltyRule = Loyalty_Rules[Membership_Level_System_loy_rul == membershipLevel && Mark_as_Active == true && Type_of_Rule == "Burning"];
                 	if(loyaltyRule == null)
                 	{
                 		resultMap.put("message","No burning rule found for this membership level.");
                 		return resultMap;
                 	}
                 	// --------------------------
                 	// Step 7: Extract conversion rate fields
                 	// --------------------------
                 	pointsPerThreshold = loyaltyRule.Points_Per_threshold;
                 	purchaseThreshold = loyaltyRule.Purchase_threshold;
                 	if(pointsPerThreshold == null || purchaseThreshold == null || purchaseThreshold == 0)
                 	{
                 		resultMap.put("message","Invalid conversion rate in loyalty rules.");
                 		return resultMap;
                 	}
                 	// --------------------------
                 	// Step 8: Perform conversion
                 	// --------------------------
                 	//amountInAED = pointsToConsume / pointsPerThreshold * purchaseThreshold;
                 	fullConversions = floor(pointsToConsume / pointsPerThreshold);
                 	// only full thresholds
                 	amountInAED = fullConversions * purchaseThreshold;
                 	// --------------------------
                 	// Step 9: Mark as authorized & return structured response
                 	// --------------------------
                 	resultMap.put("is_authorized",true);
                 	resultMap.put("message","Conversion authorized.");
                 	resultMap.put("converted_value_AED",amountInAED);
                 	resultMap.put("rule_points_per_threshold",pointsPerThreshold);
                 	resultMap.put("rule_purchase_threshold",purchaseThreshold);
                 	// 	    info "✅ Conversion Authorized:";
                 	// 	    info "Customer: " + customerRec.Name;
                 	// 	    info "Level: " + membershipLevel;
                 	// 	    info "Consume: " + pointsToConsume + " pts";
                 	// 	    info "Conversion Rate: " + pointsPerThreshold + " pts = " + purchaseThreshold + " AED";
                 	// 	    info "Value: AED " + amountInAED;
                 	return resultMap;
                 }
				 map loyaltyEngine.createrefundcalculation()
                 {
                 	orderid = "4661594000016197006";
                 	mapres = Map();
                 	mapres.put("id","0");
                 	mapres.put("is_done",false);
                 	trans = Transaction[Order_ID == orderid] range from 0 to 0;
                 	customer = Customer[ID == trans.Customer] range from 0 to 1;
                 	transactionType = "Bonus";
                 	b_type = "Refund";
                 	b_point = Bonus_Points[Bonus_Type == b_type.trim() && Status == "Active"];
                 	// ================= ORIGINAL VALUES =================
                 	previouse_earrn = ifnull(trans.Earned_Loyalty_Points,0);
                 	previouse_burned_points = ifnull(trans.Burned_Points,0);
                 	previouse_burned_bonus = ifnull(trans.Bonus_Points_Burned,0);
                 	total_Purchase_value = ifnull(trans.Total_Invoice_Amount,0);
                 	discount_val = ifnull(trans.Total_Discount_Amount,0);
                 	invoice_value = ifnull(trans.Total_Purchase_Amount,0);
                 	info "================ ORIGINAL TRANSACTION ================";
                 	info "Earned Points          : " + previouse_earrn;
                 	info "Burned Points          : " + previouse_burned_points;
                 	info "Burned Bonus           : " + previouse_burned_bonus;
                 	info "Invoice Value          : " + invoice_value;
                 	info "Discount               : " + discount_val;
                 	info "Total Purchase Value   : " + total_Purchase_value;
                 	// ================= REFUND CALCULATION =================
                 	bonus_refund = previouse_burned_bonus;
                 	points_refund = previouse_burned_points;
                 	refund_earned_points = previouse_earrn;
                 	info "================ REFUND VALUES =================";
                 	info "Bonus to Restore       : " + bonus_refund;
                 	info "Points to Restore      : " + points_refund;
                 	info "Points to Reverse      : " + refund_earned_points;
                 	// ================= CURRENT CUSTOMER BALANCE =================
                 	customer_points = Customer_Points_System[Customer == customer] range from 0 to 1;
                 	available_before = 0;
                 	bonus_before = 0;
                 	if(customer_points != null)
                 	{
                 		available_before = ifnull(customer_points.Available_Points,0);
                 		bonus_before = ifnull(customer_points.Bonus_Points,0);
                 	}
                 	info "================ CUSTOMER BEFORE REFUND ================";
                 	info "Available Before       : " + available_before;
                 	info "Bonus Before           : " + bonus_before;
                 	// ================= FINAL BALANCE AFTER REFUND =================
                 	// Step 1: reverse earned points
                 	new_available_points = available_before - refund_earned_points;
                 	// Step 2: restore burned points
                 	new_available_points = new_available_points + points_refund;
                 	// Step 3: restore bonus
                 	new_bonus_available = bonus_before + bonus_refund;
                 	new_total_balance = new_available_points + new_bonus_available;
                 	info "================ CUSTOMER AFTER REFUND ================";
                 	info "New Available Points   : " + new_available_points;
                 	info "New Bonus Available    : " + new_bonus_available;
                 	info "New Total Balance      : " + new_total_balance;
                 	// expiry calculation
                 	expiryDays = ifnull(b_point.Bonus_Expiration_Days,0);
                 	bonusValidity = zoho.currenttime.addDay(expiryDays);
                 	info "Bonus Expiry Days      : " + expiryDays;
                 	info "Bonus Valid Till       : " + bonusValidity;
                 	return mapres;
                 }
				 void loyaltyEngine.creditbirthdaybonus()
                 {
                 	try 
                 	{
                 		lst_customer = Customer[ID != 0];
                 		// Correct today date (avoid timezone issues)
                 		today_date = zoho.currenttime.toDate();
                 		// Convert today's day & month to string
                 		today_str = today_date.toString("dd-MM");
                 		//info today_str;
                 		for each  customer in lst_customer
                 		{
                 			if(customer.Date_Of_Birth != null)
                 			{
                 				dob_str = customer.Date_Of_Birth.toString("dd-MM");
                 				//	info dob_str;
                 				if(dob_str == today_str)
                 				{
                 					//			info customer.Name;
                 					lsttrans = Transaction[Bonus_Type == "Birthday" && Customer == customer.ID] sort by Transaction_Time desc range from 0 to 0;
                 					should_credit = false;
                 					if(lsttrans.count() == 0)
                 					{
                 						// No birthday bonus ever given → give first bonus
                 						should_credit = true;
                 					}
                 					else
                 					{
                 						last_bonus = lsttrans;
                 						last_bonus_date = last_bonus.Transaction_Time;
                 						diff_days = last_bonus_date.daysBetween(today_date);
                 						if(diff_days >= 365)
                 						{
                 							should_credit = true;
                 						}
                 					}
                 					if(should_credit)
                 					{
                 						thisapp.loyaltyEngine.creditbonusbirthday_V2(customer.Phone_Number);
                 					}
                 					else
                 					{
                 						info "⏳ Skipped " + customer.Name + " — already received birthday bonus within the last 365 days.";
                 					}
                 				}
                 			}
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Birthday Bonus job",e.tostring());
                 	}
                 }
				 map loyaltyEngine.creditbirthdaybonustrans(string mobileno)
                 {
                 	mapres = Map();
                 	mapres.put("id","0");
                 	mapres.put("is_done",false);
                 	//mobileno = "+971501235566";
                 	customer = Customer[Phone_Number == mobileno] range from 0 to 1;
                 	//customer = Customer[ID == id.tolong()];
                 	transactionType = "Birthday";
                 	b_type = "Birthday";
                 	b_point = Bonus_Points[Bonus_Type == b_type.trim() && Status == "Active"];
                 	//info b_point ;
                 	receivedPoints = b_point.Points;
                 	order_id = "";
                 	customer_points = null;
                 	customer_points = Customer_Points_System[Customer == customer] range from 0 to 1;
                 	available_before = 0;
                 	if(customer_points != null && customer_points.Available_Points != null)
                 	{
                 		available_before = customer_points.Available_Points;
                 	}
                 	already_signup = Transaction[Type_field == transactionType && Customer == customer] range from 0 to 1;
                 	if(already_signup.count() == 0)
                 	{
                 		// Insert needs a single record for link fields (Customer), not a collection
                 		transactionEarned = insert into Transaction
                 		[
                 			Added_User=zoho.loginuser
                 			Customer=customer
                 			Market_Global_txn=customer.Market_Global
                 			Type_field=transactionType
                 			Order_ID=order_id
                 			Total_Purchase_Amount=0
                 			Total_Discount_Amount=0
                 			Total_Invoice_Amount=0
                 			Earned_Loyalty_Points=receivedPoints
                 			Expired_Points=0
                 			Burned_Points=0
                 			Utilized_Points=0
                 			Remaining_Points=receivedPoints
                 			Transaction_Time=zoho.currenttime
                 			Status="Not Utilized"
                 			Available_Points_Before_Cancellation=available_before
                 		];
                 	}
                 	else
                 	{
                 		transactionEarned = null;
                 	}
                 	if(transactionEarned != null)
                 	{
                 		total_earned = 0;
                 		total_burned = 0;
                 		total_expired = 0;
                 		txns = Transaction[Customer == customer];
                 		for each  rec in txns
                 		{
                 			if(rec.Earned_Loyalty_Points != null)
                 			{
                 				total_earned = total_earned + rec.Earned_Loyalty_Points.toDecimal();
                 			}
                 			if(rec.Burned_Points != null)
                 			{
                 				total_burned = total_burned + rec.Burned_Points.toDecimal();
                 			}
                 			if(rec.Expired_Points != null)
                 			{
                 				total_expired = total_expired + rec.Expired_Points.toDecimal();
                 			}
                 		}
                 		balance_points = total_earned - total_burned - total_expired;
                 		if(customer_points != null)
                 		{
                 			customer_points.Total_Points_Burned=total_burned;
                 			customer_points.Total_Points_Expired=total_expired;
                 			customer_points.Total_Points_Earned=total_earned;
                 			customer_points.Available_Points=balance_points;
                 		}
                 		trns = Transaction[ID == transactionEarned];
                 		trns.Available_Points=balance_points;
                 		mapres.put("id",transactionEarned.tostring());
                 		mapres.put("is_done",true);
                 	}
                 	return mapres;
                 }
				 map loyaltyEngine.creditbonusbirthday_V2(string mobileno)
                 {
                 	mapres = Map();
                 	mapres.put("id","0");
                 	mapres.put("is_done",false);
                 	//mobileno = "+971522917760";
                 	customer = Customer[Phone_Number == mobileno] range from 0 to 1;
                 	trans = Transaction[Customer == customer] sort by Transaction_Time desc range from 0 to 0;
                 	//customer = Customer[ID == id.tolong()];
                 	transactionType = "Bonus";
                 	b_type = "Birthday";
                 	b_point = Bonus_Points[Bonus_Type == b_type.trim() && Status == "Active"];
                 	//info b_point ;
                 	// calculation fields start
                 	receivedPoints = b_point.Points;
                 	expiryDays = b_point.Bonus_Expiration_Days;
                 	bonusValidity = zoho.currentdate.addDay(expiryDays);
                 	if(trans.count() > 0)
                 	{
                 		bonus_balance = ifnull(trans.Bonus_Available,0);
                 		previouse_available_bonus_balance = ifnull(ifnull(bonus_balance.tolong(),0) + ifnull(trans.Available_Points.tolong(),0),0);
                 	}
                 	else
                 	{
                 		bonus_balance = 0;
                 		previouse_available_bonus_balance = 0;
                 	}
                 	bonus_available = receivedPoints.tolong() + bonus_balance.tolong();
                 	// end
                 	order_id = "";
                 	customer_points = null;
                 	customer_points = Customer_Points_System[Customer == customer] range from 0 to 1;
                 	available_before = 0;
                 	if(customer_points != null && customer_points.Available_Points != null)
                 	{
                 		available_before = customer_points.Available_Points;
                 	}
                 	if(true)
                 	{
                 		transactionEarned = insert into Transaction
                 		[
                 			Added_User=zoho.loginuser
                 			Customer=customer
                 			Market_Global_txn=customer.Market_Global
                 			Type_field=transactionType
                 			Bonus_Type=b_type
                 			Previous_Total_Bonus_Available=previouse_available_bonus_balance
                 			Bonus_Points_earned=ifnull(receivedPoints,0)
                 			Bonus_Available=ifnull(bonus_available,0)
                 			BonusValidity=bonusValidity
                 			Remaining_Bonus_Points=ifnull(receivedPoints,0)
                 			Order_ID=order_id
                 			Total_Purchase_Amount=0
                 			Total_Discount_Amount=0
                 			Total_Invoice_Amount=0
                 			Earned_Loyalty_Points=0
                 			Expired_Points=0
                 			Burned_Points=0
                 			Utilized_Points=0
                 			Transaction_Time=zoho.currenttime
                 			Status="Not Utilized"
                 			Available_Points_Before_Cancellation=available_before
                 		];
                 	}
                 	else
                 	{
                 		transactionEarned = null;
                 	}
                 	if(transactionEarned != null)
                 	{
                 		previouse_points = customer_points.Available_Points;
                 		if(customer_points != null)
                 		{
                 			customer_points.Bonus_Points_Earned=ifnull(ifnull(customer_points.Bonus_Points_Earned,0) + receivedPoints.tolong(),0);
                 		}
                 		trns = Transaction[ID == transactionEarned];
                 		trns.Available_Points=previouse_points;
                 		mapres.put("id",transactionEarned.tostring());
                 		mapres.put("is_done",true);
                 	}
                 	return mapres;
                 }
