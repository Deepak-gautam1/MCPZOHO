				 map clientSideRepo.dateFunc()
                 {
                 	// 	Current Date
                 	day = zoho.currentdate.day();
                 	month = zoho.currentdate.month();
                 	year = zoho.currentdate.year();
                 	dateNow = day + "-" + month + "-" + year;
                 	info dateNow;
                 	// 	Current Time
                 	hour = zoho.currenttime.hour();
                 	info hour;
                 	mins = zoho.currenttime.minute();
                 	secs = zoho.currenttime.second();
                 	if(hour > 12)
                 	{
                 		hour = hour - 12;
                 		timeNow = "0" + hour + ":" + mins + ":" + secs + " PM";
                 		info timeNow;
                 	}
                 	else if(hour == 12 || hour == 0)
                 	{
                 		timeNow = 12 + ":" + mins + ":" + secs + " PM";
                 		info timeNow;
                 	}
                 	else if(hour > 0)
                 	{
                 		timeNow = "0" + hour + ":" + mins + ":" + secs + " AM";
                 		info timeNow;
                 	}
                 	// 	Current Date & Time
                 	todayVal = dateNow + " " + timeNow;
                 	info todayVal;
                 	// 	info zoho.appname;
                 	return {"Date":dateNow.toString(),"Time":timeNow.toString(),"DateTime":todayVal.toString()};
                 }
