                 	// About Peet's
                 	about_peets_coffee_strings = Map();
                 	about_peets_coffee_strings.put("about_peets_coffee_title","About Peet's Coffee");
                 	localisible_app_strings.put("about_peets_coffee_strings",about_peets_coffee_strings);
                 	// Terms & Conditions
                 	terms_of_use_view_strings = Map();
                 	terms_of_use_view_strings.put("view_title","Privacy statements");
                 	terms_of_use_view_strings.put("terms",thisapp.fetchRecords.termsAndCondition(country));
                 	localisible_app_strings.put("terms_of_use_view_strings",terms_of_use_view_strings);
                 	terms_and_condition_view_strings = Map();
                 	terms_and_condition_view_strings.put("view_title","Terms and conditions");
                 	terms_and_condition_view_strings.put("terms",thisapp.fetchRecords.termsandconditionUAE());
                 	localisible_app_strings.put("terms_and_condition_view_strings",terms_and_condition_view_strings);
                 	//rate the app
                 	rate_the_app_strings = Map();
                 	rate_the_app_strings.put("rate_value_title","Bitter brew? That’s not our style. Spill the beans - we’re here to fix it!");
                 	rate_the_app_strings.put("rate_value_description","We’re really sorry your experience didn’t hit the mark. Tell us what happened—we’re all ears (and beans).");
                 	rate_the_app_strings.put("rate_reason_prompt","Spill the tea-or the coffee. We're listening!");
                 	rate_the_app_strings.put("rate_reason_1","My coffee wasn’t on point");
                 	rate_the_app_strings.put("rate_reason_2","The wait was longer than my Monday");
                 	rate_the_app_strings.put("rate_reason_3","Service wasn’t as warm as our brew");
                 	rate_the_app_strings.put("rate_reason_4","Something else");
                 	localisible_app_strings.put("rate_the_app_strings",rate_the_app_strings);
                 	//peets privacy policy
                 	terms_of_use_view_strings = Map();
                 	terms_of_use_view_strings.put("view_title","Privacy policy");
                 	// Add full content as list of descriptions (can split or localize later if needed)
                 	privacyList = List();
                 	// ABOUT THIS POLICY
                 	privacyList.add("ABOUT THIS POLICY");
                 	privacyList.add("This document outlines the privacy practices of Kuwait Food Co (Americana) LLC, its subsidiaries and affiliates (the \"Company,\" \"we,\" \"us,\" or \"our\"), emphasizing our commitment to privacy. We are dedicated to safeguarding your personal information and ensuring transparency regarding our handling of it. This Privacy Policy (\"Policy\") details the methods by which we collect, utilize, store, and secure your information.");
                 	privacyList.add("By accepting this Privacy Policy, you acknowledge and consent to the collection and use of your personal information by our Company. Your data will be utilized to deliver an integrated customer experience, which may include personalized services, marketing communications, participation in loyalty programs, and enhanced customer support, among other related services.");
                 	// APPLICABILITY AND SCOPE
                 	privacyList.add("APPLICABILITY AND SCOPE");
                 	privacyList.add("This Privacy Policy governs the Peet’s Coffee mobile application (the \"APP\") as well as any other platform owned by the Company that directs users to this Policy. It covers all interactions conducted through the APP, including registration for the Peet’s rewards program and order placements, during which we collect specific personal information in order to provide our services and fulfill user requests.");
                 	privacyList.add("The APP may contain links to external websites or services not operated by the Company. If you access these third-party services, please be aware that they are governed by their own privacy policy, terms of service, and data practices. The Company is not responsible for how those third parties handle your information, and we encourage you to review their privacy policies before providing any personal data.");
                 	// INFORMATION AND DATA WE COLLECT
                 	privacyList.add("INFORMATION AND DATA WE COLLECT");
                 	privacyList.add("Upon accessing our APP or visiting our stores, we collect information about you and the services you utilize. The information gathered is mainly classified under these categories: (1) information you provide voluntarily; (2) information we collect automatically; and (3) information acquired from external sources.");
                 	privacyList.add("We may collect and process the following categories of personal data:");
                 	privacyList.add("Identification Data: Includes your full name, email address, mailing address, phone number, birthday, demographic details, and login credentials.");
                 	privacyList.add("Transaction and Purchase Data: Order history, payment records (via secure third parties), purchased products, cart items, and linked promotions.");
                 	privacyList.add("Demographic and Preference Data: Age, gender, interests, and stated preferences for personalization.");
                 	privacyList.add("Technical Data: Device identifiers, IP address, browser type, OS, app usage interactions, Wi-Fi service data (MAC, dynamic IP, browser agent, etc.).");
                 	privacyList.add("Geolocation Data: Collected with your consent for location services.");
                 	privacyList.add("Audio/Visual Data: Limited cases such as customer service recordings or CCTV for quality, security, and safety purposes.");
                 	privacyList.add("Inferences: Insights generated from your interactions to personalize services.");
                 	privacyList.add("Public/Third-Party Data: From business partners, public databases, or social media to ensure accuracy and improve offerings.");
                 	// HOW WE USE IT
                 	privacyList.add("HOW WE USE IT");
                 	privacyList.add("We use your data to deliver services, process orders, improve user experience, run promotions, and ensure security. Specifically:");
                 	privacyList.add("A. Deliver & Manage Services – account registration, orders, troubleshooting, rewards tracking.");
                 	privacyList.add("B. Communicate – service notifications, promotions, account updates, inquiries.");
                 	privacyList.add("C. Improve Services – analyzing trends, testing features, customer research.");
                 	privacyList.add("D. Security & Compliance – fraud prevention, rights protection, legal obligations.");
                 	privacyList.add("E. Marketing & Advertising – tailored offers, ads, campaign measurement, co-branded activities (with consent).");
                 	privacyList.add("F. With Consent – other uses only if explicitly allowed by you.");
                 	// HOW WE SHARE YOUR INFORMATION
                 	privacyList.add("HOW WE SHARE YOUR INFORMATION");
                 	privacyList.add("We share personal information only as needed to deliver services or comply with obligations:");
                 	privacyList.add("I. Service Providers – for payments, hosting, analytics, delivery, support.");
                 	privacyList.add("II. Regulatory Requirements – compliance with tax, safety, or governmental laws.");
                 	privacyList.add("III. With Permission – for promotions, campaigns, analytics, or events with your explicit consent.");
                 	// LEGAL BASIS
                 	privacyList.add("LEGAL BASIS FOR PROCESSING");
                 	privacyList.add("A. To Fulfill a Contract – e.g., manage accounts, process orders, rewards.");
                 	privacyList.add("B. Legitimate Interests – improve app, respond to support, fraud prevention.");
                 	privacyList.add("C. Legal Obligations – maintain records, respond to authorities.");
                 	privacyList.add("D. Consent – for marketing or location services (can be withdrawn anytime).");
                 	// DATA SECURITY
                 	privacyList.add("DATA SECURITY AND PROTECTION");
                 	privacyList.add("We use firewalls, SSL, intrusion detection, and strict access controls to safeguard data. While we take all precautions, no online system can be 100% secure. Users should take their own precautions as well.");
                 	// DATA RETENTION
                 	privacyList.add("DATA RETENTION");
                 	privacyList.add("We retain your personal data only as long as necessary for program administration, transactions, legal obligations, or continuity of rewards history.");
                 	// INTERNATIONAL TRANSFERS
                 	privacyList.add("INTERNATIONAL DATA TRANSFER");
                 	privacyList.add("Your information may be transferred across countries with safeguards such as contractual clauses or binding rules to ensure compliance with applicable laws.");
                 	// ELIGIBILITY
                 	privacyList.add("ELIGIBILITY");
                 	privacyList.add("Our APP is intended only for users aged 18+. Ages 13–18 may use under guardian supervision. You agree to create one account, provide accurate info, maintain security, and accept responsibility for account activity.");
                 	// YOUR RIGHTS
                 	privacyList.add("YOUR RIGHTS AND CHOICES");
                 	privacyList.add("A. Choices – control over location sharing, email preferences, push notifications.");
                 	privacyList.add("B. Rights – access, correct, delete, restrict, object, withdraw consent, portability. Requests will be handled per applicable laws.");
                 	// POLICY UPDATES
                 	privacyList.add("POLICY UPDATES AND REVISIONS");
                 	privacyList.add("We may update this Policy to reflect changes in law or services. Updates will be communicated via app notice or in-app message. Continued use means acceptance.");
                 	// CONTACT
                 	privacyList.add("CONTACT INFORMATION");
                 	privacyList.add("For inquiries or to exercise your rights, contact: peetsappsupport@americana-food.com");
                 	// Put into map
                 	privacy_policy_view_strings = Map();
                 	privacy_policy_view_strings.put("privacy_policy",thisapp.fetchRecords.privacyPolicyContent());
                 	localisible_app_strings.put("privacy_policy_view_strings",privacy_policy_view_strings);
                 	// General
                 	localisible_app_strings.put("greeting_prefix","Welcome to Peet's Coffee");
                 	localisible_app_strings.put("points_earning_rate",pointsEarningRate);
                 	localisible_app_strings.put("scan_text","Scan to collect points");
                 	localisible_app_strings.put("available_pts_text","Available Peet's Points: ");
                 	return localisible_app_strings;
                 }
