				 list fetchRecords.getProduct_V2(String type, Customer customer)
                 {
                 	/* 	if(type == "targetItem")
                                  	{
                                  		targetCategory = thisapp.loyaltyEngine.getCustomerOrientedRedemptionList(customer,Customer_Points_System[Customer == customer.ID].Available_Points);
                                  		if(targetCategory.size() > 0)
                                  		{
                                  			categoryIds = List();
                                  			redeemableCategories = targetCategory.get(0).get("redeemable_categories");
                                  			for each  categoryId in redeemableCategories
                                  			{
                                  				categoryIds.add(categoryId.get("category_id"));
                                  			}
                                  			getProduct = Add_Product[Category in categoryIds && Image != "" && Status == "Active"];
                                  		}
                                  		else
                                  		{
                                  			getProduct = Add_Product[Image != "" && Status == "Active"] range from 1 to 5;
                                  		}
                                  		info getProduct;
                                  	} */
                 	try 
                 	{
                 		if(type == "menuList")
                 		{
                 			//Menu List For Home based on the Sequence Priority
                 			getProduct = Add_Product[Category != null && Home_Screen_Sequence_Priority != null && Category.Status == "Active" && Status == "Active" && Market == customer.Country] sort by Home_Screen_Sequence_Priority asc;
                 		}
                 		else if(type = "gestUserDetailMenu")
                 		{
                 			getProduct = Add_Product[Category != null && Home_Screen_Sequence_Priority != null && Category.Status == "Active" && Status == "Active"] sort by Home_Screen_Sequence_Priority asc;
                 		}
                 		else if(type == "customMainMenu")
                 		{
                 			getProduct = Add_Product[Category.Status == "Active" && Category.Status == "Active"] sort by Display_Sequence_Priority asc;
                 		}
                 		else if(type == "freeDrink")
                 		{
                 			//Free Drink
                 			rule = Joining_Rules[Market == customer.Country && Mark_as_Active && Joining_Benefit in {"Joining Drink","Both"}];
                 			availableProducts = rule.Product.getall();
                 			getProduct = Add_Product[ID in availableProducts && Category != null && Category.Category_Name != "Free Products" && Category.Status == "Active" && Status == "Active" && Market == customer.Country] sort by Display_Sequence_Priority asc;
                 		}
                 		else
                 		{
                 			// View All - Product List
                 			getProduct = Add_Product[Category != null && Category.Status == "Active" && Status == "Active" && Market == customer.Country] sort by Display_Sequence_Priority asc;
                 		}
                 		if(getProduct.count() > 0)
                 		{
                 			productList = List();
                 			for each  product in getProduct
                 			{
                 				imageSrc = thisapp.fileManagement.processImageUrl(product.Image);
                 				productDetail = Map();
                 				categoryDetail = Map();
                 				productDetail.put("market",product.Market);
                 				productDetail.put("category",categoryDetail);
                 				categoryDetail.put("name",product.Category.Category_Name);
                 				categoryDetail.put("id",product.Category.toString());
                 				categoryDetail.put("priority_index",product.Category.Display_Sequence_Priority);
                 				productDetail.put("id",product.ID.toString());
                 				productDetail.put("name",product.Product_Name);
                 				productImage = Map();
                 				productDetail.put("image",productImage);
                 				productImage.put("report_name","All_Products");
                 				productImage.put("field_name","Image");
                 				productImage.put("image_src",imageSrc);
                 				productImage.put("temp_img_src",thisapp.publicUrls.product(product.ID,imageSrc));
                 				priceList = List();
                 				productDetail.put("price",product.Price);
                 				productList.add(productDetail);
                 			}
                 			return productList;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getProduct",e);
                 	}
                 	return null;
                 }
				 map fetchRecords.getProfileResponse(string mobileno)
                 {
                 	profileResponse = Map();
                 	result = Map();
                 	// Fetch localized strings and customer info
                 	localappstrings = thisapp.fetchRecords.localisableAppStringsV2("0","0");
                 	objectcustomerinfo = thisapp.customerProfile.getCustomerInfo(mobileno);
                 	sliderinfo = objectcustomerinfo.getJson("membership_slider_info");
                 	profile_view_strings = localappstrings.get("profile_view_strings");
                 	logout_strings = localappstrings.get("logout_view_strings");
                 	// ---------------- Header Section ----------------
                 	headerSection = Map();
                 	userImage = Map();
                 	userImage.put("img_url","<img_url>");
                 	userImage.put("report_name","All_Home_Overviews");
                 	userImage.put("image_src","1724230804415_Profile.png");
                 	userImage.put("field_name","Image");
                 	sliderMap = Map();
                 	sliderMap.put("current_tier",sliderinfo.getJson("current_tier"));
                 	sliderMap.put("next_tier",sliderinfo.getJson("next_tier"));
                 	sliderMap.put("next_tier_threshold",sliderinfo.getJson("next_tier_threshold"));
                 	sliderMap.put("current_tier_threshold",sliderinfo.getJson("current_tier_threshold"));
                 	sliderMap.put("points_earned",sliderinfo.getJson("points_earned"));
                 	sliderMap.put("show_slider",sliderinfo.getJson("show_slider"));
                 	sliderMap.put("min","0");
                 	sliderMap.put("max","1");
                 	sliderMap.put("selected",sliderinfo.getJson("selected"));
                 	sliderInfoList = list();
                 	sliderInfoList.add(sliderMap);
                 	headerSection.put("greeting_message","Hello");
                 	headerSection.put("user_name",objectcustomerinfo.get("customer_name"));
                 	headerSection.put("user_image",userImage);
                 	headerSection.put("points_earned",objectcustomerinfo.get("total_points_earned"));
                 	headerSection.put("available_points",objectcustomerinfo.get("available_points"));
                 	headerSection.put("tier_name",objectcustomerinfo.get("current_membership_tier"));
                 	headerSection.put("tier_value",sliderinfo.getJson("selected"));
                 	headerSection.put("points_earning_rate",objectcustomerinfo.get("earning_rules"));
                 	headerSection.put("slider_info",sliderInfoList);
                 	// ---------------- Profile Options Section ----------------
                 	profileOptionsList = list();
                 	optionKeys = Map();
                 	optionKeys.put("profile_1",profile_view_strings.get("profile_details"));
                 	optionKeys.put("profile_2",profile_view_strings.get("transactions"));
                 	optionKeys.put("profile_3",profile_view_strings.get("favourite_orders"));
                 	optionKeys.put("profile_4",profile_view_strings.get("saved_Cards"));
                 	optionKeys.put("profile_5",profile_view_strings.get("account_settings"));
                 	optionKeys.put("profile_6",profile_view_strings.get("referal_system"));
                 	optionKeys.put("profile_7",profile_view_strings.get("offers"));
                 	optionKeys.put("profile_8",profile_view_strings.get("points_analysis"));
                 	optionKeys.put("profile_9",profile_view_strings.get("terms_text"));
                 	optionKeys.put("profile_14",profile_view_strings.get("terms_of_use"));
                 	optionKeys.put("profile_10",profile_view_strings.get("contact_us"));
                 	optionKeys.put("profile_11",profile_view_strings.get("about_peets_coffee"));
                 	optionKeys.put("profile_12",profile_view_strings.get("rate_the_app"));
                 	optionKeys.put("profile_13",logout_strings.get("button_text"));
                 	// Custom image numbers for each profile option
                 	imageNumbers = Map();
                 	imageNumbers.put("profile_1","50");
                 	imageNumbers.put("profile_2","51");
                 	imageNumbers.put("profile_3","52");
                 	imageNumbers.put("profile_4","53");
                 	imageNumbers.put("profile_5","54");
                 	imageNumbers.put("profile_6","55");
                 	imageNumbers.put("profile_7","56");
                 	imageNumbers.put("profile_8","57");
                 	imageNumbers.put("profile_9","58");
                 	imageNumbers.put("profile_14","59");
                 	imageNumbers.put("profile_10","60");
                 	imageNumbers.put("profile_11","61");
                 	imageNumbers.put("profile_12","62");
                 	imageNumbers.put("profile_13","63");
                 	// Loop through each profile option
                 	for each  key in optionKeys.keys()
                 	{
                 		option = Map();
                 		icon = Map();
                 		image_id = imageNumbers.get(key);
                 		image_url = thisapp.publicUrls.getlogoimages(image_id);
                 		icon.put("img_url","<img_url>");
                 		icon.put("report_name","All_Home_Overviews");
                 		icon.put("image_src",image_url);
                 		icon.put("field_name","Image");
                 		option.put("option_type",key);
                 		option.put("option_name",optionKeys.get(key));
                 		option.put("option_icon",icon);
                 		profileOptionsList.add(option);
                 	}
                 	// Final assembly
                 	result.put("header_section",headerSection);
                 	result.put("profile_option_section",profileOptionsList);
                 	profileResponse.put("result",result);
                 	profileResponse.put("code","3000");
                 	return profileResponse;
                 }
