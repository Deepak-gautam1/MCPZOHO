										{
											input.API_Response = thisapp.clientSideRepo.customAPIFunc(input.Api_Type.toLong(),"","","","","false");
										}
										else if(input.Api_Type == "36")
										{
											input.API_Response = thisapp.clientSideRepo.customAPIFunc_post(input.Api_Type.toLong(),input.Request_Body.toMap());
										}
