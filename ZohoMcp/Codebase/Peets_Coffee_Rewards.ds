				 list fetchRecords.termsAndCondition(string country)
                 {
                 	return if(country == "UAE",thisapp.fetchRecords.privacyStatementUAE(),thisapp.fetchRecords.privacyStatementKSA());
                 }
				 list fetchRecords.termsandconditionUAE()
                 {
                 	stringList = List();
                 	// Title
                 	text1 = Map();
                 	text1.put("value","Peet’s Rewards Program — Terms and Conditions");
                 	text1.put("style",1);
                 	stringList.add(text1);
                 	// Intro
                 	text2 = Map();
                 	text2.put("value","The following terms govern participation in and use of the rewards and customer loyalty program managed by Peet’s Coffee (“Peet’s Rewards” or “Rewards Program”), which is offered by Kuwait Food Co. (Americana) LLC and its affiliates (“Company”). These terms are applicable to individuals who choose to enroll in Peet’s Rewards (“Member” or “Members”) through the Peet’s Coffee mobile application (“Mobile App”) available in the United Arab Emirates (“UAE”).");
                 	text2.put("style",2);
                 	stringList.add(text2);
                 	text3 = Map();
                 	text3.put("value","These terms supersede all previous communications regarding Peet’s Rewards. Acceptance of these Terms and Conditions is mandatory for participation.");
                 	text3.put("style",3);
                 	stringList.add(text3);
                 	text4 = Map();
                 	text4.put("value","Members can earn credits (“Reward Points”) for purchases made at Peet’s Coffee outlets (“Outlets”) in UAE. These Reward Points may only be redeemed through the Mobile App for certain complimentary products (“Rewards”) listed in the Mobile App.");
                 	text4.put("style",3);
                 	stringList.add(text4);
                 	// Peet’s Rewards Enrolment
                 	sec1 = Map();
                 	sec1.put("value","Peet’s Rewards Enrolment");
                 	sec1.put("style",4);
                 	stringList.add(sec1);
                 	sec1a = Map();
                 	sec1a.put("value","Enrolment is free and no purchase is required to become a Member.");
                 	sec1a.put("style",5);
                 	stringList.add(sec1a);
                 	sec1b = Map();
                 	sec1b.put("value","Customers may enroll in the Rewards Program by opting in through the Mobile App, providing the required personal information, and accepting these Terms and Conditions.");
                 	sec1b.put("style",5);
                 	stringList.add(sec1b);
                 	sec1c = Map();
                 	sec1c.put("value","The Rewards Program is available only at selected Outlets (“Rewards Eligible Locations”) within UAE.");
                 	sec1c.put("style",5);
                 	stringList.add(sec1c);
                 	sec1d = Map();
                 	sec1d.put("value","Enrolment requires phone number verification and Mobile App login with a local UAE number.");
                 	sec1d.put("style",5);
                 	stringList.add(sec1d);
                 	sec1e = Map();
                 	sec1e.put("value","Members are eligible to receive a one-time welcome bonus of 1,000 points, valid for a period of 90 days.");
                 	sec1e.put("style",5);
                 	stringList.add(sec1e);
                 	sec1f = Map();
                 	sec1f.put("value","When a Member enrolls, the profile syncs across all Peet’s Coffee countries; however, the welcome bonus applies only in the country of initial registration.");
                 	sec1f.put("style",5);
                 	stringList.add(sec1f);
                 	sec1g = Map();
                 	sec1g.put("value","The Company reserves the right to refuse, suspend, or revoke membership at its sole discretion. Blocked Members cannot re-enroll.");
                 	sec1g.put("style",5);
                 	stringList.add(sec1g);
                 	sec1h = Map();
                 	sec1h.put("value","Members who deactivate or delete their Peet’s Rewards profile may rejoin; however, they will not be eligible for any additional welcome bonus and/or previously accumulated Reward Points.");
                 	sec1h.put("style",5);
                 	stringList.add(sec1h);
                 	sec1i = Map();
                 	sec1i.put("value","Opt out – Members may opt out of the program by contacting customer support (UAE: +971 600 522252).");
                 	sec1i.put("style",5);
                 	stringList.add(sec1i);
                 	sec1j = Map();
                 	sec1j.put("value","Reward Points and joining bonuses earned in a specific country are redeemable only through that country’s Rewards catalogue and cannot be used in any other country.");
                 	sec1j.put("style",5);
                 	stringList.add(sec1j);
                 	// App account deletion
                 	sec2 = Map();
                 	sec2.put("value","App account deletion");
                 	sec2.put("style",4);
                 	stringList.add(sec2);
                 	sec2a = Map();
                 	sec2a.put("value","Members acknowledge that uninstalling the Mobile App or deleting their account does not fully erase loyalty transaction history. The loyalty system will archive transactional details even after account deletion.");
                 	sec2a.put("style",5);
                 	stringList.add(sec2a);
                 	sec2b = Map();
                 	sec2b.put("value","Upon deletion of a Member’s account, the Peet’s Reward Points balance becomes zero and the account remains suspended until the Member re-joins the program; no earning/redemption can occur while inactive.");
                 	sec2b.put("style",5);
                 	stringList.add(sec2b);
                 	// Restrictions
                 	sec3 = Map();
                 	sec3.put("value","Restrictions");
                 	sec3.put("style",4);
                 	stringList.add(sec3);
                 	sec3a = Map();
                 	sec3a.put("value","In case of any illegal activity by a Member, the Company may remove the Member from Peet’s Rewards at its sole discretion and without prior notice.");
                 	sec3a.put("style",5);
                 	stringList.add(sec3a);
                 	sec3b = Map();
                 	sec3b.put("value","If, in the Company’s opinion, a Member abuses privileges or fails to comply with these Terms or the Privacy Policy, the Company may permanently deactivate the profile and reset the points balance to zero.");
