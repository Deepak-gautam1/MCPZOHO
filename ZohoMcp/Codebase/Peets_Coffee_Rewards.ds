				 list fileManagement.getAllProductImageObjects(Customer customer)
                 {
                 	getAllProduct = Add_Product[Category != null && Home_Screen_Sequence_Priority != null && Category.Status == "Active" && Status == "Active" && Market == customer.Country] sort by Home_Screen_Sequence_Priority asc;
                 	allProductsImageList = List();
                 	for each  product in getAllProduct
                 	{
                 		productsImageData = Map();
                 		productsImageData.put("report_name","All_Products");
                 		productsImageData.put("field_name","Image");
                 		productsImageData.put("image_src",thisapp.fileManagement.processImageUrl(product.Image));
                 		productsImageData.put("temp_img_src","");
                 		productsImageData.put("image_id",product.ID.toString());
                 		allProductsImageList.add(productsImageData);
                 	}
                 	return allProductsImageList;
                 }
				 map fileManagement.getApplicationImages()
                 {
                 	customer = Customer[Phone_Number == zoho.loginuser.mobilenumber || Phone_Number == "+971567048172"];
                 	appImages = Map();
                 	appImages.put("productImageList",thisapp.fileManagement.getAllProductImageObjects(customer));
                 	appImages.put("promotionsImageList",thisapp.fileManagement.getPromotionImagesData());
                 	return appImages;
                 }
				 string fileManagement.getCommonImage(int imagetype)
                 {
                 	return Logos[Image_Type == imagetype].Image;
                 }
				 map fileManagement.getfullImageUrl(string rptname, string fieldname, string imagesrc, string imgrefid)
                 {
                 	imageData = Map();
                 	imageData.put("report_name",rptname);
                 	imageData.put("field_name",fieldname);
                 	imageData.put("image_src",thisapp.fileManagement.processImageUrl(imagesrc));
                 	imageData.put("image_refernce_id",imgrefid);
                 	return imageData;
