                 	pickup_location.put("store_id","4661594000009609221");
                 	pickup_location.put("value","Dubai mall, lower ground floor, Dubai United Arab Emirates");
                 	pickup_details.put("pickup_time_details",pickup_time);
                 	pickup_details.put("location_details",pickup_location);
                 	response_map.put("pickup_details",pickup_details);
                 	// Coupon Section
                 	coupon_section = Map();
                 	coupon_section.put("promo_code","PAYLESSNEW");
                 	coupon_section.put("id","4661594000007400067");
                 	response_map.put("coupon_section",coupon_section);
                 	// Redeem Section
                 	redeem_section = Map();
                 	redeem_section.put("redeem_points_applied","120");
                 	redeem_section.put("available_points","2040");
                 	response_map.put("redeem_section",redeem_section);
                 	// Payment Summary
                 	payment_summary = Map();
                 	payment_summary.put("subtotal","AED 128.00");
                 	payment_summary.put("coupon_discount","-AED 12.80");
                 	payment_summary.put("vat","AED 6.40");
                 	payment_summary.put("total_amount","AED 121.60");
                 	response_map.put("payment_summary",payment_summary);
                 	// Return JSON as string
                 	//info response_map.toString();
                 	return response_map;
                 }
			 }
		 }


