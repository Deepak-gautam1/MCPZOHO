		batchworkflow
		{
			Expire_Free_Drink
			{
    			display name = "Expire Free Drink"
    			type = batchworkflow
    			form = Customer_Points_System[Is_Free_drink_available == true]
    			event = "On Schedule"
    			start = "01-Sep-2024 23:59:59"
    			frequency = daily
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											freeDrinks = Customer_Points_System[Is_Free_drink_available && Free_Drink_Expiry_Date == zoho.currentdate];
										for each  rec in freeDrinks
										{
											rec.Is_Free_drink_available=false;
											rec.Free_Drink_Status="Expired";
										}
						)
					}
    			}
    			on success 
    			{
					actions 
					{
						custom deluge script
						(
											log = insert into ncr_logs
										[
											Added_User=zoho.loginuser
											Title="Schedule - Free Drink Expiration"
											error="Free drink expiration has been completed successfully"
										];
						)
					}
    			}
			}
			Validate_User_Tier_Status
			{
    			display name = "Validate User Tier Status"
    			type = batchworkflow
    			form = Customer_Points_System
    			event = "On Schedule"
    			start = "24-Mar-2025 15:21:00"
    			frequency = daily
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											eligibleRecordsForTierValidation = Customer_Points_System[Last_90_days_schedule_triggered_on == zoho.currentdate.subDay(90)];
										log = insert into ncr_logs
										[
											Added_User=zoho.loginuser
											Title="Tier Validation Schedule"
											error=eligibleRecordsForTierValidation
										];
										silver_to = Membership_Points_System[Membership_Level == "Silver"].To.tolong();
										// 7499
										gold_to = Membership_Points_System[Membership_Level == "Gold"].To.tolong();
										// 14999
										platinum_from = Membership_Points_System[Membership_Level == "Platinum"].Above.tolong();
										// 15000
										for each  data in eligibleRecordsForTierValidation
										{
											transactions = Transaction[Customer == data.Customer && Transaction_Time >= eligibleRecordsForTierValidation.Last_90_days_schedule_triggered_on];
											totalEarnedPointsInLat90Days = transactions.sum(Earned_Loyalty_Points);
											newTier = "";
											//if(totalEarnedPointsInLat90Days < 3000)
											// 	if(totalEarnedPointsInLat90Days < silver.tolong())
											// 	{
											// 		newTier = "Silver";
											// 	}
											// 	//else if(totalEarnedPointsInLat90Days > 3000 && totalEarnedPointsInLat90Days < 6000)
											// 	else if(totalEarnedPointsInLat90Days >  silver.tolong() && totalEarnedPointsInLat90Days < gold_range.tolong())
											// 	{
											// 		newTier = "Gold";
											// 	}
											// 	//else if(totalEarnedPointsInLat90Days > 6000)
											// 	else if(totalEarnedPointsInLat90Days > platinum_range.tolong())
											// 	{
											// 		newTier = "Platinum";
											// 	}
											if(totalEarnedPointsInLat90Days <= silver_to)
											{
												newTier = "Silver";
											}
											else if(totalEarnedPointsInLat90Days > silver_to && totalEarnedPointsInLat90Days <= gold_to)
											{
												newTier = "Gold";
											}
											else if(totalEarnedPointsInLat90Days >= platinum_from)
											{
												newTier = "Platinum";
											}
											//thisapp.loyaltyEngine.getLoyaltyPromotionStatus(newTier,data.Old_Membership_Level);
											thisapp.loyaltyEngine.getLoyaltyPromotionStatus(newTier,data.Membership_Level_System.Membership_Level);
											//data.Old_Membership_Level=newTier;
											Membership_levelid = Membership_Points_System[Membership_Level == newTier];
											data.Membership_Level_System=Membership_levelid;
											memberShipTierHistory = insert into Membership_Tier_History
											[
												Added_User=zoho.loginuser
												Customer_Points_System=data.ID
												Tier=newTier
												From=data.Last_90_days_schedule_triggered_on
												To=zoho.currentdate
											];
											data.Last_90_days_schedule_triggered_on=zoho.currentdate;
										}
						)
					}
    			}
			}
			Expire_Loyalty_Points
			{
    			display name = "Expire Loyalty Points"
    			type = batchworkflow
    			form = Transaction[Status == "Not Utilized" || Status == "Partially Utilized"]
    			event = "On Schedule"
    			start = "01-Nov-2025 23:59:59"
    			frequency = daily
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											transactions = Transaction[Transaction_Time == zoho.currentdate.subDay(365) && Status == "Not Utilized" || Status == "Partially Utilized"];
										for each  rec in transactions
										{
											overAllCustomPoints = Customer_Points_System[Customer == rec.Customer];
											if(overAllCustomPoints.count() > 0)
											{
												initialPoints = overAllCustomPoints.Available_Points;
												overAllCustomPoints.Available_Points=overAllCustomPoints.Available_Points - rec.Remaining_Points;
												overAllCustomPoints.Total_Points_Expired=overAllCustomPoints.Total_Points_Expired + rec.Remaining_Points;
												response = insert into Transaction
												[
													Added_User=zoho.loginuser
													Order_ID=rec.Order_ID
													Restaurant_Name=rec.Restaurant_Name
													Type_field="Expiration"
													Earned_Loyalty_Points=0
													Burned_Points=rec.Remaining_Points
													Market=overAllCustomPoints.Customer.Country
													Available_Points=overAllCustomPoints.Available_Points
													Customer=overAllCustomPoints.Customer
													Transaction_Time=zoho.currenttime
													Total_Purchase_Amount=0
													Total_Invoice_Amount=0
													Total_Discount_Amount=0
													Available_Points_Before_Cancellation=initialPoints
													Available_Points=overAllCustomPoints.Available_Points
													Total_Points_Earned=overAllCustomPoints.Available_Points - rec.Remaining_Points
													Total_Points_Burned=overAllCustomPoints.Total_Points_Burned
													Total_Points_Expired=overAllCustomPoints.Total_Points_Expired
												];
												rec.Status="Expired";
											}
										}
						)
					}
    			}
    			on success 
    			{
					actions 
					{
						custom deluge script
						(
											log = insert into ncr_logs
										[
											Added_User=zoho.loginuser
											Title="Points Expiration - Schedlule"
											error="PE Schedlule executed successfully"
										];
						)
					}
    			}
			}
		}

		functions
		{
			open_expiry_extension_for1 as "open expiry extension form"
			{
				type =  functions
				form = Offers
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Offer_Extension?Offer_Name=" + input.ID,"popup window","height=auto,width=auto");
					)
					}
				}
			}
			open_update_profile as "open update profile"
			{
				type =  functions
				form = Customer
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Update_Profile?ids=" + input.ID,"popup window","height=auto,width=auto");
					)
					}
				}
			}
			delete_products1 as "delete products"
			{
				type =  functions
				form = Add_Product
				execution type = collection of records	
				on start
				{
					actions 
					{
						thisapp.deleteProducts(Add_Product);
					}
				}
			}
			Activity_Status_Change as "Activity Status Change"
			{
				type =  functions
				form = Add_Product
				execution type = for each record	
				on start
				{
					actions  (Status == "Active")
					{
					update Add_Product[ID == input.ID]
					[
						Status = "In Active"
					]
					}
				}
			}
			Multiple_Status_Change as "Multiple Status Change"
			{
				type =  functions
				form = Add_Product
				execution type = for each record	
				on start
				{
					actions 
					{
					update Add_Product[ID == input.ID]
					[
						Status = "In Active"
					]
					}
				}
			}
			Multiple_Delete as "Multiple Delete"
			{
				type =  functions
				form = Transaction
				execution type = for each record	
				on start
				{
				}
			}
			Single_Delete as "Single Delete"
			{
				type =  functions
				form = Transaction
				execution type = for each record	
				on start
				{
					actions 
					{
					delete from Customer[Customer_Points_System_Total_Points_Earned.Available_Points > 2500];
					}
				}
			}
		}
	}
