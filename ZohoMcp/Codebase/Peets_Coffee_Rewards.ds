				 void loyaltyEngine.test()
                 {
                 	//	thisapp.loyaltyEngine.creditbonuspoint_V2();
                 	mobileno = "+971522917760";
                 	order_id = "002";
                 	redeemablePoints = 200;
                 	totalPurchaseAmount = 70;
                 	restaurant_id = "35100";
                 	// 	mobileno = mo_number;
                 	// 	order_id = orderid.tolong();
                 	// 	redeemablePoints = redeemable_Points.tolong();
                 	// 	totalPurchaseAmount = totalPurchase_Amount.todecimal();
                 	// 	restaurant_id = restaurantid.tolong();
                 	transactionType = "Purchase";
                 	totalDiscountAmount = 0;
                 	burnedPoints = redeemablePoints;
                 	receivedPoints = "";
                 	restaurant = peets_restaurant_management.storemanagement.getRestaurantByID(restaurant_id);
                 	customer = Customer[Phone_Number == mobileno];
                 	// 	for each  t in Transaction[Customer == customer.ID] sort by Transaction_Time desc range from 0 to 0
                 	// 	{
                 	// 		previousBonus = t.Bonus_Available;
                 	// 		previousAvailable = t.Available_Points;
                 	// 		break;
                 	// 	}
                 	previousBonus = Customer_Points_System[Customer == customer.ID].Bonus_Points;
                 	previousAvailable = Customer_Points_System[Customer == customer.ID].Available_Points;
                 	info previousAvailable + "  " + previousBonus;
                 	// 	spentFromBonus = 0;
                 	// 	spentFromAvailable = 0;
                 	// 	if(previousBonus > 0)
                 	// 	{
                 	// 		for each  t in Transaction[Customer == customer.ID && Type_field = "Bonus" && BonusValidity > zoho.currenttime && Remaining_Bonus_Points > 0] sort by BonusValidity asc
                 	// 		{
                 	// 			remBonus = t.Remaining_Bonus_Points;
                 	// 			if(remBonus >= burnedPoints)
                 	// 			{
                 	// 				t.Remaining_Bonus_Points=remBonus - burnedPoints;
                 	// 				spentFromBonus = spentFromBonus + burnedPoints;
                 	// 				burnedPoints = 0;
                 	// 			}
                 	// 			else
                 	// 			{
                 	// 				spentFromBonus = spentFromBonus + remBonus;
                 	// 				burnedPoints = burnedPoints - remBonus;
                 	// 				t.Remaining_Bonus_Points=0;
                 	// 			}
                 	// 		}
                 	// 		if(burnedPoints > 0)
                 	// 		{
                 	// 			if(previousAvailable >= burnedPoints)
                 	// 			{
                 	// 				spentFromAvailable = burnedPoints;
                 	// 				previousAvailable = previousAvailable - burnedPoints;
                 	// 				burnedPoints = 0;
                 	// 			}
                 	// 			else
                 	// 			{
                 	// 				spentFromAvailable = previousAvailable;
                 	// 				burnedPoints = burnedPoints - previousAvailable;
                 	// 				previousAvailable = 0;
                 	// 				unmetburnedPoints = burnedPoints;
                 	// 			}
                 	// 		}
                 	// 	}
                 	pointsToBurn = redeemablePoints;
                 	spentFromBonus = 0;
                 	spentFromAvailable = 0;
                 	// burn bonus first (only if any)
                 	for each  t in Transaction[Customer == customer.ID && Type_field = "Bonus" && BonusValidity > zoho.currenttime && Remaining_Bonus_Points > 0] sort by BonusValidity asc
                 	{
                 		if(pointsToBurn <= 0)
                 		{
                 			break;
                 		}
                 		remBonus = t.Remaining_Bonus_Points;
                 		burn = if(remBonus >= pointsToBurn,pointsToBurn,remBonus);
                 		t.Remaining_Bonus_Points=remBonus - burn;
                 		spentFromBonus = spentFromBonus + burn;
                 		pointsToBurn = pointsToBurn - burn;
                 	}
                 	if(pointsToBurn > 0)
                 	{
                 		burnAvail = if(previousAvailable >= pointsToBurn,pointsToBurn,previousAvailable);
                 		spentFromAvailable = burnAvail;
                 		previousAvailable = previousAvailable - burnAvail;
                 		pointsToBurn = pointsToBurn - burnAvail;
                 		if(pointsToBurn > 0)
                 		{
                 			unmetburnedPoints = pointsToBurn;
                 		}
                 	}
                 	membershiplevel = Customer_Points_System[Customer == customer.ID].Membership_Level_System;
                 	loyaltyRule = Loyalty_Rules[Membership_Level_System_loy_rul == membershiplevel && Market_Global_lr == customer.Market_Global && Type_of_Rule == "Earning"];
                 	loyaltyRule_Burning = Loyalty_Rules[Membership_Level_System_loy_rul == membershiplevel && Market_Global_lr == customer.Market_Global && Type_of_Rule == "Burning"];
                 	customerLoysltyPointSystem = Customer_Points_System[Customer == customer.ID];
                 	transactionHistory = Transaction[Customer == customer.ID];
                 	spentPoints = spentFromAvailable + spentFromBonus;
                 	info spentPoints + " " + spentFromAvailable + "  " + spentFromBonus;
                 	totalDiscountAmount = thisapp.loyaltyEngine.convertPointsToAED_Burning(mobileno,spentPoints.todecimal()).get("converted_value_AED");
                 	info "discount :" + totalDiscountAmount;
                 	total_invoice_amount = totalPurchaseAmount.toDecimal() - totalDiscountAmount.toDecimal();
                 	info total_invoice_amount;
                 	receivedPoints = thisapp.loyaltyEngine.calculateLoyaltyPoints_V2(loyaltyRule,total_invoice_amount.toDecimal());
                 	info receivedPoints;
                 	transactionEarned = insert into Transaction
                 	[
                 		Added_User=zoho.loginuser
                 		Customer=customer.ID
                 		Market_Global_txn=customer.Market_Global
                 		Restaurant_Name=restaurant
                 		Type_field=transactionType
                 		Order_ID=order_id
                 		Total_Purchase_Amount=total_invoice_amount.toDecimal()
                 		Total_Discount_Amount=totalDiscountAmount.toDecimal()
                 		Total_Invoice_Amount=totalPurchaseAmount.toDecimal()
                 		Earned_Loyalty_Points=receivedPoints
                 		Utilized_Points=0
                 		Remaining_Points=receivedPoints
                 		Transaction_Time=zoho.currenttime
                 		Status="Not Utilized"
                 		Available_Points_Before_Cancellation=customerLoysltyPointSystem.Available_Points
                 	];
                 	getTransaction = Transaction[ID == transactionEarned];
                 	getTransaction.Available_Points=customerLoysltyPointSystem.Available_Points.toLong() + receivedPoints.toLong() - spentFromAvailable.toLong();
                 	// 	getTransaction.Burned_Points=burnedPoints;
                 	getTransaction.Burned_Points=spentFromAvailable;
                 	getTransaction.Bonus_Points_Burned=spentFromBonus;
                 	getTransaction.Bonus_Available=previousBonus - spentFromBonus;
                 	getTransaction.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned + receivedPoints.toLong();
                 	getTransaction.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned + burnedPoints.toLong();
                 	getTransaction.Previous_Total_Bonus_Available=previousBonus.tolong() + previousAvailable.tolong();
                 	customerLoysltyPointSystem.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned + receivedPoints.toLong();
                 	customerLoysltyPointSystem.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned + spentFromAvailable.toLong();
                 	customerLoysltyPointSystem.Available_Points=customerLoysltyPointSystem.Available_Points + receivedPoints.toLong() - spentFromAvailable.tolong();
                 	customerLoysltyPointSystem.Bonus_Points_Burned=ifnull(customerLoysltyPointSystem.Bonus_Points_Burned,0) + spentFromBonus.toLong();
                 	customerLoysltyPointSystem.Bonus_Points_Expired=ifnull(customerLoysltyPointSystem.Bonus_Points_Expired,0);
                 	thisapp.loyaltyEngine.updateMembershipLevelv2(customer.Phone_Number);
                 }
				 void loyaltyEngine.updateCountry(String country)
                 {
                 	market = Market[Market_Name == country.toUpperCase()];
                 	if(market.count() > 0)
                 	{
                 		customer = Customer[Phone_Number == zoho.loginuser.mobilenumber];
                 		customer.Country=market.ID;
                 	}
                 }
				 map loyaltyEngine.updateLoyaltyPoints(Map transaction, Customer customer, Customer_Points_System customerLoysltyPointSystem, Transaction transactionHistory)
                 {
                 	try 
                 	{
                 		loyaltyRule = Loyalty_Rules[Market_Global_lr == customer.Country && Mark_as_Active];
                 		transactionMap = {"joining_points":"Joining Points","purchase":"Purchase","cancellation":"Cancellation"};
                 		transactionType = transactionMap.get(transaction.get("transaction_type"));
                 		if(true)
                 		{
                 			approvalResponse = thisapp.loyaltyEngine.preOrderApproval(transaction,customer,customerLoysltyPointSystem,transactionHistory);
                 			loyaltyDtails = approvalResponse.get("loyalty_details");
                 			if(approvalResponse.get("is_approved"))
                 			{
                 				totalPurchaseAmount = approvalResponse.get("total_purchase_amount");
                 				totalDiscountAmount = approvalResponse.get("total_discount_amount");
                 				// 				redemptionAmount = transaction.get("total_redemption_amount").toDecimal();
                 				// 				burnedPoints = thisapp.loyaltyEngine.calculateBurnedPoints(loyaltyRule,redemptionAmount);
                 				burnedPoints = 0;
                 				receivedPoints = if(transactionType != "Joining Points",thisapp.loyaltyEngine.calculateLoyaltyPoints(loyaltyRule,totalPurchaseAmount),Joining_Rules[Joining_Benefit == "Joining Points" && Market11 == customer.Country && Mark_as_Active].Joining_Points);
                 				/* 				if(loyaltyDtails.containKey("redeemable_items") && loyaltyDtails.get("redeemable_items") != null)
                                  				{
                                  					redeemableItem = loyaltyDtails.get("redeemable_items");
                                  					for each  redItem in redeemableItem
                                  					{
                                  						if(redItem.get("is_available"))
                                  						{
                                  							burnedPoints = burnedPoints + redeemableItem.get("points_to_be_burned");
                                  						}
                                  					}
                                  				} */
                 				if(burnedPoints <= customerLoysltyPointSystem.Available_Points)
                 				{
                 					countryCode = transaction.get("country");
                 					if(countryCode == "null" || countryCode == null)
                 					{
                 						restaurant = Stores[Restaurant_ID == transaction.get("restaurant_id")].ID;
                 					}
                 					else
                 					{
                 						country = Market[Market_Name == if(countryCode == 1,"UAE","KSA")];
                 						restaurant = Stores[Restaurant_ID == transaction.get("restaurant_id") && Hub_Name == country.ID].ID;
                 					}
                 					transactionEarned = insert into Transaction
                 					[
                 						Added_User=zoho.loginuser
                 						Customer=customer.ID
                 						Market=customer.Country
                 						Restaurant_Name=restaurant
                 						Type_field=transactionType
                 						Order_ID=transaction.get("order_id")
                 						Total_Purchase_Amount=totalPurchaseAmount
                 						Total_Discount_Amount=totalDiscountAmount
                 						Total_Invoice_Amount=transaction.get("total_invoice_amount").toDecimal()
                 						Earned_Loyalty_Points=receivedPoints
                 						Utilized_Points=0
                 						Remaining_Points=receivedPoints
                 						Transaction_Time=zoho.currenttime
                 						Status="Not Utilized"
                 						Available_Points_Before_Cancellation=customerLoysltyPointSystem.Available_Points
                 					];
                 					if(loyaltyDtails.containKey("free_drink"))
                 					{
                 						freeDrink = loyaltyDtails.get("free_drink");
                 						if(freeDrink.get("is_available"))
                 						{
                 							if(freeDrink.get("type").toLong() == 1)
                 							{
                 								freeDrinkModel = Add_Product[ID_Link == freeDrink.get("product_id")];
                 								if(freeDrinkModel.count() > 0)
                 								{
                 									customerLoysltyPointSystem.Redeemed_Product=freeDrinkModel.ID;
                 									customerLoysltyPointSystem.Is_Free_drink_available=false;
                 									customerLoysltyPointSystem.Free_Drink_Status="Redeemed";
                 									customerLoysltyPointSystem.Transaction=transactionEarned;
                 								}
                 							}
                 							else if(freeDrink.get("type").toLong() == 2)
                 							{
                 								burnedPoints = 1500;
                 								thisapp.loyaltyEngine.updateRemainingPointsInTransaction(customer.ID,transactionEarned,burnedPoints);
                 							}
                 						}
                 					}
                 					getTransaction = Transaction[ID == transactionEarned];
                 					getTransaction.Available_Points=customerLoysltyPointSystem.Available_Points + receivedPoints - burnedPoints;
                 					getTransaction.Burned_Points=burnedPoints;
                 					getTransaction.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned + receivedPoints;
                 					getTransaction.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned + burnedPoints;
                 					itemList = loyaltyDtails.get("items");
                 					for each  purchasedItem in itemList
                 					{
                 						product = Add_Product[ID_Link == purchasedItem.get("product_id")];
                 						if(purchasedItem.containKey("applied_offer") && purchasedItem.get("applied_offer") != null)
                 						{
                 							offerData = purchasedItem.get("applied_offer");
                 							if(offerData.get("is_applied"))
                 							{
                 								offerAppliedID = offerData.get("offer_id").toLong();
                 							}
                 							else
                 							{
                 								offerAppliedID = null;
                 							}
                 						}
                 						else
                 						{
                 							offerAppliedID = null;
                 						}
                 						lineItems = insert into Order_Line_Items
                 						[
                 							Added_User=zoho.loginuser
                 							Transaction_ID=transactionEarned
                 							Product=product.ID
                 							Qty=purchasedItem.get("quantity")
                 							Discount=purchasedItem.get("discount_amount")
                 							Price=purchasedItem.get("price").toDecimal()
                 							Total=purchasedItem.get("net_total").toDecimal()
                 							Applied_Offers=offerAppliedID
                 						];
                 					}
                 				}
                 				customerLoysltyPointSystem.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned + receivedPoints;
                 				customerLoysltyPointSystem.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned + burnedPoints;
                 				customerLoysltyPointSystem.Available_Points=customerLoysltyPointSystem.Available_Points + receivedPoints - burnedPoints;
                 				/* 			if(customerLoysltyPointSystem.Total_Points_Burned > 7500)
                                  			{
                                  				customerLoysltyPointSystem.Membership_Level="Platinum";
                                  			}
                                  			else if(customerLoysltyPointSystem.Total_Points_Burned > 3000)
                                  			{
                                  				customerLoysltyPointSystem.Membership_Level="Gold";
                                  			} */
                 				return thisapp.loyaltyEngine.getLoyaltyData(customer,customerLoysltyPointSystem,getTransaction);
                 			}
                 			// 			return Map();
                 		}
                 		return {"message":"Flag not approved","is_approved":false};
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.updateLoyaltyPoints",e);
                 	}
                 	return null;
                 }
				 map loyaltyEngine.updateLoyaltyPoints_V2(Map transaction, Customer customer, Customer_Points_System customerLoysltyPointSystem, Transaction transactionHistory)
                 {
                 	try 
                 	{
                 		membershiplevel = Customer_Points_System[Customer == customer.ID].Membership_Level_System;
                 		loyaltyRule = Loyalty_Rules[Membership_Level_System_loy_rul == membershiplevel && Market_Global_lr == customer.Market_Global && Type_of_Rule == "Earning"];
                 		loyaltyRule_Burning = Loyalty_Rules[Membership_Level_System_loy_rul == membershiplevel && Type_of_Rule == "Burning"];
                 		transactionMap = {"joining_points":"Joining Points","purchase":"Purchase","cancellation":"Cancellation"};
                 		transactionType = transactionMap.get(transaction.get("transaction_type"));
                 		if(true)
                 		{
                 			approvalResponse = thisapp.loyaltyEngine.preOrderApproval_V2(transaction,customer,customerLoysltyPointSystem,transactionHistory);
                 			//info approvalResponse;
                 			loyaltyDtails = approvalResponse.get("loyalty_details");
                 			if(approvalResponse.get("is_approved"))
                 			{
                 				orderid = transaction.get("order_id");
                 				lstorders = Transaction[Order_ID == orderid];
                 				if(lstorders.count() <= 0)
                 				{
                 					totalPurchaseAmount = approvalResponse.get("total_purchase_amount");
                 					totalDiscountAmount = approvalResponse.get("total_discount_amount");
                 					//redemptionAmount = transaction.get("total_redemption_amount").toDecimal();
                 					//burnedPoints = thisapp.loyaltyEngine.calculateBurnedPoints(loyaltyRule,redemptionAmount);
                 					//burnedPoints = 400;
                 					receivedPoints = if(transactionType != "Joining Points",thisapp.loyaltyEngine.calculateLoyaltyPoints_V2(loyaltyRule,totalPurchaseAmount - totalDiscountAmount.toDecimal()),Joining_Rules[Joining_Benefit == "Joining Points" && Market11 == customer.Country && Mark_as_Active].Joining_Points);
                 					/* 				if(loyaltyDtails.containKey("redeemable_items") && loyaltyDtails.get("redeemable_items") != null)
                                  				{
                                  					redeemableItem = loyaltyDtails.get("redeemable_items");
                                  					for each  redItem in redeemableItem
                                  					{
                                  						if(redItem.get("is_available"))
                                  						{
                                  							burnedPoints = burnedPoints + redeemableItem.get("points_to_be_burned");
                                  						}
                                  					}
                                  				} */
                 					rewards = transaction.get("rewards");
                 					redeemablePoints = rewards.get("redeemable_points");
                 					burnedPoints = redeemablePoints;
                 					//info burnedPoints;
                 					totalDiscountAmount = ifnull(approvalResponse.get("total_discount_amount"),0);
                 					//thisapp.loyaltyEngine.convertPointsToAED_Burning(customer.Phone_Number,burnedPoints).get("converted_value_AED");
                 					//burnedPoints =
                 					if(burnedPoints <= customerLoysltyPointSystem.Available_Points)
                 					{
                 						countryCode = transaction.get("country");
                 						if(countryCode == "null" || countryCode == null)
                 						{
                 							//restaurant = Stores[Restaurant_ID == transaction.get("restaurant_id")].ID;
                 							//info transaction.get("restaurant_id");
                 							restaurant = peets_restaurant_management.storemanagement.getRestaurantByID(transaction.get("restaurant_id"));
                 						}
                 						else
                 						{
                 							//country = Market[Market_Name == if(countryCode == 1,"UAE","KSA")];
                 							//restaurant = Stores[Restaurant_ID == transaction.get("restaurant_id") && Hub_Name == country.ID].ID;
                 							//country =  Market[Market_Name == if(countryCode == 1,"UAE","KSA")];
                 							restaurant = peets_restaurant_management.storemanagement.getRestaurantByID(transaction.get("restaurant_id"));
                 						}
                 						//info restaurant;
                 						transactionEarned = insert into Transaction
                 						[
                 							Added_User=zoho.loginuser
                 							Customer=customer.ID
                 							Market_Global_txn=customer.Market_Global
                 							Restaurant_Name=restaurant
                 							Type_field=transactionType
                 							Order_ID=transaction.get("order_id")
                 							Total_Purchase_Amount=totalPurchaseAmount - totalDiscountAmount.toDecimal()
                 							Total_Discount_Amount=totalDiscountAmount
                 							Total_Invoice_Amount=transaction.get("total_invoice_amount").toDecimal()
                 							Earned_Loyalty_Points=receivedPoints
                 							Utilized_Points=0
                 							Remaining_Points=receivedPoints
                 							Transaction_Time=zoho.currenttime
                 							Status="Not Utilized"
                 							Available_Points_Before_Cancellation=customerLoysltyPointSystem.Available_Points
                 						];
                 						if(loyaltyDtails.containKey("free_drink"))
                 						{
                 							freeDrink = loyaltyDtails.get("free_drink");
                 							if(freeDrink.get("is_available"))
                 							{
                 								if(freeDrink.get("type").toLong() == 1)
                 								{
                 									freeDrinkModel = Add_Product[ID_Link == freeDrink.get("product_id")];
                 									if(freeDrinkModel.count() > 0)
                 									{
                 										customerLoysltyPointSystem.Redeemed_Product=freeDrinkModel.ID;
                 										customerLoysltyPointSystem.Is_Free_drink_available=false;
                 										customerLoysltyPointSystem.Free_Drink_Status="Redeemed";
                 										customerLoysltyPointSystem.Transaction=transactionEarned;
                 									}
                 								}
                 								else if(freeDrink.get("type").toLong() == 2)
                 								{
                 									burnedPoints = 1500;
                 									thisapp.loyaltyEngine.updateRemainingPointsInTransaction_V2(customer.ID,transactionEarned,burnedPoints);
                 								}
                 							}
                 						}
                 						getTransaction = Transaction[ID == transactionEarned];
                 						getTransaction.Available_Points=customerLoysltyPointSystem.Available_Points + receivedPoints - burnedPoints;
                 						getTransaction.Burned_Points=burnedPoints;
                 						getTransaction.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned + receivedPoints;
                 						getTransaction.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned + burnedPoints;
                 						itemList = loyaltyDtails.get("items");
                 						for each  purchasedItem in itemList
                 						{
                 							product = Add_Product[ID_Link == purchasedItem.get("product_id")];
                 							if(purchasedItem.containKey("applied_offer") && purchasedItem.get("applied_offer") != null)
                 							{
                 								offerData = purchasedItem.get("applied_offer");
                 								if(offerData.get("is_applied"))
                 								{
                 									offerAppliedID = offerData.get("offer_id").toLong();
                 								}
                 								else
                 								{
                 									offerAppliedID = null;
                 								}
                 							}
                 							else
                 							{
                 								offerAppliedID = null;
                 							}
                 							lineItems = insert into Order_Line_Items
                 							[
                 								Added_User=zoho.loginuser
                 								Transaction_ID=transactionEarned
                 								Product=product.ID
                 								Qty=purchasedItem.get("quantity")
                 								Discount=purchasedItem.get("discount_amount")
                 								Price=purchasedItem.get("price").toDecimal()
                 								Total=purchasedItem.get("net_total").toDecimal()
                 								Applied_Offers=offerAppliedID
                 							];
                 						}
                 					}
                 					customerLoysltyPointSystem.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned + receivedPoints;
                 					customerLoysltyPointSystem.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned + burnedPoints;
                 					customerLoysltyPointSystem.Available_Points=customerLoysltyPointSystem.Available_Points + receivedPoints - burnedPoints;
                 					// added by om on 27/oct/2025  to upgrade and downgrade membership
                 					// 				if(customerLoysltyPointSystem.Total_Points_Burned > 6000)
                 					// 				{
                 					// 				    id = Membership_Points_System[Membership_Level="Platinum"].ID;
                 					// 					customerLoysltyPointSystem.Membership_Level_System=id;
                 					// 				}
                 					// 				else if(customerLoysltyPointSystem.Total_Points_Burned > 3000)
                 					// 				{
                 					// 					id = Membership_Points_System[Membership_Level="Gold"].ID;
                 					// 					customerLoysltyPointSystem.Membership_Level_System=id;
                 					// 				}
                 					// 				else
                 					// 				{
                 					// 					id = Membership_Points_System[Membership_Level="Silver"].ID;
                 					// 					customerLoysltyPointSystem.Membership_Level_System=id;
                 					// 				}
                 					thisapp.loyaltyEngine.updateMembershipLevelv2(customer.Phone_Number);
                 					return thisapp.loyaltyEngine.getLoyaltyData_V2(customer,customerLoysltyPointSystem,getTransaction);
                 				}
                 				else
                 				{
                 					return {"message":"Order id already exists","is_approved":false};
                 				}
                 			}
                 			// 			return Map();
                 		}
                 		return {"message":"Flag not approved","is_approved":false};
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.updateLoyaltyPoints",e);
                 	}
                 	return null;
                 }
