				 list fetchRecords.getStoreLocations(String country, String localTime)
                 {
                 	try 
                 	{
                 		days = {"Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"};
                 		today = days.get(localTime.toTime().getDayOfWeek() - 1);
                 		getStores = Stores[Hub_Name.Market_Name == country && Status == "Active"];
                 		if(getStores.count() > 0)
                 		{
                 			storeLocationList = List();
                 			for each  store in getStores
                 			{
                 				imgSrc = thisapp.fileManagement.processImageUrl(store.Image);
                 				storeDetail = Map();
                 				storeDetail.put("store_id",store.Store_ID);
                 				storeDetail.put("restaurant_code",store.Restaurant_ID);
                 				storeDetail.put("restaurant_name",store.Restaurant);
                 				hubDetail = Map();
                 				storeDetail.put("market",hubDetail);
                 				hubDetail.put("market_name",store.Hub_Name.Market_Name);
                 				hubDetail.put("market_id",store.Hub_Name.toString());
                 				areaDetail = Map();
                 				storeDetail.put("area_data",areaDetail);
                 				areaDetail.put("area_name",store.Area.Area_Name);
                 				areaDetail.put("area_id",store.Area.toString());
                 				storeDetail.put("latitude",store.Latitude);
                 				storeDetail.put("longitude",store.Longitude);
                 				storeDetail.put("phone",thisapp.formatRestaurantPhone(store.Phone));
                 				storeDetail.put("opening_time","");
                 				storeDetail.put("closing_time","");
                 				storeImage = Map();
                 				storeDetail.put("image",storeImage);
                 				storeImage.put("report_name","All_Stores");
                 				storeImage.put("field_name","Image");
                 				storeImage.put("image_src",imgSrc);
                 				storeDetail.put("restaurant_image",thisapp.publicUrls.store(store.ID,imgSrc));
                 				storeDetail.put("id",store.ID.toString());
                 				for each  timing in store.Timings
                 				{
                 					if(timing.Day == today)
                 					{
                 						storeStatusString = "";
                 						isOpened = false;
                 						storeDetail.put("opening_time",timing.From);
                 						storeDetail.put("closing_time",timing.To);
                 						fromTime = (zoho.currentdate.toString() + " " + timing.From.toString()).toTime();
                 						toTime = (zoho.currentdate.toString() + " " + timing.To.toString()).toTime();
                 						parsedLocalTime = localTime.toTime();
                 						if(fromTime > toTime)
                 						{
                 							toTime = toTime.addHour(24);
                 							if(parsedLocalTime < fromTime)
                 							{
                 								parsedLocalTime = parsedLocalTime.addHour(24);
                 							}
                 						}
                 						if(fromTime > parsedLocalTime || toTime < parsedLocalTime)
                 						{
                 							fromTimeString = "";
                 							fromSuffixString = "AM";
                 							if(fromTime.getHour() > 12)
                 							{
                 								fromTimeString = fromTime.getHour() - 12;
                 								fromSuffixString = "PM";
                 							}
                 							else
                 							{
                 								fromTimeString = fromTime.getHour();
                 							}
                 							storeStatusString = "Closed (Opens at " + fromTimeString + ":" + if(fromTime.getMinutes() < 10,fromTime.getMinutes() + "0",fromTime.getMinutes()) + " " + fromSuffixString + ")";
                 						}
                 						else if(fromTime <= parsedLocalTime && toTime >= parsedLocalTime)
                 						{
                 							isOpened = true;
                 							toTimeString = "";
                 							toSuffixString = "AM";
                 							if(toTime.getHour() > 12)
                 							{
                 								toTimeString = toTime.getHour() - 12;
                 								toSuffixString = "PM";
                 							}
                 							else if(toTime.getHour() <= 0)
                 							{
                 								toTimeString = "12";
                 							}
                 							else
                 							{
                 								toTimeString = toTime.getHour();
                 							}
                 							storeStatusString = "Open (Closes at " + toTimeString + ":" + if(toTime.getMinutes() < 10,toTime.getMinutes() + "0",toTime.getMinutes()) + " " + toSuffixString + ")";
                 						}
                 						storeDetail.put("store_status",storeStatusString);
                 						storeDetail.put("is_opened",isOpened);
                 						break;
                 					}
                 				}
                 				storeLocationList.add(storeDetail);
                 			}
                 			return storeLocationList;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getStoreLocations",e);
                 	}
                 	return null;
                 }
				 map fetchRecords.getTermsandConditions()
                 {
                 	tncresponse = Map();
                 	result = Map();
                 	// --- Fetch Localized Strings ---
                 	localappstrings = thisapp.fetchRecords.localisableAppStringsV2("0","0");
                 	terms_strings = localappstrings.get("terms_and_condition_view_strings");
                 	//	info terms_strings;
                 	// --- Header Section ---
                 	headerSection = Map();
                 	backIcon = Map();
                 	backgroundImage = Map();
                 	backIcon.put("img_url","<img_url>");
                 	backIcon.put("report_name","All_Home_Overviews");
                 	backIcon.put("image_src","1724230804415_Profile.png");
                 	backIcon.put("field_name","Image");
                 	backgroundImage.put("img_url","<img_url>");
                 	backgroundImage.put("report_name","All_Home_Overviews");
                 	backgroundImage.put("image_src","1724230804415_Profile.png");
                 	backgroundImage.put("field_name","Image");
                 	headerSection.put("back_icon_image",thisapp.publicUrls.getlogoimages("41"));
                 	headerSection.put("background_image",thisapp.publicUrls.getlogoimages("29"));
                 	headerSection.put("header_name",terms_strings.get("view_title"));
                 	// --- Description List ---
                 	descriptionList = List();
                 	termsList = terms_strings.get("terms");
                 	// Assuming it's a List
                 	for each  d in termsList
                 	{
                 		descriptionItem = Map();
                 		descriptionItem.put("description",d);
                 		descriptionList.add(descriptionItem);
                 	}
                 	// --- Policy Section ---
                 	policySection = Map();
                 	policySection.put("description_list",descriptionList);
                 	// --- Assemble Final Response ---
                 	result.put("header_section",headerSection);
                 	result.put("tnc_section",policySection);
                 	tncresponse.put("result",result);
                 	tncresponse.put("code","3000");
                 	tncresponse.put("type","profile_9");
                 	return tncresponse;
                 }
				 list fetchRecords.getTransactions(String loginUserNumber, int startIndex, int endIndex)
                 {
                 	//Example - 4661594000000578128,1,20
                 	try 
                 	{
                 		allTransactions = Transaction[Customer.Phone_Number == loginUserNumber] sort by Transaction_Time desc range from startIndex to endIndex;
                 		if(allTransactions.count() > 0)
                 		{
                 			transactionList = List();
                 			for each  transaction in allTransactions
                 			{
                 				exsitence = false;
                 				transactionTime = transaction.Transaction_Time;
                 				for each  transactionRec in transactionList
                 				{
                 					if(transactionRec.get("month_index") == transactionTime.getMonth() && transactionRec.get("year") == transactionTime.getYear())
                 					{
                 						transactionDetail = transactionRec;
                 						transactionRec.put("this_month_earned_points",(transactionRec.get("this_month_earned_points") + transaction.Earned_Loyalty_Points - transaction.Burned_Points).toLong());
                 						transactionHistory = transactionRec.get("transaction_history");
                 						exsitence = true;
                 						break;
                 					}
                 				}
                 				if(!exsitence)
                 				{
                 					transactionDetail = Map();
                 					monthIndex = transactionTime.getMonth();
                 					transactionDetail.put("month",thisapp.getMonth(monthIndex));
                 					transactionDetail.put("year",transactionTime.getYear());
                 					transactionDetail.put("month_index",transactionTime.getMonth());
                 					transactionDetail.put("this_month_earned_points",(transaction.Earned_Loyalty_Points - transaction.Burned_Points).toLong());
                 					transactionDetail.put("points_suffix","pts");
                 					transactionHistory = List();
                 					transactionDetail.put("transaction_history",transactionHistory);
                 					transactionList.add(transactionDetail);
                 				}
                 				transactionData = Map();
                 				restaurantDetail = Map();
                 				transactionData.put("restaurant",restaurantDetail);
                 				restaurantDetail.put("restaurant_name",transaction.Restaurant_Name.Restaurant_Name);
                 				restaurantDetail.put("restaurant_id",transaction.Restaurant_Name.toString());
                 				transactionData.put("transaction_time",transaction.Transaction_Time.toString());
                 				transactionData.put("type",transaction.Type_field);
                 				transactionData.put("total_purchase_amount",transaction.Total_Purchase_Amount);
                 				transactionData.put("total_discount_amount",transaction.Total_Discount_Amount);
                 				purchasePoints = transaction.Earned_Loyalty_Points;
                 				if(purchasePoints > 0)
                 				{
                 					//Earn Case
                 					purchasePoints = "+ " + purchasePoints.toLong() + " pts";
                 				}
                 				else if(purchasePoints < 0)
                 				{
                 					//Refund Case
                 					purchasePoints = "- " + (purchasePoints * -1).toLong() + " pts";
                 				}
                 				else
                 				{
                 					// No transaction
                 					purchasePoints = "0 pts";
                 				}
                 				transactionData.put("earned_loyalty_points",purchasePoints);
                 				burnedPoints = transaction.Burned_Points;
                 				if(burnedPoints > 0)
                 				{
                 					//Burn Case
                 					burnedPoints = "- " + burnedPoints.toLong() + " pts";
                 				}
                 				else if(burnedPoints < 0)
                 				{
                 					// Burn Redund
                 					burnedPoints = "+ " + (burnedPoints * -1).toLong() + " pts";
                 				}
                 				else
                 				{
                 					burnedPoints = "";
                 				}
                 				transactionData.put("burned_points",burnedPoints);
                 				transactionData.put("overall_points_earned",transaction.Total_Points_Earned.toLong());
                 				transactionData.put("total_points_burned",transaction.Total_Points_Burned.toLong());
                 				transactionData.put("available_points","Points in hand: " + transaction.Available_Points.toLong());
                 				transactionData.put("order_id",transaction.Order_ID);
                 				transactionData.put("record_id",transaction.ID.toString());
                 				transactionHistory.add(transactionData);
                 			}
                 			return transactionList;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getTransactions",e);
                 	}
                 	return null;
                 }
