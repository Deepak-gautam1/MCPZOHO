		default list All_Transactions
		{
			displayName = "Transactions"
			show all rows from Transaction    
			(
				Customer
				Transaction_Time as "Transaction Time"
				(
					width = 165px
				)
				Type_field as "Type"
				(
					width = 90px
				)
				Total_Purchase_Amount as "Invoice"
				(
					width = 90px
				)
				Earned_Loyalty_Points as "Earned Points"
				(
					width = 110px
				)
				Available_Points as "Available Points"
				(
					width = 120px
				)
				Order_ID as "Order ID"
				(
					width = 298px
				)
				Total_Points_Earned as "Total Points Earned"
				Burned_Points as "Burned Points"
				(
					width = 110px
				)
				Market as "Market (remove)"
				(
					width = 95px
				)
				Total_Discount_Amount as "Discount"
				(
					width = 90px
				)
				Total_Invoice_Amount as "Purchase"
				(
					width = 90px
				)
				Total_Points_Earned_Before_Cancellation as "Total Points Earned Before Cancellation"
				Total_Points_Burned_Before_Cancellation as "Total Points Burned Before Cancellation"
				Available_Points_Before_Cancellation as "Previous Points"
				(
					width = 120px
				)
				Utilized_Points as "Utilized Points"
				Remaining_Points as "Remaining Points"
				Status
				(
					width = 95px
				)
				Expired_Points as "Expiration Points"
				(
					width = 130px
				)
				Customer.Phone_Number as "Phone"
				(
					width = 160px
					displayformat = plainnumber 
				)
				Market_Global_txn as "Market Global"
				(
					width = 165px
				)
				Bonus_Type as "Bonus Type"
				Previous_Total_Bonus_Available as "Previous Total (Bonus+ Available)"
				Bonus_Points_earned as "Bonus Points Earned"
				Bonus_Points_Burned as "Bonus Points Burned"
				Bonus_Expiration as "Bonus Expiration"
				Bonus_Available as " Bonus Available"
				Total_Bonus_Available as " Total (Bonus + Available)"
				Remaining_Bonus_Points as "Remaining Bonus Points"
				ID
				BonusValidity as "Bonus Validity"
				Restaurant_Name.Store_ID as "Store ID"
			)
			group by
			(
				Customer ascending
				Customer.Phone_Number ascending
			)
			sort by
			(
				Transaction_Time descending
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Bonus_Points_earned > 0)
				fields = [Earned_Loyalty_Points, Bonus_Points_earned]
				format = "color:#4ea64c;"
				}
				"New Formatting"
				{
				condition = (Bonus_Expiration > 0)
				fields = [Burned_Points, Expired_Points, Bonus_Points_Burned, Bonus_Expiration]
				format = "color:#e64d3b;"
				}
				"New Formatting"
				{
				fields = [Available_Points]
				format = "font-weight:bold;"
				}
				"New Formatting"
				{
				condition = (Type_field == "Cancellation")
				fields = [Earned_Loyalty_Points]
				format = "color:#000000;background-color:#f6abab;"
				}
				"New Formatting"
