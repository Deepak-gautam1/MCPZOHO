				 list loyaltyEngine.validateOffer(List productsToBeOrdered, Map offerPrompt, Customer customer, Customer_Points_System CustomerPointsSystem, Transaction transactionHistory)
                 {
                 	validatedOffers = List();
                 	offers = thisapp.loyaltyEngine.getAvailableOffers(customer,CustomerPointsSystem,transactionHistory);
                 	if(offers.get("is_available"))
                 	{
                 		for each  offerTobeApplied in offerPrompt
                 		{
                 			for each  offer in offers.get("available_offers")
                 			{
                 				offerTobeApplied.put("is_available",false);
                 				if(offerTobeApplied.get("offer_id") == offer.get("offer_id"))
                 				{
                 					offerTobeApplied.put("is_available",true);
                 					if(offer.get("offer_type") == 1)
                 					{
                 						offerTobeApplied.put("description",offer.get("description"));
                 						offerTobeApplied.put("discount_details",offer.get("discount_details"));
                 						productListCostEstimated = thisapp.loyaltyEngine.getOfferDiscountEstimation(0,Map(),Map());
                 					}
                 					else
                 					{
                 						offerTobeApplied.put("free_product",offer.get("free_product"));
                 					}
                 					break;
                 				}
                 			}
                 			validatedOffers.add(offerTobeApplied);
                 		}
                 	}
                 	return {validatedOffers,productListCostEstimated};
                 }
				 list loyaltyEngine.validateRedeemableItem(List itemsTobeRedeemed, Customer customer, Customer_Points_System customerLoyaltyPointSystem)
                 {
                 	redeemableItemsRules = thisapp.loyaltyEngine.getRedemptionRules(Redemption_Rules[Market = customer.Country && Points_threshold < 3000]);
                 	if(redeemableItemsRules.size() > 0)
                 	{
                 		for each  redeemableItem in itemsTobeRedeemed
                 		{
                 			redeemableItem.put("is_available",false);
                 			redeemableItemRecord = Add_Product[ID_Link == redeemableItem.get("product_id")];
                 			if(redeemableItemRecord.count() > 0)
                 			{
                 				for each  rules in redeemableItemsRules
                 				{
                 					isAvailable = false;
                 					for each  redeemableCategory in rules.get("redeemable_categories")
                 					{
                 						if(redeemableCategory.get("category_id") == redeemableItemRecord.Category)
                 						{
                 							info redeemableItemRecord.Product_Name;
                 							redeemableItem.put("is_available",true);
                 							redeemableItem.put("points_to_be_burned",rules.get("points_threshold"));
                 							isAvailable = true;
                 							break;
                 						}
                 					}
                 					if(isAvailable)
                 					{
                 						break;
                 					}
                 				}
                 			}
                 		}
                 	}
                 	return itemsTobeRedeemed;
                 }
