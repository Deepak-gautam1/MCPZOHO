                 				offerDetail.put("category",offerCategory);
                 				offerCategory.put("category_name",offer.Category.Category_Name);
                 				offerCategory.put("category_id",offer.Category);
                 				offerDetail.put("available_from","From: " + thisapp.formatDate(offer.Offer_Start_From));
                 				offerDetail.put("expires_on",if(offer.Offer_Ends_On != null,"To: " + thisapp.formatDate(offer.Offer_Ends_On),""));
                 				offerDetail.put("does_expiration_applicable",offer.Does_Expiration_Apply);
                 				offerDetail.put("offer_name",offer.Offer_Name);
                 				offerImage = Map();
                 				offerDetail.put("image",offerImage);
                 				offerImage.put("report_name","Offers_Report");
                 				offerImage.put("field_name","Image");
                 				offerImage.put("image_src",imageSrc);
                 				offerImage.put("temp_img_src",thisapp.publicUrls.offer(offer.ID,imageSrc));
                 				offerDetail.put("offer_type",offer.Offer_Type);
                 				offerDetail.put("offer_discount",if(offer.Discount_Percentage != null,offer.Discount_Percentage,0).toLong());
                 				freeProducts = List();
                 				for each  freeProduct in offer.Products
                 				{
                 					freeProductData = Map();
                 					freeProductData.put("product",freeProduct.Product_Name);
                 					freeProductData.put("id",freeProduct.ID);
                 					freeProducts.add(freeProductData);
                 				}
                 				offerDetail.put("free_products",freeProducts);
                 				offerDetail.put("id",offer.ID.toString());
                 				offerList.add(offerDetail);
                 			}
                 			/* 		offerData = Map();
                                  		presentOfferList = List();
                                  		futureOfferList = List();
                                  		offerData.put("present_offers",presentOfferList);
                                  		offerData.put("future_offers",futureOfferList); */
                 			/* 		for each  offer in fetchOffers
                                  		{
                                  			offerDetail = Map();
                                  			
                                  			if(offer.Offer_Start_From < today)
                                  			{
                                  				presentOfferList.add(offerDetail);
                                  			}
                                  			else
                                  			{
                                  				futureOfferList.add(offerDetail);
                                  			}
                                  		} */
                 			mapoffers.put("lstoffers",offerListData);
                 			return mapoffers;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getOffers",e);
                 	}
                 	return null;
                 }
				 map fetchRecords.getoffers_v3(string marketid)
                 {
                 	// Build base containers
                 	//marketid = "4661594000008171931";
                 	response = Map();
                 	result = Map();
                 	// ----------------- Header Section -----------------
                 	header_section = Map();
                 	back_icon_image = Map();
                 	back_icon_image.put("img_url","<img_url>");
                 	back_icon_image.put("report_name","All_Home_Overviews");
                 	back_icon_image.put("image_src","1724230804415_Profile.png");
                 	back_icon_image.put("field_name","Image");
                 	background_image = Map();
                 	background_image.put("img_url","<img_url>");
                 	background_image.put("report_name","All_Home_Overviews");
                 	background_image.put("image_src","1724230804415_Profile.png");
                 	background_image.put("field_name","Image");
                 	search_icon = Map();
                 	search_icon.put("img_url","<img_url>");
                 	search_icon.put("report_name","All_Home_Overviews");
                 	search_icon.put("image_src","1724230804415_Profile.png");
                 	search_icon.put("field_name","Image");
                 	header_section.put("back_icon_image",thisapp.publicUrls.getlogoimages("41"));
                 	header_section.put("background_image",thisapp.publicUrls.getlogoimages("29"));
                 	header_section.put("header_name","Offers");
                 	header_section.put("search_icon",thisapp.publicUrls.getlogoimages("31"));
                 	header_section.put("search_text","Search");
                 	// ----------------- Offer Section -----------------
                 	// 			fetchOffers = Offers[Does_Expiration_Apply == false || Offer_Ends_On >= zoho.currenttime && Status == "Active" || Selected_Customer == loginUserID] sort by Display_Sequence_Priority asc;
                 	nowdt = zoho.currenttime;
                 	lstoffers = Offers_All[From_date_offer <= nowdt && To_date_offer >= nowdt && isActive == true && Market_Global_offers == marketid.tolong()] sort by Display_Sequence asc;
                 	// lstoffers = Offers_All[
                 	//     From_date_offer <= nowdt
                 	//     && To_date_offer >= nowdt
                 	//     && isActive == true
                 	//     && Market_Global_offers == marketid.tolong()
                 	// ] sort by Display_Sequence asc;
                 	//info lstoffers;
                 	offer_section = List();
                 	// helper list to iterate twice (Deluge doesn't support 1..2 range loops)
                 	for each  offer in lstoffers
                 	{
                 		offer_map = Map();
                 		offer_cover_image = Map();
                 		offer_cover_image.put("img_url","<img_url>");
                 		offer_cover_image.put("report_name","All_Home_Overviews");
                 		offer_cover_image.put("image_src","1724230804415_Profile.png");
                 		offer_cover_image.put("field_name","Image");
                 		offer_map.put("offer_cover_image",thisapp.publicUrls.getofferimage(offer.ID.tostring()));
                 		offer_map.put("offer_name",offer.Offer_Name);
                 		offer_map.put("offer_description",offer.Description);
                 		offer_map.put("shop_button_text","Shop Now");
                 		offer_map.put("details_button_text","Details");
                 		// details_list with proper Map() items
                 		details_list = List();
                 		d = Map();
                 		d.put("description",offer.Terms_Conditions);
                 		details_list.add(d);
                 		offer_map.put("details",details_list);
                 		offer_section.add(offer_map);
                 	}
                 	// ----------------- Build Final Response -----------------
                 	result.put("header_section",header_section);
                 	result.put("offer_section",offer_section);
                 	response.put("result",result);
                 	response.put("code","3000");
                 	response.put("type","profile_7");
                 	return response;
                 }
				 map fetchRecords.getOrderConfirmation(string mobileorderid, string bsporderid)
                 {
                 	//orderid = 4661594000008137015;
                 	lstorder = Cart_Order_Test[ID == mobileorderid.tolong() && Pos_orderid == bsporderid];
                 	cust = Customer[ID == lstorder.Customer];
                 	lstorderstatus = Cart_Status[ID != 0];
                 	available_points = Customer_Points_System[Customer == cust].Available_Points;
                 	localTime = zoho.currenttime.tostring();
                 	objstore = peets_restaurant_management.storemanagement.getAllStorePeetsbystoreid(lstorder.Restaurant_Name_cart_order_all,localTime.tostring());
                 	//info lstorder.ID;
                 	lstorderitems = Cart_Order_Items[Cart_Order_ID == lstorder.ID];
                 	//info lstorderitems;
                 	//info objstore;
                 	order_response = Map();
                 	result = Map();
                 	// ================== Confirmation Section ==================
                 	currencyinfo = Map();
                 	currencyinfo.put("currencyname",lstorder.Order_Currency);
                 	currencyinfo.put("id","c01");
                 	pickup_details = Map();
                 	pickup_time_details = Map();
                 	pickup_time_details.put("type",lstorder.Pickup_Type);
                 	pickup_time_details.put("day",lstorder.Pickup_Day);
                 	pickup_details.put("pickup_time_details",pickup_time_details);
                 	confirmation_section = Map();
                 	status_icon = Map();
                 	status_icon.put("img_url","<img_url>");
                 	status_icon.put("image_src","checkmark_green.png");
                 	status_icon.put("field_name","Image");
                 	confirmation_section.put("status_icon",thisapp.publicUrls.getlogoimages("15"));
                 	confirmation_section.put("title","Order confirmed!");
                 	confirmation_section.put("message","Thank you for your order! We’re brewing it fresh and crafting with care. You’ll receive a notification when it’s ready for pickup.");
                 	confirmation_section.put("posmessage",lstorder.Pos_Message);
                 	// ================== Order Summary Section ==================
                 	order_summary_section = Map();
                 	sections_list = List();
                 	// --- Order Items Section ---
                 	order_items_section_map = Map();
                 	order_items_section_map.put("label","Order Items");
                 	expand_icon = thisapp.publicUrls.getlogoimages("90");
                 	order_items_section_map.put("expand_icon",expand_icon);
                 	item_overview = Map();
                 	item_overview.put("title","Order Items");
                 	items_list = List();
                 	for each  item in lstorderitems
                 	{
                 		lstmodifiers = item.Modifiers_Subform;
                 		itemname = copy_of_product_catalogue.productManagement.getproductnamebyid(item.Product_lookup_items);
                 		itemqty = item.Quantity;
                 		itemprice = item.Product_Price;
                 		currency = lstorder.Order_Currency;
                 		notes = "";
                 		item_id = item.Product_lookup_items.tostring();
                 		itemimage = copy_of_product_catalogue.publicUrls.getproductimage(item.Product_lookup_items.tostring());
                 		itemsize = item.Product_Size;
                 		modsByType = Map();
                 		typeOrder = List();
                 		typeIdByType = Map();
                 		modTypeIdByType = Map();
                 		for each  mod in lstmodifiers
                 		{
                 			typeName = copy_of_product_catalogue.modifiers.getmodifierstypenamebyid(mod.Modifier_Type_order);
                 			typeId = mod.Modifier_Type_order.toString();
                 			modtypeid = mod.Type_field.toString();
                 			// <-- new field
                 			valName = copy_of_product_catalogue.modifiers.getmodifiersnamebyid(mod.Modifiers_order);
                 			valId = mod.Modifiers_order;
                 			valQty = mod.Modifier_Qty;
                 			existing = modsByType.get(typeName);
                 			if(existing == null)
                 			{
                 				existing = List();
                 				modsByType.put(typeName,existing);
                 				typeOrder.add(typeName);
                 				// store both ids for this type
                 				typeIdByType.put(typeName,typeId);
                 				modTypeIdByType.put(typeName,modtypeid);
                 			}
                 			valMap = Map();
                 			valMap.put("name",valName);
                 			valMap.put("id",valId.toString());
                 			valMap.put("qty",valQty);
                 			existing.add(valMap);
                 		}
                 		modifiers_list = List();
                 		for each  t in typeOrder
                 		{
                 			entry = Map();
                 			entry.put("name",t);
                 			entry.put("id",typeIdByType.get(t));
                 			//entry.put("type",modTypeIdByType.get(t));
                 			entry.put("type",copy_of_product_catalogue.modifiersManagement.getmodifierstypebyid(typeIdByType.get(t).tolong()));
                 			entry.put("values",modsByType.get(t));
                 			modifiers_list.add(entry);
                 		}
                 		lstaddones = item.Add_ones;
                 		list_addones = List();
                 		for each  addones in lstaddones
                 		{
                 			typeaddones = Map();
                 			typeaddones.put("addones_typeid",addones.Addon_Type_order.tostring());
                 			typeaddones.put("addones_type",copy_of_product_catalogue.addonesdetail.addonestypenamebyid(addones.Addon_Type_order));
                 			typeaddones.put("addones_id",addones.Addons_order.tostring());
                 			typeaddones.put("addones",copy_of_product_catalogue.addonesdetail.getaddonesnamebyid(addones.Addons_order));
                 			typeaddones.put("addones_price",addones.Addones_Price);
                 			typeaddones.put("qty",addones.Addones_Selected_qty);
                 			typeaddones.put("total",addones.Total_Addons_Price);
                 			list_addones.add(typeaddones);
                 		}
                 		itemsize = Map();
                 		itemsize.put("name",item.Product_Size.Size);
                 		itemsize.put("id",item.Product_Size.tostring());
                 		// Build the item map and attach modifiers
                 		item_map = Map();
                 		item_map.put("item_name",itemname);
                 		item_map.put("item_image",itemimage);
                 		item_map.put("itemsize",itemsize);
                 		item_map.put("item_id",item_id);
                 		item_map.put("notes",notes);
                 		item_map.put("price",currency + " " + itemprice.tostring());
                 		item_map.put("quantity",itemqty);
                 		item_map.put("modifiers",modifiers_list);
                 		item_map.put("addones",list_addones);
                 		items_list.add(item_map);
                 	}
                 	// Attach to overview
                 	item_overview.put("items",items_list);
                 	order_items_section_map.put("item_overview",item_overview);
                 	// --- Store Location Section ---
                 	localTime = zoho.currenttime;
                 	resp_map = objstore.toMap();
                 	// Access result block
                 	result_map = resp_map.get("result");
                 	//info result_map;
                 	stores_list = result_map.get("stores");
                 	first_store = stores_list.get(0);
                 	store_overview = first_store.get("store_overview");
                 	store_detail = first_store.get("store_detail_view");
                 	//info store_overview;
                 	basic = stores_list.getJSON("basic_store");
                 	store_id = store_overview.get("id");
                 	address = store_overview.get("location_name");
                 	phone = store_overview.get("phone");
                 	phone_icon = store_overview.get("phone_icon");
                 	direction_text = store_overview.get("direction_text");
                 	direction_icon = store_overview.get("direction_icon");
                 	operating_status = store_overview.get("operating_status");
                 	is_open = store_overview.get("is_open");
                 	latitude = store_overview.get("latitude");
                 	longitude = store_overview.get("longitude");
                 	opening_time = store_overview.getJSON("opening_time");
                 	closing_time = store_overview.getJSON("closing_time");
                 	operating_status = store_overview.getJson("operating_status");
                 	star_rating = store_overview.getJSON("star_rating");
                 	direction_icon = store_overview.getJSON("direction_icon");
                 	location_icon = store_overview.getJSON("location_icon");
                 	phone_icon = store_overview.getJSON("phone_icon");
                 	review_value = store_overview.get("review_value");
                 	review_count = store_overview.get("review_count");
                 	is_open = store_overview.getJSON("is_open");
                 	duration = store_overview.get("duration");
                 	destination = store_overview.get("destination");
                 	//info operating_status;
                 	//info store_detail;
                 	res_image = store_detail.getJSON("header").getJSON("image_src");
                 	//info res_image;
                 	//----------------------------------------------------------
                 	location_details = Map();
                 	location_details.put("store_id",store_id.tostring());
                 	location_details.put("value",address.tostring());
                 	pickup_details.put("location_details",location_details);
                 	pickup_details.put("pickup_type","1");
                 	coupon_section = Map();
                 	coupon_section.put("promo_code",lstorder.Discount_Coupons.PROMO_CODE);
                 	coupon_section.put("id",lstorder.Discount_Coupons.tostring());
                 	redeem_section = Map();
                 	redeem_section.put("redeem_points_applied",ifnull(lstorder.Points_Redeem_values.tostring(),"0"));
                 	redeem_section.put("available_points",Customer_Points_System[Customer == lstorder.Customer].Available_Points.tostring());
                 	pickup_details.put("coupon_section",coupon_section);
                 	pickup_details.put("redeem_section",redeem_section);
                 	store_location_section_map = Map();
                 	store_location_section_map.put("label","Store Location");
                 	store_location_section_map.put("expand_icon",expand_icon);
                 	store_overview = Map();
                 	store_overview.put("id",store_id.tostring());
                 	store_overview.put("store_image",res_image);
                 	store_overview.put("location_name",address.tostring());
                 	store_overview.put("location_icon",location_icon);
                 	store_overview.put("review_value",star_rating.tostring());
                 	store_overview.put("review_count",review_count);
                 	store_overview.put("phone",phone.tostring());
                 	store_overview.put("phone_icon",phone_icon);
                 	store_overview.put("direction_text","Get directions");
                 	store_overview.put("direction_icon",direction_icon);
                 	store_overview.put("duration",duration);
                 	store_overview.put("destination",destination);
                 	store_overview.put("operating_status",operating_status);
                 	store_overview.put("is_open",is_open);
                 	store_overview.put("latitude",latitude);
                 	store_overview.put("longitude",longitude);
                 	store_location_section_map.put("store_overview",store_overview);
                 	// Add to sections list
                 	sections_list.add(order_items_section_map);
                 	sections_list.add(store_location_section_map);
                 	order_summary_section.put("sections",sections_list);
                 	// --- Payment Details ---
                 	order_amount = lstorder.Order_Currency + " " + lstorder.Total_Amount_s;
                 	payment_details = {"label":"Payment Details","method":"Credit/Debit Card","amount ":order_amount};
                 	order_summary_section.put("payment_details",payment_details);
                 	// --- Order Info ---
                 	point_info = Map();
                 	point_info.put("available_points",available_points.tostring());
                 	order_info = Map();
                 	order_info.put("order_number_text","Order Number");
                 	order_info.put("order_number",lstorder.ID.tostring());
                 	order_info.put("BSP_order_number",lstorder.Pos_orderid.tostring());
                 	order_info.put("item_total_text","Item Total");
                 	order_info.put("item_total",order_amount);
                 	order_info.put("peets_points_text","Peet's Points");
                 	order_info.put("peets_points","+323 Points");
                 	order_info.put("grand_total_text","Grand Total");
                 	order_info.put("grand_total",order_amount);
                 	order_info.put("vat_included",true);
                 	order_summary_section.put("order_info",order_info);
                 	payment_summary = Map();
                 	payment_summary.put("subtotal",lstorder.Sub_Total.tostring());
                 	payment_summary.put("vat",lstorder.Vat_s.tostring());
                 	payment_summary.put("total_amount",lstorder.Total_Amount_s.tostring());
                 	payment_summary.put("coupon_discount",lstorder.Payment_Coupon_Discount_s.tostring());
                 	// --- Order Tracking Section ---
                 	order_tracking_section = Map();
                 	order_tracking_section.put("track_button_text","Track your order");
                 	order_tracking_detail_section = Map();
                 	order_tracking_detail_section.put("title","Order tracking");
                 	order_tracking_detail_section.put("status",lstorder.Cart_Status.Status);
                 	now_time = zoho.currenttime.toTime();
                 	pickup_time = lstorder.Pickup_Datetime;
                 	if(pickup_time.tostring() != "")
                 	{
                 		diff_ms = pickup_time.toLong() - now_time.toLong();
                 		diff_mins = (diff_ms / (1000 * 60)).toLong();
                 		order_tracking_detail_section.put("estimated_time",diff_mins.toString() + " mins");
                 	}
                 	else
                 	{
                 		order_tracking_detail_section.put("estimated_time"," mins");
                 	}
                 	order_tracking_detail_section.put("status_indicator","On time");
                 	bg_icon = thisapp.publicUrls.getlogoimages("89");
                 	order_tracking_detail_section.put("background_image",bg_icon);
                 	order_tracking_detail_section.put("back_icon",thisapp.publicUrls.getlogoimages("29"));
                 	order_tracking_detail_section.put("clock_icon",thisapp.publicUrls.getlogoimages("88"));
                 	order_tracking_detail_section.put("refresh_icon",thisapp.publicUrls.getlogoimages("89"));
                 	timeline = List();
                 	isReached = false;
                 	order_desc = "";
                 	for each  states in lstorderstatus
                 	{
                 		if(states.Status_ID == "4")
                 		{
                 			order_desc = states.Description + lstorder.ID + " " + states.Description_Detail;
                 		}
                 		else
                 		{
                 			order_desc = states.Description + states.Description_Detail;
                 		}
                 		stepMap = Map();
                 		stepMap.put("step",states.Status);
                 		// Assuming lstorderstatus has field "Status"
                 		stepMap.put("description",order_desc);
                 		// If status is before or equal to current order status → mark as Completed
                 		if(states.ID == lstorder.Cart_Status)
                 		{
                 			stepMap.put("status","current");
                 			// This is the current step
                 			isReached = true;
                 		}
                 		else if(isReached == false)
                 		{
                 			stepMap.put("status","completed");
                 		}
                 		else
                 		{
                 			stepMap.put("status","upcoming");
                 		}
                 		timeline.add(stepMap);
                 	}
                 	order_tracking_detail_section.put("timeline",timeline);
                 	order_tracking_section.put("order_tracking_detail_section",order_tracking_detail_section);
                 	rating_prompt_section = Map();
                 	rating_prompt_section.put("title","Don’t forget to rate us!");
                 	rating_prompt_section.put("subtitle","Your feedback helps us improve! Rate us and share your experience.");
                 	rating_prompt_section.put("rating_stars",5);
                 	rating_prompt_section.put("rating_star_empty",thisapp.publicUrls.getlogoimages("21"));
                 	rating_prompt_section.put("rating_star_Completion",thisapp.publicUrls.getlogoimages("20"));
                 	rating_prompt_section.put("rating_star_full",thisapp.publicUrls.getlogoimages("22"));
                 	rate_section = {"rate_text":"How was your experience?","rate_description":"Lets us know how your Peet's moment was.","rate_value":"0"};
                 	rating_prompt_section.put("rate_section",rate_section);
                 	rate_value_section = Map();
                 	lstfeedback = Feedback[ID != 0];
                 	rate_value_list = List();
                 	for each  feedback in lstfeedback
                 	{
                 		rate_value_section = Map();
                 		rate_value_section.put("rate_text",feedback.Title_Line);
                 		rate_value_section.put("rate_description",feedback.Detail_Line);
                 		rate_value_section.put("rate_value",feedback.Rating);
                 		rate_value_section.put("rate_identifier",feedback.Improvement_Parameters);
                 		rate_value_section.put("rate_reason_text","Spill the tea-or the coffee. We're listening!");
                 		rate_value_list.add(rate_value_section);
                 	}
                 	// Attach the whole list
                 	rating_prompt_section = Map();
                 	rating_prompt_section.put("rate_value_section",rate_value_list);
                 	rate_submit_section = Map();
                 	rate_submit_section.put("image",{"img_url":"<img_url>","report_name":"All_Home_Overviews","image_src":"1724230804415_Profile.png","field_name":"Image"});
                 	rate_submit_section.put("submit_text","Thank you for your feedback!");
                 	rate_submit_section.put("submit_description","Your feedback = our favorite blend!Thank you for sharing - now back to the grind (the good kind)!");
                 	rate_submit_section.put("submit_button_name","Got it");
                 	rating_prompt_section.put("rate_submit_section",rate_submit_section);
                 	footer_section = {"button_text":"Submit"};
                 	rating_prompt_section.put("footer_section",footer_section);
                 	// ================== Assemble ==================
                 	result.put("confirmation_section",confirmation_section);
                 	result.put("order_summary_section",order_summary_section);
                 	result.put("order_tracking_section",order_tracking_section);
                 	//	result.put("store_location_section",store_location_section);
                 	result.put("curb_side_detail",thisapp.cartmanagement.getcardetailfororder(mobileorderid.tolong()));
                 	result.put("currency",currencyinfo);
                 	result.put("pickup_details",pickup_details);
                 	result.put("payment_summary",payment_summary);
                 	result.put("rating_prompt_section",rating_prompt_section);
                 	result.put("point_info",point_info);
                 	result.put("order_status",lstorder.Type_field);
                 	order_response.put("result",result);
                 	order_response.put("code","3000");
                 	return order_response;
                 }
				 map fetchRecords.getorderdetailaftercartpost(int orderid)
                 {
                 	orderid = 4661594000008137015;
                 	lstorder = Cart_Order_Test[ID == orderid];
                 	cust = Customer[ID == lstorder.Customer];
                 	lstorderstatus = Cart_Status[ID != 0];
                 	localTime = zoho.currenttime.tostring();
                 	objstore = peets_restaurant_management.storemanagement.getAllStorePeetsbystoreid(lstorder.Restaurant_Name_cart_order_all,localTime.tostring());
                 	lstorderitems = Cart_Order_Items[Cart_Order_ID == lstorder.ID];
                 	//info objstore;
                 	order_response = Map();
                 	result = Map();
                 	// ================== Confirmation Section ==================
                 	confirmation_section = Map();
                 	status_icon = Map();
                 	status_icon.put("img_url","<img_url>");
                 	status_icon.put("image_src","checkmark_green.png");
                 	status_icon.put("field_name","Image");
                 	confirmation_section.put("status_icon",thisapp.publicUrls.getlogoimages("15"));
                 	confirmation_section.put("title","Order confirmed!");
                 	confirmation_section.put("message","Thank you for your order! We’re brewing it fresh and crafting with care. You’ll receive a notification when it’s ready for pickup.");
                 	confirmation_section.put("posmessage",lstorder.Pos_Message);
                 	// ================== Order Summary Section ==================
                 	order_summary_section = Map();
                 	sections_list = List();
                 	// --- Order Items Section ---
                 	order_items_section_map = Map();
                 	// 	order_items_section_map.put("label","Order Items");
                 	// 	expand_icon = {"img_url":"<img_url>","image_src":"expand.png","field_name":"Image"};
                 	// 	order_items_section_map.put("expand_icon",expand_icon);
                 	item_overview = Map();
                 	item_overview.put("title","Order Items");
                 	// Build items_list with modifiers grouped by type
                 	items_list = List();
                 	for each  item in lstorderitems
                 	{
                 		lstmodifiers = item.Modifiers_Subform;
                 		itemname = copy_of_product_catalogue.productManagement.getproductnamebyid(item.Product_lookup_items);
                 		itemid = item.Product_lookup_items.tostring();
                 		itemqty = item.Quantity;
                 		itemprice = item.Product_Price;
                 		currency = lstorder.Order_Currency;
                 		itemimage = copy_of_product_catalogue.publicUrls.getproductimage(item.Product_lookup_items.tostring());
                 		modsByType = Map();
                 		typeOrder = List();
                 		for each  mod in lstmodifiers
                 		{
                 			typeName = copy_of_product_catalogue.modifiers.getmodifierstypenamebyid(mod.Modifier_Type_order);
                 			valName = copy_of_product_catalogue.modifiers.getmodifiersnamebyid(mod.Modifiers_order);
                 			valId = mod.Modifiers_order;
                 			valQty = mod.Modifier_Qty;
                 			existing = modsByType.get(typeName);
                 			if(existing == null)
                 			{
                 				existing = List();
                 				modsByType.put(typeName,existing);
                 				typeOrder.add(typeName);
                 			}
                 			valMap = Map();
                 			valMap.put("name",valName);
                 			valMap.put("id",valId.tostring());
                 			valMap.put("qty",valQty);
                 			existing.add(valMap);
                 		}
                 		// Flatten grouped modifiers into an ordered list
                 		modifiers_list = List();
                 		for each  t in typeOrder
                 		{
                 			entry = Map();
                 			entry.put("type",t);
                 			entry.put("values",modsByType.get(t));
                 			modifiers_list.add(entry);
                 		}
                 		lstaddones = item.Add_ones;
                 		list_addones = List();
                 		for each  addones in lstaddones
                 		{
                 			typeaddones = Map();
                 			typeaddones.put("addones_typeid",addones.Addon_Type_order.tostring());
                 			typeaddones.put("addones_type",copy_of_product_catalogue.addonesdetail.addonestypenamebyid(addones.Addon_Type_order));
                 			typeaddones.put("addones_id",addones.Addons_order.tostring());
                 			typeaddones.put("addones",copy_of_product_catalogue.addonesdetail.getaddonesnamebyid(addones.Addons_order));
                 			typeaddones.put("addones_price",addones.Addones_Price);
                 			typeaddones.put("qty",addones.Addones_Selected_qty);
                 			typeaddones.put("total",addones.Total_Addons_Price);
                 			list_addones.add(typeaddones);
                 		}
                 		// Build the item map and attach modifiers
                 		item_map = Map();
                 		item_map.put("item_name",itemname);
                 		item_map.put("item_id",itemid);
                 		item_map.put("item_image",itemimage);
                 		item_map.put("price",currency + " " + itemprice.tostring());
                 		item_map.put("quantity",itemqty);
                 		item_map.put("modifiers",modifiers_list);
                 		item_map.put("addones",list_addones);
                 		items_list.add(item_map);
                 	}
                 	// Attach to overview
                 	item_overview.put("items",items_list);
                 	order_items_section_map.put("item_overview",item_overview);
                 	// --- Store Location Section ---
                 	localTime = zoho.currenttime;
                 	resp_map = objstore.toMap();
                 	// Access result block
                 	result_map = resp_map.get("result");
                 	//info result_map;
                 	stores_list = result_map.get("stores");
                 	first_store = stores_list.get(0);
                 	store_overview = first_store.get("store_overview");
                 	//info store_overview;
                 	basic = stores_list.getJSON("basic_store");
                 	store_id = store_overview.get("id");
                 	address = store_overview.get("location_name");
                 	phone = store_overview.get("phone");
                 	phone_icon = store_overview.get("phone_icon");
                 	direction_text = store_overview.get("direction_text");
                 	direction_icon = store_overview.get("direction_icon");
                 	operating_status = store_overview.get("operating_status");
                 	is_open = store_overview.get("is_open");
                 	latitude = store_overview.get("latitude");
                 	longitude = store_overview.get("longitude");
                 	opening_time = store_overview.getJSON("opening_time");
                 	closing_time = store_overview.getJSON("closing_time");
                 	operating_status = store_overview.getJson("operating_status");
                 	star_rating = store_overview.getJSON("star_rating");
                 	direction_icon = store_overview.getJSON("direction_icon");
                 	location_icon = store_overview.getJSON("location_icon");
                 	phone_icon = store_overview.getJSON("phone_icon");
                 	review_value = store_overview.get("review_value");
                 	review_count = store_overview.get("review_count");
                 	is_open = store_overview.getJSON("is_open");
                 	duration = store_overview.get("duration");
                 	destination = store_overview.get("destination");
