                 	return logoutResponse;
                 }
				 map appspages.ratetheapp()
                 {
                 	objlocalappstring = thisapp.fetchRecords.localisableAppStringsV2("0","0");
                 	// Fetch nested string maps
                 	order_feedback_strings = objlocalappstring.get("order_feedback_view_strings");
                 	order_feedback_completion_strings = objlocalappstring.get("order_feedback_completion_view_strings");
                 	rate_the_app_strings = objlocalappstring.get("rate_the_app_strings");
                 	// Main Rating Section
                 	rate_section = Map();
                 	rate_section.put("rate_text",order_feedback_strings.get("order_feedback_title"));
                 	rate_section.put("rate_description",order_feedback_strings.get("order_feedback_description"));
                 	rate_section.put("rate_value","0");
                 	// Value Section (for negative feedback)
                 	rate_value_section = Map();
                 	rate_value_section.put("rate_text",rate_the_app_strings.get("rate_value_title"));
                 	rate_value_section.put("rate_description",rate_the_app_strings.get("rate_value_description"));
                 	rate_value_section.put("rate_value","1");
                 	rate_identifier_list = List();
                 	rate_identifier_list.add(rate_the_app_strings.get("rate_reason_1"));
                 	rate_identifier_list.add(rate_the_app_strings.get("rate_reason_2"));
                 	rate_identifier_list.add(rate_the_app_strings.get("rate_reason_3"));
                 	rate_identifier_list.add(rate_the_app_strings.get("rate_reason_4"));
                 	rate_value_section.put("rate_identifier",rate_identifier_list);
                 	rate_value_section.put("rate_reason_text",rate_the_app_strings.get("rate_reason_prompt"));
                 	// Submit Section
                 	image = Map();
                 	image.put("img_url","<img_url>");
                 	image.put("report_name","All_Home_Overviews");
                 	image.put("image_src","1724230804415_Profile.png");
                 	image.put("field_name","Image");
                 	rate_submit_section = Map();
                 	rate_submit_section.put("image",image);
                 	rate_submit_section.put("submit_text",order_feedback_completion_strings.get("order_feedback_completion_title"));
                 	rate_submit_section.put("submit_description",order_feedback_completion_strings.get("order_feedback_completion_desc_1") + " " + order_feedback_completion_strings.get("order_feedback_completion_desc_2"));
                 	rate_submit_section.put("submit_button_name",order_feedback_completion_strings.get("order_feedback_completion_button"));
                 	// Footer
                 	footer_section = Map();
                 	footer_section.put("button_text",order_feedback_strings.get("order_feedback_submit_button"));
                 	// Compose Final Result
                 	result = Map();
                 	result.put("rate_section",rate_section);
                 	result.put("rate_value_section",rate_value_section);
                 	result.put("rate_submit_section",rate_submit_section);
                 	result.put("footer_section",footer_section);
                 	rate_the_app_response = Map();
                 	rate_the_app_response.put("result",result);
                 	rate_the_app_response.put("code","3000");
                 	rate_the_app_response.put("type","profile_12");
                 	return rate_the_app_response;
                 }
