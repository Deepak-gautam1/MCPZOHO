                 		}
                 		fileKey = "6Q6eV1q96BtjJbk3AxFzpUxZhRQSj2kVNHYdZQXQrnFD3As6MCPgVTarQuWWvx2BV8EXZMaF4OGtjKTFupSZDx09XqJ1Ej3J05GM";
                 		// Or get dynamically
                 		encodedPath = encodeUrl(imagePath);
                 		publicURL = "https://creatorapp.zohopublic.com/file/rtbidigitalassets_americanafood/test-peets-new/" + foldername + "/" + fet.ID + "/" + fieldPath + "/image-download/" + fileKey + "?filepath=/" + encodedPath;
                 		privateURL = "https://creator.zoho.com/file/rtbidigitalassets_americanafood/test-peets-new/" + foldername + "/" + fet.ID + "/" + fieldPath + "/image-download/" + fileKey + "?filepath=/" + encodedPath;
                 		imgMap.put("public_image_src",publicURL);
                 		imgMap.put("private_image_src",privateURL);
                 	}
                 	else
                 	{
                 		imgMap.put("error","Image not found for ID: " + recordid.toString());
