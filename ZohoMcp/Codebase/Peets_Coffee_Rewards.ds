                 	burned_bonus = if(lstpointsummapry != null && lstpointsummapry.Bonus_Points_Burned != null,lstpointsummapry.Bonus_Points_Burned,0);
                 	current_bonus = if(lstpointsummapry != null && lstpointsummapry.Bonus_Points != null,lstpointsummapry.Bonus_Points,0);
                 	// 	current_bonus = if(lstpointsummapry != null && lstpointsummapry.Bonus_Points != null,lstpointsummapry.Bonus_Points,0);
                 	// 	c_point = if(lstpointsummapry != null && lstpointsummapry.Available_Points != null,lstpointsummapry.Available_Points,0);	
                 	c_point = if(lstpointsummapry != null && lstpointsummapry.Available_Points != null,lstpointsummapry.Available_Points,0);
                 	bonus_expired = if(lstpointsummapry != null && lstpointsummapry.Bonus_Points_Expired != null,lstpointsummapry.Bonus_Points_Expired,0);
                 	current_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points != null,lstpointsummapry.Total_Points,0);
                 	points_expired_all = expired_points + bonus_expired;
                 	pv_reedeem = ifnull(burned_points,0) + ifnull(burned_bonus,0);
                 	//info points_expired_all;
                 	bonus_points_sum = ifnull(lstpointsummapry.Bonus_Points_Earned,0);
                 	// 	for each  tr in lsttransaction
                 	// 	{
                 	// 		is_bonus = (tr.Type_field != null && tr.Type_field.toString() == "Bonus") || (tr.Type_field != null && tr.Type_field.toString() == "Bonus");
                 	// 		if(is_bonus && tr.Earned_Loyalty_Points != null)
                 	// 		{
                 	// 			bonus_points_sum = bonus_points_sum + tr.Bonus_Points_earned;
                 	// 		}
                 	// 	}
                 	mapsegment = Map();
                 	mapsegment.put("earned_points",earned_points);
                 	mapsegment.put("burned_points",burned_points);
                 	mapsegment.put("current_points",current_points);
                 	mapsegment.put("expired_points",expired_points);
                 	mapsegment.put("bonus_points",earned_bonus);
                 	mapsegment.put("burned_bonus",burned_bonus);
                 	mapsegment.put("current_bonus",current_bonus);
                 	mapsegment.put("bonus_expired",bonus_expired);
                 	mapsegment.put("total_redeem",pv_reedeem);
                 	headerSection = Map();
                 	backIcon = Map();
                 	backIcon.put("img_url",thisapp.publicUrls.getlogoimages("41"));
                 	backIcon.put("report_name","Point_Analysis");
                 	backIcon.put("image_src","back_arrow.png");
                 	backIcon.put("field_name","Image");
                 	backgroundImage = Map();
                 	backgroundImage.put("img_url",thisapp.publicUrls.getlogoimages("19"));
                 	backgroundImage.put("report_name","Point_Analysis");
                 	backgroundImage.put("image_src","header_pattern.png");
                 	backgroundImage.put("field_name","Image");
                 	headerSection.put("back_icon_image",backIcon);
                 	headerSection.put("background_image",backgroundImage);
                 	headerSection.put("header_name","Point Analysis");
                 	allowedEarnTypes = List();
                 	allowedEarnTypes.add("Purchase");
                 	allowedEarnTypes.add("Birthday");
                 	allowedEarnTypes.add("Referral");
                 	allowedEarnTypes.add("Signup");
                 	earnedItems = List();
                 	bonusItems = List();
                 	currentItems = List();
                 	// Earned + Bonus
                 	redeemedItems = List();
                 	expiredItems = List();
                 	for each  trans in lsttransaction
                 	{
                 		tf = if(trans.Type_field != null,trans.Type_field.toString(),"");
                 		tsub_type = if(trans.Bonus_Type != null,trans.Bonus_Type.toString(),"");
                 		pt = if(trans.Type_field != null,trans.Type_field.toString(),"");
                 		//ponits
                 		pv = if(trans.Earned_Loyalty_Points != null,trans.Earned_Loyalty_Points,0);
                 		pv_redeemed = if(trans.Burned_Points != null,trans.Burned_Points,0);
                 		pv_expiration = if(trans.Expired_Points != null,trans.Expired_Points,0);
                 		//bonus
                 		pv_bonus = if(trans.Bonus_Points_earned != null,trans.Bonus_Points_earned,0);
                 		pv_bonus_consumed = if(trans.Bonus_Points_Burned != null,trans.Bonus_Points_Burned,0);
                 		pv_bonus_expired = if(trans.Bonus_Expiration != null,trans.Bonus_Expiration,0);
                 		pv_redeem_bonus = ifnull(trans.Bonus_Points_Burned,0);
                 		pv_redeem_points = ifnull(trans.Burned_Points,0);
                 		pv_total_redeemed = pv_redeem_bonus + pv_redeem_points;
                 		tx_id = if(trans.ID != null,trans.ID.toString(),"#");
                 		tx_date = if(trans.Transaction_Time != null,trans.Transaction_Time.toString("dd MMM yyyy"),"");
                 		expiry_date = if(trans.Transaction_Time != null,trans.BonusValidity.toString("dd MMM yyyy"),"");
                 		sign = if(pv >= 0,"+","-");
                 		_sign = "+";
                 		sign_bonus = if(pv_bonus >= 0,"+","-");
                 		sign_pv_redeemed = if(pv_redeemed >= 0,"+","-");
                 		// points 
                 		points = sign + pv.toString() + " Points";
                 		//points_redeem = "-" + pv_redeemed + " Points";
                 		points_expired = "-" + pv_expiration + " Points";
                 		//bonus
                 		points_bonus = sign_bonus + pv_bonus + " Points";
                 		bonus_expired = "-" + pv_bonus_expired + " Points";
                 		bonus_consume = "-" + pv_bonus_consumed + " Points";
                 		points_redeem = "-" + pv_total_redeemed + " Points";
                 		//expiry = "";
                 		expiry = if(trans.BonusValidity != null,trans.BonusValidity.toString("dd MMM yyyy"),"");
                 		loc = if(trans.Restaurant_Name != null,trans.Restaurant_Name.toString(),"");
                 		// --- Earned (Purchase, Birthday, Referral) ---
                 		if(allowedEarnTypes.contains(tf))
                 		{
                 			itemE = Map();
                 			itemE.put("transaction_id",tx_id);
                 			itemE.put("date",tx_date);
                 			itemE.put("points",points);
                 			itemE.put("point_type","Earned");
                 			itemE.put("expire_date",expiry);
                 			//info loc;
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemE.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemE.put("cafe_location","");
                 			}
                 			earnedItems.add(itemE);
                 			currentItems.add(itemE);
                 			// also part of current
                 		}
                 		// --- Bonus (Point_Type == Bonus OR Type_field == Bonus) ---
                 		if(pt == "Bonus" || tf == "Bonus")
                 		{
                 			itemB = Map();
                 			itemB.put("transaction_id",tx_id);
                 			itemB.put("date",tx_date);
                 			itemB.put("points",points_bonus);
                 			itemB.put("point_type","Bonus - " + tsub_type);
                 			itemB.put("expire_date",expiry);
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemB.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemB.put("cafe_location","");
                 			}
                 			bonusItems.add(itemB);
                 			currentItems.add(itemB);
                 			// also part of current
                 		}
                 		// --- Redeemed (negative points OR explicit Redeemed) ---
                 		if(pv_total_redeemed > 0 && pt == "Purchase" || tf == "Purchase")
                 		{
                 			itemR = Map();
                 			itemR.put("transaction_id",tx_id);
                 			itemR.put("date",tx_date);
                 			itemR.put("points",points_redeem);
                 			itemR.put("point_type","Redeemed");
                 			itemR.put("expire_date",expiry);
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemR.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemR.put("cafe_location","");
                 			}
                 			redeemedItems.add(itemR);
                 		}
                 		// --- Expired (Expiration) ---
                 		if(tf == "Expiration" || pt == "Expiration")
                 		{
                 			itemX = Map();
                 			itemX.put("transaction_id",tx_id);
                 			itemX.put("date",tx_date);
                 			itemX.put("points",bonus_expired);
                 			itemX.put("point_type","Expiration - " + tsub_type);
                 			itemX.put("expire_date","");
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemX.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemX.put("cafe_location","");
                 			}
                 			expiredItems.add(itemX);
                 		}
                 	}
                 	segmentsList = List();
                 	// Earned Points
                 	earned = Map();
                 	earned.put("label","Earned Points");
                 	earned.put("value",if(mapsegment.get("earned_points") != null,mapsegment.get("earned_points"),0));
                 	earned.put("color","#F1C40F");
                 	earnedSection = Map();
                 	earnedSection.put("title","Earned Points");
                 	earnedSection.put("items",earnedItems);
                 	earned.put("earned_points_section",earnedSection);
                 	segmentsList.add(earned);
                 	// Bonus Points
                 	bonus = Map();
                 	bonus.put("label","Bonus Points");
                 	bonus.put("value",ifnull(current_bonus,0));
                 	bonus.put("color","#2ECC71");
                 	bonusSection = Map();
                 	bonusSection.put("title","Bonus Points");
                 	bonusSection.put("items",bonusItems);
                 	bonus.put("bonus_points_section",bonusSection);
                 	segmentsList.add(bonus);
                 	// Current Points
                 	current = Map();
                 	current.put("label","Current Points");
                 	//info current_points;
                 	current.put("value",ifnull(current_points,0));
                 	//#3498DB
                 	current.put("color","#3498DB");
                 	currentSection = Map();
                 	currentSection.put("title","Current Points");
                 	currentSection.put("items",currentItems);
                 	current.put("current_points_section",currentSection);
                 	segmentsList.add(current);
                 	// Redeemed Points
                 	redeemed = Map();
                 	redeemed.put("label","Redeemed Points");
                 	redeemed.put("value",ifnull(pv_reedeem,0));
                 	redeemed.put("color","#E74C3C");
                 	redeemedSection = Map();
                 	redeemedSection.put("title","Redeemed Points");
                 	redeemedSection.put("items",redeemedItems);
                 	redeemed.put("redeemed_points_section",redeemedSection);
                 	segmentsList.add(redeemed);
                 	// Expired Points
                 	expired = Map();
                 	expired.put("label","Expired Points");
                 	expired.put("value",ifnull(points_expired_all,0));
                 	expired.put("color","#9B59B6");
                 	expiredSection = Map();
                 	expiredSection.put("title","Expired Points");
                 	expiredSection.put("items",expiredItems);
                 	expired.put("expired_points_section",expiredSection);
                 	segmentsList.add(expired);
                 	// ---------------------------
                 	// Chart + currency equivalent
                 	// ---------------------------
                 	chart = Map();
                 	chart.put("total_points",current_points);
                 	// Example conversion (10 pts = AED 1.00)
                 	rate = burning_thrasehold;
                 	currency_equiv_val = round(current_points / rate,2);
                 	chart.put("currency_equivalent","AED " + currency_equiv_val.toString());
                 	chart.put("segments",segmentsList);
                 	// ---------------------------
                 	// Points Overview
                 	// ---------------------------
                 	pointsOverview = Map();
                 	pointsOverview.put("chart",chart);
                 	pointsOverview.put("details_button_text","Details");
                 	// ---------------------------
                 	// Final Response
                 	// ---------------------------
                 	result = Map();
                 	result.put("header_section",headerSection);
                 	result.put("points_overview",pointsOverview);
                 	pointAnalysisResponse = Map();
                 	pointAnalysisResponse.put("result",result);
                 	pointAnalysisResponse.put("code","3000");
                 	pointAnalysisResponse.put("type","profile_8");
                 	return pointAnalysisResponse;
                 }
				 map fetchRecords.getPointAnalysisResponse_V2_test()
                 {
                 	mobileno = "+971528012943";
                 	custid = Customer[Phone_Number == mobileno];
                 	if(custid == null)
                 	{
                 		err = Map();
                 		err.put("code","404");
                 		err.put("message","Customer not found");
                 		return err;
                 	}
                 	lstorders = Cart_Order_Test[Customer.ID == custid.ID.tolong() && Type_field == "Order"];
                 	lsttransaction = Transaction[Customer.ID == custid.ID.tolong()];
                 	lstpointsummapry = Customer_Points_System[Customer.ID == custid.ID.tolong()];
                 	burning_thrasehold = Loyalty_Rules[Type_of_Rule == "Burning" && Membership_Level_System_loy_rul == lstpointsummapry.Membership_Level_System].Points_Per_threshold;
                 	typeCountMap = Map();
                 	for each  tr in lsttransaction
                 	{
                 		tf = if(tr.Type_field != null,tr.Type_field.toString(),"Unknown");
                 		if(typeCountMap.containKey(tf))
                 		{
                 			typeCountMap.put(tf,typeCountMap.get(tf) + 1);
                 		}
                 		else
                 		{
                 			typeCountMap.put(tf,1);
                 		}
                 	}
                 	typeList = List();
                 	for each  k in typeCountMap.keys()
                 	{
                 		rec = Map();
                 		rec.put("type",k);
                 		rec.put("count",typeCountMap.get(k));
                 		typeList.add(rec);
                 	}
                 	//points earn burn current
                 	earned_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points_Earned != null,lstpointsummapry.Total_Points_Earned,0);
                 	burned_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points_Burned != null,lstpointsummapry.Total_Points_Burned,0);
                 	expired_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points_Expired != null,lstpointsummapry.Total_Points_Expired,0);
                 	//bonus earn burn current
                 	earned_bonus = if(lstpointsummapry != null && lstpointsummapry.Bonus_Points_Earned != null,lstpointsummapry.Bonus_Points_Earned,0);
                 	burned_bonus = if(lstpointsummapry != null && lstpointsummapry.Bonus_Points_Burned != null,lstpointsummapry.Bonus_Points_Burned,0);
                 	current_bonus = if(lstpointsummapry != null && lstpointsummapry.Bonus_Points != null,lstpointsummapry.Bonus_Points,0);
                 	// 	current_bonus = if(lstpointsummapry != null && lstpointsummapry.Bonus_Points != null,lstpointsummapry.Bonus_Points,0);
                 	// 	c_point = if(lstpointsummapry != null && lstpointsummapry.Available_Points != null,lstpointsummapry.Available_Points,0);	
                 	c_point = if(lstpointsummapry != null && lstpointsummapry.Available_Points != null,lstpointsummapry.Available_Points,0);
                 	bonus_expired = if(lstpointsummapry != null && lstpointsummapry.Bonus_Points_Expired != null,lstpointsummapry.Bonus_Points_Expired,0);
                 	current_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points != null,lstpointsummapry.Total_Points,0);
                 	//redeem_points = if(lstpointsummapry != null && lstpointsummapry. != null,lstpointsummapry.Total_Points,0);
                 	points_expired_all = expired_points + bonus_expired;
                 	pv_reedeem = ifnull(burned_points,0) + ifnull(burned_bonus,0);
                 	//info points_expired_all;
                 	bonus_points_sum = ifnull(lstpointsummapry.Bonus_Points_Earned,0);
                 	// 	for each  tr in lsttransaction
                 	// 	{
                 	// 		is_bonus = (tr.Type_field != null && tr.Type_field.toString() == "Bonus") || (tr.Type_field != null && tr.Type_field.toString() == "Bonus");
                 	// 		if(is_bonus && tr.Earned_Loyalty_Points != null)
                 	// 		{
                 	// 			bonus_points_sum = bonus_points_sum + tr.Bonus_Points_earned;
                 	// 		}
                 	// 	}
                 	mapsegment = Map();
                 	mapsegment.put("earned_points",earned_points);
                 	mapsegment.put("burned_points",burned_points);
                 	mapsegment.put("current_points",current_points);
                 	mapsegment.put("expired_points",expired_points);
                 	mapsegment.put("bonus_points",earned_bonus);
                 	mapsegment.put("burned_bonus",burned_bonus);
                 	mapsegment.put("current_bonus",current_bonus);
                 	mapsegment.put("bonus_expired",bonus_expired);
                 	headerSection = Map();
                 	backIcon = Map();
                 	backIcon.put("img_url",thisapp.publicUrls.getlogoimages("41"));
                 	backIcon.put("report_name","Point_Analysis");
                 	backIcon.put("image_src","back_arrow.png");
                 	backIcon.put("field_name","Image");
                 	backgroundImage = Map();
                 	backgroundImage.put("img_url",thisapp.publicUrls.getlogoimages("19"));
                 	backgroundImage.put("report_name","Point_Analysis");
                 	backgroundImage.put("image_src","header_pattern.png");
                 	backgroundImage.put("field_name","Image");
                 	headerSection.put("back_icon_image",backIcon);
                 	headerSection.put("background_image",backgroundImage);
                 	headerSection.put("header_name","Point Analysis");
                 	allowedEarnTypes = List();
                 	allowedEarnTypes.add("Purchase");
                 	allowedEarnTypes.add("Birthday");
                 	allowedEarnTypes.add("Referral");
                 	allowedEarnTypes.add("Signup");
                 	earnedItems = List();
                 	bonusItems = List();
                 	currentItems = List();
                 	// Earned + Bonus
                 	redeemedItems = List();
                 	expiredItems = List();
                 	for each  trans in lsttransaction
                 	{
                 		tf = if(trans.Type_field != null,trans.Type_field.toString(),"");
                 		tsub_type = if(trans.Bonus_Type != null,trans.Bonus_Type.toString(),"");
                 		pt = if(trans.Type_field != null,trans.Type_field.toString(),"");
                 		//ponits
                 		pv = if(trans.Earned_Loyalty_Points != null,trans.Earned_Loyalty_Points,0);
                 		pv_redeemed = if(trans.Burned_Points != null,trans.Burned_Points,0);
                 		pv_expiration = if(trans.Expired_Points != null,trans.Expired_Points,0);
                 		//bonus
                 		pv_bonus = if(trans.Bonus_Points_earned != null,trans.Bonus_Points_earned,0);
                 		pv_bonus_consumed = if(trans.Bonus_Points_Burned != null,trans.Bonus_Points_Burned,0);
                 		pv_bonus_expired = if(trans.Bonus_Expiration != null,trans.Bonus_Expiration,0);
                 		pv_redeem_bonus = ifnull(trans.Bonus_Points_Burned,0);
                 		pv_redeem_points = ifnull(trans.Burned_Points,0);
                 		pv_total_redeemed = pv_redeem_bonus + pv_redeem_points;
                 		//info total_redeem_points;
                 		tx_id = if(trans.ID != null,trans.ID.toString(),"#");
                 		tx_date = if(trans.Transaction_Time != null,trans.Transaction_Time.toString("dd MMM yyyy"),"");
                 		expiry_date = if(trans.Transaction_Time != null,trans.BonusValidity.toString("dd MMM yyyy"),"");
                 		sign = if(pv >= 0,"+","-");
                 		_sign = "+";
                 		sign_bonus = if(pv_bonus >= 0,"+","-");
                 		sign_pv_redeemed = if(pv_redeemed >= 0,"+","-");
                 		// points 
                 		points = sign + pv.toString() + " Points";
                 		points_expired = "-" + pv_expiration + " Points";
                 		//bonus
                 		points_bonus = sign_bonus + pv_bonus + " Points";
                 		bonus_expired = "-" + pv_bonus_expired + " Points";
                 		bonus_consume = "-" + pv_bonus_consumed + " Points";
                 		//total_redeem_points = "-" + pv_total_redeemed + "Points";
                 		points_redeem = "-" + pv_total_redeemed + " Points";
                 		//expiry = "";
                 		expiry = if(trans.BonusValidity != null,trans.BonusValidity.toString("dd MMM yyyy"),"");
                 		loc = if(trans.Restaurant_Name != null,trans.Restaurant_Name.toString(),"");
                 		// --- Earned (Purchase, Birthday, Referral) ---
                 		if(allowedEarnTypes.contains(tf))
                 		{
                 			itemE = Map();
                 			itemE.put("transaction_id",tx_id);
                 			itemE.put("date",tx_date);
                 			itemE.put("points",points);
                 			itemE.put("point_type","Earned");
                 			itemE.put("expire_date",expiry);
                 			//info loc;
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemE.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemE.put("cafe_location","");
                 			}
                 			earnedItems.add(itemE);
                 			currentItems.add(itemE);
                 			// also part of current
                 		}
                 		// --- Bonus (Point_Type == Bonus OR Type_field == Bonus) ---
                 		if(pt == "Bonus" || tf == "Bonus")
                 		{
                 			itemB = Map();
                 			itemB.put("transaction_id",tx_id);
                 			itemB.put("date",tx_date);
                 			itemB.put("points",points_bonus);
                 			itemB.put("point_type","Bonus - " + tsub_type);
                 			itemB.put("expire_date",expiry);
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemB.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemB.put("cafe_location","");
                 			}
                 			bonusItems.add(itemB);
                 			currentItems.add(itemB);
                 			// also part of current
                 		}
                 		// --- Redeemed (negative points OR explicit Redeemed) ---
                 		if(pv_total_redeemed > 0 && pt == "Purchase" || tf == "Purchase")
                 		{
                 			itemR = Map();
                 			itemR.put("transaction_id",tx_id);
                 			itemR.put("date",tx_date);
                 			itemR.put("points",points_redeem);
                 			itemR.put("point_type","Redeemed");
                 			itemR.put("expire_date",expiry);
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemR.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemR.put("cafe_location","");
                 			}
                 			redeemedItems.add(itemR);
                 		}
                 		// --- Expired (Expiration) ---
                 		if(tf == "Expiration" || pt == "Expiration")
                 		{
                 			itemX = Map();
                 			itemX.put("transaction_id",tx_id);
                 			itemX.put("date",tx_date);
                 			itemX.put("points",bonus_expired);
                 			itemX.put("point_type","Expiration - " + tsub_type);
                 			itemX.put("expire_date","");
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemX.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemX.put("cafe_location","");
                 			}
                 			expiredItems.add(itemX);
                 		}
                 	}
                 	segmentsList = List();
                 	// Earned Points
                 	earned = Map();
                 	earned.put("label","Earned Points");
                 	earned.put("value",if(mapsegment.get("earned_points") != null,mapsegment.get("earned_points"),0));
                 	earned.put("color","#F1C40F");
                 	earnedSection = Map();
                 	earnedSection.put("title","Earned Points");
                 	earnedSection.put("items",earnedItems);
                 	earned.put("earned_points_section",earnedSection);
                 	segmentsList.add(earned);
                 	// Bonus Points
                 	bonus = Map();
                 	bonus.put("label","Bonus Points");
                 	bonus.put("value",ifnull(current_bonus,0));
                 	bonus.put("color","#2ECC71");
                 	bonusSection = Map();
                 	bonusSection.put("title","Bonus Points");
                 	bonusSection.put("items",bonusItems);
                 	bonus.put("bonus_points_section",bonusSection);
                 	segmentsList.add(bonus);
                 	// Current Points
                 	current = Map();
                 	current.put("label","Current Points");
                 	//info current_points;
                 	current.put("value",ifnull(current_points,0));
                 	//#3498DB
                 	current.put("color","#3498DB");
                 	currentSection = Map();
                 	currentSection.put("title","Current Points");
                 	currentSection.put("items",currentItems);
                 	current.put("current_points_section",currentSection);
                 	segmentsList.add(current);
                 	// Redeemed Points
                 	redeemed = Map();
                 	redeemed.put("label","Redeemed Points");
                 	redeemed.put("value",ifnull(pv_reedeem,0));
                 	redeemed.put("color","#E74C3C");
                 	redeemedSection = Map();
                 	redeemedSection.put("title","Redeemed Points");
                 	redeemedSection.put("items",redeemedItems);
                 	redeemed.put("redeemed_points_section",redeemedSection);
                 	segmentsList.add(redeemed);
                 	// Expired Points
                 	expired = Map();
                 	expired.put("label","Expired Points");
                 	expired.put("value",ifnull(points_expired_all,0));
                 	expired.put("color","#9B59B6");
                 	expiredSection = Map();
                 	expiredSection.put("title","Expired Points");
                 	expiredSection.put("items",expiredItems);
                 	expired.put("expired_points_section",expiredSection);
                 	segmentsList.add(expired);
                 	// ---------------------------
                 	// Chart + currency equivalent
                 	// ---------------------------
                 	chart = Map();
                 	chart.put("total_points",current_points);
                 	// Example conversion (10 pts = AED 1.00)
                 	rate = burning_thrasehold;
                 	currency_equiv_val = round(current_points / rate,2);
                 	chart.put("currency_equivalent","AED " + currency_equiv_val.toString());
                 	chart.put("segments",segmentsList);
                 	// ---------------------------
                 	// Points Overview
                 	// ---------------------------
                 	pointsOverview = Map();
                 	pointsOverview.put("chart",chart);
                 	pointsOverview.put("details_button_text","Details");
                 	// ---------------------------
                 	// Final Response
                 	// ---------------------------
                 	result = Map();
                 	result.put("header_section",headerSection);
                 	result.put("points_overview",pointsOverview);
                 	pointAnalysisResponse = Map();
                 	pointAnalysisResponse.put("result",result);
                 	pointAnalysisResponse.put("code","3000");
                 	pointAnalysisResponse.put("type","profile_8");
                 	return pointAnalysisResponse;
                 }
				 map fetchRecords.getPrivacyPolicyResponse()
                 {
                 	privacyPolicyResponse = Map();
                 	result = Map();
                 	// --- Fetch Localized Strings ---
                 	localappstrings = thisapp.fetchRecords.localisableAppStringsV2("0","0");
                 	terms_strings = localappstrings.get("privacy_policy_view_strings");
                 	//	info terms_strings;
                 	// --- Header Section ---
                 	headerSection = Map();
                 	backIcon = Map();
                 	backgroundImage = Map();
                 	backIcon.put("img_url","<img_url>");
                 	backIcon.put("report_name","All_Home_Overviews");
                 	backIcon.put("image_src","1724230804415_Profile.png");
                 	backIcon.put("field_name","Image");
                 	backgroundImage.put("img_url","<img_url>");
                 	backgroundImage.put("report_name","All_Home_Overviews");
                 	backgroundImage.put("image_src","1724230804415_Profile.png");
                 	backgroundImage.put("field_name","Image");
                 	headerSection.put("back_icon_image",thisapp.publicUrls.getlogoimages("41"));
                 	headerSection.put("background_image",thisapp.publicUrls.getlogoimages("29"));
                 	headerSection.put("header_name","Privacy policy");
                 	// --- Description List ---
                 	descriptionList = List();
                 	// 	termsList = fetchRecords.privacyPolicyContent();//terms_strings.get("privacy_policy");
                 	// 	info termsList;
                 	// 	// Assuming it's a List
                 	// 	for each  d in termsList
                 	// 	{
                 	// 		descriptionItem = Map();
                 	// 		descriptionItem.put("description",d);
                 	// 		descriptionList.add(descriptionItem);
                 	// 	}
                 	resp = thisapp.fetchRecords.privacyPolicyContent();
                 	termsList = resp.get("privacy_policy_view_strings").get("privacy_policy");
                 	descriptionList = List();
                 	for each  d in termsList
                 	{
                 		section = Map();
                 		section.put("heading",d.get("heading"));
                 		section.put("description",d.get("description"));
                 		// Keep points as an array of strings (no {point: ...} maps)
                 		rawPoints = if(d.containKey("points"),d.get("points"),null);
                 		if(rawPoints != null)
                 		{
                 			cleanPoints = List();
                 			for each  p in rawPoints
                 			{
                 				if(p != null && p.tostring().trim() != "")
                 				{
                 					cleanPoints.add(p.tostring());
                 				}
                 			}
                 			if(cleanPoints.size() > 0)
                 			{
                 				section.put("points",cleanPoints);
                 			}
                 		}
                 		descriptionList.add(section);
                 	}
                 	policySection = Map();
                 	policySection.put("description_list",descriptionList);
                 	// --- Assemble Final Response ---
                 	result.put("header_section",headerSection);
                 	result.put("policy_section",policySection);
                 	privacyPolicyResponse.put("result",result);
                 	privacyPolicyResponse.put("code","3000");
                 	privacyPolicyResponse.put("type","profile_9");
                 	return privacyPolicyResponse;
                 }
				 list fetchRecords.getProduct(String type, Customer customer)
                 {
                 	/* 	if(type == "targetItem")
                                  	{
                                  		targetCategory = thisapp.loyaltyEngine.getCustomerOrientedRedemptionList(customer,Customer_Points_System[Customer == customer.ID].Available_Points);
                                  		if(targetCategory.size() > 0)
                                  		{
                                  			categoryIds = List();
                                  			redeemableCategories = targetCategory.get(0).get("redeemable_categories");
                                  			for each  categoryId in redeemableCategories
                                  			{
                                  				categoryIds.add(categoryId.get("category_id"));
                                  			}
                                  			getProduct = Add_Product[Category in categoryIds && Image != "" && Status == "Active"];
                                  		}
                                  		else
                                  		{
                                  			getProduct = Add_Product[Image != "" && Status == "Active"] range from 1 to 5;
                                  		}
                                  		info getProduct;
                                  	} */
                 	try 
                 	{
                 		if(type == "menuList")
                 		{
                 			//Menu List For Home based on the Sequence Priority
                 			getProduct = Add_Product[Category != null && Home_Screen_Sequence_Priority != null && Category.Status == "Active" && Status == "Active" && Market == customer.Country] sort by Home_Screen_Sequence_Priority asc;
                 		}
                 		else if(type = "gestUserDetailMenu")
                 		{
                 			getProduct = Add_Product[Category != null && Home_Screen_Sequence_Priority != null && Category.Status == "Active" && Status == "Active"] sort by Home_Screen_Sequence_Priority asc;
                 		}
                 		else if(type == "customMainMenu")
                 		{
                 			getProduct = Add_Product[Category.Status == "Active" && Category.Status == "Active"] sort by Display_Sequence_Priority asc;
                 		}
                 		else if(type == "freeDrink")
                 		{
                 			//Free Drink
                 			rule = Joining_Rules[Market == customer.Country && Mark_as_Active && Joining_Benefit in {"Joining Drink","Both"}];
                 			availableProducts = rule.Product.getall();
                 			getProduct = Add_Product[ID in availableProducts && Category != null && Category.Category_Name != "Free Products" && Category.Status == "Active" && Status == "Active" && Market == customer.Country] sort by Display_Sequence_Priority asc;
                 		}
                 		else
                 		{
                 			// View All - Product List
                 			getProduct = Add_Product[Category != null && Category.Status == "Active" && Status == "Active" && Market == customer.Country] sort by Display_Sequence_Priority asc;
                 		}
                 		if(getProduct.count() > 0)
                 		{
                 			productList = List();
                 			for each  product in getProduct
                 			{
                 				imageSrc = thisapp.fileManagement.processImageUrl(product.Image);
                 				productDetail = Map();
                 				categoryDetail = Map();
                 				productDetail.put("market",product.Market);
                 				productDetail.put("category",categoryDetail);
                 				categoryDetail.put("name",product.Category.Category_Name);
                 				categoryDetail.put("id",product.Category.toString());
                 				categoryDetail.put("priority_index",product.Category.Display_Sequence_Priority);
                 				productDetail.put("id",product.ID.toString());
                 				productDetail.put("name",product.Product_Name);
                 				productImage = Map();
                 				productDetail.put("image",productImage);
                 				productImage.put("report_name","All_Products");
                 				productImage.put("field_name","Image");
                 				productImage.put("image_src",imageSrc);
                 				productImage.put("temp_img_src",thisapp.publicUrls.product(product.ID,imageSrc));
                 				priceList = List();
                 				productDetail.put("price",product.Price);
                 				productList.add(productDetail);
                 			}
                 			return productList;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getProduct",e);
                 	}
                 	return null;
                 }
