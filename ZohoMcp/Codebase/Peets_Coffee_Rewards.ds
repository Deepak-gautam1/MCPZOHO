				 map membershipdetail.getLstMembership(string custmobileno)
                 {
                 	result = Map();
                 	cust_dtl = Customer[Phone_Number == custmobileno];
                 	//cust_membership = Customer_Points_System[Customer.Phone_Number == custmobileno].Old_Membership_Level;
                 	cust_membership = Customer_Points_System[Customer.Phone_Number == custmobileno].Membership_Level_System.Membership_Level;
                 	cust_membership_id = Customer_Points_System[Customer.Phone_Number == custmobileno];
                 	cust_points_detail = Customer_Points_System[Customer.Phone_Number = custmobileno];
                 	memberships_list = list();
                 	all_memberships = Membership_Details_H[ID != 0];
                 	for each  membership_rec in all_memberships
                 	{
                 		dtlmembership = Map();
                 		ismembership = false;
                 		msgcaption = "";
                 		points_text = "";
                 		mem_tirefrom = null;
                 		mem_tireto = null;
                 		above = null;
                 		if(membership_rec.Membership_Tier.Membership_Level == cust_membership)
                 		{
                 			ismembership = true;
                 			msgcaption = "Current";
                 		}
                 		mem_tirefrom = Membership_Points_System[ID == membership_rec.Membership_Tier.ID].From;
                 		mem_tireto = Membership_Points_System[ID == membership_rec.Membership_Tier.ID].To;
                 		if(mem_tirefrom == null && mem_tireto == null)
                 		{
                 			above = Membership_Points_System[ID == membership_rec.Membership_Tier.ID].Above;
                 			points_text = above.toString() + " + Points";
                 		}
                 		else
                 		{
                 			points_text = mem_tirefrom.toString() + " - " + mem_tireto.toString() + " Points";
                 		}
                 		dtlmembership.put("ID",membership_rec.ID.toString());
                 		dtlmembership.put("ismember",ismembership);
                 		dtlmembership.put("membership",membership_rec.Membership_Tier.Membership_Level);
                 		dtlmembership.put("report_name","Membership_Details_H_Report");
                 		dtlmembership.put("field_name","Image");
                 		dtlmembership.put("img_src",thisapp.fileManagement.processImageUrl(membership_rec.Icon));
                 		dtlmembership.put("temp_img_src","");
                 		dtlmembership.put("image_id",membership_rec.ID.toString());
                 		dtlmembership.put("msgcaption",msgcaption);
                 		dtlmembership.put("points",points_text);
                 		dtlmembership.put("desc_subheading",membership_rec.Sub_Heading);
                 		earningpoints_list = list();
                 		for each  earningpoints in membership_rec.Bullet_points
                 		{
                 			earningpoint = Map();
                 			earningpoint.put("bullet_point_id",earningpoints.ID.toString());
                 			earningpoint.put("bullet_point_type",earningpoints.Description_Type);
                 			earningpoint.put("bullet_point_caption",earningpoints.Earning_Rules);
                 			earningpoints_list.add(earningpoint);
                 		}
                 		dtlmembership.put("earn_rule_points",earningpoints_list);
                 		memberships_list.add(dtlmembership);
                 	}
                 	result.put("customer_info",thisapp.customerProfile.getCustomerInfo(custmobileno));
                 	result.put("memberships",memberships_list);
                 	return result;
                 }
