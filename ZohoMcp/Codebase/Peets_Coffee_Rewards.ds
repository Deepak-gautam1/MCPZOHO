				 map apppagesmetrialdisplay.commetmentcraftpage()
                 {
                 	pagemetrial = Map();
                 	lsthome_page = List();
                 	header = Map();
                 	header.put("back_icon",thisapp.publicUrls.getlogoimages("41"));
                 	lsthomeitems = Home_Footer_H[ID != 0] sort by Display_Priority_Sequence asc;
                 	for each  item in lsthomeitems
                 	{
                 		homepgitems = Map();
                 		homepgitems.put("ID",item.ID);
                 		// 		homepgitems.put("Market",item.Market);
                 		homepgitems.put("Market",item.Market_Global);
                 		homepgitems.put("Learn_More",item.Learn_More);
                 		homepgitems.put("Sequence",item.Display_Priority_Sequence);
                 		homepgitems.put("Description",item.Description);
                 		homepgitems.put("Heading",item.Heading);
                 		homepgitems.put("Active",item.Active);
                 		// Image processing
                 		lstimage = List();
                 		for each  homepageslider in item.Images
                 		{
                 			imageDataHome = Map();
                 			imageDataHome.put("report_name","Home_Footer_H_Report");
                 			imageDataHome.put("field_name","Home_Footer_H_Report.Images.Image");
                 			imageDataHome.put("image_src",thisapp.publicUrls.gethomepagefooterimage(item.ID.tostring()));
                 			lstimage.add(imageDataHome);
                 		}
                 		homepgitems.put("image_home",lstimage);
                 		lsthome_page.add(homepgitems);
                 	}
                 	// Sort by Display_Priority_Sequence
                 	//lsthome_page_sorted = thisapp.apppagesmetrialdisplay.sortListByNumericField(lsthome_page,"Sequence");
                 	// Return result
                 	//pagemetrial.put("pageitemlist",lsthome_page_sorted);
                 	pagemetrial.put("header",header);
                 	pagemetrial.put("pageitemlist",lsthome_page);
                 	return pagemetrial;
                 }
				 list apppagesmetrialdisplay.sortListByField(list recordList, string fieldName)
                 {
                 	// Step 1: Setup helper collections
                 	keyList = List();
                 	// To store sorting keys
                 	keyToRecord = Map();
                 	// Key => Record map
                 	sortedList = List();
                 	// Final sorted records
                 	// Step 2: Build sorting keys
                 	for each  item in recordList
                 	{
                 		sortValue = ifnull(item.get(fieldName),9999).toString();
                 		// use .toString() for uniformity
                 		uniqueKey = sortValue + "-" + item.get("ID").toString();
                 		// ensure uniqueness
                 		keyList.add(uniqueKey);
                 		keyToRecord.put(uniqueKey,item);
                 	}
                 	// Step 3: Sort the keys alphabetically (acts as ascending numeric if padded properly)
                 	sortedKeys = keyList.sort(true);
                 	// true = ascending
                 	// Step 4: Build sorted list
                 	for each  key in sortedKeys
                 	{
                 		sortedList.add(keyToRecord.get(key));
                 	}
                 	return sortedList;
                 }
				 list apppagesmetrialdisplay.sortListByNumericField(list itemTypeList, string fieldName)
                 {
                 	listSize = itemTypeList.size();
                 	if(listSize > 1)
                 	{
                 		for each  index1 in itemTypeList
                 		{
                 			for each  index2 in itemTypeList
                 			{
                 				priority1 = index1.get(fieldName).toNumber();
                 				priority2 = index2.get(fieldName).toNumber();
                 				if(priority1 < priority2)
                 				{
                 					temp = index1;
                 					index1.putAll(index2);
                 					index2.putAll(temp);
                 				}
                 			}
                 		}
                 	}
                 	return itemTypeList;
                 }
				 map appspages.getaboutus()
                 {
                 	// Fetch localizable app strings
                 	objlocalappstring = thisapp.fetchRecords.localisableAppStringsV2("0","0");
                 	// Extract about_peets_coffee_strings map
                 	about_strings = objlocalappstring.get("about_peets_coffee_strings");
                 	if(about_strings == null)
                 	{
                 		about_strings = Map();
                 	}
                 	// Initialize root map
                 	responseMap = Map();
                 	resultMap = Map();
                 	// --- Header Section ---
                 	headerSection = Map();
                 	backIcon = Map();
                 	backgroundImage = Map();
                 	backIcon.put("img_url","<img_url>");
                 	backIcon.put("report_name","All_Home_Overviews");
                 	backIcon.put("image_src","1724230804415_Profile.png");
                 	backIcon.put("field_name","Image");
                 	backgroundImage.put("img_url","<img_url>");
                 	backgroundImage.put("report_name","All_Home_Overviews");
                 	backgroundImage.put("image_src","1724230804415_Profile.png");
