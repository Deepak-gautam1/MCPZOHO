                 										customerLoysltyPointSystem.Transaction=transactionEarned;*/
                 									}
                 								}
                 								else if(freeDrink.get("type").toLong() == 2)
                 								{
                 									burnedPoints = 1500;
                 									thisapp.loyaltyEngine.updateRemainingPointsInTransaction_V2(customer.ID,transactionEarned.tolong(),burnedPoints);
                 								}
                 							}
                 						}
                 						getTransaction = Transaction[ID == transactionEarned.tolong()];
                 						/*getTransaction.Available_Points=customerLoysltyPointSystem.Available_Points + receivedPoints - burnedPoints;
                 						getTransaction.Burned_Points=burnedPoints;
                 						getTransaction.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned + receivedPoints;
                 						getTransaction.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned + burnedPoints;*/
                 						itemList = loyaltyDtails.get("items");
                 						for each  purchasedItem in itemList
                 						{
                 							product = Add_Product[ID_Link == purchasedItem.get("product_id")];
                 							if(purchasedItem.containKey("applied_offer") && purchasedItem.get("applied_offer") != null)
                 							{
                 								offerData = purchasedItem.get("applied_offer");
                 								if(offerData.get("is_applied"))
                 								{
                 									offerAppliedID = offerData.get("offer_id").toLong();
                 								}
                 								else
                 								{
                 									offerAppliedID = null;
                 								}
                 							}
                 							else
                 							{
                 								offerAppliedID = null;
                 							}
                 							lineItems = insert into Order_Line_Items
                 							[
                 								Added_User=zoho.loginuser
                 								Transaction_ID=transactionEarned
                 								Product=product.ID
                 								Qty=purchasedItem.get("quantity")
                 								Discount=purchasedItem.get("discount_amount")
                 								Price=purchasedItem.get("price").toDecimal()
                 								Total=purchasedItem.get("net_total").toDecimal()
                 								Applied_Offers=offerAppliedID
                 							];
                 						}
                 					}
                 					/*	customerLoysltyPointSystem.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned + receivedPoints;
                 					customerLoysltyPointSystem.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned + burnedPoints;
                 					customerLoysltyPointSystem.Available_Points=customerLoysltyPointSystem.Available_Points + receivedPoints - burnedPoints;*/
                 					// added by om on 27/oct/2025  to upgrade and downgrade membership
                 					// 				if(customerLoysltyPointSystem.Total_Points_Burned > 6000)
                 					// 				{
                 					// 				    id = Membership_Points_System[Membership_Level="Platinum"].ID;
                 					// 					customerLoysltyPointSystem.Membership_Level_System=id;
                 					// 				}
                 					// 				else if(customerLoysltyPointSystem.Total_Points_Burned > 3000)
                 					// 				{
                 					// 					id = Membership_Points_System[Membership_Level="Gold"].ID;
                 					// 					customerLoysltyPointSystem.Membership_Level_System=id;
                 					// 				}
                 					// 				else
                 					// 				{
                 					// 					id = Membership_Points_System[Membership_Level="Silver"].ID;
                 					// 					customerLoysltyPointSystem.Membership_Level_System=id;
                 					// 				}
                 					thisapp.loyaltyEngine.updateMembershipLevelv2(customer.Phone_Number);
                 					return thisapp.loyaltyEngine.getLoyaltyData_V2(customer,customerLoysltyPointSystem,getTransaction);
                 				}
                 				else
                 				{
                 					return {"message":"Order id already exists","is_approved":false};
                 				}
                 			}
                 			// 			return Map();
                 		}
                 		return {"message":"Flag not approved","is_approved":false};
                 	}
                 	catch (e)
                 	{
                 		info e.tostring();
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.updateLoyaltyPoints",e);
                 	}
                 	return null;
                 }
				 map loyaltyEngine.updateMembershipLevel(String loginUserNumber)
                 {
                 	loyaltyDetails = Customer_Points_System[Customer.Phone_Number == loginUserNumber];
                 	info loyaltyDetails;
                 	if(loyaltyDetails.count() > 0)
                 	{
                 		//currentLevel = loyaltyDetails.Old_Membership_Level;
                 		currentLevel = loyaltyDetails.Membership_Level_System;
                 		info currentLevel;
                 		if(currentLevel.Membership_Level == "Silver" && loyaltyDetails.Available_Points > 2999)
                 		{
                 			//	loyaltyDetails.Old_Membership_Level="Gold";
                 			membershiplevel = Membership_Points_System[Membership_Level == "Gold"];
                 			loyaltyDetails.Membership_Level_System=membershiplevel;
                 		}
                 		else if(currentLevel.Membership_Level == "Gold" && loyaltyDetails.Available_Points > 5999)
                 		{
                 			//	loyaltyDetails.Old_Membership_Level="Platinum";
                 			membershiplevel = Membership_Points_System[Membership_Level == "Platinum"];
                 			loyaltyDetails.Membership_Level_System=membershiplevel;
                 		}
                 		//return {"request_status":"success","current_level":loyaltyDetails.Old_Membership_Level};
                 		return {"request_status":"success","current_level":loyaltyDetails.Membership_Level_System};
                 	}
                 	return {"request_status":"failed"};
                 }
				 map loyaltyEngine.updateMembershipLevelv2(String loginUserNumber)
                 {
                 	//loginUserNumber = "+971555534010";
                 	currentDate = zoho.currenttime.toDate();
                 	startDate = currentDate.addDay(-180).toDate();
                 	c_id = Customer[Phone_Number == loginUserNumber];
                 	transactions = Transaction[Customer.ID == c_id.ID && Type_field == "Purchase" && Transaction_Time >= startDate];
                 	totalEarnPoints = 0.0;
                 	for each  rec in transactions
                 	{
                 		if(rec.Earned_Loyalty_Points != null)
                 		{
                 			totalEarnPoints = totalEarnPoints + rec.Earned_Loyalty_Points;
                 		}
                 	}
                 	//info totalEarnPoints;
                 	//totalEarnPoints =15000;
                 	loyaltyDetails = Customer_Points_System[Customer.Phone_Number == loginUserNumber];
                 	if(loyaltyDetails.count() > 0)
                 	{
                 		currentLevel = Membership_Points_System[ID = loyaltyDetails.Membership_Level_System].Membership_Level;
                 		platinum_range = Membership_Points_System[Membership_Level == "Platinum"].Above;
                 		gold_range = Membership_Points_System[Membership_Level == "Gold"].From;
                 		silver = Membership_Points_System[Membership_Level == "Silver"].From;
                 		// 		info platinum_range;
                 		// 		info gold_range;
                 		// 		info silver;
                 		//ifnull(loyaltyDetails, "Silver");
                 		newLevel = "";
                 		if(totalEarnPoints >= platinum_range)
                 		{
                 			newLevel = "Platinum";
                 		}
                 		else if(totalEarnPoints >= gold_range)
                 		{
                 			newLevel = "Gold";
                 		}
                 		else
                 		{
                 			newLevel = "Silver";
                 		}
                 		if(currentLevel != newLevel)
                 		{
                 			id = Membership_Points_System[Membership_Level = newLevel].ID;
                 			loyaltyDetails.Membership_Level_System=id;
                 		}
                 		return {"request_status":"success","phone_number":loginUserNumber,"current_level":currentLevel,"new_level":newLevel,"points_considered":totalEarnPoints};
                 	}
                 	else
                 	{
                 		return {"request_status":"failed","reason":"No loyalty record found"};
                 	}
                 }
				 map loyaltyEngine.updateOrderStatus(string data)
                 {
                 	response = Map();
                 	try 
                 	{
                 		//order_data = {"requestParam":{"bsp_order_id":"","mobile_order_id":"4661594000013150485","type":"1"}};
                 		response.put("is_done",false);
                 		response.put("mobile_no","");
                 		response.put("email","");
                 		response.put("current_status","");
                 		response.put("mobile_order_id","");
                 		response.put("bsp_order_id","");
                 		// Uncomment if data is coming dynamically
                 		order_data = data.toMap();
                 		//params = order_data.get("requestParam");
                 		params = order_data;
                 		// order_data.get("requestParam");
                 		bsp_order_id = params.get("bsp_order_id");
                 		mobile_order_id = params.get("mobile_order_id");
                 		Ready_to_pickup_time = params.get("ready_to_pickup_on");
                 		Order_Deleverd_Job_time = params.get("order_completed_on");
                 		type = params.get("type");
                 		order_status = Cart_Status[Status_ID == type].ID;
                 		order_detail = Cart_Order_Test[ID == mobile_order_id.toLong()];
                 		if(order_detail.count() > 0)
                 		{
                 			for each  rec in order_detail
                 			{
                 				rec.Cart_Status=order_status;
                 				rec.Ready_to_pickup_time=Ready_to_pickup_time;
                 				rec.Order=Order_Deleverd_Job_time;
                 				rec.Pos_orderid=bsp_order_id;
                 				rec.Pos_Message="Order sent to kitchen";
                 				response.put("is_done",true);
                 				response.put("mobile_no",rec.Customer.Phone_Number.toString());
                 				response.put("email",rec.Customer.Email);
                 				response.put("current_status",rec.Cart_Status.Status);
                 				response.put("mobile_order_id",rec.ID.toString());
                 				response.put("bsp_order_id",rec.Pos_orderid.toString());
                 			}
                 		}
                 		else
                 		{
                 			response.put("error","No matching order found for ID: " + mobile_order_id);
                 		}
                 	}
                 	catch (e)
                 	{
                 		response.put("is_done",false);
                 		response.put("error","Exception: " + e.toString());
                 	}
                 	return response;
                 }
				 void loyaltyEngine.updateRemainingPointsInTransaction(int customerID, int transactionID, int burnedPoints)
                 {
                 	if(burnedPoints > 0)
                 	{
                 		transaction = Transaction[Status in {"Not Utilized","Partially Utilized"} && Customer == customerID] sort by Transaction_Time asc;
                 		retrivedPoints = 0;
                 		for each  thisRecord in transaction
                 		{
                 			if(retrivedPoints <= burnedPoints)
                 			{
                 				thisTransactionPoints = thisRecord.Remaining_Points;
                 				retrivedPoints = retrivedPoints + thisTransactionPoints;
                 				thisRecord.Transaction_Used_For=transactionID;
                 				if(retrivedPoints >= burnedPoints)
                 				{
                 					if(retrivedPoints > burnedPoints)
                 					{
                 						remainingPoints = retrivedPoints - burnedPoints;
                 						thisRecord.Remaining_Points=remainingPoints;
                 						lastUtilisedPoints = thisRecord.Utilized_Points;
                 						thisRecord.Utilized_Points=thisRecord.Earned_Loyalty_Points - remainingPoints;
                 						thisRecord.Last_Used_Points=thisRecord.Utilized_Points - lastUtilisedPoints;
                 						thisRecord.Status="Partially Utilized";
                 					}
                 					else
                 					{
                 						thisRecord.Status="Utilized";
                 						thisRecord.Utilized_Points=thisRecord.Utilized_Points + thisRecord.Remaining_Points;
                 						thisRecord.Remaining_Points=0;
                 						thisRecord.Last_Used_Points=thisTransactionPoints;
                 					}
                 					break;
                 				}
                 				else
                 				{
                 					thisRecord.Status="Utilized";
                 				}
                 				thisRecord.Utilized_Points=thisRecord.Utilized_Points + thisRecord.Remaining_Points;
                 				thisRecord.Remaining_Points=0;
                 				thisRecord.Last_Used_Points=thisTransactionPoints;
                 			}
                 		}
                 	}
                 }
