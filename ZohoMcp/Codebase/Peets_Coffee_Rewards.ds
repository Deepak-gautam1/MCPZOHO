				 void loyaltyEngine.ExpirePoints(string customerid)
                 {
                 	//mobileno = "+971522917760";
                 	customer = Customer[ID == customerid.tolong()];
                 	customerId = customer.ID;
                 	// 	info customer.Name;
                 	nowDT = zoho.currenttime;
                 	customerLoysltyPointSystem = Customer_Points_System[Customer == customerId];
                 	for each  b in Transaction[Customer == customerId && Type_field == "Bonus" && BonusValidity < nowDT && Remaining_Bonus_Points > 0] sort by BonusValidity asc
                 	{
                 		info b.Bonus_Type;
                 		totalExpired = 0;
                 		// 		for each  t in Transaction[Customer == customerId] sort by Transaction_Time desc range from 0 to 0
                 		// 		{
                 		// 			previousBonus = t.Bonus_Available;
                 		// 			previousAvailable = t.Available_Points;
                 		// 			previousTotal = previousBonus + previousAvailable;
                 		// 			break;
                 		// 		}
                 		previousBonus = Customer_Points_System[Customer == customer.ID].Bonus_Points;
                 		previousAvailable = Customer_Points_System[Customer == customer.ID].Available_Points;
                 		previousTotal = previousBonus + previousAvailable;
                 		expiredPts = b.Remaining_Bonus_Points;
                 		if(expiredPts > 0)
                 		{
                 			trasactionExpired = insert into Transaction
                 			[
                 				Market_Global_txn=customer.Market_Global
                 				Customer=customerId
                 				Transaction_Time=nowDT
                 				Type_field="Expiration"
                 				Bonus_Type=b.Bonus_Type
                 				BonusValidity=b.BonusValidity
                 				Bonus_Points_earned=0
                 				Bonus_Points_Burned=0
                 				Bonus_Expiration=expiredPts
                 				Bonus_Available=previousBonus - expiredPts
                 				Remaining_Bonus_Points=0
                 				Available_Points=customerLoysltyPointSystem.Available_Points.toLong()
                 				Previous_Total_Bonus_Available=previousTotal
                 				Added_User=zoho.loginuser
                 			];
                 			totalExpired = totalExpired + expiredPts;
                 			b.Remaining_Bonus_Points=0;
                 		}
                 		customerLoysltyPointSystem.Bonus_Points_Expired=ifnull(customerLoysltyPointSystem.Bonus_Points_Expired,0) + totalExpired;
                 	}
                 }
				 map loyaltyEngine.getAvailableFreeDrinks(Customer customer, Customer_Points_System loyaltyData)
                 {
                 	freeDrinksData = Map();
                 	try 
                 	{
                 		if(loyaltyData.Is_Free_drink_available || loyaltyData.Available_Points >= 1500)
                 		{
                 			freeDrinksData.put("is_available",true);
                 			if(loyaltyData.Is_Free_drink_available)
                 			{
                 				type = 1;
                 				joiningRules = Joining_Rules[Market == customer.Country && Mark_as_Active && Joining_Benefit in {"Joining Drink","Both"}];
                 			}
                 			else if(loyaltyData.Available_Points >= 1500)
                 			{
                 				joiningRules = Joining_Rules[Market == customer.Country && Mark_as_Active && Joining_Benefit in {"Free Product / Drink","Both"}];
                 				type = 2;
                 			}
                 			freeDrinks = List();
                 			freeDrinksData.put("available_drinks",freeDrinks);
                 			for each  rule in joiningRules
                 			{
                 				drink = Map();
                 				drink.put("product_name",rule.Product.Product_Name);
                 				drink.put("product_id",rule.Product.ID_Link);
                 				drink.put("description",rule.Product.Description);
                 				drink.put("price",rule.Product.Price);
                 				drink.put("type",type);
                 				freeDrinks.add(drink);
                 			}
                 			return freeDrinksData;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.getAvailableFreeDrinks",e);
                 	}
                 	freeDrinksData.put("is_available",false);
                 	freeDrinksData.put("available_drinks",null);
                 	return freeDrinksData;
                 }
