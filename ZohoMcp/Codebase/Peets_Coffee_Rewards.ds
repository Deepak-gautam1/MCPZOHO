                 			order_data.put("order_type","Purchase");
                 			order_data.put("pickup_option",peets_restaurant_management.facilitymanagement.getfacilitybyid(lstorder.Method_of_Ordering));
                 			order_data.put("pickup_time",lstorder.Pickup_Datetime.tostring());
                 			// Amounts (ensure numbers, not strings)
                 			order_data.put("total_purchase_amount",ifnull(lstorder.Sub_Total,0).toDecimal());
                 			coupon_discount = ifnull(lstorder.Payment_Coupon_Discount_s,0).toDecimal();
                 			redeem_discount = ifnull(lstorder.Point_Redeem_Value,0).toDecimal();
                 			total_discount = coupon_discount + redeem_discount;
                 			order_data.put("total_discount_amount",total_discount);
                 			order_data.put("total_invoice_amount",ifnull(lstorder.Total_Amount_s,0).toDecimal());
                 			payment_data.put("payment_source",ifnull(lstorder.Tender_Type,"").tostring());
                 			payment_data.put("payment_ref_id",ifnull(lstorder.Merchant_Order_Ref,"").tostring());
                 			payment_data.put("order_detail_id",ifnull(lstorder.Order_Detail_ID,"").tostring());
                 			// Ordered items
                 			ordered_items = List();
                 			for each  item in lstorderitems
                 			{
                 				item1 = Map();
                 				size = item.Product_Size;
                 				link_id = copy_of_product_catalogue.productManagement.getlinkidbasedonsizendid(item.Product_lookup_items,size);
                 				item1.put("product_name",copy_of_product_catalogue.productManagement.getproductnamebyid(item.Product_lookup_items));
                 				//item1.put("product_id",item.Product_lookup_items.toString());
                 				item1.put("product_id",link_id.toString());
                 				// ensure numeric types
                 				item1.put("price",ifnull(item.Product_Price,0).toDecimal());
                 				item1.put("quantity",ifnull(item.Quantity,0).toDecimal());
                 				item1.put("total_amount",ifnull(item.Total_Item_Price,0).toDecimal());
                 				item1.put("notes",lstorder.Order_notes.tostring());
                 				// Modifiers -> values
                 				modifiers_list = List();
                 				lstmodifiers = item.Modifiers_Subform;
                 				// map: typeName -> List of value-maps
                 				modsByType = Map();
                 				// to preserve order of types as encountered
                 				typeOrder = List();
                 				for each  mod in lstmodifiers
                 				{
                 					mod_linkid = copy_of_product_catalogue.modifiersManagement.getmodifierlinkidbysizeandid(mod.Modifiers_order,mod.Modifier_Size.toString());
                 					typeName = ifnull(copy_of_product_catalogue.modifiers.getmodifierstypenamebyid(mod.Modifier_Type_order),"");
                 					valName = ifnull(copy_of_product_catalogue.modifiers.getmodifiersnamebyid(mod.Modifiers_order),"");
                 					valId = mod.Modifiers_order;
                 					l_id = mod_linkid;
                 					valQty = ifnull(mod.Modifier_Qty,0).toDecimal();
                 					// start list if first time we see this type
                 					existing = modsByType.get(typeName);
                 					if(existing == null)
                 					{
                 						existing = List();
                 						modsByType.put(typeName,existing);
                 						typeOrder.add(typeName);
                 						// remember order
                 					}
                 					valMap = Map();
                 					valMap.put("name",valName);
                 					//valMap.put("id",valId.toString());
                 					valMap.put("id",l_id.toString());
                 					valMap.put("qty",valQty);
                 					existing.add(valMap);
                 				}
                 				for each  t in typeOrder
                 				{
                 					entry = Map();
                 					entry.put("type",t);
                 					entry.put("values",modsByType.get(t));
                 					modifiers_list.add(entry);
                 				}
                 				// Add-Ons (keep keys; ensure numeric qty; safely handle empty)
                 				lstaddones = item.Add_ones;
                 				// your subform for add-ons
                 				if(lstaddones != null && lstaddones.count() > 0)
                 				{
                 					addon_map = Map();
                 					addon_map.put("type","Add-Ons");
                 					addon_map.put("id","9033228821218947");
                 					values_list = List();
                 					for each  addone in lstaddones
                 					{
                 						val = Map();
                 						val.put("name",copy_of_product_catalogue.addonesdetail.getaddonesnamebyid(addone.Addons_order));
                 						val.put("id",copy_of_product_catalogue.addonesdetail.getaddoneslinkidbyid(addone.Addons_order));
                 						val.put("qty",ifnull(addone.Addones_Selected_qty,0).toDecimal());
                 						values_list.add(val);
                 					}
                 					addon_map.put("values",values_list);
                 					modifiers_list.add(addon_map);
                 				}
                 				item1.put("modifiers",modifiers_list);
                 				ordered_items.add(item1);
                 			}
                 			order_data.put("ordered_items",ordered_items);
                 			order_data.put("payment",payment_data);
                 			order_data.put("curb_details",car_details);
                 			//	info order_data;
                 			responce = thisapp.azurefunction.azurepostfunction(order_data);
                 			//info responce;
                 			//	responce = null;
                 			resp_map = responce.toMap();
                 			// ---- Top-level ----
                 			code = resp_map.get("code");
                 			status = resp_map.get("status");
                 			message = resp_map.get("message");
                 			// ---- Data ----
                 			data_map = resp_map.get("data");
                 			mobile_order_id = data_map.get("mobile_order_id");
                 			bsP_order_id = data_map.get("bsP_order_id");
                 			ordertest_res = Cart_Order_Test[ID == mobile_order_id];
                 			ordertest_res.Pos_resp=responce.toString();
                 			ordertest_res.Pos_Message=message;
                 			if(status == "SUCCESS" || status == "PENDING" && code == "3000" || code == "2000")
                 			{
                 				ordertest = Cart_Order_Test[ID == mobile_order_id];
                 				ordertest.Pos_orderid=bsP_order_id;
                 				ordertest.Payment_Status="done";
                 				//ordertest.Cart_Status ="Order Placed";
                 				// ordertest.Type_field = "Order";
                 			}
                 			else
                 			{
                 				//ordertest_failed = Cart_Order_Test[ID == mobile_order_id];
                 				//ordertest_failed.Type_field="Cart";
                 			}
                 			//orderconfirmationresp = thisapp.fetchRecords.getOrderConfirmation(mobile_order_id,bsP_order_id);
                 			//orderconfirmationresp = null;
                 			//result.put("result",orderconfirmationresp);
                 			// added to test the bsp response
                 			result.put("result",responce);
                 		}
                 		else
                 		{
                 			//throws "Not a valid order";
                 			result.put("result","Not a valid Restaurant");
                 			thisapp.ErrorHandling.catchCall("send order to pos","Not a valid Restaurant ");
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("send order to pos",e.tostring());
                 	}
                 	return result;
                 }
