                 	store_overview.put("id",store_id.tostring());
                 	store_overview.put("location_name",address.tostring());
                 	store_overview.put("location_icon",location_icon);
                 	store_overview.put("review_value",star_rating.tostring());
                 	store_overview.put("review_count",review_count);
                 	store_overview.put("phone",phone.tostring());
                 	store_overview.put("phone_icon",phone_icon);
                 	store_overview.put("direction_text","Get directions");
                 	store_overview.put("direction_icon",direction_icon);
                 	store_overview.put("duration",duration);
                 	store_overview.put("destination",destination);
                 	store_overview.put("operating_status",operating_status);
                 	store_overview.put("is_open",is_open);
                 	store_overview.put("latitude",latitude);
                 	store_overview.put("longitude",longitude);
                 	store_location_section_map.put("store_overview",store_overview);
                 	// Add to sections list
                 	sections_list.add(order_items_section_map);
                 	//sections_list.add(store_location_section_map);
                 	order_summary_section.put("sections",sections_list);
                 	// --- Payment Details ---
                 	order_amount = lstorder.Total_Amount_s;
                 	payment_details = {"label":"Payment Details","method":"Credit/Debit Card","amount ":order_amount};
                 	//order_summary_section.put("payment_details",payment_details);
                 	// --- Order Info ---
                 	order_info = Map();
                 	order_info.put("order_number_text","Order Number");
                 	order_info.put("order_number",lstorder.ID.tostring());
                 	order_info.put("BSP_order_number",lstorder.Pos_orderid.tostring());
                 	order_info.put("item_total_text","Item Total");
                 	order_info.put("order_currency",lstorder.Order_Currency);
                 	order_info.put("item_total",lstorder.Sub_Total);
                 	//order_info.put("peets_points_text","Peet's Points");
                 	order_info.put("peets_points","+323 Points");
                 	//order_info.put("grand_total_text","Grand Total");
                 	order_info.put("Coupon_Discount",lstorder.Payment_Coupon_Discount_s);
                 	order_info.put("Coupon_id",lstorder.Discount_Coupons.tostring());
                 	order_info.put("Coupon_name",lstorder.Discount_Coupons.PROMO_CODE);
                 	order_info.put("order_notes",lstorder.Order_notes);
                 	order_info.put("order_rate",lstorder.Order_Rating.tostring());
                 	order_info.put("total",order_amount);
                 	order_info.put("vat",lstorder.Vat_s);
                 	isvat = false;
                 	if(lstorder.Vat_s != "")
                 	{
                 		isvat = true;
                 	}
                 	order_info.put("vat_included",isvat);
                 	order_summary_section.put("order_info",order_info);
                 	// --- Order Tracking Section ---
                 	order_tracking_section = Map();
                 	order_tracking_section.put("track_button_text","Track your order");
                 	order_tracking_detail_section = Map();
                 	order_tracking_detail_section.put("title","Order tracking");
                 	order_tracking_detail_section.put("status",lstorder.Cart_Status.Status);
                 	// Current datetime → extract only time
                 	now_time = zoho.currenttime.toTime();
                 	// Pickup time from order (already a Time field)
                 	pickup_time = lstorder.Pickup_Datetime;
                 	// Get difference in minutes
                 	diff_ms = pickup_time.toLong() - now_time.toLong();
                 	diff_mins = (diff_ms / (1000 * 60)).toLong();
                 	// Save into response
                 	order_tracking_detail_section.put("estimated_time",diff_mins.toString() + " mins");
                 	order_tracking_detail_section.put("status_indicator","On time");
                 	bg_icon = {"img_url":"<img_url>","image_src":"expand.png","field_name":"Image"};
                 	order_tracking_detail_section.put("background_image",bg_icon);
                 	order_tracking_detail_section.put("back_icon",bg_icon);
                 	order_tracking_detail_section.put("clock_icon",bg_icon);
                 	order_tracking_detail_section.put("refresh_icon",bg_icon);
                 	// 	timeline = List();
                 	// 	steptocompleted =false;
                 	// 	 for each states in lstorderstatus
                 	//      {
                 	// 		 if(states.ID==lstorder.Cart_Status){
                 	// 		 }
                 	// 		 timeline.add({"step":"Ready to pickup","description":"Order #"+lstorder.ID + " from Peet’s Coffee","status": lstorder.Cart_Status.Status});
                 	//      } 
                 	timeline = List();
                 	isReached = false;
                 	// Flag to mark when current status is reached
                 	order_desc = "";
                 	for each  states in lstorderstatus
                 	{
                 		if(states.Status_ID == "4")
                 		{
                 			order_desc = states.Description + lstorder.ID + " " + states.Description_Detail;
                 		}
                 		else
                 		{
                 			order_desc = states.Description + states.Description_Detail;
                 		}
                 		stepMap = Map();
                 		stepMap.put("step",states.Status);
                 		// Assuming lstorderstatus has field "Status"
                 		stepMap.put("description",order_desc);
                 		// If status is before or equal to current order status → mark as Completed
                 		if(states.ID == lstorder.Cart_Status)
                 		{
                 			stepMap.put("status","current");
                 			// This is the current step
                 			isReached = true;
                 		}
                 		else if(isReached == false)
                 		{
                 			stepMap.put("status","completed");
                 		}
                 		else
                 		{
                 			stepMap.put("status","upcoming");
                 		}
                 		timeline.add(stepMap);
                 	}
                 	order_tracking_detail_section.put("timeline",timeline);
                 	order_tracking_section.put("order_tracking_detail_section",order_tracking_detail_section);
                 	// --- Order Items Subsection ---
                 	order_items_section = Map();
                 	order_items_section.put("section_title","Order Items");
                 	order_items_section.put("summary_link_text","View Order Summary");
                 	sub_items = List();
                 	sub_items.add({"item_name":"Iced Spanish Latte","quantity":2,"price":"AED 32.00","image_url":"<image_url>"});
                 	sub_items.add({"item_name":"Rigatoni All Arrabbiata","quantity":2,"price":"AED 32.00","image_url":"<image_url>"});
                 	order_items_section.put("items",sub_items);
                 	order_details_section = Map();
                 	order_details_section.put("section_title","Order Details");
                 	order_details_section.put("order_number","#234567");
                 	order_details_section.put("method_label","Method");
                 	order_details_section.put("method_value","Pickup");
                 	order_details_section.put("store_location_label","Store Location");
                 	order_details_section.put("store_location_value","Dubai mall, lower ground floor, Dubai United Arab Emirates");
                 	order_summary_nested = Map();
                 	order_summary_nested.put("title","Order Summary");
                 	products = List();
                 	product1 = Map();
                 	product1.put("product_image",{"img_url":"<img_url>","report_name":"Orders","image_src":"iced_spanish_latte.png","field_name":"Product_Image"});
                 	product1.put("product_name","Iced Spanish Latte");
                 	product1.put("quantity",2);
                 	product1.put("price","AED 32.00");
                 	product1.put("customization_label","Customization:");
                 	product1.put("customization_value","Medium, espresso forte dark roast (blend) - by default, oat milk, caramel syrup, whipped cream, sugar syrup, brown sugar (multiple)");
                 	product1.put("notes_label","Notes:");
                 	product1.put("notes_value","Make it strong");
                 	products.add(product1);
                 	order_summary_nested.put("products",products);
                 	order_details_section.put("order_summary_section",order_summary_nested);
                 	payment_summary_section = Map();
                 	payment_summary_section.put("title","Payment Summary");
                 	payment_summary_section.put("sub_total_label","Sub total");
                 	payment_summary_section.put("sub_total_value","AED 128.00");
                 	payment_summary_section.put("coupon_label","Coupon discount (get10)");
                 	payment_summary_section.put("coupon_value","-AED 12.80");
                 	payment_summary_section.put("vat_label","Vat 5%");
                 	payment_summary_section.put("vat_value","AED 6.40");
                 	payment_summary_section.put("total_label","Total amount");
                 	payment_summary_section.put("total_value","AED 121.60");
                 	order_details_section.put("payment_summary_section",payment_summary_section);
                 	order_details_section.put("view_receipt_button_text","View receipt");
                 	order_items_section.put("order_details_section",order_details_section);
                 	order_tracking_section.put("order_items_section",order_items_section);
                 	// --- Store Location Section ---
                 	store_location_section = Map();
                 	store_location_section.put("store_text","Dubai mall, lower ground floor, Dubai United Arab Emirates");
                 	store_location_section.put("timing","30–35 mins");
                 	store_location_section.put("distance","10.2 km");
                 	store_location_section.put("directions_text","Get directions");
                 	store_location_section.put("icon",{"img_url":"<store_icon_url>"});
                 	// --- Rating Prompt Section ---
                 	rating_prompt_section = Map();
                 	rating_prompt_section.put("title","Don’t forget to rate us!");
                 	rating_prompt_section.put("subtitle","Your feedback helps us improve! Rate us and share your experience.");
                 	rating_prompt_section.put("rating_stars",5);
                 	rate_section = {"rate_text":"How was your experience?","rate_description":"Lets us know how your Peet's moment was.","rate_value":"0"};
                 	rating_prompt_section.put("rate_section",rate_section);
                 	rate_value_section = Map();
                 	rate_value_section.put("rate_text","Bitter brew? That’s not our style. Spill the beans - we’re here to fix it!");
                 	rate_value_section.put("rate_description","We’re really sorry your experience didn’t hit the mark. Tell us what happened—we’re all ears (and beans).");
                 	rate_value_section.put("rate_value","1");
                 	rate_value_section.put("rate_identifier",{"My coffee wasn’t on point","The wait was longer than my Monday","Service wasn’t as warm as our brew","Something else"});
                 	rate_value_section.put("rate_reason_text","Spill the tea-or the coffee. We're listening!");
                 	rating_prompt_section.put("rate_value_section",rate_value_section);
                 	rate_submit_section = Map();
                 	rate_submit_section.put("image",{"img_url":"<img_url>","report_name":"All_Home_Overviews","image_src":"1724230804415_Profile.png","field_name":"Image"});
                 	rate_submit_section.put("submit_text","Thank you for your feedback!");
                 	rate_submit_section.put("submit_description","Your feedback = our favorite blend!Thank you for sharing - now back to the grind (the good kind)!");
                 	rate_submit_section.put("submit_button_name","Got it");
                 	rating_prompt_section.put("rate_submit_section",rate_submit_section);
                 	footer_section = {"button_text":"Submit"};
                 	rating_prompt_section.put("footer_section",footer_section);
                 	// ================== Assemble ==================
                 	//result.put("confirmation_section",confirmation_section);
                 	result.put("order_summary_section",order_summary_section);
                 	//result.put("order_tracking_section",order_tracking_section);
                 	//result.put("store_location_section",store_location_section);
                 	//result.put("rating_prompt_section",rating_prompt_section);
                 	order_response.put("result",result);
                 	order_response.put("code","3000");
                 	return order_response;
                 }
				 map fetchRecords.getorderdetailbyid(int orderid)
                 {
                 	//	orderid = 4661594000013251006;
                 	lstorder = Cart_Order_Test[ID == orderid];
                 	cust = Customer[ID == lstorder.Customer];
                 	lstorderstatus = Cart_Status[ID != 0 && Display_on_app == true] sort by Display_Prio_Seq desc;
                 	cust_point_info = Customer_Points_System[Customer == cust];
                 	available_points = cust_point_info.Total_Points;
                 	current_member = cust_point_info.Membership_Level_System;
                 	loyalty_info = Loyalty_Rules[Membership_Level_System_loy_rul == current_member && Market_Global_lr == cust.Market_Global && Type_of_Rule == "Burning" && Mark_as_Active == true];
                 	//info loyalty_info;
                 	localTime = zoho.currenttime.tostring();
                 	objstore = peets_restaurant_management.storemanagement.getAllStorePeetsbystoreid(lstorder.Restaurant_Name_cart_order_all,localTime.tostring());
                 	//info lstorder.ID;
                 	lstorderitems = Cart_Order_Items[Cart_Order_ID == lstorder.ID];
                 	//info lstorderitems;
                 	//info objstore;
                 	order_response = Map();
                 	result = Map();
                 	// ================== Confirmation Section ==================
                 	currencyinfo = Map();
                 	currencyinfo.put("currencyname",lstorder.Order_Currency);
                 	currencyinfo.put("id","c01");
                 	pickup_details = Map();
                 	pickup_time_details = Map();
                 	pickup_time_details.put("type",lstorder.Pickup_Type);
                 	pickup_time_details.put("day",lstorder.Pickup_Day);
                 	pickup_time_details.put("pickup_time",lstorder.Pickup_Datetime.tostring());
                 	pickup_details.put("pickup_time_details",pickup_time_details);
                 	confirmation_section = Map();
                 	status_icon = Map();
                 	status_icon.put("img_url","<img_url>");
                 	status_icon.put("image_src","checkmark_green.png");
                 	status_icon.put("field_name","Image");
                 	confirmation_section.put("status_icon",thisapp.publicUrls.getlogoimages("15"));
                 	confirmation_section.put("title","Order confirmed!");
                 	confirmation_section.put("message","Thank you for your order! We’re brewing it fresh and crafting with care. You’ll receive a notification when it’s ready for pickup.");
                 	confirmation_section.put("posmessage",lstorder.Pos_Message);
                 	// ================== Order Summary Section ==================
                 	order_summary_section = Map();
                 	sections_list = List();
                 	// --- Order Items Section ---
                 	order_items_section_map = Map();
                 	order_items_section_map.put("label","Order Items");
                 	expand_icon = thisapp.publicUrls.getlogoimages("90");
                 	points_error_icon = thisapp.publicUrls.getlogoimages("93");
                 	order_items_section_map.put("expand_icon",expand_icon);
                 	item_overview = Map();
                 	item_overview.put("title","Order Items");
                 	items_list = List();
                 	for each  item in lstorderitems
                 	{
                 		lstmodifiers = item.Modifiers_Subform;
                 		itemname = copy_of_product_catalogue.productManagement.getproductnamebyid(item.Product_lookup_items);
                 		itemqty = item.Quantity;
                 		itemprice = item.Product_Price;
                 		currency = lstorder.Order_Currency;
                 		notes = "";
                 		item_id = item.Product_lookup_items.tostring();
                 		itemimage = copy_of_product_catalogue.publicUrls.getproductimage(item.Product_lookup_items.tostring());
                 		itemsize = item.Product_Size;
                 		modsByType = Map();
                 		typeOrder = List();
                 		typeIdByType = Map();
                 		modTypeIdByType = Map();
                 		for each  mod in lstmodifiers
                 		{
                 			typeName = copy_of_product_catalogue.modifiers.getmodifierstypenamebyid(mod.Modifier_Type_order);
                 			typeId = mod.Modifier_Type_order.toString();
                 			modtypeid = mod.Type_field.toString();
                 			// <-- new field
                 			valName = copy_of_product_catalogue.modifiers.getmodifiersnamebyid(mod.Modifiers_order);
                 			valId = mod.Modifiers_order;
                 			valQty = mod.Modifier_Qty;
                 			existing = modsByType.get(typeName);
                 			if(existing == null)
                 			{
                 				existing = List();
                 				modsByType.put(typeName,existing);
                 				typeOrder.add(typeName);
                 				// store both ids for this type
                 				typeIdByType.put(typeName,typeId);
                 				modTypeIdByType.put(typeName,modtypeid);
                 			}
                 			valMap = Map();
                 			valMap.put("name",valName);
                 			valMap.put("id",valId.toString());
                 			valMap.put("qty",valQty);
                 			existing.add(valMap);
                 		}
                 		modifiers_list = List();
                 		for each  t in typeOrder
                 		{
                 			entry = Map();
                 			entry.put("name",t);
                 			entry.put("id",typeIdByType.get(t));
                 			//entry.put("type",modTypeIdByType.get(t));
                 			entry.put("type",copy_of_product_catalogue.modifiersManagement.getmodifierstypebyid(typeIdByType.get(t).tolong()));
                 			entry.put("values",modsByType.get(t));
                 			modifiers_list.add(entry);
                 		}
                 		lstaddones = item.Add_ones;
                 		list_addones = List();
                 		sum_price_addones = 0;
                 		for each  addones in lstaddones
                 		{
                 			typeaddones = Map();
                 			typeaddones.put("addones_typeid",addones.Addon_Type_order.tostring());
                 			typeaddones.put("addones_type",copy_of_product_catalogue.addonesdetail.addonestypenamebyid(addones.Addon_Type_order));
                 			typeaddones.put("addones_id",addones.Addons_order.tostring());
                 			typeaddones.put("addones",copy_of_product_catalogue.addonesdetail.getaddonesnamebyid(addones.Addons_order));
                 			typeaddones.put("addones_price",addones.Addones_Price);
                 			typeaddones.put("qty",addones.Addones_Selected_qty);
                 			typeaddones.put("total",addones.Total_Addons_Price);
                 			sum_price_addones = sum_price_addones + addones.Total_Addons_Price;
                 			list_addones.add(typeaddones);
                 		}
                 		itemsize = Map();
                 		itemsize.put("name",item.Product_Size.Size);
                 		itemsize.put("id",item.Product_Size.tostring());
                 		// Build the item map and attach modifiers
                 		item_map = Map();
                 		item_map.put("item_name",itemname);
                 		item_map.put("item_image",itemimage);
                 		item_map.put("itemsize",itemsize);
                 		item_map.put("item_id",item_id);
                 		item_map.put("notes",notes);
                 		item_map.put("price",currency + " " + itemprice.tostring());
                 		item_map.put("price_addones_total",currency + " " + (sum_price_addones.tolong() + itemprice.tolong()).tostring());
                 		item_map.put("quantity",itemqty);
                 		item_map.put("modifiers",modifiers_list);
                 		item_map.put("addones",list_addones);
                 		items_list.add(item_map);
                 	}
                 	// Attach to overview
                 	item_overview.put("items",items_list);
                 	order_items_section_map.put("item_overview",item_overview);
                 	// --- Store Location Section ---
                 	localTime = zoho.currenttime;
                 	resp_map = objstore.toMap();
