				 map fetchRecords.getPointAnalysisResponse(string mobileno)
                 {
                 	//mobileno = "+971555534010";
                 	custid = Customer[Phone_Number == mobileno];
                 	if(custid == null)
                 	{
                 		err = Map();
                 		err.put("code","404");
                 		err.put("message","Customer not found");
                 		return err;
                 	}
                 	lstorders = Cart_Order_Test[Customer.ID == custid.ID.tolong() && Type_field == "Order"];
                 	lsttransaction = Transaction[Customer.ID == custid.ID.tolong()];
                 	lstpointsummapry = Customer_Points_System[Customer.ID == custid.ID.tolong()];
                 	typeCountMap = Map();
                 	for each  tr in lsttransaction
                 	{
                 		tf = if(tr.Type_field != null,tr.Type_field.toString(),"Unknown");
                 		if(typeCountMap.containKey(tf))
                 		{
                 			typeCountMap.put(tf,typeCountMap.get(tf) + 1);
                 		}
                 		else
                 		{
                 			typeCountMap.put(tf,1);
                 		}
                 	}
                 	typeList = List();
                 	for each  k in typeCountMap.keys()
                 	{
                 		rec = Map();
                 		rec.put("type",k);
                 		rec.put("count",typeCountMap.get(k));
                 		typeList.add(rec);
                 	}
                 	earned_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points_Earned != null,lstpointsummapry.Total_Points_Earned,0);
                 	burned_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points_Burned != null,lstpointsummapry.Total_Points_Burned,0);
                 	current_points = if(lstpointsummapry != null && lstpointsummapry.Available_Points != null,lstpointsummapry.Available_Points,0);
                 	expired_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points_Expired != null,lstpointsummapry.Total_Points_Expired,0);
                 	bonus_points_sum = 0;
                 	for each  tr in lsttransaction
                 	{
                 		is_bonus = (tr.Type_field != null && tr.Type_field.toString() == "Bonus") || (tr.Type_field != null && tr.Type_field.toString() == "Bonus");
                 		if(is_bonus && tr.Earned_Loyalty_Points != null)
                 		{
                 			bonus_points_sum = bonus_points_sum + tr.Earned_Loyalty_Points;
                 		}
                 	}
                 	mapsegment = Map();
                 	mapsegment.put("earned_points",earned_points);
                 	mapsegment.put("burned_points",burned_points);
                 	mapsegment.put("current_points",current_points);
                 	mapsegment.put("expired_points",expired_points);
                 	mapsegment.put("bonus_points",bonus_points_sum);
                 	headerSection = Map();
                 	backIcon = Map();
                 	backIcon.put("img_url",thisapp.publicUrls.getlogoimages("41"));
                 	backIcon.put("report_name","Point_Analysis");
                 	backIcon.put("image_src","back_arrow.png");
                 	backIcon.put("field_name","Image");
                 	backgroundImage = Map();
                 	backgroundImage.put("img_url",thisapp.publicUrls.getlogoimages("19"));
                 	backgroundImage.put("report_name","Point_Analysis");
                 	backgroundImage.put("image_src","header_pattern.png");
                 	backgroundImage.put("field_name","Image");
                 	headerSection.put("back_icon_image",backIcon);
                 	headerSection.put("background_image",backgroundImage);
                 	headerSection.put("header_name","Point Analysis");
                 	allowedEarnTypes = List();
                 	allowedEarnTypes.add("Purchase");
                 	allowedEarnTypes.add("Birthday");
                 	allowedEarnTypes.add("Referral");
                 	earnedItems = List();
                 	bonusItems = List();
                 	currentItems = List();
                 	// Earned + Bonus
                 	redeemedItems = List();
                 	expiredItems = List();
                 	for each  trans in lsttransaction
                 	{
                 		tf = if(trans.Type_field != null,trans.Type_field.toString(),"");
                 		pt = if(trans.Type_field != null,trans.Type_field.toString(),"");
                 		pv = if(trans.Earned_Loyalty_Points != null,trans.Earned_Loyalty_Points,0);
                 		tx_id = if(trans.ID != null,trans.ID.toString(),"#");
                 		tx_date = if(trans.Transaction_Time != null,trans.Transaction_Time.toString("dd MMM yyyy"),"");
                 		sign = if(pv >= 0,"+","-");
                 		points = sign + pv.toString() + " Points";
                 		expiry = "";
                 		//expiry  = if(trans.Expiry_Date != null, trans.Expiry_Date.toString("dd MMM yyyy"), "");
                 		loc = if(trans.Restaurant_Name != null,trans.Restaurant_Name.toString(),"");
                 		// --- Earned (Purchase, Birthday, Referral) ---
                 		if(allowedEarnTypes.contains(tf))
                 		{
                 			itemE = Map();
                 			itemE.put("transaction_id",tx_id);
                 			itemE.put("date",tx_date);
                 			itemE.put("points",points);
                 			itemE.put("point_type","Earned");
                 			itemE.put("expire_date",expiry);
                 			//info loc;
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemE.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemE.put("cafe_location","");
                 			}
                 			earnedItems.add(itemE);
                 			currentItems.add(itemE);
                 			// also part of current
                 		}
                 		// --- Bonus (Point_Type == Bonus OR Type_field == Bonus) ---
                 		if(pt == "Bonus" || tf == "Bonus")
                 		{
                 			itemB = Map();
                 			itemB.put("transaction_id",tx_id);
                 			itemB.put("date",tx_date);
                 			itemB.put("points",points);
                 			itemB.put("point_type","Bonus");
                 			itemB.put("expire_date",expiry);
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemB.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemB.put("cafe_location","");
                 			}
                 			bonusItems.add(itemB);
                 			currentItems.add(itemB);
                 			// also part of current
                 		}
                 		// --- Redeemed (negative points OR explicit Redeemed) ---
                 		if(pv < 0 || pt == "Redeemed" || tf == "Redeemed")
                 		{
                 			itemR = Map();
                 			itemR.put("transaction_id",tx_id);
                 			itemR.put("date",tx_date);
                 			itemR.put("points",points);
                 			itemR.put("point_type","Redeemed");
                 			itemR.put("expire_date",expiry);
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemR.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemR.put("cafe_location","");
                 			}
                 			redeemedItems.add(itemR);
                 		}
                 		// --- Expired (Expiration) ---
                 		if(tf == "Expiration" || pt == "Expiration")
                 		{
                 			itemX = Map();
                 			itemX.put("transaction_id",tx_id);
                 			itemX.put("date",tx_date);
                 			itemX.put("points",points);
                 			itemX.put("point_type","Expiration");
                 			itemX.put("expire_date",expiry);
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemX.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemX.put("cafe_location","");
                 			}
                 			expiredItems.add(itemX);
                 		}
                 	}
                 	segmentsList = List();
                 	// Earned Points
                 	earned = Map();
                 	earned.put("label","Earned Points");
                 	earned.put("value",if(mapsegment.get("earned_points") != null,mapsegment.get("earned_points"),0));
                 	earned.put("color","#F1C40F");
                 	earnedSection = Map();
                 	earnedSection.put("title","Earned Points");
                 	earnedSection.put("items",earnedItems);
                 	earned.put("earned_points_section",earnedSection);
                 	segmentsList.add(earned);
                 	// Bonus Points
                 	bonus = Map();
                 	bonus.put("label","Bonus Points");
                 	bonus.put("value",if(mapsegment.get("bonus_points") != null,mapsegment.get("bonus_points"),0));
                 	bonus.put("color","#2ECC71");
                 	bonusSection = Map();
                 	bonusSection.put("title","Bonus Points");
                 	bonusSection.put("items",bonusItems);
                 	bonus.put("bonus_points_section",bonusSection);
                 	segmentsList.add(bonus);
                 	// Current Points
                 	current = Map();
                 	current.put("label","Current Points");
                 	current.put("value",if(mapsegment.get("current_points") != null,mapsegment.get("current_points"),0));
                 	current.put("color","#3498DB");
                 	currentSection = Map();
                 	currentSection.put("title","Current Points");
                 	currentSection.put("items",currentItems);
                 	current.put("current_points_section",currentSection);
                 	segmentsList.add(current);
                 	// Redeemed Points
                 	redeemed = Map();
                 	redeemed.put("label","Redeemed Points");
                 	redeemed.put("value",if(mapsegment.get("burned_points") != null,mapsegment.get("burned_points"),0));
                 	redeemed.put("color","#E74C3C");
                 	redeemedSection = Map();
                 	redeemedSection.put("title","Redeemed Points");
                 	redeemedSection.put("items",redeemedItems);
                 	redeemed.put("redeemed_points_section",redeemedSection);
                 	segmentsList.add(redeemed);
                 	// Expired Points
                 	expired = Map();
                 	expired.put("label","Expired Points");
                 	expired.put("value",if(mapsegment.get("expired_points") != null,mapsegment.get("expired_points"),0));
                 	expired.put("color","#9B59B6");
                 	expiredSection = Map();
                 	expiredSection.put("title","Expired Points");
                 	expiredSection.put("items",expiredItems);
                 	expired.put("expired_points_section",expiredSection);
                 	segmentsList.add(expired);
                 	// ---------------------------
                 	// Chart + currency equivalent
                 	// ---------------------------
                 	chart = Map();
                 	chart.put("total_points",current_points);
                 	// Example conversion (10 pts = AED 1.00)
                 	rate = 0.1;
                 	currency_equiv_val = round(current_points * rate,2);
                 	chart.put("currency_equivalent","AED " + currency_equiv_val.toString());
                 	chart.put("segments",segmentsList);
                 	// ---------------------------
                 	// Points Overview
                 	// ---------------------------
                 	pointsOverview = Map();
                 	pointsOverview.put("chart",chart);
                 	pointsOverview.put("details_button_text","Details");
                 	// ---------------------------
                 	// Final Response
                 	// ---------------------------
                 	result = Map();
                 	result.put("header_section",headerSection);
                 	result.put("points_overview",pointsOverview);
                 	pointAnalysisResponse = Map();
                 	pointAnalysisResponse.put("result",result);
                 	pointAnalysisResponse.put("code","3000");
                 	pointAnalysisResponse.put("type","profile_8");
                 	return pointAnalysisResponse;
                 }
				 map fetchRecords.getPointAnalysisResponse_Internal_testing()
                 {
                 	mobileno = "+971559065062";
                 	custid = Customer[Phone_Number == mobileno];
                 	if(custid == null)
                 	{
                 		err = Map();
                 		err.put("code","404");
                 		err.put("message","Customer not found");
                 		return err;
                 	}
                 	lstorders = Cart_Order_Test[Customer.ID == custid.ID.tolong() && Type_field == "Order"];
                 	lsttransaction = Transaction[Customer.ID == custid.ID.tolong()];
                 	lstpointsummapry = Customer_Points_System[Customer.ID == custid.ID.tolong()];
                 	typeCountMap = Map();
                 	for each  tr in lsttransaction
                 	{
                 		tf = if(tr.Type_field != null,tr.Type_field.toString(),"Unknown");
                 		if(typeCountMap.containKey(tf))
                 		{
                 			typeCountMap.put(tf,typeCountMap.get(tf) + 1);
                 		}
                 		else
                 		{
                 			typeCountMap.put(tf,1);
                 		}
                 	}
                 	typeList = List();
                 	for each  k in typeCountMap.keys()
                 	{
                 		rec = Map();
                 		rec.put("type",k);
                 		rec.put("count",typeCountMap.get(k));
                 		typeList.add(rec);
                 	}
                 	earned_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points_Earned != null,lstpointsummapry.Total_Points_Earned,0);
                 	burned_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points_Burned != null,lstpointsummapry.Total_Points_Burned,0);
                 	current_points = if(lstpointsummapry != null && lstpointsummapry.Available_Points != null,lstpointsummapry.Available_Points,0);
                 	expired_points = if(lstpointsummapry != null && lstpointsummapry.Total_Points_Expired != null,lstpointsummapry.Total_Points_Expired,0);
                 	bonus_points_sum = 0;
                 	for each  tr in lsttransaction
                 	{
                 		is_bonus = (tr.Type_field != null && tr.Type_field.toString() == "Signup") || (tr.Type_field != null && tr.Type_field.toString() == "Signup");
                 		if(is_bonus && tr.Earned_Loyalty_Points != null)
                 		{
                 			bonus_points_sum = bonus_points_sum + tr.Earned_Loyalty_Points;
                 		}
                 	}
                 	mapsegment = Map();
                 	mapsegment.put("earned_points",earned_points);
                 	mapsegment.put("burned_points",burned_points);
                 	mapsegment.put("current_points",current_points);
                 	mapsegment.put("expired_points",expired_points);
                 	mapsegment.put("bonus_points",bonus_points_sum);
                 	headerSection = Map();
                 	backIcon = Map();
                 	backIcon.put("img_url",thisapp.publicUrls.getlogoimages("41"));
                 	backIcon.put("report_name","Point_Analysis");
                 	backIcon.put("image_src","back_arrow.png");
                 	backIcon.put("field_name","Image");
                 	backgroundImage = Map();
                 	backgroundImage.put("img_url",thisapp.publicUrls.getlogoimages("19"));
                 	backgroundImage.put("report_name","Point_Analysis");
                 	backgroundImage.put("image_src","header_pattern.png");
                 	backgroundImage.put("field_name","Image");
                 	headerSection.put("back_icon_image",backIcon);
                 	headerSection.put("background_image",backgroundImage);
                 	headerSection.put("header_name","Point Analysis");
                 	allowedEarnTypes = List();
                 	allowedEarnTypes.add("Purchase");
                 	allowedEarnTypes.add("Birthday");
                 	allowedEarnTypes.add("Referral");
                 	earnedItems = List();
                 	bonusItems = List();
                 	currentItems = List();
                 	// Earned + Bonus
                 	redeemedItems = List();
                 	expiredItems = List();
                 	for each  trans in lsttransaction
                 	{
                 		tf = if(trans.Type_field != null,trans.Type_field.toString(),"");
                 		pt = if(trans.Type_field != null,trans.Type_field.toString(),"");
                 		pv = if(trans.Earned_Loyalty_Points != null,trans.Earned_Loyalty_Points,0);
                 		tx_id = if(trans.ID != null,trans.ID.toString(),"#");
                 		tx_date = if(trans.Transaction_Time != null,trans.Transaction_Time.toString("dd MMM yyyy"),"");
                 		sign = if(pv >= 0,"+","-");
                 		points = sign + pv.toString() + " Points";
                 		expiry = "";
                 		//expiry  = if(trans.Expiry_Date != null, trans.Expiry_Date.toString("dd MMM yyyy"), "");
                 		loc = if(trans.Restaurant_Name != null,trans.Restaurant_Name.toString(),"");
                 		// --- Earned (Purchase, Birthday, Referral) ---
                 		if(allowedEarnTypes.contains(tf))
                 		{
                 			itemE = Map();
                 			itemE.put("transaction_id",tx_id);
                 			itemE.put("date",tx_date);
                 			itemE.put("points",points);
                 			itemE.put("point_type","Earned");
                 			itemE.put("expire_date",expiry);
                 			//info loc;
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemE.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemE.put("cafe_location","");
                 			}
                 			earnedItems.add(itemE);
                 			currentItems.add(itemE);
                 			// also part of current
                 		}
                 		// --- Bonus (Point_Type == Bonus OR Type_field == Bonus) ---
                 		if(pt == "Bonus" || tf == "Bonus")
                 		{
                 			itemB = Map();
                 			itemB.put("transaction_id",tx_id);
                 			itemB.put("date",tx_date);
                 			itemB.put("points",points);
                 			itemB.put("point_type","Bonus");
                 			itemB.put("expire_date",expiry);
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemB.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemB.put("cafe_location","");
                 			}
                 			bonusItems.add(itemB);
                 			currentItems.add(itemB);
                 			// also part of current
                 		}
                 		// --- Redeemed (negative points OR explicit Redeemed) ---
                 		if(pv < 0 || pt == "Redeemed" || tf == "Redeemed")
                 		{
                 			itemR = Map();
                 			itemR.put("transaction_id",tx_id);
                 			itemR.put("date",tx_date);
                 			itemR.put("points",points);
                 			itemR.put("point_type","Redeemed");
                 			itemR.put("expire_date",expiry);
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemR.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemR.put("cafe_location","");
                 			}
                 			redeemedItems.add(itemR);
                 		}
                 		// --- Expired (Expiration) ---
                 		if(tf == "Expiration" || pt == "Expiration")
                 		{
                 			itemX = Map();
                 			itemX.put("transaction_id",tx_id);
                 			itemX.put("date",tx_date);
                 			itemX.put("points",points);
                 			itemX.put("point_type","Expiration");
                 			itemX.put("expire_date",expiry);
                 			if(loc != null && loc != "")
                 			{
                 				id_val = loc.toDecimal().toLong();
                 				itemX.put("cafe_location",peets_restaurant_management.storemanagement.restaurantnamebyid(id_val));
                 			}
                 			else
                 			{
                 				itemX.put("cafe_location","");
                 			}
                 			expiredItems.add(itemX);
                 		}
                 	}
                 	segmentsList = List();
                 	// Earned Points
                 	earned = Map();
                 	earned.put("label","Earned Points");
                 	earned.put("value",if(mapsegment.get("earned_points") != null,mapsegment.get("earned_points"),0));
                 	earned.put("color","#F1C40F");
                 	earnedSection = Map();
                 	earnedSection.put("title","Earned Points");
                 	earnedSection.put("items",earnedItems);
                 	earned.put("earned_points_section",earnedSection);
                 	segmentsList.add(earned);
                 	// Bonus Points
                 	bonus = Map();
                 	bonus.put("label","Bonus Points");
                 	bonus.put("value",if(mapsegment.get("bonus_points") != null,mapsegment.get("bonus_points"),0));
                 	bonus.put("color","#2ECC71");
                 	bonusSection = Map();
                 	bonusSection.put("title","Bonus Points");
                 	bonusSection.put("items",bonusItems);
                 	bonus.put("bonus_points_section",bonusSection);
                 	segmentsList.add(bonus);
                 	// Current Points
                 	current = Map();
                 	current.put("label","Current Points");
                 	current.put("value",if(mapsegment.get("current_points") != null,mapsegment.get("current_points"),0));
                 	current.put("color","#3498DB");
                 	currentSection = Map();
                 	currentSection.put("title","Current Points");
                 	currentSection.put("items",currentItems);
                 	current.put("current_points_section",currentSection);
                 	segmentsList.add(current);
                 	// Redeemed Points
                 	redeemed = Map();
                 	redeemed.put("label","Redeemed Points");
                 	redeemed.put("value",if(mapsegment.get("burned_points") != null,mapsegment.get("burned_points"),0));
                 	redeemed.put("color","#E74C3C");
                 	redeemedSection = Map();
                 	redeemedSection.put("title","Redeemed Points");
                 	redeemedSection.put("items",redeemedItems);
                 	redeemed.put("redeemed_points_section",redeemedSection);
                 	segmentsList.add(redeemed);
                 	// Expired Points
                 	expired = Map();
                 	expired.put("label","Expired Points");
                 	expired.put("value",if(mapsegment.get("expired_points") != null,mapsegment.get("expired_points"),0));
                 	expired.put("color","#9B59B6");
                 	expiredSection = Map();
                 	expiredSection.put("title","Expired Points");
                 	expiredSection.put("items",expiredItems);
                 	expired.put("expired_points_section",expiredSection);
                 	segmentsList.add(expired);
                 	// ---------------------------
                 	// Chart + currency equivalent
                 	// ---------------------------
                 	chart = Map();
                 	chart.put("total_points",current_points);
                 	// Example conversion (10 pts = AED 1.00)
                 	rate = 0.1;
                 	currency_equiv_val = round(current_points * rate,2);
                 	chart.put("currency_equivalent","AED " + currency_equiv_val.toString());
                 	chart.put("segments",segmentsList);
                 	// ---------------------------
                 	// Points Overview
                 	// ---------------------------
                 	pointsOverview = Map();
