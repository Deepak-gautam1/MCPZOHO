				 map fetchRecords.privacyPolicyContent()
                 {
                 	localisible_app_strings = Map();
                 	privacyList = List();
                 	// ===== ABOUT THIS POLICY =====
                 	m = Map();
                 	m.put("heading","ABOUT THIS POLICY");
                 	m.put("description","This document outlines the privacy practices of Kuwait Food Co (Americana) LLC, its subsidiaries and affiliates (the \"Company,\" \"we,\" \"us,\" or \"our\"), emphasizing our commitment to privacy. We are dedicated to safeguarding your personal information and ensuring transparency regarding our handling of it. This Privacy Policy (\"Policy\") details the methods by which we collect, utilize, store, and secure your information.\n\nBy accepting this Privacy Policy, you acknowledge and consent to the collection and use of your personal information by our Company. Your data will be utilized to deliver an integrated customer experience, which may include personalized services, marketing communications, participation in loyalty programs, and enhanced customer support, among other related services.");
                 	m.put("points",List());
                 	// no bullets here, just the description
                 	privacyList.add(m);
                 	// ===== APPLICABILITY AND SCOPE =====
                 	m = Map();
                 	m.put("heading","APPLICABILITY AND SCOPE");
                 	m.put("description","This Privacy Policy governs the Peet’s Coffee mobile application (the \"APP\") as well as any other platform owned by the Company that directs users to this Policy. It covers all interactions conducted through the APP, including registration for the Peet’s rewards program and order placements, during which we collect specific personal information in order to provide our services and fulfill user requests.");
                 	pts = List();
                 	pts.add("The APP may contain links to external websites or services not operated by the Company. If you access these third-party services, please be aware that they are governed by their own privacy policy, terms of service, and data practices. The Company is not responsible for how those third parties handle your information, and we encourage you to review their privacy policies before providing any personal data.");
                 	m.put("points",pts);
                 	privacyList.add(m);
                 	// ===== INFORMATION AND DATA WE COLLECT =====
                 	m = Map();
                 	m.put("heading","INFORMATION AND DATA WE COLLECT");
                 	m.put("description","Upon accessing our APP or visiting our stores, we collect information about you and the services you utilize. The information gathered is mainly classified under these categories: (1) information you provide voluntarily; (2) information we collect automatically; and (3) information acquired from external sources. We may collect and process the following categories of personal data:");
                 	pts = List();
                 	pts.add("Identification Data: Includes your full name, email address, mailing address, phone number, birthday, demographic details, and login credentials.");
                 	pts.add("Transaction and Purchase Data: Order history, payment records (via secure third parties), purchased products, cart items, and linked promotions.");
                 	pts.add("Demographic and Preference Data: Age, gender, interests, and stated preferences for personalization.");
                 	pts.add("Technical Data: Device identifiers, IP address, browser type, OS, app usage interactions, Wi-Fi service data (MAC, dynamic IP, browser agent, etc.).");
                 	pts.add("Geolocation Data: Collected with your consent for location services.");
                 	pts.add("Audio/Visual Data: Limited cases such as customer service recordings or CCTV for quality, security, and safety purposes.");
                 	pts.add("Inferences: Insights generated from your interactions to personalize services.");
                 	pts.add("Public/Third-Party Data: From business partners, public databases, or social media to ensure accuracy and improve offerings.");
                 	m.put("points",pts);
                 	privacyList.add(m);
                 	// ===== HOW WE USE IT =====
                 	m = Map();
                 	m.put("heading","HOW WE USE IT");
                 	m.put("description","We use your data to deliver services, process orders, improve user experience, run promotions, and ensure security. Specifically:");
                 	pts = List();
                 	pts.add("A. Deliver & Manage Services – account registration, orders, troubleshooting, rewards tracking.");
                 	pts.add("B. Communicate – service notifications, promotions, account updates, inquiries.");
                 	pts.add("C. Improve Services – analyzing trends, testing features, customer research.");
                 	pts.add("D. Security & Compliance – fraud prevention, rights protection, legal obligations.");
                 	pts.add("E. Marketing & Advertising – tailored offers, ads, campaign measurement, co-branded activities (with consent).");
                 	pts.add("F. With Consent – other uses only if explicitly allowed by you.");
                 	m.put("points",pts);
                 	privacyList.add(m);
                 	// ===== HOW WE SHARE YOUR INFORMATION =====
                 	m = Map();
                 	m.put("heading","HOW WE SHARE YOUR INFORMATION");
                 	m.put("description","We share personal information only as needed to deliver services or comply with obligations:");
                 	pts = List();
                 	pts.add("I. Service Providers – for payments, hosting, analytics, delivery, support.");
                 	pts.add("II. Regulatory Requirements – compliance with tax, safety, or governmental laws.");
                 	pts.add("III. With Permission – for promotions, campaigns, analytics, or events with your explicit consent.");
                 	m.put("points",pts);
                 	privacyList.add(m);
                 	// ===== LEGAL BASIS FOR PROCESSING =====
                 	m = Map();
                 	m.put("heading","LEGAL BASIS FOR PROCESSING");
                 	m.put("description","We process your data based on the following legal grounds:");
                 	pts = List();
                 	pts.add("A. To Fulfill a Contract – e.g., manage accounts, process orders, rewards.");
                 	pts.add("B. Legitimate Interests – improve app, respond to support, fraud prevention.");
                 	pts.add("C. Legal Obligations – maintain records, respond to authorities.");
                 	pts.add("D. Consent – for marketing or location services (can be withdrawn anytime).");
                 	m.put("points",pts);
                 	privacyList.add(m);
                 	// ===== DATA SECURITY AND PROTECTION =====
                 	m = Map();
                 	m.put("heading","DATA SECURITY AND PROTECTION");
                 	m.put("description","We use firewalls, SSL, intrusion detection, and strict access controls to safeguard data. While we take all precautions, no online system can be 100% secure. Users should take their own precautions as well.");
                 	m.put("points",List());
                 	privacyList.add(m);
                 	// ===== DATA RETENTION =====
                 	m = Map();
                 	m.put("heading","DATA RETENTION");
                 	m.put("description","We retain your personal data only as long as necessary for program administration, transactions, legal obligations, or continuity of rewards history.");
                 	m.put("points",List());
                 	privacyList.add(m);
                 	// ===== INTERNATIONAL DATA TRANSFER =====
                 	m = Map();
                 	m.put("heading","INTERNATIONAL DATA TRANSFER");
                 	m.put("description","Your information may be transferred across countries with safeguards such as contractual clauses or binding rules to ensure compliance with applicable laws.");
                 	m.put("points",List());
                 	privacyList.add(m);
                 	// ===== ELIGIBILITY =====
