				 map loyaltyEngine.refund_2_0(Map transaction, Customer customer, Customer_Points_System customerLoysltyPointSystem)
                 {
                 	try 
                 	{
                 		if(transaction.containKey("type"))
                 		{
                 			if(transaction.get("type") == 1)
                 			{
                 				orderTransaction = Transaction[Customer == customer.ID && Order_ID == transaction.get("order_id")] sort by Transaction_Time desc;
                 			}
                 			else
                 			{
                 				orderTransaction = Transaction[Customer == customer.ID] sort by Transaction_Time desc;
                 			}
                 		}
                 		if(orderTransaction.count() > 0 && orderTransaction.Type_field != "Cancellation")
                 		{
                 			avaialablePoints = customerLoysltyPointSystem.Available_Points;
                 			totalEarnedPoints = ifnull(orderTransaction.Earned_Loyalty_Points,0);
                 			totalBurnedPoints = ifnull(orderTransaction.Burned_Points,0);
                 			orderTransaction.Status="Cancelled";
                 			/* 			orderTransaction.Earned_Loyalty_Points=totalEarnedPoints * -1;
                                  			orderTransaction.Burned_Points=totalBurnedPoints * -1; */
                 			transactionID = insert into Transaction
                 			[
                 				Added_User=zoho.loginuser
                 				Customer=customer.ID
                 				Market=customer.Country
                 				Restaurant_Name=orderTransaction.Restaurant_Name
                 				Type_field="Cancellation"
                 				Order_ID=orderTransaction.Order_ID
                 				Total_Purchase_Amount=orderTransaction.Total_Purchase_Amount
                 				Total_Discount_Amount=orderTransaction.Total_Discount_Amount
                 				Total_Invoice_Amount=orderTransaction.Total_Invoice_Amount
                 				Earned_Loyalty_Points=totalEarnedPoints * -1
                 				Burned_Points=totalBurnedPoints * -1
                 				Transaction_Time=zoho.currenttime
                 				Available_Points_Before_Cancellation=customerLoysltyPointSystem.Available_Points
                 			];
                 			customerLoysltyPointSystem.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned - orderTransaction.Earned_Loyalty_Points;
                 			customerLoysltyPointSystem.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned - orderTransaction.Burned_Points;
                 			customerLoysltyPointSystem.Available_Points=customerLoysltyPointSystem.Total_Points_Earned - customerLoysltyPointSystem.Total_Points_Burned;
                 			getTransaction = Transaction[ID == transactionID];
                 			getTransaction.Status="Cancelled";
                 			getTransaction.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned;
                 			getTransaction.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned;
                 			getTransaction.Available_Points=customerLoysltyPointSystem.Available_Points;
                 			if(customerLoysltyPointSystem.Transaction == orderTransaction.ID)
                 			{
                 				customerLoysltyPointSystem.Is_Free_drink_available=true;
                 				customerLoysltyPointSystem.Redeemed_Product=null;
                 				customerLoysltyPointSystem.Transaction=null;
                 			}
                 			thisapp.loyaltyEngine.restoreRemainingPoints(orderTransaction.ID);
                 			return thisapp.loyaltyEngine.getLoyaltyData(customer,customerLoysltyPointSystem,orderTransaction);
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.refund_2_0",e);
                 	}
                 	return null;
                 }
				 map loyaltyEngine.refund_2_0_V2(Map transaction, Customer customer, Customer_Points_System customerLoysltyPointSystem)
                 {
                 	try 
                 	{
                 		if(transaction.containKey("type"))
                 		{
                 			if(transaction.get("type") == 1)
                 			{
                 				orderTransaction = Transaction[Customer == customer.ID && Order_ID == transaction.get("order_id")] sort by Transaction_Time desc;
                 			}
                 			else
                 			{
                 				orderTransaction = Transaction[Customer == customer.ID] sort by Transaction_Time desc;
                 			}
                 		}
                 		if(orderTransaction.count() > 0 && orderTransaction.Type_field != "Cancellation")
                 		{
                 			avaialablePoints = customerLoysltyPointSystem.Available_Points;
                 			totalEarnedPoints = ifnull(orderTransaction.Earned_Loyalty_Points,0);
                 			totalBurnedPoints = ifnull(orderTransaction.Burned_Points,0);
                 			orderTransaction.Status="Cancelled";
                 			/* 			orderTransaction.Earned_Loyalty_Points=totalEarnedPoints * -1;
                                  			orderTransaction.Burned_Points=totalBurnedPoints * -1; */
                 			transactionID = insert into Transaction
                 			[
                 				Added_User=zoho.loginuser
                 				Customer=customer.ID
                 				Market=customer.Country
                 				Restaurant_Name=orderTransaction.Restaurant_Name
                 				Type_field="Cancellation"
                 				Order_ID=orderTransaction.Order_ID
                 				Total_Purchase_Amount=orderTransaction.Total_Purchase_Amount
                 				Total_Discount_Amount=orderTransaction.Total_Discount_Amount
                 				Total_Invoice_Amount=orderTransaction.Total_Invoice_Amount
                 				Earned_Loyalty_Points=totalEarnedPoints * -1
                 				Burned_Points=totalBurnedPoints * -1
                 				Transaction_Time=zoho.currenttime
                 				Available_Points_Before_Cancellation=customerLoysltyPointSystem.Available_Points
                 			];
                 			customerLoysltyPointSystem.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned - orderTransaction.Earned_Loyalty_Points;
                 			customerLoysltyPointSystem.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned - orderTransaction.Burned_Points;
                 			customerLoysltyPointSystem.Available_Points=customerLoysltyPointSystem.Total_Points_Earned - customerLoysltyPointSystem.Total_Points_Burned;
                 			getTransaction = Transaction[ID == transactionID];
                 			getTransaction.Status="Cancelled";
                 			getTransaction.Total_Points_Earned=customerLoysltyPointSystem.Total_Points_Earned;
                 			getTransaction.Total_Points_Burned=customerLoysltyPointSystem.Total_Points_Burned;
                 			getTransaction.Available_Points=customerLoysltyPointSystem.Available_Points;
                 			if(customerLoysltyPointSystem.Transaction == orderTransaction.ID)
                 			{
                 				customerLoysltyPointSystem.Is_Free_drink_available=true;
                 				customerLoysltyPointSystem.Redeemed_Product=null;
                 				customerLoysltyPointSystem.Transaction=null;
                 			}
                 			thisapp.loyaltyEngine.restoreRemainingPoints(orderTransaction.ID);
                 			return thisapp.loyaltyEngine.getLoyaltyData(customer,customerLoysltyPointSystem,orderTransaction);
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - loyaltyEngine.refund_2_0",e);
                 	}
                 	return null;
                 }
				 void loyaltyEngine.removeFreeDrinkRule(int id)
                 {
                 	delete from Joining_Rules[ID == id];
                 	openUrl("#Script:page.refresh","same window");
                 }
				 void loyaltyEngine.restoreRemainingPoints(int transactionID)
                 {
                 	transaction = Transaction[Transaction_Used_For == transactionID];
                 	for each  rec in transaction
                 	{
                 		rec.Utilized_Points=rec.Utilized_Points - rec.Last_Used_Points;
                 		rec.Remaining_Points=rec.Last_Used_Points;
                 		rec.Transaction_Used_For=null;
                 		if(rec.Remaining_Points == rec.Earned_Loyalty_Points)
                 		{
                 			rec.Status="Not Utilized";
                 		}
                 		else
                 		{
                 			rec.Status="Partially Utilized";
                 		}
                 	}
                 }
				 map loyaltyEngine.temp_customepoints_V2(string mobileno, string bonus_point)
                 {
                 	//string mobileno
                 	mapres = Map();
                 	mapres.put("id","0");
                 	mapres.put("is_done",false);
                 	//mobileno = "+971562597702";
                 	customer = Customer[Phone_Number == mobileno] range from 0 to 1;
                 	trans = Transaction[Customer == customer] sort by Transaction_Time desc range from 0 to 0;
                 	//customer = Customer[ID == id.tolong()];
                 	transactionType = "Bonus";
                 	b_type = "Points c/f";
                 	b_point = Bonus_Points[Bonus_Type == b_type.trim() && Status == "Active"];
                 	//info b_point ;
                 	// calculation fields start
                 	receivedPoints = bonus_point.tolong();
                 	//b_point.Points;
                 	expiryDays = b_point.Bonus_Expiration_Days;
                 	b_validity = zoho.currenttime;
                 	bonusValidity = b_validity.addDay(expiryDays);
                 	if(trans.count() > 0)
                 	{
                 		bonus_balance = ifnull(trans.Bonus_Available,0);
                 		previouse_available_bonus_balance = ifnull(ifnull(bonus_balance.tolong(),0) + ifnull(trans.Available_Points.tolong(),0),0);
                 	}
                 	else
                 	{
                 		bonus_balance = 0;
                 		previouse_available_bonus_balance = 0;
                 	}
                 	bonus_available = receivedPoints.tolong() + bonus_balance.tolong();
                 	// end
                 	order_id = "";
                 	customer_points = null;
                 	customer_points = Customer_Points_System[Customer == customer] range from 0 to 1;
                 	available_before = 0;
                 	if(customer_points != null && customer_points.Available_Points != null)
                 	{
                 		available_before = customer_points.Available_Points;
                 	}
                 	if(customer_points.count() > 3)
                 	{
                 		already_signup = Transaction[Bonus_Type == b_type && Customer == customer && Type_field == transactionType];
                 	}
                 	info "b_type" + b_type;
                 	info "trans type " + transactionType;
                 	info already_signup;
                 	if(already_signup.count() <= 0)
                 	{
                 		// Insert needs a single record for link fields (Customer), not a collection
                 		transactionEarned = insert into Transaction
                 		[
                 			Added_User=zoho.loginuser
                 			Customer=customer
                 			Market_Global_txn=customer.Market_Global
                 			Type_field=transactionType
                 			Bonus_Type=b_type
                 			Previous_Total_Bonus_Available=previouse_available_bonus_balance
                 			Bonus_Points_earned=ifnull(receivedPoints,0)
                 			Bonus_Available=ifnull(bonus_available,0)
                 			BonusValidity=bonusValidity
                 			Remaining_Bonus_Points=ifnull(receivedPoints,0)
                 			Order_ID=order_id
                 			Total_Purchase_Amount=0
                 			Total_Discount_Amount=0
                 			Total_Invoice_Amount=0
                 			Earned_Loyalty_Points=0
                 			Available_Points=customer_points.Available_Points
                 			Expired_Points=0
                 			Burned_Points=0
                 			Utilized_Points=0
                 			Transaction_Time=zoho.currenttime
                 			Status="Not Utilized"
                 			Available_Points_Before_Cancellation=available_before
                 		];
                 	}
                 	else
                 	{
                 		transactionEarned = null;
                 	}
                 	if(transactionEarned != null)
                 	{
                 		total_earned = customer_points.Total_Points_Earned;
                 		total_burned = customer_points.Total_Points_Burned;
                 		total_expired = customer_points.Total_Points_Expired;
                 		balance_points = customer_points.Available_Points;
                 		if(customer_points != null)
                 		{
                 			customer_points.Bonus_Points_Earned=ifnull(ifnull(customer_points.Bonus_Points_Earned,0) + receivedPoints.tolong(),0);
                 			customer_points.Total_Points_Burned=total_burned;
                 			customer_points.Total_Points_Expired=total_expired;
                 			customer_points.Total_Points_Earned=total_earned;
                 			customer_points.Available_Points=balance_points;
                 		}
                 		trns = Transaction[ID == transactionEarned];
                 		trns.Available_Points=balance_points;
                 		mapres.put("id",transactionEarned.tostring());
                 		mapres.put("is_done",true);
                 	}
                 	return mapres;
                 }
				 void loyaltyEngine.temp_points_fun()
                 {
                 	lstcust_points = Temp_data_points[ID != 0];
                 	for each  cust in lstcust_points
                 	{
                 		thisapp.loyaltyEngine.temp_customepoints_V2(cust.Phone.trim(),cust.Delta.trim());
                 	}
                 }
