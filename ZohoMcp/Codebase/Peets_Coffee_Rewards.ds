                 	sec4e = Map();
                 	sec4e.put("value","Members can check their Rewards balance only through the Mobile App available in UAE. Points are automatically calculated and credited within 48 hours of the order.");
                 	sec4e.put("style",5);
                 	stringList.add(sec4e);
                 	sec4f = Map();
                 	sec4f.put("value","If an account is blocked/deactivated/deleted before order confirmation, no Rewards points will be credited.");
                 	sec4f.put("style",5);
                 	stringList.add(sec4f);
                 	// Membership Tiers
                 	sec5 = Map();
                 	sec5.put("value","Membership Tiers");
                 	sec5.put("style",4);
