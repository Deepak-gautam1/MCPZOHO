				 map accounts_handler.version_controler(int platformType, String currentUsrVersion)
                 {
                 	localisibleStrings = Map();
                 	localisibleStrings.put("title","App update Required!");
                 	localisibleStrings.put("description","Our latest update includes new features and bug fixes. for more seamless experience");
                 	localisibleStrings.put("update_button_text","Update App");
                 	localisibleStrings.put("skip_button_text","Skip");
                 	localisibleStrings.put("android_url","https://play.google.com/store/apps/details?id=com.peetscoffee.rewards");
                 	localisibleStrings.put("ios_url","https://apps.apple.com/app/id6756050366");
                 	platforms = {"android","ios"};
                 	//{"all"}
                 	versions = {{"platform":"android","latest_version":"2.0.2","force_updates_needed_for":"all","nonenforcement_update_for":{},"popup_needed":true,"should_logout":false},{"platform":"ios","latest_version":"2.0.2","force_updates_needed_for":"all","nonenforcement_update_for":{},"popup_needed":false,"should_logout":false}};
                 	targetedPlatform = platforms.get(platformType - 1);
                 	for each  versionData in versions
                 	{
                 		if(versionData.get("platform") == targetedPlatform)
                 		{
                 			if(currentUsrVersion == versionData.get("latest_version"))
                 			{
                 				return {"is_upto_date":true};
                 			}
                 			else
                 			{
                 				forceUpdatedFor = versionData.get("force_updates_needed_for");
                 				if(forceUpdatedFor.isText() == true && forceUpdatedFor == "all")
                 				{
                 					return {"is_upto_date":false,"force_updated_needed":false,"popup_needed":versionData.get("popup_needed"),"should_logout":versionData.get("should_logout"),"strings":localisibleStrings};
                 				}
                 				else if(forceUpdatedFor.contains(currentUsrVersion))
                 				{
                 					return {"is_upto_date":false,"force_updated_needed":false,"popup_needed":versionData.get("popup_needed"),"should_logout":versionData.get("should_logout"),"strings":localisibleStrings};
                 				}
                 				else
                 				{
                 					nonforcementUpdateFor = versionData.get("nonenforcement_update_for");
                 					if(nonforcementUpdateFor.isText() == true && nonforcementUpdateFor == "all")
                 					{
                 						return {"is_upto_date":false,"force_updated_needed":false,"popup_needed":versionData.get("popup_needed"),"should_logout":versionData.get("should_logout"),"strings":localisibleStrings};
                 					}
                 					else if(nonforcementUpdateFor.contains(currentUsrVersion))
                 					{
                 						return {"is_upto_date":false,"force_updated_needed":false,"popup_needed":versionData.get("popup_needed"),"should_logout":versionData.get("should_logout"),"strings":localisibleStrings};
                 					}
                 					else
                 					{
                 						return {"is_upto_date":true};
                 					}
                 				}
                 			}
                 		}
                 	}
                 	return {};
                 }
				 list apiEndPoints.apimain(Map requestParams)
                 {
                 	action = toNumber(requestParams.get('action'));
                 	resp = List();
                 	try 
                 	{
                 		if(action == 1)
                 		{
                 			data = requestParams.get('data');
                 			if(data == null)
                 			{
                 				throws 'data is null';
                 			}
                 			custmobileno = data.get('cust_mobileno');
                 			if(custmobileno == null)
                 			{
                 				throws 'customer mobile is null';
                 			}
                 			resp = thisapp.membershipdetail.getLstMembership(custmobileno);
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("main",e);
                 		// info e.lineNo; 
                 		// info e.message;
                 		// info e; 
                 		err = Map();
                 		err.put('error',true);
                 		resp.add(err);
                 	}
                 	return resp;
                 }
