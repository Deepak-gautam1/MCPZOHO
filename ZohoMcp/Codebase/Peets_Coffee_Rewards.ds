				 map reqparsars.getCartDetailsFromRequest(string request)
                 {
                 	requestMap = request.toMap();
                 	response = Map();
                 	response.put("type",requestMap.get("type"));
                 	response.put("cartorderid",requestMap.get("cartorderid"));
                 	response.put("currency",requestMap.get("currency"));
                 	productList = list();
                 	if(requestMap.containKey("items") && requestMap.get("items") != null)
                 	{
                 		for each  item in requestMap.get("items")
                 		{
                 			product = Map();
                 			product.put("product_id",item.get("product_id"));
                 			product.put("product_name",item.get("product_name"));
                 			product.put("size",item.get("itemsize"));
                 			product.put("price",item.get("price"));
                 			product.put("quantity",item.get("quantity"));
                 			product.put("notes",item.get("notes"));
                 			modifiers = list();
                 			addons = list();
                 			if(item.containKey("modifiers") && item.get("modifiers") != null)
                 			{
                 				for each  mod in item.get("modifiers")
                 				{
                 					modEntry = Map();
                 					modEntry.put("type",mod.get("type"));
                 					modEntry.put("id",mod.get("id"));
                 					modEntry.put("values",mod.get("values"));
                 					if(mod.get("type").toString() == "5")
                 					{
                 						addons.add(modEntry);
                 					}
                 					else
                 					{
                 						modifiers.add(modEntry);
                 					}
                 				}
                 			}
                 			product.put("modifiers",modifiers);
                 			product.put("addons",addons);
                 			productList.add(product);
                 		}
                 	}
                 	// Add product section
                 	response.put("products",productList);
                 	// Add meta sections
                 	response.put("type",requestMap.get("type"));
                 	if(requestMap.containKey("pickup_details"))
                 	{
                 		response.put("pickup_details",requestMap.get("pickup_details"));
                 	}
                 	if(requestMap.containKey("coupon_section"))
                 	{
                 		response.put("coupon",requestMap.get("coupon_section"));
                 	}
                 	if(requestMap.containKey("redeem_section"))
                 	{
                 		response.put("redeem",requestMap.get("redeem_section"));
                 	}
                 	if(requestMap.containKey("payment_summary"))
                 	{
                 		response.put("payment_summary",requestMap.get("payment_summary"));
                 	}
                 	return response;
                 }
				 void signupmanagement.signupbonussettlement(int customer_id)
                 {
                 	cust = Customer[ID == customer_id];
                 	try 
                 	{
                 		thisapp.loyaltyEngine.creditbonuspoint_V2(cust.Phone_Number.tostring());
                 	}	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Bonus Point Exception",e);
                 	}
                 	try 
                 	{
                 		//thisapp.crmIntegration.pushCustomersToCrm(cust.Name,cust.Email,cust.Phone_Number);
                 	}	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("CRM Push Error",e);
                 	}
                 	try 
                 	{
                 		str1 = " ";
                 		val = leftpad(str1,99);
                 		lst_val = val.replaceAll(" ","0,").toList();
                 		for each index i in lst_val
                 		{
                 			idText = randomNumber(100000,999999);
                 			//zoho.randomNumber(1000,999999).tostring(); //customer_id.toString();
                 			//	last6 = if(idText.length() > 6,idText.substring(idText.length() - 6,idText.length()),idText);
                 			refCode = "PEETS" + idText;
                 			//info refCode;
                 			existingCount = Customer[Referral_Code == refCode].count();
                 			if(existingCount == 0)
                 			{
                 				cust.Referral_Code=refCode;
                 				break;
                 			}
                 		}
                 	}	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Referral code error",e);
                 	}
                 }
				 void temp.customer_transfertopoint()
                 {
                 	lstcustomers = Customer[ID != 0];
                 	memRec = Membership_Points_System[Membership_Level == "Silver"].ID;
                 	count = 0;
                 	for each  customer in lstcustomers
                 	{
                 		phone = customer.Phone_Number.trim();
                 		if(phone != null && phone != "")
                 		{
                 			isAvailable = Customer_Points_System[Import_Phone_No == phone && Customer == customer.ID];
                 			if(isAvailable.count() == 0)
                 			{
                 				count = count + 1;
                 				insert into Customer_Points_System
                 				[
                 					Customer=customer.ID
                 					Import_Phone_No=phone
                 					Available_Points=0
                 					Membership_Level_System=memRec
                 					Total_Points_Earned=0
                 					Total_Points_Burned=0
                 					Bonus_Points_Earned=0
                 					Bonus_Points_Burned=0
                 					Bonus_Points_Expired=0
                 					Added_User=zoho.loginuser
                 				]
                 			}
                 		}
                 	}
                 	info "Total records inserted : " + count;
                 }
				 void temp.temp_sharecode()
                 {
                 	lstcustomer = Customer[Referral_Code == null || Referral_Code == ""];
                 	//info lstcustomer.count();
                 	for each  customer in lstcustomer
                 	{
                 		idText = customer.ID.toString();
                 		last6 = if(idText.length() > 6,idText.substring(idText.length() - 6,idText.length()),idText);
                 		refCode = "PEETS" + last6;
                 		customer.Referral_Code=refCode;
                 	}
                 }
				 void temp.temp_update_refcode(string customer_id)
                 {
                 	cust = Customer[ID == customer_id.tolong()];
                 	idText = randomNumber(100000,999999);
                 	//zoho.randomNumber(1000,999999).tostring(); //customer_id.toString();
                 	//	last6 = if(idText.length() > 6,idText.substring(idText.length() - 6,idText.length()),idText);
                 	refCode = "PEETS" + idText;
                 	cust.Referral_Code=refCode;
                 }
