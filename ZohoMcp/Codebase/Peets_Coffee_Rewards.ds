				 string publicUrls.generatePublicImageUrl(string rec, string imageFieldApiName, string appOwner, string appLinkName, string reportLinkName, string publicKey)
                 {
                 	imageUrl = "";
                 	if(rec != null && rec.get(imageFieldApiName) != null)
                 	{
                 		rawImage = rec.get(imageFieldApiName);
                 		filePath = rawImage.getSuffix("/image").getPrefix("\"").trim();
                 		imageUrl = "https://creatorapp.zohopublic.com/file/" + appOwner + "/" + appLinkName + "/" + reportLinkName + "/" + rec.get("ID").toString() + "/" + imageFieldApiName + "/image-download/" + publicKey + "?filepath=" + filePath;
                 	}
                 	return imageUrl;
                 }
