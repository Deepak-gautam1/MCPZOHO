				 map appspages.getcontactus()
                 {
                 	// Fetch localizable strings
                 	objlocalappstring = thisapp.fetchRecords.localisableAppStringsV2("0","0");
                 	// Extract contact_us_view_strings map
                 	contact_strings = objlocalappstring.get("contact_us_view_strings");
                 	if(contact_strings == null)
                 	{
                 		contact_strings = Map();
                 	}
                 	// Initialize root response map
                 	responseMap = Map();
                 	resultMap = Map();
                 	// --- Header Section ---
                 	headerSection = Map();
                 	backIcon = Map();
                 	backgroundImage = Map();
                 	backIcon.put("img_url","<img_url>");
                 	backIcon.put("report_name","All_Home_Overviews");
                 	backIcon.put("image_src","1724230804415_Profile.png");
                 	backIcon.put("field_name","Image");
                 	backgroundImage.put("img_url","<img_url>");
                 	backgroundImage.put("report_name","All_Home_Overviews");
                 	backgroundImage.put("image_src","1724230804415_Profile.png");
                 	backgroundImage.put("field_name","Image");
                 	header_name = contact_strings.get("view_title");
                 	if(header_name == null)
                 	{
                 		header_name = "Contact us";
                 	}
                 	headerSection.put("back_icon_image",thisapp.publicUrls.getlogoimages("41"));
                 	headerSection.put("background_image",thisapp.publicUrls.getlogoimages("29"));
                 	headerSection.put("header_name",header_name);
                 	// --- Contact Us Section ---
                 	contactUsSection = Map();
                 	// Contact image
                 	contactImage = Map();
                 	contactImage.put("img_url","<img_url>");
                 	contactImage.put("report_name","All_Home_Overviews");
                 	contactImage.put("image_src","1724230804415_Profile.png");
                 	contactImage.put("field_name","Image");
                 	contactUsSection.put("contact_us_image",thisapp.publicUrls.getlogoimages("13"));
                 	// Message text
                 	messageText = contact_strings.get("description");
                 	if(messageText == null)
                 	{
                 		messageText = "For questions about the app send us a message and we will do our best to help you!";
                 	}
                 	contactUsSection.put("message_text",messageText);
                 	// Email image
                 	emailImage = Map();
                 	emailImage.put("img_url","<img_url>");
                 	emailImage.put("report_name","All_Home_Overviews");
                 	emailImage.put("image_src","1724230804415_Profile.png");
                 	emailImage.put("field_name","Image");
                 	contactUsSection.put("email_image",thisapp.publicUrls.getlogoimages("64"));
                 	// Email text
                 	emailText = contact_strings.get("contact_email");
                 	if(emailText == null)
                 	{
                 		emailText = "amr.peetsappsupport@americana-food.com";
                 	}
                 	contactUsSection.put("email_text",emailText);
                 	// Follow us text (static fallback)
                 	contactUsSection.put("follow_us_text","Follow us");
                 	// --- Social Media Apps List ---
                 	// 	socialApps = list();
                 	// 	for each  i in {1,2,3}
                 	// 	{
                 	// 		app = Map();
                 	// 		appImage = Map();
                 	// 		appImage.put("img_url","<img_url>");
                 	// 		appImage.put("report_name","All_Home_Overviews");
                 	// 		appImage.put("image_src","1724230804415_Profile.png");
                 	// 		appImage.put("field_name","Image");
                 	// 		app.put("app_image",appImage);
                 	// 		app.put("account_url","<account_url>");
                 	// 		socialApps.add(app);
                 	// 	}
                 	socialApps = List();
                 	// Define the image type numbers for social media icons
                 	imageNumbers = Map();
                 	imageNumbers.put(1,"65");
                 	imageNumbers.put(2,"66");
                 	imageNumbers.put(3,"69");
                 	//imageNumbers.put(3,"67");
                 	//imageNumbers.put(4,"68");
                 	accountUrls = Map();
                 	accountUrls.put(1,"https://www.facebook.com/peetscoffeeuae");
                 	accountUrls.put(2,"https://www.instagram.com/peetscoffeeuae");
                 	accountUrls.put(3,"https://twitter.com/@peetscoffeeuae");
                 	for each  i in {1,2,3}
                 	{
                 		app = Map();
                 		appImage = Map();
                 		img_number = imageNumbers.get(i);
                 		img_url = thisapp.publicUrls.getlogoimages(img_number);
                 		// Dynamically fetched using image number
                 		appImage.put("img_url","<img_url>");
                 		appImage.put("report_name","All_Home_Overviews");
                 		appImage.put("image_src",img_url);
                 		appImage.put("field_name","Image");
                 		app.put("app_image",appImage);
                 		app.put("account_url",accountUrls.get(i));
                 		socialApps.add(app);
                 	}
                 	contactUsSection.put("social_media_apps",socialApps);
                 	// --- Assemble Final Response ---
                 	resultMap.put("header_section",headerSection);
                 	resultMap.put("contact_us_section",contactUsSection);
                 	responseMap.put("result",resultMap);
                 	responseMap.put("code","3000");
                 	responseMap.put("type","profile_10");
                 	return responseMap;
                 }
				 map appspages.logoutresponce()
