				 string crmIntegration.pushCustomersToCrm(String lastName, String email, String phone)
                 {
                 	try 
                 	{
                 		param = {"Last_Name":lastName,"Email":email,"Phone":phone,"Added_Time":zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ss"),"Status":"Active","Loyalty_Brand":1,"Brand_Name":"Peet's Coffee"};
                 		response = zoho.crm.createRecord("Contacts",param);
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="Function - crmIntegration.pushCustomersToCrm - Crm Contact Push Record Response"
                 			error=response
                 		];
                 		return response.get("id");
                 	}	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - crmIntegration.pushCustomersToCrm",e);
                 	}
                 	return null;
                 }
				 int customerProfile.addNewCustomer(String lastName, String number)
                 {
                 	try 
                 	{
                 		firstChar = lastName.subString(0,1).toUpperCase();
                 		lastNameLength = lastName.toList("").size();
                 		lastName = firstChar + lastName.subString(1,lastNameLength - 1);
                 		membershiplevelid = Membership_Points_System[Membership_Level == "Silver"];
                 		try 
                 		{
                 			newCustomer = insert into Customer
                 			[
                 				Added_User=zoho.loginuser
                 				Name=lastName
                 				Country=Market[Market_Name == "UAE"].ID
                 				Status="Active"
                 				Phone_Number=number
                 			];
                 			if(isNumber(newCustomer))
                 			{
                 				history = insert into Member_History
                 				[
                 					Added_User=zoho.loginuser
                 					Customer=newCustomer
                 					Start_Time=zoho.currenttime
                 				];
                 			}
                 		}
                 		catch (e)
                 		{
                 			thisapp.ErrorHandling.catchCall("Function - customerProfile.addNewCustomer - Duplicate Call",e);
                 			return Customer[Phone_Number == number].ID;
                 		}
                 		relatedCRMID = thisapp.crmIntegration.pushCustomersToCrm(lastName,"",number);
                 		//Old_Membership_Level="Silver"
                 		customerPoints = insert into Customer_Points_System
                 		[
                 			Added_User=zoho.loginuser
                 			Customer=newCustomer
                 			Total_Points_Burned=0
                 			Total_Points_Earned=0
                 			Available_Points=0
                 			Is_Free_drink_available=true
                 			Membership_Level_System=membershiplevelid
                 			Related_CRM_ID=relatedCRMID
                 			Free_Drink_Expiry_Date=zoho.currentdate.addMonth(1)
                 			Free_Drink_Status="Available"
                 		];
                 		return newCustomer;
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - customerProfile.addNewCustomer - Final Catch",e);
                 	}
                 	return null;
                 }
				 int customerProfile.checkLoginUserMobile()
                 {
                 	number = zoho.loginuser.mobilenumber;
                 	if(number != null)
                 	{
                 		customer = Customer[Phone_Number == number];
                 		if(customer.count() > 0)
                 		{
                 			return customer.ID;
                 		}
                 	}
                 	return 0;
                 }
				 map customerProfile.createNewCustomer(string fullname, string emailaddress, string mobile, string mobileno, string gender, string dateofbirth, string nationality, string referal_code)
                 {
                 	response = Map();
                 	response.put("is_done",false);
                 	response.put("message","Profile not created successfully");
                 	try 
                 	{
                 		dialing_code = mobile.left(4);
                 		if(dialing_code == "" || dialing_code == null)
                 		{
                 			dialing_code = "+971";
                 		}
                 		market_global = global_configuration.fetchrecord.getmarketbydialingcode(dialing_code);
                 		// ✅ Insert 1 moved to sub-function
                 		customer_id = thisapp.customerProfile.insertCustomer(fullname,gender,emailaddress,mobile,market_global,dateofbirth,nationality);
                 		// ✅ Insert 2 moved to sub-function
                 		thisapp.customerProfile.insertMemberHistory(customer_id);
                 		relatedCRMID = "";
                 		membershiplevelid = Membership_Points_System[Membership_Level == "Silver"].ID;
                 		try 
                 		{
                 			relatedCRMID = thisapp.crmIntegration.pushCustomersToCrm(fullname,emailaddress,mobileno);
                 		}		catch (e)
                 		{
                 		}
                 		// ✅ Insert 3 moved to sub-function
                 		thisapp.customerProfile.insertCustomerPoints(customer_id.tostring(),membershiplevelid.tostring(),relatedCRMID);
                 		thisapp.signupmanagement.signupbonussettlement(customer_id.tolong());
                 		if(referal_code != null || referal_code != "")
                 		{
                 			thisapp.creditbonus.referalbonuscredit(referal_code.trim().tostring(),mobile.tostring());
                 		}
                 		response.put("is_done",true);
                 		response.put("message","Profile created successfully");
                 	}	catch (e)
                 	{
                 		response.put("is_done",false);
                 		response.put("message","Error occurred: " + e.toString());
                 		thisapp.ErrorHandling.catchCall("createNewCustomer",e.tostring());
                 	}
                 	return response;
                 }
