				 void customerProfile.deleteCustomer(String loginUserPhone)
                 {
                 	try 
                 	{
                 		customer = Customer[Phone_Number == loginUserPhone];
                 		customer.Status="In Active";
                 		endTime = zoho.currenttime;
                 		getHistory = Member_History[Customer == customer.ID] sort by Added_Time desc,ID;
                 		getHistory.End_Time=endTime;
                 		getHistory.No_of_Days=getHistory.Start_Time.daysBetween(endTime);
                 		thisapp.crmIntegration.deleteCrmContact(customer.Customer_Points_System_Total_Points_Earned.Related_CRM_ID);
                 		/* delete from Transaction[Customer == customer.ID];
                                  		delete from Customer_Points_System[Customer == customer.ID];
                                  		delete from Customer[ID == customer.ID]; */
                 		thisapp.portal.deleteUser(loginUserPhone);
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - customerProfile.deleteCustomer",e);
                 	}
                 }
				 map customerProfile.deleteCustomer_V2(String loginUserPhone)
                 {
                 	response = Map();
                 	response.put("is_Deleted",false);
                 	response.put("message","");
                 	try 
                 	{
                 		customer = Customer[Phone_Number == loginUserPhone];
                 		customer.Status="In Active";
                 		endTime = zoho.currenttime;
                 		getHistory = Member_History[Customer == customer.ID] sort by Added_Time desc,ID;
                 		getHistory.End_Time=endTime;
                 		getHistory.No_of_Days=getHistory.Start_Time.daysBetween(endTime);
                 		//thisapp.crmIntegration.deleteCrmContact(customer.Customer_Points_System_Total_Points_Earned.Related_CRM_ID);
                 		/* delete from Transaction[Customer == customer.ID];
                                  		delete from Customer_Points_System[Customer == customer.ID];
                                  		delete from Customer[ID == customer.ID]; */
                 		thisapp.portal.deleteUser(loginUserPhone);
                 		response.put("is_Deleted",true);
                 		response.put("message","Account deleted successfully");
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - customerProfile.deleteCustomer",e);
                 		response.put("is_Deleted",false);
                 		response.put("message","Error");
                 	}
                 	response = thisapp.accounts_handler.deleteaccount();
                 	return response;
                 }
				 map customerProfile.getCustomerInfo(string custmobileno)
                 {
                 	// string custmobileno
                 	//string custmobileno
                 	//custmobileno = "+971581204371";
                 	// 	return {"ph": custmobileno};
                 	customer_info = Map();
                 	customer_record = Customer[Phone_Number == custmobileno.trim()];
                 	if(customer_record != null)
                 	{
                 		points_record = Customer_Points_System[Customer == customer_record.ID];
                 		//	info points_record.Membership_Level_System;
                 		if(points_record != null)
                 		{
                 			//membership_level = points_record.Old_Membership_Level;
                 			membership_level = Membership_Points_System[ID == points_record.Membership_Level_System].Membership_Level;
                 			//info membership_level;
                 			membership_details = Membership_Details_H[Membership_Tier.Membership_Level == membership_level];
                 			// Bullet point rules for earning
                 			earning_rules_list = List();
                 			expiration_rules_list = List();
                 			for each  bullet in membership_details.Bullet_points
                 			{
                 				if(bullet.Description_Type == "Earn" && bullet.For_Display_on_customer_info == true)
                 				{
                 					earning_rules_list.add(bullet.Earning_Rules);
                 				}
                 				if(bullet.Description_Type == "Burn" && bullet.For_Display_on_customer_info == true)
                 				{
                 					expiration_rules_list.add(bullet.Earning_Rules);
                 				}
                 			}
                 			// Slider information setup
                 			slider_list = List();
                 			slider_info = Map();
                 			current_membership = Membership_Points_System[Membership_Level == membership_level];
                 			next_membership = Membership_Points_System[Position == current_membership.Position + 1];
                 			//info next_membership;
                 			//info next_membership;
                 			// Find highest tier position
                 			nextmembershipidv = Membership_Details_H[Membership_Tier.Membership_Level == next_membership.Membership_Level];
                 			all_memberships = Membership_Points_System[ID != 0];
                 			highest_position = 0;
                 			for each  membership in all_memberships
                 			{
                 				if(membership.Position > highest_position)
                 				{
                 					highest_position = membership.Position;
                 				}
                 			}
                 			// Add slider info
                 			slider_info.put("current_tier",current_membership.Membership_Level);
                 			slider_info.put("current_tier_id",current_membership.Membership_Level);
                 			if(next_membership != null)
                 			{
                 				slider_info.put("next_tier",next_membership.Membership_Level);
                 				//slider_info.put("next_tier_threshold",next_membership.To.toString());
                 				slider_info.put("next_tier_threshold",current_membership.To.toString());
                 			}
                 			else
                 			{
                 				slider_info.put("next_tier","");
                 				slider_info.put("next_tier_threshold","");
                 			}
                 			slider_info.put("current_tier_threshold",current_membership.From.toString());
                 			slider_info.put("points_earned",ifnull(points_record.Total_Points,0).tostring());
                 			//info membership_details.ID.tostring();
                 			slider_info.put("slider_icon_from",thisapp.publicUrls.getmembershipicons(membership_details.ID.tostring(),"SliderIcon").getJson("public_image_src"));
                 			//info current_membership.ID.tostring();
                 			slider_info.put("slider_icon_to",thisapp.publicUrls.getmembershipicons(nextmembershipidv.ID.tostring(),"SliderIcon").getJson("public_image_src"));
                 			slider_info.put("slider_icon_selected",thisapp.publicUrls.getlogoimages("16"));
                 			if(current_membership.Position < highest_position)
                 			{
                 				slider_info.put("show_slider","true");
                 			}
                 			else
                 			{
                 				slider_info.put("show_slider","false");
                 			}
                 			slider_info.put("min","0");
                 			slider_info.put("max","1");
                 			// 	info current_membership;
                 			// 	info next_membership;
                 			// 	info points_record;
                 			// 			slider_info.put("selected",thisapp.customerslider.getSliderValue(current_membership.To.toString(),next_membership.To.toString(),points_record.Total_Points_Earned.toString()));
                 			current_to = ifnull(current_membership.From,0).toString();
                 			next_to = ifnull(current_membership.To,0).toString();
                 			total_points = ifnull(points_record.Total_Points_Earned,0).toString();
                 			// 			info "+current " + current_to;
                 			// 			info "next " + next_to;
                 			// 			info "total " + total_points;
                 			//next_to =6000;
                 			slider_info.put("selected",thisapp.customerslider.getSliderValue(current_to,next_to,total_points));
                 			//slider_info.put("selected","0.50");
                 			slider_list.add(slider_info);
                 			// Final customer info map
                 			customer_info.put("customer_id",customer_record.ID.toString());
                 			customer_info.put("customer_market",customer_record.Market_Global.tostring());
                 			customer_info.put("customer_name",customer_record.Name);
                 			customer_info.put("current_membership_tier",membership_level.toString());
                 			customer_info.put("total_points_earned",points_record.Total_Points_Earned.toString());
                 			customer_info.put("total_points_used",points_record.Total_Points_Burned.toString());
                 			customer_info.put("available_points",ifnull(points_record.Available_Points,0).tolong() + ifnull(points_record.Bonus_Points,0).tolong());
                 			customer_info.put("expired_points",points_record.Total_Points_Expired.toString());
                 			customer_info.put("earning_rules",earning_rules_list);
                 			customer_info.put("expiration_rules",expiration_rules_list);
                 			customer_info.put("membership_slider_info",slider_list);
                 		}
                 		else
                 		{
                 			customer_info.put("error","Customer point details not found.");
                 		}
                 	}
                 	else
                 	{
                 		customer_info.put("error","Customer not found.");
                 	}
                 	return customer_info;
                 }
				 map customerProfile.getCustomerinfoTest()
                 {
                 	// string custmobileno
                 	custmobileno = "+97111223344";
                 	customer_info = Map();
                 	customer_record = Customer[Phone_Number == input.custmobileno];
                 	if(customer_record != null)
                 	{
                 		points_record = Customer_Points_System[Customer == customer_record];
                 		if(points_record != null)
                 		{
                 			//membership_level = points_record.Old_Membership_Level;
                 			membership_level = Membership_Points_System[ID == points_record.Membership_Level_System].Membership_Level;
                 			membership_details = Membership_Details_H[Membership_Tier.Membership_Level == membership_level];
                 			// Bullet point rules for earning
                 			earning_rules_list = List();
                 			expiration_rules_list = List();
                 			for each  bullet in membership_details.Bullet_points
                 			{
                 				if(bullet.Description_Type == "Earn" && bullet.For_Display_on_customer_info == true)
                 				{
                 					earning_rules_list.add(bullet.Earning_Rules);
                 				}
                 				if(bullet.Description_Type == "Burn" && bullet.For_Display_on_customer_info == true)
                 				{
                 					expiration_rules_list.add(bullet.Earning_Rules);
                 				}
                 			}
                 			// Slider information setup
                 			slider_list = List();
                 			slider_info = Map();
                 			info membership_level;
                 			current_membership = Membership_Points_System[Membership_Level == membership_level];
                 			next_membership = Membership_Points_System[Position == current_membership.Position + 1];
                 			// Find highest tier position
                 			nextmembershipidv = Membership_Details_H[Membership_Tier.Membership_Level == next_membership.Membership_Level];
                 			all_memberships = Membership_Points_System[ID != 0];
                 			highest_position = 0;
                 			for each  membership in all_memberships
                 			{
                 				if(membership.Position > highest_position)
                 				{
                 					highest_position = membership.Position;
                 				}
                 			}
                 			// Add slider info
                 			slider_info.put("current_tier",current_membership.Membership_Level);
                 			slider_info.put("current_tier_id",current_membership.Membership_Level);
                 			if(next_membership != null)
                 			{
                 				slider_info.put("next_tier",next_membership.Membership_Level);
                 				slider_info.put("next_tier_threshold",next_membership.To.toString());
                 			}
                 			else
                 			{
                 				slider_info.put("next_tier","");
                 				slider_info.put("next_tier_threshold","");
                 			}
                 			slider_info.put("current_tier_threshold",current_membership.To.toString());
                 			slider_info.put("points_earned",points_record.Total_Points_Earned.toString());
                 			//info membership_details.ID.tostring();
                 			slider_info.put("slider_icon_from",thisapp.publicUrls.getmembershipicons(membership_details.ID.tostring(),"SliderIcon").getJson("public_image_src"));
                 			//info current_membership.ID.tostring();
                 			slider_info.put("slider_icon_to",thisapp.publicUrls.getmembershipicons(nextmembershipidv.ID.tostring(),"SliderIcon").getJson("public_image_src"));
                 			slider_info.put("slider_icon_selected",thisapp.publicUrls.getlogoimages("16"));
                 			if(current_membership.Position < highest_position)
                 			{
                 				slider_info.put("show_slider","true");
                 			}
                 			else
                 			{
                 				slider_info.put("show_slider","false");
                 			}
                 			slider_info.put("min","0");
                 			slider_info.put("max","1");
                 			current_to = ifnull(current_membership.To,0).toString();
                 			next_to = ifnull(next_membership.To,0).toString();
                 			total_points = ifnull(points_record.Total_Points_Earned,0).toString();
                 			info "+current " + current_to;
                 			info "next " + next_to;
                 			info "total " + total_points;
                 			slider_info.put("selected",thisapp.customerslider.getSliderValue(current_to,next_to,total_points));
                 			slider_list.add(slider_info);
                 			// Final customer info map
                 			customer_info.put("customer_id",customer_record.ID.toString());
                 			customer_info.put("customer_market",customer_record.Market_Global.tostring());
                 			customer_info.put("customer_name",customer_record.Name);
                 			customer_info.put("current_membership_tier",membership_level.toString());
                 			customer_info.put("total_points_earned",points_record.Total_Points_Earned.toString());
                 			customer_info.put("total_points_used",points_record.Total_Points_Burned.toString());
                 			customer_info.put("available_points",points_record.Available_Points.toString());
                 			customer_info.put("expired_points",points_record.Total_Points_Expired.toString());
                 			customer_info.put("earning_rules",earning_rules_list);
                 			customer_info.put("expiration_rules",expiration_rules_list);
                 			customer_info.put("membership_slider_info",slider_list);
                 		}
                 		else
                 		{
                 			customer_info.put("error","Customer point details not found.");
                 		}
                 	}
                 	else
                 	{
                 		customer_info.put("error","Customer not found.");
                 	}
                 	return customer_info;
                 }
