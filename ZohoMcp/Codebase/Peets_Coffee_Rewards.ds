				 map customerProfile.getuserprofiledetailbyid(string loggeninmobileno, string mobileno, string display_name)
                 {
                 	// 	loggeninmobileno = "+971581204371";
                 	// 	mobileno = "+971581204371";
                 	// 	display_name = "mathan Sir";
                 	response = Map();
                 	result = Map();
                 	// Fetch customer record
                 	lstcustomer = Customer[Phone_Number == loggeninmobileno];
                 	//	info lstcustomer;
                 	if(lstcustomer.count() > 0)
                 	{
                 		cart_id = Cart_Order_Test[Customer == lstcustomer.ID && Type_field == "Cart"].ID;
                 	}
                 	else
                 	{
                 		cart_id = null;
                 	}
                 	//info lstcustomer.ID;
                 	if(lstcustomer.count() > 0)
                 	{
                 		objcustomer = lstcustomer;
                 		// --------------------------
                 		// Header Section
                 		// --------------------------
                 		header_section = Map();
                 		back_icon_image = Map();
                 		back_icon_image.put("img_url",thisapp.publicUrls.getlogoimages("41"));
                 		header_section.put("back_icon_image",back_icon_image);
                 		background_image = Map();
                 		background_image.put("img_url",thisapp.publicUrls.getlogoimages("31"));
                 		header_section.put("background_image",background_image);
                 		header_section.put("header_name","My Profile");
                 		edit_icon_image = Map();
                 		edit_icon_image.put("img_url",thisapp.publicUrls.getlogoimages("31"));
                 		header_section.put("edit_icon_image",edit_icon_image);
                 		// --------------------------
                 		// Profile Section
                 		// --------------------------
                 		profile_section = Map();
                 		profile_image = Map();
                 		profile_image.put("img_url","<img_url>");
                 		// Replace if you have profile image logic
                 		profile_section.put("profile_image",thisapp.publicUrls.getuserimage(lstcustomer.ID.tostring()));
                 		profile_section.put("full_name",ifnull(objcustomer.Name,""));
                 		profile_section.put("email_address",ifnull(objcustomer.Email,""));
                 		// Phone Number with Country Flag
                 		market = global_configuration.fetchrecord.getmarketshortbyid(objcustomer.Market_Global);
                 		phone_number = Map();
                 		country_flag = Map();
                 		country_flag.put("img_url","<img_url>");
                 		phone_number.put("country_flag",market.get("flag"));
                 		phone_number.put("phone_number",ifnull(objcustomer.Phone_Number,""));
                 		profile_section.put("phone_number",phone_number);
                 		if(objcustomer.Date_Of_Birth != null)
                 		{
                 			profile_section.put("date_of_birth",objcustomer.Date_Of_Birth.toDate().toString("dd-MMM-yyyy"));
                 		}
                 		else
                 		{
                 			profile_section.put("date_of_birth","");
                 		}
                 		profile_section.put("gender",ifnull(objcustomer.Gender,""));
                 		if(objcustomer.Nationality_Global != null)
                 		{
                 			profile_section.put("nationality",global_configuration.fetchrecord.getnationalitybyid(objcustomer.Nationality_Global.tostring()).get("name"));
                 			profile_section.put("nationality_id",global_configuration.fetchrecord.getnationalitybyid(objcustomer.Nationality_Global.tostring()).get("ID"));
                 		}
                 		profile_section.put("display_name",display_name);
                 		// --------------------------
                 		// Combine Sections
                 		// --------------------------
                 		result.put("header_section",header_section);
                 		result.put("profile_section",profile_section);
                 	}
                 	response.put("display_name",display_name);
                 	response.put("result",result);
                 	//response.put("code","3000");
                 	response.put("type","profile_1");
                 	response.put("cartid",cart_id.tostring());
                 	response.put("nationality",global_configuration.fetchrecord.getlstNationality());
                 	if(lstcustomer.count() > 0)
                 	{
                 		response.put("is_user_present",true);
                 	}
                 	else
                 	{
                 		response.put("is_user_present",false);
                 	}
                 	response.put("mobileno",loggeninmobileno.tostring());
                 	return response;
                 }
