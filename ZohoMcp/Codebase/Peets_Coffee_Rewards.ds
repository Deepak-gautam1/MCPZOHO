                 	m.put("description","Our APP is intended only for users aged 18+. Ages 13–18 may use under guardian supervision. You agree to create one account, provide accurate info, maintain security, and accept responsibility for account activity.");
                 	m.put("points",List());
                 	privacyList.add(m);
                 	// ===== YOUR RIGHTS AND CHOICES =====
                 	m = Map();
                 	m.put("heading","YOUR RIGHTS AND CHOICES");
                 	m.put("description","You have control over how we use your information and may exercise the following rights subject to applicable laws:");
