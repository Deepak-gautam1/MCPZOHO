	pages
	{
		page Customer_Home
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\t//thisapp.fetchRecords.getHomePageResponse();\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Dashboard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t\n</layout>\n</zml>"
		}
		page Loyalty_Engine(string tab, string tabA, string tabB, string tabC)
		{
			displayname = "Loyalty Engine"
			Content="<zml    \t\t\n\t\t\n\t\t\tbgColor='#FFFFFF'\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet1' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet1()\ncontent\n&lt;%{\n\t// \tmarketList = thisapp.loyaltyEngineCSS.getMarkets();\n\t// \t&lt;a href=&quot;#Page:Loyalty_Engine?tab=3&quot;&gt;&lt;div class=&quot;&lt;%=input.tabC%&gt;&quot;&gt;Redemption Rules&lt;/div&gt;&lt;/a&gt;\n\t%&gt;\n&lt;style&gt;\n  .parent_container {\n\t  height: calc(100vh - 100px);\n\t  \n\t  \n  }\n .tab_container {\n\t display: flex; \n\t border-bottom: 1px solid #ddd;\n }\n .tab_style, .tab_active {\n    padding: 8px 12px 8px 12px;\n    letter-spacing: 0.1px;\n    margin: 10px 0 0 15px;\n\tcolor: #aaa;\n}\n.tab_active {\n\tcolor: #000;\n    border-bottom: 1.8px solid #BA925F;\n\t\n}\n.rules_list_div {\n    display: flex;\n    overflow: auto;\n    height: calc(100% - 80px);\n\tmargin: 15px;\n}\n.rules_container {\n    width: 400px;\n    margin: 0 15px 0 0px;\n    height: 100%;\n    background: #fcfcfc;\n    border: 1px solid #eeeeee57;\n\toverflow: auto;\n}\n.container_country_sec {\n\tdisplay: flex;\n    justify-content: space-between;\n}\n\n.country_name_div {\n    padding: 4px 15px 4px 15px;\n    background: #9D8668;\n    border-radius: 50px;\n    width: max-content;\n    color: #fff;\n    font-size: 12px;\n    margin: 10px 0 15px 10px;\n   \n}\n\n.add_new_ic {\n\twidth: 20px;\n    height: 20px;\n    background: #c2c2c2;\n    display: flex;\n    border-radius: 50%;\n    font-size: 18px;\n    margin: 10px 10px 0px 0px;\n    justify-content: center;\n    align-items: center;\n    color: #fff;\n}\n.rule_panel, .member_points_panel {\n    background: #fff;\n    margin: 10px 10px 0 10px;\n    box-shadow: 0 0 2px 0 #ddd;\n    border-radius: 4px;\n\tposition: relative;\n\tcursor: pointer;\n\tdisplay: flex;\n\talign-items: flex-end;\n\toverflow: hidden\n}\n\n.rule_panel:hover .ppp {\n\tdisplay: block;\n}\n\n.ppp {\n    padding: 0 10px 10px 0;\n    display: none;\n}\n\n\n.rule_panel:hover {\n    transform: scale(1.005);\n    background-image: linear-gradient(45deg, #bb976a1f, #f7f6f000, transparent);\n}\n\n.offer_sec {\n\tdisplay: flex;\n\tjustify-content: space-between;\n\theight: 31px;\n}\n\n.secondary_sec {\n\tdisplay: flex;\n    align-items: center;\n}\n\n.offer_name {\n    font-weight: 500;\n    padding: 10px 0 0 10px;\n}\n\n.offer_status {\n        background: #00ff0026;\n    width: max-content;\n    padding: 3px 13px 3px 13px;\n    margin: 9px 10px 0 0px;\n    font-size: 12px;\n    box-sizing: border-box;\n    border-radius: 50px;\n    color: #008000;\n    border: 0.5px solid #00800047;\n    position: absolute;\n    top: 0;\n    right: 0;\n}\n.point_div, .drink_div, .currency_fill, .respective_points_fill {\n    font-size: 12px;\n    font-weight: 500;\n    background: #415365;\n    color: #fff;\n    padding: 4px 8px 4px 8px;\n    width: max-content;\n    border-radius: 50px;\n    margin: 5px 0 0 6px;\n\tdisplay: flex;\n\talign-items: center;\n}\n\n.drink_div {\n\tfont-weight: 400;\n    padding: 2px 8px 2px 8px;\n\tbackground: 0;\n    background-image: linear-gradient(45deg, #415365, #5e6638bf);\n    text-shadow: 0.5px 0px 0px #66605c;\n}\n\n.star_water_mark {\n\t\n    background-image: url(&apos;https://i.postimg.cc/Nfpj6Njj/Screenshot-2024-06-27-at-7-10-36-PM.png&apos;);\n    position: absolute;\n    height: 60px;\n    width: 60px;\n    bottom: 10px;\n    right: 5px;\n    background-size: 100%;\n\n}\n\n.drink_water_mark {\n\tbackground-image: url(&apos;https://i.postimg.cc/K8HR5Gz9/Screenshot-2024-06-27-at-7-48-46-PM.png&apos;);\n    position: absolute;\n    height: 60px;\n    width: 60px;\n    bottom: 10px;\n    right: 5px;\n    background-size: 100%;\n\tdisplay: none;\n\t\n}\n\n.desc {\n        z-index: 10;\n    position: relative;\n    font-size: 10px;\n    color: #aaa;\n    width: 100%;\n    padding: 10px 10px 10px 10px;\n    box-sizing: border-box;\n    line-height: 15px;\n}\n.tab_style:hover {\n    border-bottom: 1.5px solid #a5a5a5;\n}\n\n    .currency_fill {\n    background: #5F6738;\n    background-image: linear-gradient(45deg, #415365, transparent);\n}\n\n.respective_points_fill {\n\t\n}\n\n.membership_card {\n   font-size: 12px;\n    width: 80px;\n    padding: 4px 0 4px 9px;\n    box-sizing: border-box;\n    color: #fff;\n    position: relative;\n\n}\n\n.membership_card::before {\n          position: absolute;\n    content: &quot;&quot;;\n    width: 14.9px;\n    height: 14.8px;\n    right: -7.5px;\n    rotate: 45deg;\n    background: #fff;\n}\n\n.membership_points_txt {\n\tfont-weight: 500;\n    height: max-content;\n    font-size: 14px;\n    border: 1px solid #ccc;\n    padding: 2px 8px 2px 7px;\n    border-radius: 50px;\n    margin: 10px 0 0 10px;\n    background: #F7F6F0;\n}\n\n.flex-end {\n    display: flex;\n    justify-content: space-between;\n\talign-items: center\n}\n\n.member_offer {\n\t       background: #6a6262;\n    font-weight: 400;\n    font-size: 10px;\n    border: 1px solid #eee;\n    color: #e7e7e7;\n    /* align-items: center; */\n    height: max-content;\n    padding: 1px 7px 1px 7px;\n    margin: 0 8px 0 0;\n    border-radius: 50px;\n}\n\n.member_points_panel {\n    box-shadow: 0px 0px 3px 0 #cccccc;\n\tdisplay: block\n}\n\n\n\n.silver_medal {\n    background-image: linear-gradient(45deg, #585858, #C7C7C7);\n}\n\n.gold_medal {\n    background-image: linear-gradient(45deg, #BA8E3A, #FAC665);\n}\n\n.platinum_medal {\n    background-image: linear-gradient(45deg,#45457A, #8F92D4);\n}\n.silver_medal_container {\n// \tbox-shadow: 0 0 2px 0 #585858\t;\n\tbackground-image: linear-gradient(45deg, #58585812, transparent, transparent);\n}\n.gold_medal_container {\n// \tbox-shadow: 0 0 2px 0 #BA8E3A\t;\n\t background-image: linear-gradient(45deg, #ba8e3a1c, transparent, transparent);\n}\n\n.platinum_medal_container {\n// \tbox-shadow: 0 0 2px 0 #45457A;\n\tbackground-image: linear-gradient(45deg, #45457a1a, transparent, transparent);\n\t\n}\n\n.platinum_medal_container:hover {\n    background-image: linear-gradient(45deg, #45457a1a, transparent, transparent);\n}\n\n.gold_medal_container:hover {\n    background-image: linear-gradient(45deg, #ba8e3a1c, transparent, transparent);\n}\n\n.silver_medal_container:hover {\n    background-image: linear-gradient(45deg, #58585812, transparent, transparent);\n}\n&lt;/style&gt;\n  &lt;div class=&quot;parent_container&quot;&gt;\n\t  &lt;div class=&quot;tab_container&quot;&gt;\n\t\t&lt;a href=&quot;#Page:Loyalty_Engine?tab=1&quot;&gt;&lt;div class=&quot;&lt;%=input.tabA%&gt;&quot;&gt;Joining Benefit Rules&lt;/div&gt;&lt;/a&gt;\n\t\t&lt;a href=&quot;#Page:Loyalty_Engine?tab=2&quot;&gt;&lt;div class=&quot;&lt;%=input.tabB%&gt;&quot;&gt;Loyalty Earning Rules&lt;/div&gt;&lt;/a&gt;\n\t\t&lt;a href=&quot;#Page:Loyalty_Engine?tab=3&quot;&gt;&lt;div class=&quot;&lt;%=input.tabC%&gt;&quot;&gt;Membership Points&lt;/div&gt;&lt;/a&gt;\n\t\t\n\t  &lt;/div&gt;\n\t  &lt;div class=&quot;rules_list_div&quot;&gt;\n\t  &lt;%=thisapp.loyaltyEngineCSS.createContent(input.tab.toLong())%&gt;\n\t  &lt;/div&gt;\n  &lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
			script
			{
				if(input.tab == "1" || input.tab == null)
				{
					input.tab = "1";
					input.tabA = "tab_active";
					input.tabB = "tab_style";
					input.tabC = "tab_style";
				}
				else if(input.tab == "2")
				{
					input.tabA = "tab_style";
					input.tabB = "tab_active";
					input.tabC = "tab_style";
				}
				else if(input.tab == "3")
				{
					input.tabA = "tab_style";
					input.tabB = "tab_style";
					input.tabC = "tab_active";
				}
			}
		}
		page Onboarding_Page
