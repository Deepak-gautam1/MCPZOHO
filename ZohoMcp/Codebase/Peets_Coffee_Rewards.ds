                 		Bonus_Points_Earned=0
                 		Bonus_Points_Burned=0
                 		Bonus_Points_Expired=0
                 		Is_Free_drink_available=false
                 		Membership_Level_System=membershiplevelid.tolong()
                 		Related_CRM_ID=relatedCRMID
                 	];
                 }
				 void customerProfile.insertMemberHistory(string customer_id)
                 {
                 	history_id = insert into Member_History
                 	[
                 		Customer=customer_id.tolong()
                 		Start_Time=zoho.currenttime
                 		Added_User=zoho.loginuser
                 	];
                 }
				 map customerProfile.updateProfile(string mobileno, string customer)
                 {
                 	response = Map();
                 	response.put("is_done",false);
                 	response.put("message","Profile not updated successfully");
                 	try 
                 	{
                 		requestParameter = customer.toMap();
                 		profileinfo = requestParameter.get("profile_info");
                 		fullname = profileinfo.get("name");
                 		emailaddress = profileinfo.get("email_address");
                 		dateofbirth = profileinfo.get("date_of_birth");
                 		gender = profileinfo.get("gender");
                 		mobile = profileinfo.get("mobile_number").trim();
                 		nationality = profileinfo.get("nationality");
                 		referal_code = profileinfo.get("referal_code");
                 		customer_info = Customer[Phone_Number == mobile];
                 		if(customer_info.count() > 0)
                 		{
                 			customer_info.Name=fullname;
                 			customer_info.Gender=gender;
                 			customer_info.Email=emailaddress;
                 			customer_info.Nationality_Global=nationality;
                 			if(customer_info.Date_Of_Birth == null)
                 			{
                 				customer_info.Date_Of_Birth=dateofbirth;
                 			}
                 			response.put("is_done",true);
                 			response.put("message","Profile updated successfully");
                 		}
                 		else
                 		{
                 			// ✅ Only change: moved to sub-function to fix insert limit error
                 			newCustomerResult = thisapp.customerProfile.createNewCustomer(fullname,emailaddress,mobile,mobileno,gender,dateofbirth,nationality,referal_code);
                 			response.put("is_done",newCustomerResult.get("is_done"));
                 			response.put("message",newCustomerResult.get("message"));
                 		}
                 	}	catch (e)
                 	{
                 		info e;
                 		//thisapp.maintainance.user_info_mantainance(mobile);
                 		response.put("is_done",false);
                 		response.put("message","Error occurred: " + e.toString());
                 		thisapp.ErrorHandling.catchCall("update profile",e.tostring());
                 	}
                 	info response;
                 	return response;
                 }
				 map customerProfile.updateProfile_test(string mobileno, string customer)
                 {
                 	response = Map();
                 	response.put("is_done",false);
                 	response.put("message","Profile not updated successfully");
                 	try 
                 	{
                 		requestParameter = customer.toMap();
                 		profileinfo = requestParameter.get("profile_info");
                 		fullname = profileinfo.get("name");
                 		emailaddress = profileinfo.get("email_address");
                 		dateofbirth = profileinfo.get("date_of_birth");
                 		gender = profileinfo.get("gender");
                 		mobile = profileinfo.get("mobile_number");
                 		nationality = profileinfo.get("nationality");
                 		referal_code = profileinfo.get("referal_code");
                 		//profileinfo.get("referal_code");
                 		customer_info = Customer[Phone_Number == mobile];
                 		if(customer_info.count() > 0)
                 		{
                 			customer_info.Name=fullname;
                 			customer_info.Gender=gender;
                 			customer_info.Email=emailaddress;
                 			customer_info.Nationality_Global=nationality;
                 			if(customer_info.Date_Of_Birth == null && dateofbirth != "")
                 			{
                 				customer_info.Date_Of_Birth=dateofbirth;
                 			}
                 			response.put("is_done",true);
                 			response.put("message","Profile updated successfully");
                 		}
                 		else
                 		{
                 			dialing_code = mobile.left(4);
                 			if(dialing_code == "" || dialing_code == null)
                 			{
                 				dialing_code = "+971";
                 			}
                 			market_global = global_configuration.fetchrecord.getmarketbydialingcode(dialing_code);
                 			customer_id = insert into Customer
                 			[
                 				Name=fullname
                 				Gender=gender
                 				Email=emailaddress
                 				Phone_Number=mobile
                 				Market_Global=market_global.get("ID").tolong()
                 				Status="Active"
                 				Date_Of_Birth=dateofbirth
                 				Nationality=market_global.get("market_full_name")
                 				Nationality_Global=nationality
                 				Added_User=zoho.loginuser
                 			];
                 			history_id = insert into Member_History
                 			[
                 				Customer=customer_id
                 				Start_Time=zoho.currenttime
                 				Added_User=zoho.loginuser
                 			];
                 			membershiplevelid = Membership_Points_System[Membership_Level == "Silver"];
                 			relatedCRMID = thisapp.crmIntegration.pushCustomersToCrm(fullname,emailaddress,mobileno,dateofbirth);
                 			customerPoints = insert into Customer_Points_System
                 			[
                 				Added_User=zoho.loginuser
                 				Customer=customer_id
                 				Total_Points_Burned=0
                 				Total_Points_Earned=0
                 				Total_Points_Expired=0
                 				Available_Points=0
                 				Bonus_Points_Earned=0
                 				Bonus_Points_Burned=0
                 				Bonus_Points_Expired=0
                 				Is_Free_drink_available=false
                 				Membership_Level_System=membershiplevelid
                 				Related_CRM_ID=relatedCRMID
                 			];
                 			thisapp.signupmanagement.signupbonussettlement(customer_id);
                 			if(referal_code != null || referal_code != "")
                 			{
                 				thisapp.creditbonus.referalbonuscredit(referal_code.trim().tostring(),mobile.tostring());
                 			}
                 			response.put("is_done",true);
                 			response.put("message","Profile created successfully");
                 		}
                 	}	catch (e)
                 	{
                 		response.put("is_done",false);
                 		response.put("message","Error occurred: " + e.toString());
                 		thisapp.ErrorHandling.catchCall("update profile",e.tostring());
                 	}
                 	return response;
                 }
