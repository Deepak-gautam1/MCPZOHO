				 string customerslider.getSliderValue(string current_tier, string next_tier, string cust_earned)
                 {
                 	//info next_tier;
                 	slider_value = 0.0;
                 	// Convert strings to Decimal safely
                 	// 	current_val = current_tier.toDecimal();
                 	// 	next_val = next_tier.toDecimal();
                 	// 	earned_val = cust_earned.toDecimal();
                 	// Clean and convert safely
                 	// 	base_val = 3000; //if(current_tier != null && current_tier.trim() != "",current_tier.toDecimal(),0);
                 	// 	next_val = 5999; //if(next_tier != null && next_tier.trim() != "",next_tier.toDecimal(),0);
                 	// 	earned_val = 3500;//if(cust_earned != null && cust_earned.trim() != "",cust_earned.toDecimal(),0);
                 	base_val = if(current_tier != null && current_tier.trim() != "",current_tier.toDecimal(),0);
                 	next_val = if(next_tier != null && next_tier.trim() != "",next_tier.toDecimal(),0);
                 	earned_val = if(cust_earned != null && cust_earned.trim() != "",cust_earned.toDecimal(),0);
                 	// Avoid divide-by-zero
                 	if(next_val - base_val != 0)
                 	{
                 		slider_value = (earned_val - base_val) / (next_val - base_val);
                 	}
                 	// Clamp between 0 and 1
                 	if(slider_value < 0)
                 	{
                 		slider_value = 0.0;
                 	}
                 	else if(slider_value > 1)
                 	{
                 		slider_value = 1.0;
                 	}
                 	// Return as string or formatted decimal if needed
                 	return slider_value.round(2).toString();
                 	// Or use .round(2).toString() for 2 decimal places
                 }
				 string customerslider.getSliderValueTesting(string current_tier, string next_tier, string cust_earned)
                 {
                 	//info next_tier;
                 	slider_value = 0.0;
                 	current_val = current_tier.toDecimal();
                 	next_val = next_tier.toDecimal();
                 	earned_val = cust_earned.toDecimal();
                 	// Avoid divide-by-zero
                 	if(next_val - current_val != 0)
                 	{
                 		slider_value = (earned_val - current_val) / (next_val - current_val);
                 	}
                 	// Clamp between 0 and 1
                 	if(slider_value < 0)
                 	{
                 		slider_value = 0.0;
                 	}
                 	else if(slider_value > 1)
                 	{
                 		slider_value = 1.0;
                 	}
                 	// Return as string or formatted decimal if needed
                 	return slider_value.toString();
                 	// Or use .round(2).toString() for 2 decimal places
                 }
				 void ErrorHandling.catchCall(String title, String response)
                 {
                 	try 
                 	{
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :"apsingh@americana-food.com","hsharma@americana-food.com"
                 			subject :title
                 			message :response
                 		]
                 	}	catch (mailError)
                 	{
                 		info "Sendmail failed: " + mailError.toString();
                 	}
                 	try 
                 	{
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title=title
                 			error=response
                 		];
                 	}	catch (logError)
                 	{
                 		info "Log insert failed: " + logError.toString();
                 	}
                 }
				 string ErrorMonitor.getPossibleErrors()
                 {
                 	message = "";
                 	markets = Market[ID != 0];
                 	if(markets.count() == 0)
                 	{
                 		message = message + "There is no market available in the Market report in Setup section$";
                 	}
                 	else if(markets.count() > 0)
                 	{
                 		isUAEAvailable = false;
                 		isKSAAvailable = false;
                 		for each  market in markets
                 		{
                 			if(isUAEAvailable && isKSAAvailable)
                 			{
                 				break;
                 			}
                 			if(market.Market_Name == "UAE")
                 			{
                 				isUAEAvailable = true;
                 			}
                 			else if(market.Market_Name == "KSA")
                 			{
                 				isKSAAvailable = true;
                 			}
                 		}
                 		if(isUAEAvailable && isKSAAvailable)
                 		{
                 			joiningDrinkAvailabilityUAE = false;
                 			joiningDrinkAvailabilityKSA = false;
                 			redeemDrinkAvailabilityUAE = false;
                 			redeemDrinkAvailabilityKSA = false;
                 			for each  marketJR in markets
                 			{
                 				joiningDrink = Joining_Rules[Joining_Benefit == "Joining Drink" && Market == marketJR && Mark_as_Active];
                 				freeDrink = Joining_Rules[Joining_Benefit == "Free Product / Drink" && Market == marketJR && Mark_as_Active];
                 			}
                 		}
                 		else if(!isUAEAvailable && !isKSAAvailable)
                 		{
                 			message = message + "Both UAE and KSA markets not availble in the Market report in Setup section$";
                 		}
                 		else
                 		{
                 			if(!isUAEAvailable)
                 			{
                 				message = message + "UAE market is not availble in the Market report in Setup section$";
                 			}
                 			else if(!isKSAAvailable)
                 			{
                 				message = message + "KSA market is not availble in the Market report in Setup section$";
                 			}
                 		}
                 	}
                 	products = Add_Product[ID != 0];
                 	if(products.count() == 0)
                 	{
                 		message = message + "There is no product available in the Product List report$";
                 	}
                 	return message;
                 }
				 map favmanagement.addorderinfavourities(string mobileno, string itemid)
                 {
                 	// mobileno = "+971555534010";
                 	// itemid   = "4661594000007841027";
                 	resp = Map();
                 	cust = Customer[Phone_Number == mobileno];
                 	if(cust == null)
                 	{
                 		resp.put("code","4001");
                 		resp.put("message","Customer not found for the given mobile number.");
                 		return resp;
                 	}
                 	item_id_long = itemid.toLong();
                 	// find existing favourite with type-correct compare
                 	fav = Favourite_Orders[Customer_Name == cust && Request_Product == item_id_long];
                 	// if not found (or empty handle), create and return — do NOT proceed to toggle
                 	if(fav == null || fav.ID == null)
                 	{
                 		newfav = insert into Favourite_Orders
                 		[
                 			Added_User=zoho.loginuser
                 			Customer_Name=cust
                 			Request_Product=item_id_long
                 			Is_Active=true
                 		];
                 		resp.put("code","3000");
                 		resp.put("message","Favourite created and activated.");
                 		resp.put("is_active",true);
                 		resp.put("favourite_id",newfav);
                 		return resp;
                 	}
                 	// toggle only when a record actually exists
                 	new_status = if(fav.Is_Active == true,false,true);
                 	fav.Is_Active=new_status;
                 	resp.put("code","3000");
                 	resp.put("message",if(new_status,"Favourite activated.","Favourite deactivated."));
                 	resp.put("is_active",new_status);
                 	resp.put("favourite_id",fav.ID);
                 	return resp;
                 }
