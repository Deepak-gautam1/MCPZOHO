				 map fetchRecords.getfavourite(string mobileno)
                 {
                 	// -------- Input / Auth --------
                 	//mobileno = "+971555534010";
                 	c_id = Customer[Phone_Number == mobileno];
                 	custloginid = c_id.ID;
                 	//info c_id.ID;
                 	customer_rec = Customer[ID == custloginid.tolong()];
                 	//info customer_rec;
                 	if(customer_rec == null)
                 	{
                 		resp = Map();
                 		resp.put("result",Map());
                 		resp.put("code","3004");
                 		resp.put("type","profile_3");
                 		return resp;
                 	}
                 	loginid = customer_rec.ID;
                 	// -------- Root containers --------
                 	favouriteResponse = Map();
                 	result = Map();
                 	// -------- Header Section --------
                 	headerSection = Map();
                 	// Prefer your hosted images; if they return null, fall back to static maps
                 	back_icon_default = Map();
                 	back_icon_default.put("img_url","<img_url>");
                 	back_icon_default.put("report_name","Favorites");
                 	back_icon_default.put("image_src","back_arrow.png");
                 	back_icon_default.put("field_name","Image");
                 	bg_default = Map();
                 	bg_default.put("img_url","<img_url>");
                 	bg_default.put("report_name","Favorites");
                 	bg_default.put("image_src","header_pattern.png");
                 	bg_default.put("field_name","Image");
                 	back_icon_img = thisapp.publicUrls.getlogoimages("41");
                 	background_img = thisapp.publicUrls.getlogoimages("29");
                 	headerSection.put("back_icon_image",if(back_icon_img != null,back_icon_img,back_icon_default));
                 	headerSection.put("background_image",if(background_img != null,background_img,bg_default));
                 	headerSection.put("header_name","Favourites");
                 	// -------- Search Section --------
                 	searchSection = Map();
                 	filterIcon = Map();
                 	filterIcon.put("img_url","<img_url>");
                 	filterIcon.put("report_name","Favorites");
                 	filterIcon.put("image_src","filter_icon.png");
                 	filterIcon.put("field_name","Image");
                 	searchSection.put("placeholder","Search stores, area or street name");
                 	filter_img = thisapp.publicUrls.getlogoimages("86");
                 	searchSection.put("filter_icon_image",filter_img);
                 	itemsList = List();
                 	for each  fav in Favourite_Orders[Customer_Name.ID == loginid && Is_Active == true]
                 	{
                 		//info fav;
                 		// Fetch product info for the fav item (assumes JSON/Map returned)
                 		objitem = copy_of_product_catalogue.productManagement.getbestsellerforfavitem(fav.Request_Product);
                 		item = Map();
                 		price = Map();
                 		image1 = Map();
                 		name_val = if(objitem != null,objitem.getJson("Name"),null);
                 		id_val = if(objitem != null,objitem.getJson("ID"),null);
                 		desc_val = if(objitem != null,objitem.getJson("description"),null);
                 		image1.put("image_src",objitem.getJson("image"));
                 		item.put("badge","Bestseller");
                 		item.put("item_name",name_val);
                 		item.put("item_id",id_val.tostring());
                 		//item.put("price",price);
                 		item.put("description",desc_val);
                 		//item.put("calories",cal_val);
                 		item.put("image",image1);
                 		//	item.put("is_favorite",true);
                 		item.put("add_button_text","+ Add");
                 		itemsList.add(item);
                 	}
                 	// -------- Assemble & Return --------
                 	result.put("header_section",headerSection);
                 	result.put("search_section",searchSection);
                 	result.put("items",itemsList);
                 	favouriteResponse.put("result",result);
                 	favouriteResponse.put("code","3000");
                 	favouriteResponse.put("type","profile_3");
                 	return favouriteResponse;
                 }
				 list fetchRecords.getfavouriteorderbyid(int customerloginid)
                 {
                 	//customerloginid = 4661594000005964007;
                 	return Favourite_Orders[Customer_Name == customerloginid && Is_Active == true].Request_Product.getAll();
                 }
				 map fetchRecords.getHomePageResponse(String userLoginNumber, String localAppTime)
                 {
                 	try 
                 	{
                 		homePageResponse = Map();
                 		homePageResponse.put("type",2);
                 		number = userLoginNumber;
                 		getCustomer = Customer[Phone_Number == number];
                 		if(getCustomer.count() == 0 && number != null && number != "")
                 		{
                 			newCus = thisapp.customerProfile.addNewCustomer(zoho.loginuser,number);
                 			getCustomer = Customer[ID == newCus];
                 			homePageResponse.put("type",1);
                 		}
                 		else
                 		{
                 			if(getCustomer.Status == "In Active")
                 			{
                 				getCustomer.Status="Active";
                 				History = insert into Member_History
                 				[
                 					Added_User=zoho.loginuser
                 					Customer=getCustomer.ID
                 					Start_Time=zoho.currenttime
                 				];
                 			}
                 		}
                 		getLoyaltyPointsSystem = Customer_Points_System[Customer == getCustomer.ID];
                 		customerBasicDetail = thisapp.fetchRecords.getCustomerDetails(getCustomer);
                 		homePageResponse.put("user_personal_data",customerBasicDetail);
                 		getLoyaltyRule = Loyalty_Rules[Market_Global_lr == getCustomer.Country && Mark_as_Active];
                 		availablePoints = customerBasicDetail.get("available_points");
                 		availablePoints = availablePoints.toLong();
                 		membershipLevel = customerBasicDetail.get("membership_level");
                 		homePageResponse.put("membership_level",membershipLevel);
                 		headerCard = List();
                 		// 		homePageResponse.put("header_cards",headerCard);
                 		freeDrink = Map();
                 		homePageResponse.put("free_drink",freeDrink);
                 		freeDrink.put("is_free_drink_available",getLoyaltyPointsSystem.Is_Free_drink_available);
                 		freeDrinkCard = Map();
                 		freeDrinkCard.put("card_type",1);
                 		if(getLoyaltyPointsSystem.Is_Free_drink_available)
                 		{
                 			freeDrinkCard.put("welcome_message","Great to see you!");
                 			freeDrinkCard.put("title","FREE DRINK");
                 			freeDrinkCard.put("expiry_text","Expires");
                 			freeDrinkCard.put("expiry_date",if(getCustomer.Added_Time != null,thisapp.formatDate(getLoyaltyPointsSystem.Free_Drink_Expiry_Date),thisapp.formatDate(zoho.currenttime.addYear(1))));
                 			freeDrinkCard.put("button_name","CLAIM & ENJOY");
                 			freeDrinkCard.put("free_drink_listing_description","Redeem a drink of your choice from our curated selection.");
                 			freeDrinkCard.put("redeem_button_text","REDEEM");
                 			freeDrinkCard.put("free_drinks",thisapp.fetchRecords.getProduct("freeDrink",getCustomer));
                 			freeDrink.put("free_drink_card",freeDrinkCard);
                 		}
                 		//  		memberShipCard = Map();
                 		headerCard.add(freeDrinkCard);
                 		cxOrientedRewards = thisapp.loyaltyEngine.getCustomerOrientedRedemptionList(getCustomer,availablePoints);
                 		if(cxOrientedRewards.size() > 0)
                 		{
                 			nextRewardPoints = cxOrientedRewards.get(0).get("points_threshold");
                 		}
                 		else
                 		{
                 			nextRewardPoints = 1500;
                 		}
                 		homePageResponse.put("next_reward_points",nextRewardPoints);
                 		homePageResponse.put("next_reward_text",if(nextRewardPoints <= 3000,(nextRewardPoints - customerBasicDetail.get("available_points")) + " points to next reward","Redeem your rewards"));
                 		homePageResponse.put("points_to_be_collected_for_next_reward",(nextRewardPoints - customerBasicDetail.get("available_points")).toLong());
                 		/*		memberShipCard = Map();
                                  				memberShipCard.put("card_type",2);
                                  				if(availablePoints < 3000 && membershipLevel == "Silver")
                                  				{
                                  					memberShipCard.put("type",1);
                                  					memberShipCard.put("bottom_text","Collect " + (3000 - availablePoints).toLong() + "  Points to reach Gold");
                                  				}
                                  				else if(availablePoints > 3000 && membershipLevel == "Silver")
                                  				{
                                  					memberShipCard.put("type",2);
                                  					memberShipCard.put("bottom_text","GET TO GOLD");
                                  				}
                                  				else if(availablePoints > 3000 && membershipLevel == "Gold")
                                  				{
                                  					memberShipCard.put("type",3);
                                  					memberShipCard.put("bottom_text","Collect " + (7500 - availablePoints).toLong() + "  Points to reach Platinum");
                                  				}
                                  				else if(availablePoints > 7500 && membershipLevel == "Gold")
                                  				{
                                  					memberShipCard.put("type",4);
                                  					memberShipCard.put("bottom_text","GET TO PLATINUM");
                                  				}
                                  				else
                                  				{
                                  					memberShipCard.put("type",5);
                                  					memberShipCard.put("bottom_text","More points more rewards");
                                  				}
                                  				headerCard.add(memberShipCard);*/
                 		redeemableCard = Map();
                 		redeemableCard.put("card_type",3);
                 		redeemableCard.put("next_reward_points",nextRewardPoints);
                 		redeemableCard.put("next_reward_text",if(nextRewardPoints <= 3000,(nextRewardPoints - customerBasicDetail.get("available_points")) + " points to next reward","Redeem your rewards"));
                 		redeemableCard.put("points_to_be_collected_for_next_reward",(nextRewardPoints - customerBasicDetail.get("available_points")).toLong());
                 		headerCard.add(redeemableCard);
                 		// 		homePageResponse.put("membership_card",memberShipCard);
                 		homePageResponse.put("membership_card",{"bottom_text":"","type":1});
                 		redeemableDrinkCard = Map();
                 		redeemableDrinkCard.put("card_type",4);
                 		redeemableDrinkCard.put("redeemable_item_count",(availablePoints / 1500).toLong());
                 		// 		redeemableDrinkCard.put("redeemable_freedrink_text",if(availablePoints < 1500 && availablePoints != 0,"Gain " + (1500 - availablePoints).toLong() + " more points for the free drink",if(availablePoints >= 1500,"Available free drinks","")));
                 		redeemableDrinkCard.put("redeemable_freedrink_text",if(availablePoints < 1500,"Collect " + (1500 - availablePoints).toLong() + " points to start redeeming","Available free drink"));
                 		// 		redeemableDrinkCard.put("redeemable_freedrink_text",if(availablePoints < 1500, "","Available free drinks"));
                 		redeemableDrinkCard.put("points_threshold",1500);
                 		redeemableDrinkCard.put("bottom_text","Collect 1500 Points to start redeeming");
                 		redeemableDrinkCard.put("free_drink_listing_description","Redeem a drink of your choice from our curated selection.");
                 		redeemableDrinkCard.put("redeem_button_text","REDEEM");
                 		redeemableDrinkCard.put("redeemable_drinks",thisapp.fetchRecords.getRedeemableDrinksHome(getCustomer,getLoyaltyPointsSystem));
                 		homePageResponse.put("redeemable_free_drink_card",redeemableDrinkCard);
                 		redemptionRules = Map();
                 		redemptionRules.put("title","How  rewards work?");
                 		redemptionRules.put("description","More points mean more perks, discounts, and exclusive offers just for you");
                 		try 
                 		{
                 			redemptionRules.put("rule_list",thisapp.loyaltyEngine.getRedemptionRules(Redemption_Rules[Market = getCustomer.Country]));
                 		}
                 		catch (e)
                 		{
                 			thisapp.ErrorHandling.catchCall("Function - fetchRecords.getHomePageResponse - New Redemption Error",e);
                 		}
                 		homePageResponse.put("redemption_rules",redemptionRules);
                 		promotionSection = Map();
                 		homePageResponse.put("promotion_section",promotionSection);
                 		promotionSection.put("title","Let's get rewards");
                 		promotionSection.put("promotion_list",thisapp.fetchRecords.getPromotions(getLoyaltyPointsSystem));
                 		menuSection = Map();
                 		homePageResponse.put("menu_section",menuSection);
                 		menuSection.put("title","Our Menu");
                 		menuSection.put("button_name","View all");
                 		menuSection.put("menu_list",thisapp.fetchRecords.getProduct("menuList",getCustomer));
                 		offerSection = Map();
                 		homePageResponse.put("offer_section",offerSection);
                 		offerSection.put("title","Offers for you");
                 		offerData = thisapp.fetchRecords.getOffers(customerBasicDetail.get("customer_id"));
                 		offerList = {};
                 		for each  offerDetail in offerData
                 		{
                 			for each  offer in offerDetail.get("offer_list")
                 			{
                 				offerList.add(offer);
                 			}
                 		}
                 		offerSection.put("offer_list",offerList);
                 		offerSection.put("button_name","View all");
                 		homePageResponse.put("stores",thisapp.fetchRecords.getStoreLocations(customerBasicDetail.get("country"),localAppTime));
                 		homePageResponse.put("localisible_app_strings",thisapp.fetchRecords.localisableAppStrings("Collect " + getLoyaltyRule.Points_Per_threshold.toLong() + " points for every " + getLoyaltyRule.Purchase_threshold.toLong() + " " + getCustomer.Country.Currency_Name,getCustomer.Country.Market_Name));
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="Function - fetchRecords.getHomePageResponse ::: Log"
                 			error=localAppTime + "\n" + number
                 		];
                 		return homePageResponse;
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getHomePageResponse - Error in Peet's coffee customer home page",e + "\n" + number);
                 		log = insert into ncr_logs
                 		[
                 			Added_User=zoho.loginuser
                 			Title="Function - fetchRecords.getHomePageResponse ::: Log - Dup"
                 			error=localAppTime + "\n" + number
                 		];
                 	}
                 	return null;
                 }
				 map fetchRecords.getHomePageResponse_V2(String userLoginNumber, String localAppTime)
                 {
                 	try 
                 	{
                 		homePageResponse = Map();
                 		homePageResponse.put("type",2);
                 		number = userLoginNumber;
                 		getCustomer = Customer[Phone_Number == number];
                 		if(getCustomer.count() == 0 && number != null && number != "")
                 		{
                 			newCus = thisapp.customerProfile.addNewCustomer(zoho.loginuser,number);
                 			getCustomer = Customer[ID == newCus];
                 			homePageResponse.put("type",1);
                 		}
                 		else
                 		{
                 			if(getCustomer.Status == "In Active")
                 			{
                 				getCustomer.Status="Active";
                 				History = insert into Member_History
                 				[
                 					Added_User=zoho.loginuser
                 					Customer=getCustomer.ID
                 					Start_Time=zoho.currenttime
                 				];
                 			}
                 		}
                 		getLoyaltyPointsSystem = Customer_Points_System[Customer == getCustomer.ID];
                 		customerBasicDetail = thisapp.fetchRecords.getCustomerDetails(getCustomer);
                 		homePageResponse.put("user_personal_data",customerBasicDetail);
                 		getLoyaltyRule = Loyalty_Rules[Market_Global_lr == getCustomer.Country && Mark_as_Active];
                 		availablePoints = customerBasicDetail.get("available_points");
                 		availablePoints = availablePoints.toLong();
                 		membershipLevel = customerBasicDetail.get("membership_level");
                 		homePageResponse.put("membership_level",membershipLevel);
                 		headerCard = List();
                 		// 		homePageResponse.put("header_cards",headerCard);
                 		freeDrink = Map();
                 		homePageResponse.put("free_drink",freeDrink);
                 		freeDrink.put("is_free_drink_available",getLoyaltyPointsSystem.Is_Free_drink_available);
                 		freeDrinkCard = Map();
                 		freeDrinkCard.put("card_type",1);
                 		if(getLoyaltyPointsSystem.Is_Free_drink_available)
                 		{
                 			freeDrinkCard.put("welcome_message","Great to see you!");
                 			freeDrinkCard.put("title","FREE DRINK");
                 			freeDrinkCard.put("expiry_text","Expires");
                 			freeDrinkCard.put("expiry_date",if(getCustomer.Added_Time != null,thisapp.formatDate(getLoyaltyPointsSystem.Free_Drink_Expiry_Date),thisapp.formatDate(zoho.currenttime.addYear(1))));
                 			freeDrinkCard.put("button_name","CLAIM & ENJOY");
                 			freeDrinkCard.put("free_drink_listing_description","Redeem a drink of your choice from our curated selection.");
                 			freeDrinkCard.put("redeem_button_text","REDEEM");
                 			freeDrinkCard.put("free_drinks",thisapp.fetchRecords.getProduct("freeDrink",getCustomer));
                 			freeDrink.put("free_drink_card",freeDrinkCard);
                 		}
                 		//  		memberShipCard = Map();
                 		headerCard.add(freeDrinkCard);
                 		cxOrientedRewards = thisapp.loyaltyEngine.getCustomerOrientedRedemptionList(getCustomer,availablePoints);
                 		if(cxOrientedRewards.size() > 0)
                 		{
                 			nextRewardPoints = cxOrientedRewards.get(0).get("points_threshold");
                 		}
                 		else
                 		{
                 			nextRewardPoints = 1500;
                 		}
                 		homePageResponse.put("next_reward_points",nextRewardPoints);
                 		homePageResponse.put("next_reward_text",if(nextRewardPoints <= 3000,(nextRewardPoints - customerBasicDetail.get("available_points")) + " points to next reward","Redeem your rewards"));
                 		homePageResponse.put("points_to_be_collected_for_next_reward",(nextRewardPoints - customerBasicDetail.get("available_points")).toLong());
                 		/*		memberShipCard = Map();
                                  				memberShipCard.put("card_type",2);
                                  				if(availablePoints < 3000 && membershipLevel == "Silver")
                                  				{
                                  					memberShipCard.put("type",1);
                                  					memberShipCard.put("bottom_text","Collect " + (3000 - availablePoints).toLong() + "  Points to reach Gold");
                                  				}
                                  				else if(availablePoints > 3000 && membershipLevel == "Silver")
                                  				{
                                  					memberShipCard.put("type",2);
                                  					memberShipCard.put("bottom_text","GET TO GOLD");
                                  				}
                                  				else if(availablePoints > 3000 && membershipLevel == "Gold")
                                  				{
                                  					memberShipCard.put("type",3);
                                  					memberShipCard.put("bottom_text","Collect " + (7500 - availablePoints).toLong() + "  Points to reach Platinum");
                                  				}
                                  				else if(availablePoints > 7500 && membershipLevel == "Gold")
                                  				{
                                  					memberShipCard.put("type",4);
                                  					memberShipCard.put("bottom_text","GET TO PLATINUM");
                                  				}
                                  				else
                                  				{
                                  					memberShipCard.put("type",5);
                                  					memberShipCard.put("bottom_text","More points more rewards");
                                  				}
                                  				headerCard.add(memberShipCard);*/
                 		redeemableCard = Map();
                 		redeemableCard.put("card_type",3);
                 		redeemableCard.put("next_reward_points",nextRewardPoints);
                 		redeemableCard.put("next_reward_text",if(nextRewardPoints <= 3000,(nextRewardPoints - customerBasicDetail.get("available_points")) + " points to next reward","Redeem your rewards"));
                 		redeemableCard.put("points_to_be_collected_for_next_reward",(nextRewardPoints - customerBasicDetail.get("available_points")).toLong());
                 		headerCard.add(redeemableCard);
                 		// 		homePageResponse.put("membership_card",memberShipCard);
                 		homePageResponse.put("membership_card",{"bottom_text":"","type":1});
                 		redeemableDrinkCard = Map();
                 		redeemableDrinkCard.put("card_type",4);
                 		redeemableDrinkCard.put("redeemable_item_count",(availablePoints / 1500).toLong());
                 		// 		redeemableDrinkCard.put("redeemable_freedrink_text",if(availablePoints < 1500 && availablePoints != 0,"Gain " + (1500 - availablePoints).toLong() + " more points for the free drink",if(availablePoints >= 1500,"Available free drinks","")));
                 		redeemableDrinkCard.put("redeemable_freedrink_text",if(availablePoints < 1500,"Collect " + (1500 - availablePoints).toLong() + " points to start redeeming","Available free drink"));
                 		// 		redeemableDrinkCard.put("redeemable_freedrink_text",if(availablePoints < 1500, "","Available free drinks"));
                 		redeemableDrinkCard.put("points_threshold",1500);
                 		redeemableDrinkCard.put("bottom_text","Collect 1500 Points to start redeeming");
                 		redeemableDrinkCard.put("free_drink_listing_description","Redeem a drink of your choice from our curated selection.");
                 		redeemableDrinkCard.put("redeem_button_text","REDEEM");
                 		redeemableDrinkCard.put("redeemable_drinks",thisapp.fetchRecords.getRedeemableDrinksHome(getCustomer,getLoyaltyPointsSystem));
                 		homePageResponse.put("redeemable_free_drink_card",redeemableDrinkCard);
                 		redemptionRules = Map();
