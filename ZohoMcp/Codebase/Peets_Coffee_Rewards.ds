                 			if(brand == null)
                 			{
                 				throws 'Brand is required';
                 			}
                 			market = data.getJSON("market");
                 			if(market == null)
                 			{
                 				throws 'Market is required';
                 			}
                 			is_guest = data.getJSON("is_guest");
                 			if(is_guest == null)
                 			{
                 				is_guest = false;
                 			}
                 			if(is_guest == true)
                 			{
                 				resp = thisapp.fetchRecords.homePageResponce_Guest_V3();
                 			}
                 			else
                 			{
                 				resp = thisapp.fetchRecords.homePageResponce_V3(loginuser_mobileno,local_AppTime,brand,market);
