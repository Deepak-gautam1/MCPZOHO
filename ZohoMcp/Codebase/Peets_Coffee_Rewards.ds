                 	greet.put("button_name","View Details");
                 	greet.put("points_expiration_info",cust_info.get("expiration_rules"));
                 	greet.put("points_earning_rate",cust_info.get("earning_rules"));
                 	greet.put("slider_info",cust_info.get("membership_slider_info"));
                 	// from Membership_Details_H   
                 	home_result.put("greeting_and_tier_section",greet);
                 	cust_id = cust_info.get("customer_id").toLong();
                 	lstpromos = List();
                 	lstpromos = thisapp.fetchRecords.getpromotionforhomepage().tolist();
                 	info lstpromos.size();
                 	promoList = List();
                 	for each  promo_product in lstpromos
                 	{
                 		promo = Map();
                 		imageMap = Map();
                 		//imageBlock = promo_product.getJSON("image");
                 		//imageMap.put("img_url",imageBlock.get("image"));
                 		// 		imageMap.put("report_name",imageBlock.get("report_name"));
                 		imageMap.put("image_src",promo_product.get("image"));
                 		promo.put("image",imageMap);
                 		promo.put("id",promo_product.getJson("id"));
                 		promo.put("type",promo_product.getJson("type"));
                 		promoList.add(promo);
                 	}
                 	promoSection = Map();
                 	promoSection.put("promotion_list",promoList);
                 	home_result.put("promotion_section",promoSection);
                 	bestSellerList = List();
                 	b_seller = List();
                 	b_seller = copy_of_product_catalogue.productManagement.getBestseller(marketId.tolong());
                 	lstfavourite = thisapp.fetchRecords.getfavouriteorderbyid(cust_id);
                 	//info lstfavourite;
                 	for each  product in b_seller
                 	{
                 		isinfav = false;
                 		b_fabicon = thisapp.publicUrls.getlogoimages("45").get("public_image_url");
                 		for each  faborder in lstfavourite
                 		{
                 			if(faborder == product.get("ID"))
                 			{
                 				isinfav = true;
                 				b_fabicon = thisapp.publicUrls.getlogoimages("48").get("public_image_url");
                 				break;
                 			}
                 			else
                 			{
                 				isinfav = false;
                 				b_fabicon = thisapp.publicUrls.getlogoimages("45").get("public_image_url");
                 			}
                 		}
                 		//info product.get("prod_imgsrc");
                 		mapproduct = Map();
                 		//product.put("name",product.getJson("Name"));
                 		product_image = Map();
                 		product_image.put("image_src",product.get("prod_imgsrc"));
                 		product_image.put("field_name","Mobile_Image");
                 		product_image.put("id",product.get("ID").tostring());
                 		mapproduct.put("product_image",product_image);
                 		mapproduct.put("fabicon",b_fabicon);
                 		mapproduct.put("isfabforuser",isinfav);
                 		mapproduct.put("name",product.getJson("Name"));
                 		mapproduct.put("add_to_cart_button_name","+ Add");
                 		// Wrap and add
                 		wrapped = Map();
                 		wrapped.put("product",mapproduct);
                 		bestSellerList.add(wrapped);
                 	}
                 	// Final section map
                 	bestSection = Map();
                 	bestSection.put("title","Best Seller");
                 	bestSection.put("best_seller_list",bestSellerList);
                 	//info bestSection;
                 	// Add to final result
                 	home_result.put("best_seller_section",bestSection);
                 	lstfooterdata = Home_Footer_H[ID != 0 && isforfooter == true];
                 	for each  footerdata in lstfooterdata
                 	{
                 		brandCommit = Map();
                 		brandCommit.put("title",footerdata.Heading);
                 		brandCommit.put("description",footerdata.Description);
                 		if(footerdata.Active == "Active")
                 		{
                 			//brandCommit.put("cta_link","Learn More");
                 		}
                 		imageSrc = thisapp.publicUrls.gethomepagefooterimage(footerdata.ID.tostring());
                 		//info imageSrc;
                 		footerImage = Map();
                 		footerImage.put("report_name","Home_Footer_H_Report");
                 		footerImage.put("field_name","Image");
                 		footerImage.put("image_src",imageSrc);
                 		footerImage.put("temp_img_src",imageSrc);
                 		brandCommit.put("image_src",imageSrc);
                 		brandCommit.put("id",footerdata.ID.tostring());
                 	}
                 	home_result.put("brand_commitment_section",brandCommit);
                 	lst_tier = thisapp.fetchRecords.getlstTire(cust_mobileno,logintime);
                 	//info lst_tire;
                 	home_result.put("tier_list",lst_tier);
                 	commenttocraft = thisapp.apppagesmetrialdisplay.commetmentcraftpage();
                 	home_result.put("commitmentcraft_list",commenttocraft);
                 	//commetmentcraft_list - spelling mistake corrected
                 	home_result.put("point_analysis",thisapp.fetchRecords.getPointAnalysisResponse(cust_mobileno));
                 	//	orderst =  Cart_Status[Status=="Cart"];
                 	//info cust_id;
                 	//c_id = Customer[Phone_Number == cust_mobileno].ID;
                 	cartid = Cart_Order_Test[Customer == cust_id && Type_field == "Cart"].ID;
                 	//info c_id;
                 	home_result.put("cartid",cartid.tostring());
                 	//home_response.put("result",home_result);
                 	//home_response.put("code",3000);
                 	return home_result;
                 	//{"home_response":home_response};
                 }
				 map fetchRecords.homePageResponce_V4_Cached(string cust_mobileno, string logintime, string brand, string marketId)
                 {
                 	return thisapp.fetchRecords.homePageResponce_V3_Cached(cust_mobileno,logintime,brand,marketId);
                 }
