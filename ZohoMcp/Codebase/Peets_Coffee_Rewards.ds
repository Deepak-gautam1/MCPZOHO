				 map loyaltyEngine.validateFreeDrink(Map redemptionPrompt, Customer customer, Customer_Points_System customerLoyaltyPointSystem)
                 {
                 	joiningDrinks = thisapp.loyaltyEngine.getAvailableFreeDrinks(customer,customerLoyaltyPointSystem);
                 	redemptionPrompt.put("is_available",false);
                 	if(joiningDrinks.get("is_available"))
                 	{
                 		productTobeRedeemed = redemptionPrompt.get("product_id");
                 		isAllowedItem = false;
                 		redeemableItemList = joiningDrinks.get("available_drinks");
                 		for each  redeemableProduct in redeemableItemList
                 		{
                 			redemptionProductType = redemptionPrompt.get("type");
                 			if(redemptionProductType == 0)
                 			{
                 				redemptionProductType = redeemableProduct.get("type");
                 			}
                 			if(redeemableProduct.get("product_id") == productTobeRedeemed && redeemableProduct.get("type") == redemptionProductType)
                 			{
                 				chosenItem = redeemableProduct;
                 				isAllowedItem = true;
                 				break;
                 			}
                 		}
                 		if(isAllowedItem)
                 		{
                 			redemptionPrompt.put("is_available",true);
                 			redemptionPrompt.put("price",chosenItem.get("price"));
                 			redemptionPrompt.put("discount_amount",chosenItem.get("price"));
                 			redemptionPrompt.put("type",chosenItem.get("type"));
                 			redemptionPrompt.put("message","Product available to redeeem");
                 		}
                 		else
                 		{
                 			redemptionPrompt.put("message","The product you are trying to redeem is not available in the redeemable free drink list");
                 		}
                 	}
                 	else
                 	{
                 		redemptionPrompt.put("message","The user is not eligible to redeem a free drink");
                 	}
                 	return redemptionPrompt;
                 }
