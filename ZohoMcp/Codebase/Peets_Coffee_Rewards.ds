				 map appspages.settingsresponse()
                 {
                 	objlocalappstring = thisapp.fetchRecords.localisableAppStringsV2("0","0");
                 	// Extract relevant nested maps safely
                 	settings_strings = objlocalappstring.get("settings_edit_view_strings");
                 	if(settings_strings == null)
                 	{
                 		settings_strings = Map();
                 	}
                 	delete_strings = objlocalappstring.get("delete_account_view_strings");
                 	if(delete_strings == null)
                 	{
                 		delete_strings = Map();
                 	}
                 	// Header section
                 	back_icon = Map();
                 	back_icon.put("img_url","<img_url>");
                 	back_icon.put("report_name","Settings");
                 	back_icon.put("image_src","back_arrow.png");
                 	back_icon.put("field_name","Image");
                 	background_image = Map();
                 	background_image.put("img_url","<img_url>");
                 	background_image.put("report_name","Settings");
                 	background_image.put("image_src","header_pattern.png");
                 	background_image.put("field_name","Image");
                 	header_section = Map();
                 	header_section.put("back_icon_image",back_icon);
                 	header_section.put("background_image",background_image);
                 	header_section.put("header_name",if(settings_strings.get("settings_edit_view_title") != null,settings_strings.get("settings_edit_view_title"),"Settings"));
                 	// App Permissions Section
                 	app_permissions_list = list();
                 	location_icon = Map();
                 	location_icon.put("img_url","<img_url>");
                 	location_icon.put("report_name","Settings");
                 	location_icon.put("image_src","location_logo.png");
                 	location_icon.put("field_name","Image");
                 	location = Map();
                 	location.put("icon",location_icon);
                 	location.put("label",if(settings_strings.get("settings_edit_view_location_text") != null,settings_strings.get("settings_edit_view_location_text"),"Location"));
                 	location.put("is_enabled",true);
                 	app_permissions_list.add(location);
                 	notification_icon = Map();
                 	notification_icon.put("img_url","<img_url>");
                 	notification_icon.put("report_name","Settings");
                 	notification_icon.put("image_src","Notification_logo.png");
                 	notification_icon.put("field_name","Image");
                 	notification = Map();
                 	notification.put("icon",notification_icon);
                 	notification.put("label",if(settings_strings.get("settings_edit_view_notification_text") != null,settings_strings.get("settings_edit_view_notification_text"),"Notification"));
                 	notification.put("is_enabled",true);
                 	app_permissions_list.add(notification);
                 	app_permissions_section = Map();
                 	app_permissions_section.put("title",if(settings_strings.get("settings_edit_view_App_permisson_text") != null,settings_strings.get("settings_edit_view_App_permisson_text"),"App permissions"));
                 	app_permissions_section.put("items",app_permissions_list);
                 	// Notification Preferences Section (static labels for now)
                 	notification_preferences_list = list();
                 	for each  label in {"Email notification","Sms","Push notification"}
                 	{
                 		item = Map();
                 		icon = Map();
                 		icon.put("img_url","<img_url>");
                 		icon.put("report_name","Settings");
                 		icon.put("image_src","location_logo.png");
                 		icon.put("field_name","Image");
                 		item.put("icon",icon);
                 		item.put("label",label);
                 		// replace with localization if available later
                 		item.put("is_enabled",false);
                 		notification_preferences_list.add(item);
                 	}
                 	notification_preferences_section = Map();
                 	notification_preferences_section.put("title","Notification preferences");
                 	notification_preferences_section.put("items",notification_preferences_list);
                 	// Language Settings Section
                 	lang_description_list = list();
                 	lang_description_list.add({"description":"You should be able to send, receive messages in the selected language"});
                 	language_options = list();
                 	language_options.add({"label":"English","is_selected":true});
                 	language_options.add({"label":"Arabic","is_selected":false});
                 	language_settings_section = Map();
                 	language_settings_section.put("header_text","Change language");
                 	language_settings_section.put("title","Select preferred language");
                 	language_settings_section.put("description_list",lang_description_list);
                 	language_settings_section.put("options",language_options);
                 	language_settings_section.put("button_text","Update");
                 	// Country Settings Section
                 	country_description_list = list();
                 	country_description_list.add({"description":"You should be able to send, receive messages in the selected country"});
                 	uae_flag = Map();
                 	uae_flag.put("img_url","<img_url>");
                 	uae_flag.put("report_name","Settings");
                 	uae_flag.put("image_src","uae_flag.png");
                 	uae_flag.put("field_name","Image");
                 	ksa_flag = Map();
                 	ksa_flag.put("img_url","<img_url>");
                 	ksa_flag.put("report_name","Settings");
                 	ksa_flag.put("image_src","ksa_flag.png");
                 	ksa_flag.put("field_name","Image");
                 	country_options = list();
                 	country_options.add({"country_name":"UAE","flag_image":uae_flag,"is_selected":true});
                 	country_options.add({"country_name":"KSA","flag_image":ksa_flag,"is_selected":false});
                 	country_settings_section = Map();
                 	country_settings_section.put("header_text","Change Country");
                 	country_settings_section.put("title","Select preferred country");
                 	country_settings_section.put("description_list",country_description_list);
                 	country_settings_section.put("options",country_options);
                 	country_settings_section.put("button_text","Update");
                 	// Delete Account Confirmation Section
                 	delete_description_list = list();
                 	delete_description = delete_strings.get("view_description");
                 	if(delete_description == null)
                 	{
                 		delete_description = "Are you sure you want to delete your account?";
                 	}
                 	delete_description_list.add({"description":delete_description});
                 	delete_illustration = Map();
                 	delete_illustration.put("img_url","<img_url>");
                 	delete_illustration.put("report_name","Settings");
                 	delete_illustration.put("image_src","delete_illustration.png");
                 	delete_illustration.put("field_name","Image");
                 	delete_success_icon = Map();
                 	delete_success_icon.put("img_url","<img_url>");
                 	delete_success_icon.put("report_name","Settings");
                 	delete_success_icon.put("image_src","success_tick.png");
                 	delete_success_icon.put("field_name","Image");
                 	delete_success_desc = list();
                 	delete_success_desc.add({"description":"We’re sad to see you go – but your last sip with us won’t be your last memory."});
                 	delete_success_desc.add({"description":"Before you go, got a sec?\nTell us how we could’ve made your cup (and your experience) a little better."});
                 	delete_success_buttons = list();
                 	delete_success_buttons.add({"text":"Share your feedback","type":"primary"});
                 	delete_success_buttons.add({"text":"Close","type":"secondary"});
                 	delete_account_success = Map();
                 	delete_account_success.put("icon",delete_success_icon);
                 	delete_account_success.put("title","Account deleted. But our hearts? Still brewing.");
                 	delete_account_success.put("description_list",delete_success_desc);
                 	delete_account_success.put("buttons",delete_success_buttons);
                 	delete_buttons = list();
                 	delete_buttons.add({"text":"Delete account","type":"danger","delete_account_success_section":delete_account_success});
                 	delete_buttons.add({"text":"Cancel","type":"secondary"});
                 	delete_buttons.add({"text":"Talk with us","type":"outline"});
                 	delete_account_confirmation = Map();
                 	header_text = delete_strings.get("view_title");
                 	if(header_text == null)
                 	{
                 		header_text = "Delete account";
                 	}
                 	delete_account_confirmation.put("header_text",header_text);
                 	subtitle_text = delete_strings.get("view_subtitle");
                 	if(subtitle_text == null)
                 	{
                 		subtitle_text = "Leaving already?";
                 	}
                 	delete_account_confirmation.put("title",subtitle_text);
                 	delete_account_confirmation.put("description_list",delete_description_list);
                 	delete_account_confirmation.put("illustration",delete_illustration);
                 	delete_account_confirmation.put("buttons",delete_buttons);
                 	// Account Actions
                 	account_actions = list();
                 	action1 = Map();
                 	action1.put("icon",location_icon);
                 	action1.put("label","Change language");
                 	action1.put("action_type","navigate");
                 	action1.put("target","language_settings");
                 	action1.put("language_settings_section",language_settings_section);
                 	account_actions.add(action1);
                 	action2 = Map();
                 	action2.put("icon",location_icon);
                 	action2.put("label","Change Country");
                 	action2.put("action_type","navigate");
                 	action2.put("target","country_settings");
                 	action2.put("country_settings_section",country_settings_section);
                 	account_actions.add(action2);
                 	action3 = Map();
                 	action3.put("icon",location_icon);
                 	action3.put("label","Delete account");
                 	action3.put("action_type","navigate");
                 	action3.put("target","delete_account");
                 	action3.put("delete_account_confirmation",delete_account_confirmation);
                 	account_actions.add(action3);
                 	account_section = Map();
                 	account_section.put("title","Account");
                 	account_section.put("actions",account_actions);
                 	// Combine into final settings main section
                 	settings_main_section = Map();
                 	settings_main_section.put("app_permissions_section",app_permissions_section);
                 	settings_main_section.put("notification_preferences_section",notification_preferences_section);
                 	settings_main_section.put("account_section",account_section);
                 	result = Map();
                 	result.put("header_section",header_section);
                 	result.put("settings_main_section",settings_main_section);
                 	settings_response = Map();
                 	settings_response.put("result",result);
                 	settings_response.put("code","3000");
                 	settings_response.put("type","profile_5");
                 	return settings_response;
                 }
				 map azurefunction.azurepostfunction(map order_data)
                 {
                 	// 	info order_data;
                 	final_out = Map();
                 	// 	info data;
                 	// <-- always returned at the end
                 	url = "https://appordersprod.azurewebsites.net/api/AppOrder";
                 	//url = "https://appordersuat.azurewebsites.net/api/AppOrder";
                 	// Headers
                 	headers = Map();
                 	// 	headers.put("Accept","application/json");
                 	headers.put("Content-Type","application/json");
                 	headers.put("Authorization",""); // Azure Function key removed - set via secure config
                 	// if needed
                 	try 
                 	{
                 		// Ensure JSON string body
                 		payload = if(order_data != null,order_data.toString(),"{}");
                 		resp = invokeurl
                 		[
                 			url :url
                 			type :POST
                 			parameters:payload
                 			headers:headers
                 		];
                 		//info "resp: " + resp;
                 		// Normalize resp -> resp_map
                 		resp_map = Map();
                 		is_map = false;
                 		// Try a Map access to detect if resp is already a Map
                 		try 
                 		{
                 			dummy = resp.get("code");
                 			is_map = true;
                 		}
                 		catch (ie)
                 		{
                 			is_map = false;
                 		}
                 		if(is_map == true)
                 		{
                 			resp_map = resp;
                 		}
                 		else
                 		{
                 			// Try to parse JSON string into Map
                 			try 
                 			{
                 				resp_map = resp.toString().toMap();
                 			}
                 			catch (pe)
                 			{
                 				// Fallback: keep raw string under "raw"
                 				resp_map.put("raw",resp.toString());
                 			}
                 		}
                 		// Build unified output
                 		final_out.put("code",if(resp_map.containKey("code"),resp_map.get("code"),null));
                 		final_out.put("status",if(resp_map.containKey("status"),resp_map.get("status"),null));
                 		final_out.put("message",if(resp_map.containKey("message"),resp_map.get("message"),null));
                 		final_out.put("data",if(resp_map.containKey("data"),resp_map.get("data"),null));
                 	}
                 	catch (e)
                 	{
                 		final_out.put("code",5000);
                 		final_out.put("status","FAILED");
                 		final_out.put("message","Error posting order: " + e.toString());
                 		final_out.put("data",null);
                 	}
                 	return final_out;
                 	// <-- explicit return at end
                 }
