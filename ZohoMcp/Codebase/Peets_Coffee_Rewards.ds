				 void maintainance.recalculate_customer_points(string mobileno)
                 {
                 	// get customer
                 	customer = Customer[Phone_Number == mobileno] range from 0 to 1;
                 	if(customer.count() == 0)
                 	{
                 		info "Customer not found for mobile: " + mobileno;
                 		return;
                 	}
                 	// get customer points record
                 	customer_points = Customer_Points_System[Customer == customer.ID] range from 0 to 1;
                 	if(customer_points.count() == 0)
                 	{
                 		info "Customer Points System record not found for mobile: " + mobileno;
                 		return;
                 	}
                 	// get all transactions of this customer
                 	all_transactions = Transaction[Customer == customer.ID];
                 	if(all_transactions.count() == 0)
                 	{
                 		info "No transactions found for mobile: " + mobileno;
                 		return;
                 	}
                 	// initialize all counters
                 	total_bonus_earned = 0;
                 	total_bonus_burned = 0;
                 	total_bonus_expired = 0;
                 	total_points_earned = 0;
                 	total_points_burned = 0;
                 	total_points_expired = 0;
                 	available_points = 0;
                 	bonus_available = 0;
                 	// loop through all transactions and calculate
                 	for each  trns in all_transactions
                 	{
                 		// bonus points
                 		total_bonus_earned = total_bonus_earned + ifnull(trns.Bonus_Points_earned.tolong(),0);
                 		total_bonus_burned = total_bonus_burned + ifnull(trns.Burned_Points.tolong(),0);
                 		total_bonus_expired = total_bonus_expired + ifnull(trns.Expired_Points.tolong(),0);
                 		// loyalty points
                 		total_points_earned = total_points_earned + ifnull(trns.Earned_Loyalty_Points.tolong(),0);
                 		total_points_burned = total_points_burned + ifnull(trns.Utilized_Points.tolong(),0);
                 		total_points_expired = total_points_expired + ifnull(trns.Expired_Points.tolong(),0);
                 	}
                 	// get latest transaction for available points
                 	latest_trans = Transaction[Customer == customer.ID] sort by Transaction_Time desc range from 0 to 0;
                 	if(latest_trans.count() > 0)
                 	{
                 		available_points = ifnull(latest_trans.Available_Points.tolong(),0);
                 		bonus_available = ifnull(latest_trans.Bonus_Available.tolong(),0);
                 	}
                 	info "total_bonus_earned: " + total_bonus_earned;
                 	info "total_bonus_burned: " + total_bonus_burned;
                 	info "total_bonus_expired: " + total_bonus_expired;
                 	info "total_points_earned: " + total_points_earned;
                 	info "total_points_burned: " + total_points_burned;
                 	info "total_points_expired: " + total_points_expired;
                 	info "available_points: " + available_points;
                 	info "bonus_available: " + bonus_available;
                 	// update customer points system
                 	try 
                 	{
                 		customer_points.Bonus_Points_Earned=total_bonus_earned;
                 		customer_points.Bonus_Points_Burned=total_bonus_burned;
                 		customer_points.Bonus_Points_Expired=total_bonus_expired;
                 		customer_points.Total_Points_Earned=total_points_earned;
                 		customer_points.Total_Points_Burned=total_points_burned;
                 		customer_points.Total_Points_Expired=total_points_expired;
                 		customer_points.Available_Points=available_points;
                 		info "Customer Points System updated successfully for mobile: " + mobileno;
                 	}	catch (e)
                 	{
                 		info "Customer Points update error: " + e.toString();
                 	}
                 }
				 map maintainance.temp_creditbonuspoint_V2(string mobileno)
                 {
                 	mapres = Map();
                 	mapres.put("id","0");
                 	mapres.put("is_done",false);
                 	customer = Customer[Phone_Number == mobileno] range from 0 to 1;
                 	if(customer.count() == 0)
                 	{
                 		info "Customer not found for mobile: " + mobileno;
                 		return mapres;
                 	}
                 	trans = Transaction[Customer == customer.ID] sort by Transaction_Time desc range from 0 to 0;
                 	transactionType = "Bonus";
                 	b_type = "Sign Up";
                 	b_point = Bonus_Points[Bonus_Type == b_type.trim() && Status == "Active"];
                 	if(b_point.count() == 0)
                 	{
                 		info "No active bonus point config found for type: " + b_type;
                 		return mapres;
                 	}
                 	// calculation fields — from correct function
                 	receivedPoints = b_point.Points;
                 	expiryDays = b_point.Bonus_Expiration_Days;
                 	b_validity = zoho.currenttime;
                 	bonusValidity = b_validity.addDay(expiryDays);
                 	if(trans.count() > 0)
                 	{
                 		bonus_balance = ifnull(trans.Bonus_Available,0);
                 		previouse_available_bonus_balance = ifnull(ifnull(bonus_balance.tolong(),0) + ifnull(trans.Available_Points.tolong(),0),0);
                 	}
                 	else
                 	{
                 		bonus_balance = 0;
                 		previouse_available_bonus_balance = 0;
                 	}
                 	bonus_available = receivedPoints.tolong() + bonus_balance.tolong();
                 	// end
                 	order_id = "";
                 	customer_points = Customer_Points_System[Customer == customer.ID] range from 0 to 1;
                 	available_before = 0;
                 	if(customer_points != null && customer_points.Available_Points != null)
                 	{
                 		available_before = customer_points.Available_Points;
                 	}
                 	// check already signup bonus — from correct function (count <= 2)
                 	already_signup = Transaction[Bonus_Type == b_type && Customer == customer.ID && Type_field == transactionType];
                 	info "b_type: " + b_type;
                 	info "trans type: " + transactionType;
                 	info "already_signup count: " + already_signup.count();
                 	transactionEarned = null;
                 	if(already_signup.count() == 0)
                 	{
                 		try 
                 		{
                 			transactionEarned = insert into Transaction
                 			[
                 				Added_User=zoho.loginuser
                 				Customer=customer.ID
                 				Market_Global_txn=customer.Market_Global
                 				Type_field=transactionType
                 				Bonus_Type=b_type
                 				Previous_Total_Bonus_Available=previouse_available_bonus_balance
                 				Bonus_Points_earned=ifnull(receivedPoints,0)
                 				Bonus_Available=ifnull(bonus_available,0)
                 				BonusValidity=bonusValidity
                 				Remaining_Bonus_Points=ifnull(receivedPoints,0)
                 				Order_ID=order_id
                 				Total_Purchase_Amount=0
                 				Total_Discount_Amount=0
                 				Total_Invoice_Amount=0
                 				Earned_Loyalty_Points=0
                 				Available_Points=customer_points.Available_Points
                 				Expired_Points=0
                 				Burned_Points=0
                 				Utilized_Points=0
                 				Transaction_Time=zoho.currenttime
                 				Status="Not Utilized"
                 				Available_Points_Before_Cancellation=available_before
                 			];
                 		}		catch (e)
                 		{
                 			info "Transaction insert error: " + e.toString();
                 			return mapres;
                 		}
                 	}
                 	if(transactionEarned != null)
                 	{
                 		try 
                 		{
                 			total_earned = customer_points.Total_Points_Earned;
                 			total_burned = customer_points.Total_Points_Burned;
                 			total_expired = customer_points.Total_Points_Expired;
                 			balance_points = customer_points.Available_Points;
                 			if(customer_points.count() > 0)
                 			{
                 				customer_points.Bonus_Points_Earned=ifnull(ifnull(customer_points.Bonus_Points_Earned,0) + receivedPoints.tolong(),0);
                 				customer_points.Bonus_Points_Burned=ifnull(customer_points.Bonus_Points_Burned.tolong(),0);
                 				customer_points.Bonus_Points_Expired=ifnull(customer_points.Bonus_Points_Expired.tolong(),0);
                 				customer_points.Total_Points_Burned=total_burned;
                 				customer_points.Total_Points_Expired=total_expired;
                 				customer_points.Total_Points_Earned=total_earned;
                 				customer_points.Available_Points=balance_points;
                 			}
                 			trns = Transaction[ID == transactionEarned];
                 			trns.Available_Points=balance_points;
                 			mapres.put("id",transactionEarned.toString());
                 			mapres.put("is_done",true);
                 		}		catch (e)
                 		{
                 			info "Customer points update error: " + e.toString();
                 		}
                 	}
                 	return mapres;
                 }
