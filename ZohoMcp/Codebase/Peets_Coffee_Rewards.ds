				 map fetchRecords.getRedeemableDrinksHome(Customer customer, Customer_Points_System loyaltyData)
                 {
                 	try 
                 	{
                 		freeDrinksData = Map();
                 		if(loyaltyData.Is_Free_drink_available || loyaltyData.Available_Points >= 1500)
                 		{
                 			freeDrinksData.put("is_available",true);
                 			if(loyaltyData.Is_Free_drink_available)
                 			{
                 				type = 1;
                 				joiningRules = Joining_Rules[Product != null && Market == customer.Country && Mark_as_Active && Joining_Benefit in {"Joining Drink","Both"}];
                 			}
                 			else if(loyaltyData.Available_Points >= 1500)
                 			{
                 				joiningRules = Joining_Rules[Product != null && Market == customer.Country && Mark_as_Active && Joining_Benefit in {"Free Product / Drink","Both"}];
                 				type = 2;
                 			}
                 			productList = List();
                 			freeDrinksData.put("available_drinks",productList);
                 			for each  rule in joiningRules
                 			{
                 				product = Add_Product[ID == rule.Product && Status == "Active" && Category != null && Category.Status == "Active"];
                 				if(product.count() > 0)
                 				{
                 					productDetail = Map();
                 					categoryDetail = Map();
                 					productDetail.put("market",product.Market);
                 					productDetail.put("category",categoryDetail);
                 					categoryDetail.put("name",product.Category.Category_Name);
                 					categoryDetail.put("id",product.Category.toString());
                 					categoryDetail.put("priority_index",product.Category.Display_Sequence_Priority);
                 					productDetail.put("id",product.ID.toString());
                 					productDetail.put("name",product.Product_Name);
                 					productImage = Map();
                 					productDetail.put("image",productImage);
                 					productImage.put("report_name","All_Products");
                 					productImage.put("field_name","Image");
                 					productImage.put("image_src",thisapp.fileManagement.processImageUrl(product.Image));
                 					productImage.put("temp_img_src","");
                 					priceList = List();
                 					productDetail.put("price",product.Price);
                 					productList.add(productDetail);
                 				}
                 			}
                 			return freeDrinksData;
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("Function - fetchRecords.getRedeemableDrinksHome",e);
                 	}
                 	freeDrinksData.put("is_available",false);
                 	freeDrinksData.put("available_drinks",null);
                 	return freeDrinksData;
                 }
