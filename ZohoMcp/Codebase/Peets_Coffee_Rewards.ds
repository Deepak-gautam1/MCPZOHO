                 	//loyaltyDetails.put("available_points",customerLoysltyPointSystem.Available_Points);
                 	loyaltyDetails.put("available_points",customerLoysltyPointSystem.Total_Points);
                 	purchaseThreshold = Loyalty_Rules[Market_Global_lr == customer.Market_Global && Type_of_Rule == "Burning" && Membership_Level_System_loy_rul == customerLoysltyPointSystem.Membership_Level_System].Points_Per_threshold;
                 	loyaltyDetails.put("points_to_amount_threshold",purchaseThreshold);
                 	loyaltyDetails.put("total_points_earn",customerLoysltyPointSystem.Total_Points_Earned);
                 	loyaltyDetails.put("total_points_burn",customerLoysltyPointSystem.Total_Points_Burned);
                 	membershiplevel = Membership_Points_System[ID == customerLoysltyPointSystem.Membership_Level_System].Membership_Level;
                 	loyaltyDetails.put("membership_level",membershiplevel);
                 	loyaltyDetails.put("last_redemption_date",if(transactionHistory.count() > 0,transactionHistory.Transaction_Time.toString(),null));
                 	return response;
                 }
				 string loyaltyEngine.getLoyaltyPromotionStatus(String currrentTier, String previousTier)
                 {
                 	if(currrentTier == previousTier)
                 	{
                 		return "Retained";
                 	}
                 	else if(currrentTier == "Silver" && previousTier == "Gold" || previousTier == "Platinum")
                 	{
                 		return "Demoted";
                 	}
                 	else if(currrentTier == "Gold" && previousTier == "Platinum")
                 	{
                 		return "Demoted";
                 	}
                 	else if(currrentTier == "Platinum" && previousTier == "Gold" || currrentTier == "Silver")
                 	{
                 		return "Promoted";
                 	}
                 	else if(currrentTier == "Gold" && previousTier == "Silver")
                 	{
                 		return "Promoted";
                 	}
                 	return "";
                 }
				 map loyaltyEngine.getMembershipDiscount(String membershipLevel, int market, String discountID)
                 {
                 	if(discountID != "-1")
                 	{
                 		memberShipDiscount = Membership_Points_System[Membership_Level == membershipLevel && Market_Global_mpoints == market && Discount_ID == discountID];
                 	}
                 	else
                 	{
                 		memberShipDiscount = Membership_Points_System[Membership_Level == membershipLevel && Market_Global_mpoints == market];
                 	}
                 	if(memberShipDiscount.count() > 0)
                 	{
                 		discountDetails = Map();
                 		discountPercentage = memberShipDiscount.Discount_percentage;
                 		if(discountPercentage != null && discountPercentage > 0)
                 		{
                 			discountDetails.put("discount_percentage",discountPercentage);
                 			discountDetails.put("discount_id",memberShipDiscount.Discount_ID);
                 			discountDetails.put("description",memberShipDiscount.Discount_description);
                 			return discountDetails;
                 		}
                 	}
                 	return null;
                 }
				 map loyaltyEngine.getMembershipDiscount_V2(String membershipLevel, int market, String discountID)
                 {
