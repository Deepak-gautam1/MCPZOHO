                 							Transaction_Time=zoho.currenttime
                 							Status="Not Utilized"
                 							Available_Points_Before_Cancellation=customerLoysltyPointSystem.Available_Points
                 						];*/
                 						cartorderid = transaction.get("order_id");
                 						paymentforpoint = ifnull(totalPurchaseAmount,0) - ifnull(totalDiscountAmount,0).toDecimal();
                 						storeid = transaction.get("restaurant_id");
                 						// 						info "totalPurchaseAmount" +totalPurchaseAmount ;
                 						// 					info "totalDiscountAmount" +totalDiscountAmount;
                 						// 					info "redeemablePoints" +redeemablePoints;
                 						// 					info "burnedPoints" +burnedPoints;
                 						// 					info "paymentforpoint" +paymentforpoint;
                 						//info 'p_purchase' + paymentforpoint;
                 						//info storeid;
                 						// 						transactionEarned = thisapp.loyaltyEngine.new_trans_point_settlement(customer.Phone_Number.tostring(),cartorderid.tostring(),burnedPoints.tostring(),paymentforpoint.tostring(),storeid.tostring(),true);
                 						transactionEarned = thisapp.loyaltyEngine.new_trans_point_settlement(customer.Phone_Number.tostring(),cartorderid.tostring(),burnedPoints.tostring(),totalPurchaseAmount.tostring(),storeid.tostring(),true);
                 						if(loyaltyDtails.containKey("free_drink"))
                 						{
                 							freeDrink = loyaltyDtails.get("free_drink");
                 							if(freeDrink.get("is_available"))
                 							{
                 								if(freeDrink.get("type").toLong() == 1)
                 								{
                 									freeDrinkModel = Add_Product[ID_Link == freeDrink.get("product_id")];
                 									if(freeDrinkModel.count() > 0)
