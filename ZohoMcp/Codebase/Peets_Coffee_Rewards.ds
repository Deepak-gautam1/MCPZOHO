                 		mapimage.put("private_image_url",privateURL);
                 	}
                 	else
                 	{
                 		mapimage.put("private_image_url",thisapp.publicUrls.getlogoimages("-100").get("private_image_url"));
                 	}
                 	return mapimage;
                 }
