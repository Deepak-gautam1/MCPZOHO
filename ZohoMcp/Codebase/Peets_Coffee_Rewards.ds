				 list loyaltyEngineCSS.getMarkets()
                 {
                 	marketList = List();
                 	markets = Market[ID != 0];
                 	if(markets.count() > 0)
                 	{
                 		for each  market in markets
                 		{
                 			marketList.add(market.ID);
                 		}
                 		return marketList;
                 	}
                 	return null;
                 }
