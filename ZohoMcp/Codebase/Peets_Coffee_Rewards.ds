                 	bestSection.put("title","Best Seller");
                 	bestSection.put("best_seller_list",bestSellerList);
                 	//info bestSection;
                 	// Add to final result
                 	home_result.put("best_seller_section",bestSection);
                 	lstfooterdata = Home_Footer_H[ID != 0 && isforfooter == true];
                 	for each  footerdata in lstfooterdata
                 	{
                 		brandCommit = Map();
                 		brandCommit.put("title",footerdata.Heading);
                 		brandCommit.put("description",footerdata.Description);
                 		if(footerdata.Active == "Active")
                 		{
                 			//brandCommit.put("cta_link","Learn More");
                 		}
                 		imageSrc = thisapp.publicUrls.gethomepagefooterimage(footerdata.ID.tostring());
                 		//info imageSrc;
                 		footerImage = Map();
                 		footerImage.put("report_name","Home_Footer_H_Report");
                 		footerImage.put("field_name","Image");
                 		footerImage.put("image_src",imageSrc);
                 		footerImage.put("temp_img_src",imageSrc);
                 		brandCommit.put("image_src",imageSrc);
                 		brandCommit.put("id",footerdata.ID.tostring());
                 	}
                 	home_result.put("brand_commitment_section",brandCommit);
                 	//	orderst =  Cart_Status[Status=="Cart"];
                 	//info cust_id;
                 	//c_id = Customer[Phone_Number == cust_mobileno].ID;
                 	//	cartid = Cart_Order_Test[Customer == cust_id && Type_field == "Cart"].ID;
                 	//info c_id;
                 	home_result.put("cartid","");
                 	//home_response.put("result",home_result);
                 	//home_response.put("code",3000);
                 	return home_result;
                 	//{"home_response":home_response};
                 }
				 map fetchRecords.homePageResponce_V3(string cust_mobileno, string logintime, string brand, string marketId)
                 {
                 	//cust_mobileno = zoho.loginuser.mobilenumber;
                 	//info cust_mobileno;
                 	home_response = Map();
                 	/* ========== HOME RESPONSE ========== */
                 	home_result = Map();
                 	header = Map();
                 	header.put("image_src",thisapp.publicUrls.getlogoimages("1").get("public_image_url"));
                 	header.put("back_icon",thisapp.publicUrls.getlogoimages("41").get("public_image_url"));
                 	//header.put("id",homepagelogo.ID);
                 	//info header;
                 	home_result.put("header",header);
                 	greet = Map();
                 	cust_info = thisapp.customerProfile.getCustomerInfo(cust_mobileno);
                 	//info cust_info;
                 	marketId = cust_info.get("customer_market");
                 	greet.put("greeting_message",thisapp.greetings.getGreetingFromLoginTime(logintime));
                 	greet.put("user_name",cust_info.get("customer_name"));
                 	greet.put("marketid",cust_info.get("customer_market"));
                 	greet.put("points_earned",cust_info.get("total_points_earned"));
                 	greet.put("available_points",cust_info.get("available_points"));
                 	greet.put("tier_name",cust_info.get("current_membership_tier"));
                 	s_info = cust_info.get("membership_slider_info");
                 	//info s_info;
                 	current_tire_val = s_info.getJSON("current_tier_threshold");
                 	next_tire_val = s_info.getJSON("next_tier_threshold");
                 	current_val = s_info.getJSON("points_earned");
                 	tire_val = thisapp.customerslider.getSliderValue(current_tire_val,next_tire_val,current_val);
                 	greet.put("tier_value",tire_val.toString());
                 	greet.put("ispointrefresh",true);
                 	greet.put("button_name","View Details");
                 	greet.put("points_expiration_info",cust_info.get("expiration_rules"));
                 	greet.put("points_earning_rate",cust_info.get("earning_rules"));
                 	greet.put("slider_info",cust_info.get("membership_slider_info"));
                 	// from Membership_Details_H   
                 	home_result.put("greeting_and_tier_section",greet);
                 	cust_id = cust_info.get("customer_id").toLong();
                 	lstpromos = List();
                 	lstpromos = thisapp.fetchRecords.getpromotionforhomepage().tolist();
                 	info lstpromos.size();
                 	promoList = List();
                 	for each  promo_product in lstpromos
                 	{
                 		promo = Map();
                 		imageMap = Map();
                 		//imageBlock = promo_product.getJSON("image");
                 		//imageMap.put("img_url",imageBlock.get("image"));
                 		// 		imageMap.put("report_name",imageBlock.get("report_name"));
                 		imageMap.put("image_src",promo_product.get("image"));
                 		promo.put("image",imageMap);
                 		promo.put("id",promo_product.getJson("id"));
                 		promo.put("type",promo_product.getJson("type"));
                 		promoList.add(promo);
                 	}
                 	promoSection = Map();
                 	promoSection.put("promotion_list",promoList);
                 	home_result.put("promotion_section",promoSection);
                 	bestSellerList = List();
                 	b_seller = List();
                 	b_seller = copy_of_product_catalogue.productManagement.getBestseller(marketId.tolong());
                 	lstfavourite = thisapp.fetchRecords.getfavouriteorderbyid(cust_id);
                 	//info lstfavourite;
                 	for each  product in b_seller
                 	{
                 		isinfav = false;
                 		b_fabicon = thisapp.publicUrls.getlogoimages("45").get("public_image_url");
                 		for each  faborder in lstfavourite
                 		{
                 			if(faborder == product.get("ID"))
                 			{
                 				isinfav = true;
                 				b_fabicon = thisapp.publicUrls.getlogoimages("48").get("public_image_url");
                 				break;
                 			}
                 			else
                 			{
                 				isinfav = false;
                 				b_fabicon = thisapp.publicUrls.getlogoimages("45").get("public_image_url");
                 			}
                 		}
                 		//info product.get("prod_imgsrc");
                 		mapproduct = Map();
                 		//product.put("name",product.getJson("Name"));
                 		product_image = Map();
                 		product_image.put("image_src",product.get("prod_imgsrc"));
                 		product_image.put("field_name","Mobile_Image");
                 		product_image.put("id",product.get("ID").tostring());
                 		mapproduct.put("product_image",product_image);
                 		mapproduct.put("fabicon",b_fabicon);
                 		mapproduct.put("isfabforuser",isinfav);
                 		mapproduct.put("name",product.getJson("Name"));
                 		mapproduct.put("add_to_cart_button_name","+ Add");
                 		// Wrap and add
                 		wrapped = Map();
                 		wrapped.put("product",mapproduct);
                 		bestSellerList.add(wrapped);
                 	}
                 	// Final section map
                 	bestSection = Map();
                 	bestSection.put("title","Best Seller");
                 	bestSection.put("best_seller_list",bestSellerList);
                 	//info bestSection;
                 	// Add to final result
                 	home_result.put("best_seller_section",bestSection);
                 	lstfooterdata = Home_Footer_H[ID != 0 && isforfooter == true];
                 	for each  footerdata in lstfooterdata
                 	{
                 		brandCommit = Map();
                 		brandCommit.put("title",footerdata.Heading);
                 		brandCommit.put("description",footerdata.Description);
                 		if(footerdata.Active == "Active")
                 		{
                 			//brandCommit.put("cta_link","Learn More");
                 		}
                 		imageSrc = thisapp.publicUrls.gethomepagefooterimage(footerdata.ID.tostring());
                 		//info imageSrc;
                 		footerImage = Map();
                 		footerImage.put("report_name","Home_Footer_H_Report");
                 		footerImage.put("field_name","Image");
                 		footerImage.put("image_src",imageSrc);
                 		footerImage.put("temp_img_src",imageSrc);
                 		brandCommit.put("image_src",imageSrc);
                 		brandCommit.put("id",footerdata.ID.tostring());
                 	}
                 	home_result.put("brand_commitment_section",brandCommit);
                 	lst_tier = thisapp.fetchRecords.getlstTire(cust_mobileno,logintime);
                 	//info lst_tire;
                 	home_result.put("tier_list",lst_tier);
                 	commenttocraft = thisapp.apppagesmetrialdisplay.commetmentcraftpage();
                 	home_result.put("commitmentcraft_list",commenttocraft);
                 	//commetmentcraft_list - spelling mistake corrected
                 	home_result.put("point_analysis",thisapp.fetchRecords.getPointAnalysisResponse(cust_mobileno));
                 	//	orderst =  Cart_Status[Status=="Cart"];
                 	//info cust_id;
                 	//c_id = Customer[Phone_Number == cust_mobileno].ID;
                 	cartid = Cart_Order_Test[Customer == cust_id && Type_field == "Cart"].ID;
                 	//info c_id;
                 	home_result.put("cartid",cartid.tostring());
                 	//home_response.put("result",home_result);
                 	//home_response.put("code",3000);
                 	return home_result;
                 	//{"home_response":home_response};
                 }
				 map fetchRecords.homePageResponce_V3_Cached(string cust_mobileno, string logintime, string brand, string marketId)
                 {
                 	// 	expiredRows = Response_Cache[Expired_On <= zoho.currenttime];
                 	// 	for each  row in expiredRows
                 	// 	{
                 	// 		delete from Response_Cache[ID == row.ID];
                 	// 	}
                 	response = Map();
                 	//     cust_mobileno = "+971555534010";
                 	//     logintime = "07:35:00 PM";
                 	//     brand = "4661594000007554025";
                 	//     marketId = "4661594000008171931";
                 	//     localTime_store = "18-11-2025 09:30:00 AM";
                 	params = Map();
                 	params.put("cust_mobileno",cust_mobileno);
                 	//params.put("logintime",logintime);
                 	params.put("brand",brand);
                 	params.put("marketId",marketId);
                 	// params.put("localTime_store", localTime_store);
                 	canonical = "";
                 	pkeys = params.keys().sort(true);
                 	for each  k in pkeys
                 	{
                 		canonical = canonical + k + "=" + params.get(k) + "&";
                 	}
                 	if(canonical.endsWith("&"))
                 	{
                 		cacheKey = canonical.left(canonical.length() - 1);
                 	}
                 	else
                 	{
                 		cacheKey = canonical;
                 	}
                 	//objcached = Response_Cache[Params_Value == cacheKey && Expired_On > zoho.currenttime];
                 	objcached = Response_Cache[Params_Value == cacheKey];
                 	if(objcached.count() > 0)
                 	{
                 		//	response.put("result",objcached.Response.toMap());
                 		return objcached.Response.toMap();
                 	}
                 	else
                 	{
                 		objresponse = thisapp.fetchRecords.homePageResponce_V3_test(cust_mobileno,logintime,brand,marketId);
                 		response.put("result",objresponse);
                 		insert into Response_Cache
                 		[
                 			Api_Type=1
                 			Added_User=zoho.loginuser
                 			Params_Value=cacheKey
                 			Response=objresponse.toString()
                 			Created_Date=zoho.currenttime
                 			Expired_On=zoho.currenttime.addMinutes(10)
                 			User=zoho.loginuser
                 		]
                 		return objresponse;
                 	}
                 	//	return response;
                 }
				 map fetchRecords.homePageResponce_V3_partial_cached()
                 {
                 	//string cust_mobileno, string logintime, string brand, string marketId
                 	cust_mobileno = "+971555534010";
                 	//cust_mobileno = zoho.loginuser.mobilenumber;
                 	logintime = "07:35:00 PM";
                 	brand = "4661594000007554025";
                 	marketId = "4661594000008171931";
                 	// FINAL RESULT MAP (unchanged)
                 	home_result = Map();
                 	/**********************************************
                      * -- PRELOAD / CACHE EXTERNAL CALLS ONCE --
                      **********************************************/
                 	// header images (called once)
                 	header = Map();
                 	header_image_map = thisapp.publicUrls.getlogoimages("1");
                 	back_icon_map = thisapp.publicUrls.getlogoimages("41");
                 	header.put("image_src",header_image_map.get("public_image_url"));
                 	header.put("back_icon",if(back_icon_map != null && back_icon_map.get("public_image_url") != null,back_icon_map.get("public_image_url"),""));
                 	home_result.put("header",header);
                 	// Preload favourite icons (once)
                 	fab_default_map = thisapp.publicUrls.getlogoimages("45");
                 	fab_filled_map = thisapp.publicUrls.getlogoimages("48");
                 	fab_default = if(fab_default_map != null && fab_default_map.get("public_image_url") != null,fab_default_map.get("public_image_url"),"");
                 	fab_filled = if(fab_filled_map != null && fab_filled_map.get("public_image_url") != null,fab_filled_map.get("public_image_url"),"");
                 	/**********************************************
                      * -- FETCH HEAVY RECORDS ONCE --
                      **********************************************/
                 	// Customer info (single call)
                 	cust_info = thisapp.customerProfile.getCustomerInfo(cust_mobileno);
                 	// Safely obtain marketId from customer info if present
                 	if(cust_info.get("customer_market") != null)
                 	{
                 		marketId = cust_info.get("customer_market");
                 	}
                 	// Promotions: fetch once
                 	lstpromos = thisapp.fetchRecords.getpromotionforhomepage();
                 	// tolist() only if result exists and is not already a list (defensive)
                 	if(lstpromos != null)
                 	{
                 		// If method returns a collection that supports tolist(), use it; otherwise keep as is
                 		try 
                 		{
                 			lstpromos = lstpromos.tolist();
                 		}
                 		catch (e)
                 		{
                 			// keep original
                 		}
                 	}
                 	else
                 	{
                 		lstpromos = List();
                 	}
                 	// Best sellers (single call)
                 	// Ensure marketId is a number for productManagement if required
                 	bestseller_result = List();
                 	try 
                 	{
                 		bestseller_result = copy_of_product_catalogue.productManagement.getBestseller(marketId.tolong());
                 	}
                 	catch (e)
                 	{
                 		// fallback empty list
                 		bestseller_result = List();
                 	}
                 	if(bestseller_result == null)
                 	{
                 		bestseller_result = List();
                 	}
                 	// Favourites for customer (single call)
                 	cust_id = 0;
                 	try 
                 	{
                 		cust_id = cust_info.get("customer_id").toLong();
                 	}
                 	catch (e)
                 	{
                 		cust_id = 0;
                 	}
                 	lstfavourite = thisapp.fetchRecords.getfavouriteorderbyid(cust_id);
                 	if(lstfavourite == null)
                 	{
                 		lstfavourite = List();
                 	}
                 	/**********************************************
                      * -- BUILD GREETING & TIER SECTION (unchanged keys) --
                      **********************************************/
                 	greet = Map();
                 	greet.put("greeting_message",thisapp.greetings.getGreetingFromLoginTime(logintime));
                 	greet.put("user_name",cust_info.get("customer_name"));
                 	greet.put("marketid",cust_info.get("customer_market"));
                 	greet.put("points_earned",cust_info.get("total_points_earned"));
                 	greet.put("available_points",cust_info.get("available_points"));
                 	greet.put("tier_name",cust_info.get("current_membership_tier"));
                 	s_info = cust_info.get("membership_slider_info");
                 	// defensive JSON extraction
                 	current_tire_val = "";
                 	next_tire_val = "";
                 	current_val = "";
                 	try 
                 	{
                 		current_tire_val = s_info.getJSON("current_tier_threshold");
                 		next_tire_val = s_info.getJSON("next_tier_threshold");
                 		current_val = s_info.getJSON("points_earned");
                 	}
                 	catch (e)
                 	{
                 		// keep empty if missing
                 	}
                 	tire_val = thisapp.customerslider.getSliderValue(current_tire_val,next_tire_val,current_val);
                 	greet.put("tier_value",tire_val.toString());
                 	greet.put("button_name","View Details");
                 	greet.put("points_expiration_info",cust_info.get("expiration_rules"));
                 	greet.put("points_earning_rate",cust_info.get("earning_rules"));
                 	greet.put("slider_info",cust_info.get("membership_slider_info"));
                 	home_result.put("greeting_and_tier_section",greet);
                 	/**********************************************
                      * -- PROMOTIONS SECTION (preserve keys) --
                      **********************************************/
                 	promoList = List();
                 	for each  promo_product in lstpromos
                 	{
                 		promo = Map();
                 		imageMap = Map();
                 		// original code used promo_product.get("image") — preserve
                 		imageMap.put("image_src",promo_product.get("image"));
                 		promo.put("image",imageMap);
                 		promo.put("id",promo_product.getJson("id"));
                 		promo.put("type",promo_product.getJson("type"));
                 		promoList.add(promo);
                 	}
                 	promoSection = Map();
                 	promoSection.put("promotion_list",promoList);
                 	home_result.put("promotion_section",promoSection);
                 	/**********************************************
                      * -- BEST SELLER SECTION: optimize favourites lookup --
                      **********************************************/
                 	// Create fast lookup map for favourites (keys as stringified IDs)
                 	favMap = Map();
                 	for each  fav in lstfavourite
                 	{
                 		// guard against different ID types
                 		try 
                 		{
                 			favKey = fav.tostring();
                 		}
                 		catch (e)
                 		{
                 			favKey = fav;
                 		}
                 		favMap.put(favKey,true);
                 	}
                 	bestSellerList = List();
                 	// Pre-cache frequently used strings/values for micro-optimization
                 	add_to_cart_label = "+ Add";
                 	for each  product in bestseller_result
                 	{
                 		// single extraction of ID & image & name
                 		prodID_str = "";
                 		try 
                 		{
                 			prodID_str = product.get("ID").tostring();
                 		}
                 		catch (e)
                 		{
                 			prodID_str = product.get("ID");
                 		}
                 		// check favourite using map O(1)
                 		isinfav = false;
                 		if(favMap.get(prodID_str) != null && favMap.get(prodID_str) == true)
                 		{
                 			isinfav = true;
                 			b_fabicon = fab_filled;
                 		}
                 		else
                 		{
                 			isinfav = false;
                 			b_fabicon = fab_default;
                 		}
                 		// Compose product map (minimized repeated conversions)
                 		mapproduct = Map();
                 		product_image = Map();
                 		product_image.put("image_src",product.get("prod_imgsrc"));
                 		product_image.put("field_name","Mobile_Image");
                 		product_image.put("id",prodID_str);
                 		mapproduct.put("product_image",product_image);
                 		mapproduct.put("fabicon",b_fabicon);
                 		mapproduct.put("isfabforuser",isinfav);
                 		mapproduct.put("name",product.getJson("Name"));
                 		mapproduct.put("add_to_cart_button_name",add_to_cart_label);
                 		// Wrap and add
                 		wrapped = Map();
                 		wrapped.put("product",mapproduct);
                 		bestSellerList.add(wrapped);
                 	}
                 	// Final best seller section (keys preserved)
                 	bestSection = Map();
                 	bestSection.put("title","Best Seller");
                 	bestSection.put("best_seller_list",bestSellerList);
                 	home_result.put("best_seller_section",bestSection);
                 	/**********************************************
                      * -- BRAND COMMITMENT / FOOTER SECTION --
                      * Keep behavior the same as original: produce brandCommit and set it.
                      **********************************************/
                 	lstfooterdata = Home_Footer_H[ID != 0 && isforfooter == true];
                 	brandCommit = Map();
                 	for each  footerdata in lstfooterdata
                 	{
                 		brandCommit = Map();
                 		brandCommit.put("title",footerdata.Heading);
                 		brandCommit.put("description",footerdata.Description);
                 		if(footerdata.Active == "Active")
                 		{
                 			// keep same behavior (CTA omitted originally)
                 		}
                 		// Fetch image once per footer item
                 		imageSrc = thisapp.publicUrls.gethomepagefooterimage(footerdata.ID.tostring());
                 		footerImage = Map();
                 		footerImage.put("report_name","Home_Footer_H_Report");
                 		footerImage.put("field_name","Image");
                 		footerImage.put("image_src",imageSrc);
                 		footerImage.put("temp_img_src",imageSrc);
                 		brandCommit.put("image_src",imageSrc);
                 		brandCommit.put("id",footerdata.ID.tostring());
                 		// (Note: original code overwrote brandCommit each loop iteration; we preserved that behavior)
                 	}
                 	home_result.put("brand_commitment_section",brandCommit);
                 	/**********************************************
                      * -- CART ID LOOKUP (keep same key) --
                      * Optimize by limiting fields returned (if possible) — but preserve behavior.
                      **********************************************/
                 	cartid = "";
                 	try 
                 	{
                 		cartRec = Cart_Order_Test[Customer == cust_id && Type_field == "Cart"];
                 		if(cartRec != null)
                 		{
                 			// If multiple records, use the ID of the first item (matching prior behavior)
                 			try 
                 			{
                 				// When a query returns a collection, get .ID may be list; guard for that
                 				if(cartRec.ID != null)
                 				{
                 					cartid = cartRec.ID.tostring();
                 				}
                 				else
                 				{
                 					cartid = "";
                 				}
                 			}
                 			catch (e)
                 			{
                 				// fallback safe
                 				cartid = "";
                 			}
                 		}
                 	}
                 	catch (e)
                 	{
                 		cartid = "";
                 	}
                 	home_result.put("cartid",cartid);
                 	// Return final map (structure & keys identical to previous version)
                 	return home_result;
                 }
