			 Deluge
			 {
				 void aa()
                 {
                 }
				 string createJSONfromParams(map params)
                 {
                 	return params.toString();
                 	// returns clean JSON string
                 }
				 void deleteProducts(Add_Product product)
                 {
                 	for each  rec in product
                 	{
                 		delete from Joining_Rules[Product == product];
                 		delete from Add_Product[ID == product];
                 	}
                 }
				 string formatDate(date dateValue)
                 {
                 	strDate = dateValue.toString();
                 	splitted = strDate.toList(" ").get(0).toList("-");
                 	return splitted.get(1) + " " + splitted.get(0) + ", " + splitted.get(2);
                 }
				 string formatRestaurantPhone(String phone)
                 {
                 	sample = phone;
                 	if(sample.toList("").size() >= 14)
                 	{
                 		sample = sample.replaceAll(" ","");
                 		firstPortion = sample.subString(0,4);
                 		secondPortion = sample.subString(4,6);
                 		thirdPortion = sample.subString(6,9);
                 		fourthPortion = sample.subString(9);
                 		return firstPortion + " " + secondPortion + " " + thirdPortion + " " + fourthPortion;
                 	}
                 	else
                 	{
                 		return sample;
                 	}
                 }
				 string getMonth(int monthIndex)
                 {
                 	months = {"January","February","March","April","May","June","July","August","September","October","November","December"};
                 	monthIndex = monthIndex - 1;
                 	if(monthIndex <= months.size())
                 	{
                 		return months.get(monthIndex);
                 	}
                 	return null;
                 }
				 map accounts_handler.deleteaccount()
                 {
                 	response = Map();
                 	result = Map();
                 	result.put("success_section",thisapp.publicUrls.getlogoimages("15"));
                 	// Content (title + message)
                 	content = Map();
                 	content.put("title","Account deleted. But our hearts? Still brewing.");
                 	content.put("message","We’re sad to see you go - but your last sip with us won’t be your last memory. " + "If you ever feel like brewing up a comeback, we’d love to welcome you back.\n\n" + "Before you go, got a sec?\n" + "Tell us how we could’ve made your cup (and your experience) a little better.");
                 	result.put("content",content);
                 	// Footer buttons
                 	footer = Map();
                 	footer.put("primary_button",{"text":"Share your feedback","action":"open_feedback"});
                 	footer.put("secondary_button",{"text":"Close","action":"close"});
                 	result.put("footer",footer);
                 	layout = Map();
                 	layout.put("type","modal");
                 	layout.put("alignment","center");
                 	result.put("layout",layout);
                 	response.put("result",result);
                 	response.put("code","3000");
                 	return response;
                 }
				 map accounts_handler.deleteaccountpageresponce(int accountid)
                 {
                 	response = Map();
                 	result = Map();
                 	// Header
                 	header = Map();
                 	header.put("title","Delete account");
                 	result.put("header",header);
                 	// Illustration section
                 	back_image = Map();
                 	result.put("back_image",thisapp.publicUrls.getlogoimages("41"));
                 	result.put("header_image",thisapp.publicUrls.getlogoimages("29"));
                 	result.put("background",thisapp.publicUrls.getlogoimages("15"));
                 	// Content
                 	content = Map();
                 	content.put("title","Leaving already?");
                 	content.put("message","Are you sure you want to delete your account? This means saying goodbye to your rewards, order history, and all those great coffee moments. This can’t be undone (not even with a triple espresso).\n\nBut hey, if you’re having second thoughts (we hope you are), we’re just a tap away.");
                 	result.put("content",content);
                 	// Footer buttons
                 	footer = Map();
                 	footer.put("primary_button",{"text":"Delete account","action":"delete_account"});
                 	footer.put("secondary_button",{"text":"Cancel","action":"cancel"});
                 	footer.put("tertiary_button",{"text":"Talk with us","action":"support"});
                 	result.put("footer",footer);
                 	response.put("result",result);
                 	response.put("code","3000");
                 	return response;
                 }
				 map accounts_handler.qrcodeinfo(string mobileno)
                 {
                 	resp = Map();
                 	result = Map();
                 	result.put("header_image",thisapp.publicUrls.getlogoimages("29"));
                 	//mobileno = "";
                 	// Fetch customer profile
                 	try 
                 	{
                 		cust_info = thisapp.customerProfile.getCustomerInfo(mobileno);
                 		//info cust_info;
                 		// Membership slider info (first entry)
                 		slider_list = cust_info.get("membership_slider_info");
                 		slider0 = slider_list.get(0);
                 		slider_icon_selected = slider0.get("slider_icon_selected");
                 		// Earning rules (use the first rule as subtitle)
                 		earning_rules_list = cust_info.get("earning_rules");
                 		earning_rule_html = earning_rules_list.get(0);
                 		// Profile Card
                 		profile_card = Map();
                 		profile_card.put("name",cust_info.get("customer_name"));
                 		tier_map = Map();
                 		tier_map.put("name",cust_info.get("current_membership_tier"));
                 		tier_map.put("icon",slider_icon_selected);
                 		// map with public/private URLs
                 		profile_card.put("tier",tier_map);
                 		profile_card.put("earned_points_label","Earned Points");
                 		profile_card.put("earned_points_value",cust_info.get("available_points").tostring());
                 		profile_card.put("mobileno",mobileno);
                 		result.put("profile_card",profile_card);
                 		// Instruction section
                 		instruction = Map();
                 		instruction.put("title","Scan to collect points");
                 		instruction.put("subtitle",earning_rule_html);
                 		result.put("instruction",instruction);
                 		// Assemble
                 		resp.put("result",result);
                 		resp.put("code","3000");
                 	}
                 	catch (e)
                 	{
                 		resp.put("result","error");
                 		resp.put("code","500");
                 		resp.put("message","Something seems wrong");
                 		info e.tostring();
                 		thisapp.ErrorHandling.catchCall("Qr Info",e.toString());
                 	}
                 	return resp;
                 }
