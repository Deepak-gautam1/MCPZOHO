				 string cartmanagement.createnewexistingcart(string customerid)
                 {
                 	cust_id = customerid.tonumber();
                 	lstcart = List();
                 	lstcustomer = List();
                 	lstcustomer = Customer[ID == cust_id];
                 	if(lstcustomer.count() > 0)
                 	{
                 		contactno = lstcustomer.Phone_Number;
                 		lstcart = Cart_View[Customer == cust_id && Cart_Status == 0];
                 		if(lstcart.count() <= 0)
                 		{
                 			insert into Cart_View
                 			[
                 				Added_User=zoho.loginuser
                 				Cart_Status=0
                 				Customer=cust_id
                 				Order_Method=0
                 				Payment_Amount=0
                 				Payment_ID=0
                 				Phone_Number=contactno
                 				Restaurant_Name=0
                 				Subtotal=0
                 				Total_Amount=0
                 				Total_Discount=0
                 				VAT=0
                 				VAT1=0
                 			]
                 		}
                 	}
                 	return Cart_View[Customer == cust_id && Cart_Status == 0].ID.tostring();
                 }
				 map cartmanagement.getcardetailfororder(int orderid)
                 {
                 	car_info_map = Map();
                 	car_record = Curbside_Car_Information[Cart_Order_Test == orderid];
                 	//info car_record;
                 	car_info_map.put("cart_order_test",car_record.Cart_Order_Test.toString());
                 	car_info_map.put("curbs_carinfo",thisapp.publicUrls.getlogoimages("80"));
                 	car_info_map.put("car_details",car_record.Car_Details);
                 	car_info_map.put("car_details_off",thisapp.publicUrls.getlogoimages("81"));
                 	car_info_map.put("car_details_on",thisapp.publicUrls.getlogoimages("82"));
                 	car_info_map.put("car_colour",car_record.Car_Colour);
                 	car_info_map.put("car_colour_icon",thisapp.publicUrls.getlogoimages("91"));
                 	car_info_map.put("plate_number",car_record.Plate_Number);
                 	car_info_map.put("plate_number_on",thisapp.publicUrls.getlogoimages("83"));
                 	car_info_map.put("plate_number_off",thisapp.publicUrls.getlogoimages("84"));
                 	return car_info_map;
                 }
				 void cartmanagement.order_status_delevered()
                 {
                 	statusid = Cart_Status[Status_ID == "5"].ID;
                 	ready_pickup = Cart_Status[Status_ID == "4"].ID;
                 	objorder = Cart_Order_Test[Cart_Status == ready_pickup && Order <= zoho.currenttime];
                 	//info objorder.count();
                 	for each  rec in objorder
                 	{
                 		rec.Cart_Status=statusid;
                 	}
                 }
				 map cartmanagement.savecardetailfororder(string orderid, string cardetail, string carcolor, string plateno)
                 {
                 	responce = Map();
                 	delete from Curbside_Car_Information[Cart_Order_Test = orderid.tolong()];
                 	detailid = insert into Curbside_Car_Information
                 	[
                 		Cart_Order_Test=orderid
                 		Car_Details=cardetail
                 		Car_Colour=carcolor
                 		Plate_Number=plateno
                 		Added_User=zoho.loginuser
                 	];
                 	responce.put("id",detailid.tostring());
                 	return responce;
                 }
				 map cartmanagement.savecartrequestdata(string customer_mobile, string cart_data)
                 {
                 	responce = Map();
                 	try 
                 	{
                 		parsedResponse = cart_data.toMap();
                 		//parsedResponse = cartrequest.toMap();
                 		//info parsedResponse;
                 		currency_detail = parsedResponse.get("currency");
                 		mobileno = customer_mobile;
                 		//"+971555534010";
                 		//mobileno = zoho.loginuser.mobilenumber;
                 		cust_id = Customer[Phone_Number == mobileno].ID;
                 		//info mobileno;
                 		// Step 1: Parse the incoming JSON request
                 		//parsedResponse = thisapp.reqparsars.getCartDetailsFromRequest(cartrequest);
                 		//info parsedResponse;
                 		order_type = parsedResponse.get("type");
                 		order_notes = parsedResponse.get("order_notes");
                 		cartorderid = parsedResponse.get("cartorderid");
                 		if(cartorderid == "")
                 		{
                 			cartorderid = Cart_Order_Test[Customer == cust_id && Type_field == "Cart"].ID;
                 		}
                 		nc_id = parsedResponse.get("cartorderid");
                 		if(nc_id == "")
                 		{
                 			nc_id = Cart_Order_Test[Customer == cust_id && Type_field == "Cart"].ID;
                 		}
                 		currency = currency_detail.get("currencyname");
                 		if(currency == null)
                 		{
                 			currency = currency_detail;
                 		}
                 		pickup_details = parsedResponse.getJson("pickup_details");
                 		//info pickup_details;
                 		_loc = pickup_details.get("location_details");
                 		pickup_store_id = _loc.get("store_id");
                 		if(isNull(nc_id) || nc_id.toString().trim() == "-1")
                 		{
                 			cartorderid = insert into Cart_Order_Test
                 			[
                 				Customer=cust_id
                 				Type_field="Cart"
                 				Payment_Status="not done"
                 				Restaurant_Name_cart_order_all=pickup_store_id
                 				Added_User=zoho.loginuser
                 			];
                 		}
                 		//info cartorderid;
                 		// 	//info currency;
                 		//obj_cartmaster = Cart_Order_Test[ID == cartorderid && Type_field == "Cart"];
                 		obj_cartmaster = Cart_Order_Test[ID == cartorderid && Type_field == "Cart"];
                 		//info obj_cartmaster ;
                 		pickup_details = parsedResponse.getJson("pickup_details");
                 		//info pickup_details;
                 		pickup_type = null;
                 		pickup_time_type = null;
                 		pickup_day = null;
                 		pickup_store_id = null;
                 		pickup_location_value = null;
                 		if(pickup_details != null)
                 		{
                 			//info pickup_type;
                 			// pickup_time_details { type, day }
                 			//info pickup_details;
                 			_pt = pickup_details.get("pickup_time_details");
                 			if(_pt.get("pickup_type"))
                 			{
                 				pickup_type = _pt.get("pickup_type");
                 			}
                 			pickup_time_type = _pt.get("type");
                 			pickup_day = _pt.get("day");
                 			// location_details { store_id, value }
                 			pickup_time = _pt.get("pickup_time");
                 			// 			if(pickup_time_type == "1")
                 			// 			{
                 			// 				pickup_day = "Today";
                 			// 			}
                 			// 			if(pickup_time_type == "2")
                 			// 			{
                 			// 				pickup_day = "Tommorow";
                 			// 			}
                 			_loc = pickup_details.get("location_details");
                 			pickup_store_id = _loc.get("store_id");
                 			pickup_location_value = _loc.get("value");
                 		}
                 		coupon_section = parsedResponse.get("coupon_section");
                 		coupon_promo_code = null;
                 		coupon_id = null;
                 		if(coupon_section != null && !coupon_section.isEmpty())
                 		{
                 			coupon_promo_code = coupon_section.get("promo_code");
                 			if(coupon_section.get("id") != null && coupon_section.get("id") != "")
                 			{
                 				coupon_id = coupon_section.get("id").toLong();
                 			}
                 		}
                 		root = parsedResponse;
                 		redeem_section = parsedResponse.get("redeem_section");
                 		if(redeem_section == null)
                 		{
                 			redeem_section = parsedResponse.get("redeem");
                 		}
                 		if(redeem_section == null)
                 		{
                 			redeem_section = root.get("redeem_section");
                 		}
                 		redeem_points_applied = null;
                 		redeem_available_points = null;
                 		if(redeem_section != null)
                 		{
                 			redeem_points_applied = redeem_section.get("redeem_points_applied").tostring();
                 			redeem_available_points = redeem_section.get("available_points");
                 			redeem_points_value = redeem_section.get("redeem_points_value");
                 		}
                 		payment_summary = parsedResponse.get("payment_summary");
                 		payment_subtotal = null;
                 		payment_coupon_discount = null;
                 		payment_vat = null;
                 		payment_total_amount = null;
                 		if(payment_summary != null)
                 		{
                 			payment_subtotal = payment_summary.get("subtotal");
                 			payment_coupon_discount = payment_summary.get("coupon_discount");
                 			payment_vat = payment_summary.get("vat");
                 			payment_total_amount = payment_summary.get("total_amount");
                 		}
                 		if(order_type = 1)
                 		{
                 			obj_cartmaster.Type_field="Cart";
                 		}
                 		if(order_type = 2)
                 		{
                 			obj_cartmaster.Type_field="Order";
                 		}
                 		//info pickup_day;
                 		obj_cartmaster.Restaurant_Name_cart_order_all=pickup_store_id;
                 		obj_cartmaster.Method_of_Ordering=peets_restaurant_management.storemanagement.ordermethodidbytype(pickup_type);
                 		obj_cartmaster.Order_notes=order_notes;
                 		obj_cartmaster.Discount_Coupons=coupon_id;
                 		obj_cartmaster.Sub_Total=payment_subtotal;
                 		obj_cartmaster.Payment_Coupon_Discount_s=payment_coupon_discount;
                 		obj_cartmaster.Vat_s=payment_vat;
                 		obj_cartmaster.Total_Amount_s=payment_total_amount;
                 		obj_cartmaster.Customer=cust_id;
                 		obj_cartmaster.Order_Currency=currency;
                 		obj_cartmaster.Order_notes=order_notes;
                 		obj_cartmaster.Pickup_Type=pickup_time_type;
                 		obj_cartmaster.Pickup_Day=pickup_day;
                 		//added to resolve date empty parse issue 
                 		//obj_cartmaster.Pickup_Datetime=pickup_time;
                 		if(pickup_time != "")
                 		{
                 			obj_cartmaster.Pickup_Datetime=pickup_time;
                 		}
                 		obj_cartmaster.Points_Redeem_values=redeem_points_applied;
                 		obj_cartmaster.Point_Redeem_Value=redeem_points_value;
                 		obj_cartmaster.Cart_Status=Cart_Status[Status == "Cart Open"].ID;
                 		if(order_type == 1)
                 		{
                 			obj_cartmaster.Payment_Status="not done";
                 		}
                 		//info order_type;
                 		if(order_type == 2)
                 		{
                 			obj_cartmaster.Payment_Status="done";
                 		}
                 		curbside_details = parsedResponse.getJson("curbside_details");
                 		car_detail = null;
                 		car_color = null;
                 		plate_no = null;
                 		if(curbside_details != null && !curbside_details.isEmpty())
                 		{
                 			if(curbside_details.get("cardetail") != null && curbside_details.get("cardetail") != "")
                 			{
                 				car_detail = curbside_details.get("cardetail");
                 			}
                 			if(curbside_details.get("carcolor") != null && curbside_details.get("carcolor") != "")
                 			{
                 				car_color = curbside_details.get("carcolor");
                 			}
                 			if(curbside_details.get("plateno") != null && curbside_details.get("plateno") != "")
                 			{
                 				plate_no = curbside_details.get("plateno");
                 			}
                 		}
                 		if(pickup_type == "2")
                 		{
                 			thisapp.cartmanagement.savecardetailfororder(cartorderid,car_detail,car_color,plate_no);
                 		}
                 		//info parsedResponse.get("items");
                 		delete from Cart_Order_Items[Cart_Order_ID == cartorderid];
                 		for each  productMap in parsedResponse.get("items")
                 		{
                 			// 		prod_size = productMap.get("size").get('id');
                 			prod_size = productMap.get("itemsize").get('id');
                 			itemQty = productMap.get("quantity");
                 			//info prod_size;
                 			mainRow = insert into Cart_Order_Items
                 			[
                 				Product_lookup_items=productMap.get("product_id")
                 				Quantity=productMap.get("quantity")
                 				Order_Request=parsedResponse
                 				Product_Size=prod_size
                 				Cart_Order_ID=cartorderid
                 				Product_Price=productMap.get("price")
                 				Total_Item_Price=productMap.get("quantity") * productMap.get("price")
                 				Added_User=zoho.loginuser
                 			];
                 			//subformrow = mainRow.;
                 			modifiersSubform = list();
                 			modifierRows = Collection();
                 			addonesrow = Collection();
                 			mainorderrow = Cart_Order_Items[ID == mainRow];
                 			//info productMap.get("product_id");
                 			for each  modGroup in productMap.get("modifiers")
                 			{
                 				modsize = null;
                 				_m = modGroup.get("type");
                 				for each  modVal in modGroup.get("values")
                 				{
                 					if(_m == 1)
                 					{
                 						modsize = modVal.get("id");
                 					}
                 					if(modVal.get("qty") >= "1")
                 					{
                 						modifierMap = {"1":"Size","2":"Beans","3":"Milk","4":"Sugar","6":"Addones"};
                 						modifier_type = ifnull(modifierMap.get(_m),"Unknown");
                 						if(_m == 2 || _m == 3 || _m == 4 || _m == 5)
                 						{
                 							// 					info productMap.get("product_id");
                 							// 					info prod_size;
                 							// 					info modVal.get("id");
                 							// 				    info _m;
                 							size_id_resolved = copy_of_product_catalogue.modifiersManagement.getmodifiersizeforcart(productMap.get("product_id"),prod_size,modVal.get("id"),_m);
                 							s_id = size_id_resolved.get("sizeid");
                 							l_id = size_id_resolved.get("linkid");
                 							modRow = Cart_Order_Items.Modifiers_Subform();
                 							modRow.Modifier_Type_order=modGroup.get("id");
                 							modRow.Modifiers_order=modVal.get("id");
                 							modRow.Modifier_Size=s_id;
                 							modRow.Linkid=l_id;
                 							modRow.Type_field=_m;
                 							modRow.Modifier_Qty=modVal.get("qty");
                 							modifierRows.insert(modRow);
                 							//info size_id_resolved;
                 						}
                 						else if(_m == 6)
                 						{
                 							// 						if(!isNull(modGroup.get("id")) && !isNull(modVal.get("id")) && !isNull(modVal.get("qty")))
                 							// 						{
                 							addonesprice = copy_of_product_catalogue.addonesdetail.getaddonespricebyid(modVal.get("id").tolong());
                 							addonestype = copy_of_product_catalogue.addonesdetail.getaddonestypeidbyaddonesid(modVal.get("id").tolong());
                 							//info modGroup.get("id");
                 							//	info modVal.get("addonesid");
                 							addrow = Cart_Order_Items.Add_ones();
                 							//addrow.Addon_Type_order=modVal.get("addonesid");
                 							addrow.Addon_Type_order=addonestype;
                 							addrow.Addons_order=modVal.get("id");
                 							addrow.Addones_Price=addonesprice.tostring();
                 							addrow.Addones_Selected_qty=modVal.get("qty");
                 							addonetotalprice = modVal.get("qty") * addonesprice * itemQty.tolong();
                 							addrow.Total_Addons_Price=addonetotalprice;
                 							addonesrow.insert(addrow);
                 							//}
                 						}
                 					}
                 				}
                 			}
                 			if(modifierRows.size() > 0)
                 			{
                 				mainorderrow.Modifiers_Subform.insert(modifierRows);
                 			}
                 			if(addonesrow.size() > 0)
                 			{
                 				mainorderrow.Add_ones.insert(addonesrow);
                 			}
                 		}
                 	}	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("cart save",e.toString());
                 	}
                 	//info cartorderid;
                 	parsedResponse = thisapp.fetchRecords.getorderdetailbyid(cartorderid.tolong());
                 	return parsedResponse;
                 }
