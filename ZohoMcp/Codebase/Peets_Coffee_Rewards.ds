				 string customerProfile.insertCustomer(string fullname, string gender, string emailaddress, string mobile, map market_global, string dateofbirth, string nationality)
                 {
                 	customer_id = insert into Customer
                 	[
                 		Name=fullname
                 		Gender=gender
                 		Email=emailaddress
                 		Phone_Number=mobile
                 		Market_Global=market_global.get("ID").tolong()
                 		Status="Active"
                 		Date_Of_Birth=dateofbirth
                 		Nationality=market_global.get("market_full_name")
                 		Nationality_Global=nationality.tolong()
                 		Added_User=zoho.loginuser
                 	];
                 	return customer_id;
                 }
				 void customerProfile.insertCustomerPoints(string customer_id, string membershiplevelid, string relatedCRMID)
                 {
                 	customerPoints = insert into Customer_Points_System
                 	[
                 		Added_User=zoho.loginuser
                 		Customer=customer_id.tolong()
                 		Total_Points_Burned=0
                 		Total_Points_Earned=0
                 		Total_Points_Expired=0
                 		Available_Points=0
                 		Bonus_Points_Earned=0
                 		Bonus_Points_Burned=0
                 		Bonus_Points_Expired=0
                 		Is_Free_drink_available=false
                 		Membership_Level_System=membershiplevelid.tolong()
                 		Related_CRM_ID=relatedCRMID
                 	];
                 }
				 void customerProfile.insertCustomerPoints_test(string customer_id, string membershiplevelid, string relatedCRMID)
                 {
                 	customerPoints = insert into Customer_Points_System
                 	[
