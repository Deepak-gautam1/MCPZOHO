 application "Loyalty Engine Handler"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Dubai"
 	time format = "24-hr"

 	forms
	{
		form Loyalty_Engine
		{
			displayname = "Loyalty Engine"
			success message = "Loyalty Engine Added Successfully"
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Loyalty_Engines
		{
			displayName = "All Loyalty Engines"
			show all rows from Loyalty_Engine    
		}
	}


		 functions
		 {
			 Deluge
			 {
				 map loyaltyEngineExecutionCall(Map requestParams)
                 {
                 	try 
                 	{
                 		brandID = requestParams.get("loyalty_brand").toLong();
                 		if(brandID == 1)
                 		{
                 			return peets_coffee1.loyaltyEngine.executeLoyaltyProgramme(requestParams);
                 		}
                 		else if(brandID == 2)
                 		{
                 			return krispy_kreme.loyaltyEngine.executeLoyaltyProgramme(requestParams);
                 		}
                 		else
                 		{
                 			return {"message":"invalid brand value passeed"};
                 		}
                 	}
                 	catch (e)
                 	{
                 		return {"message":"Error Occured, Please contact your developer"};
                 	}
                 }
