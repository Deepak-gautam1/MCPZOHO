				 void ManualSync.syncCategory()
                 {
                 	getRec = Item_Type[ID != 0 && Brand == 4661594000001750007];
                 	for each  rec in getRec
                 	{
                 		referenceID = krispy_kreme.MainAppSync.syncCategory(rec.ID);
                 		if(referenceID != 0)
                 		{
                 			rec.Loyalty_Reference=referenceID;
                 		}
                 	}
                 }
				 void ManualSync.syncProductManually()
                 {
                 	getRec = Request_Product[ID != 0 && Brand_Lookup == 4661594000001750007];
                 	for each  rec in getRec
                 	{
                 		referenceID = krispy_kreme.MainAppSync.syncProductCatalog(rec.ID);
                 		if(referenceID != 0)
                 		{
                 			rec.Loyalty_Reference=referenceID;
                 		}
                 	}
                 }
				 list marketManagement.getAllMarkets(String brandId)
                 {
                 	marketList = list();
                 	brandRecord = Brand[ID == toNumber(brandId)];
                 	if(brandRecord != null && brandRecord.Market_Lookup != null)
                 	{
                 		marketIds = brandRecord.Market_Lookup;
                 		for each  marketId in marketIds
                 		{
                 			marketDetails = Map();
                 			marketRecord = Market[ID == marketId];
                 			if(marketRecord != null)
                 			{
                 				marketDetails.put('uid',marketRecord.ID.toString());
                 				marketDetails.put('market_name',marketRecord.Name);
                 				marketDetails.put('market_currency',marketRecord.Currency_Lookup.Symbol);
                 				marketDetails.put('market_flag',thisapp.fileManagement.processImageUrl(marketRecord.Flag));
                 			}
                 			marketList.add(marketDetails);
                 		}
                 	}
                 	else
                 	{
                 		marketList.add("No markets found for the selected brand.");
                 	}
                 	return marketList;
                 }
