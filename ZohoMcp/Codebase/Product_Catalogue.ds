												// Initialize an empty list
												menuMixRecord = Request_Product[ID == input.Item_Name];
												// Fetch the corresponding record
												if(menuMixRecord != null)
												{
													lstSizeVar = menuMixRecord.Size_Subform;
													for each  sizeRecord in lstSizeVar
													{
														input.Size_Lookup:ui.add(sizeRecord.Size_Lookup);
													}
												}
												else
												{
													info "Item not found!";
												}
											}
										}
						)
					}
				}

			}
