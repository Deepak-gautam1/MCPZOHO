			ckecklinkidwithmarket as "ckecklinkidwithmarket"
			{
				type =  form
				form = Request_Product

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											lstitem = Request_Product[Link_ID == input.Link_ID && Market_Lookup == input.Market_Lookup];
										info lstitem.count();
										if(input.Link_ID != null)
										{
											if(lstitem.count() > 0)
											{
												alert "The link id " + input.Link_ID + " is already associated with another product in this market";
												cancel submit;
											}
										}
						)
					}
				}

			}
			checksizewithmarket as "checksizewithmarket"
			{
				type =  form
				form = Request_Product

				record event = on add or edit
					status = inactive

				on add row of Size_Subform
				{
					actions 
					{
						custom deluge script
						(
											newLinkId = row.Link_ID;
										if(newLinkId == null)
										{
											return;
										}
										// Link IDs are unique per market by design - see updateLoyaltyPoints in krispy_kreme
										sizedetail = Request_Product[Market_Lookup == input.Market_Lookup && ID != input.ID];
										dupe = false;
										for each  rec in sizedetail
										{
											for each  size in rec.Size_Subform
											{
												if(size.Link_ID != null && size.Link_ID == newLinkId)
												{
													dupe = true;
												}
											}
										}
										if(dupe)
										{
											alert "This Link ID already exists for the selected Market.";
											row.Link_ID=null;
										}
						)
					}
				}

			}
