                 		brand_map.put("name",b.Name);
                 		markets = List();
                 		for each  m in b.Market_Lookup
                 		{
                 			market_map = Map();
                 			market_map.put("id",m.ID);
                 			market_map.put("name",m.Name);
                 			markets.add(market_map);
                 		}
                 		brand_map.put("markets",markets);
                 		brand.add(brand_map);
                 	}
                 	return brand;
                 }
