                 	brandId = 4661594000001750007;
                 	storeId = "4661594000002096381";
                 	marketId = 4661594000001749003;
                 	channelId = 4661594000002303003;
                 	productList = List();
                 	categoryGroups = Map();
                 	products = Request_Product[Brand_Lookup == toNumber(brandId) && Market_Lookup == toNumber(marketId) && Channel_Lookup == toNumber(channelId) && Item_Type_Lookup != null];
                 	// 	products = Request_Product[ID == 4661594000028606106];
                 	products_exclude = restaurant_management.storemanagement.getStoreExcludeItems(storeId);
                 	for each  product in products
                 	{
                 		if(products_exclude.contains(product.ID))
                 		{
                 			continue;
                 		}
                 		if(product.Item_Type_Lookup.Have_size = true)
                 		{
                 			subLinkID = product.Size_Subform.Link_ID;
                 			subfromToList = if(subLinkID != null,subLinkID.toList(),{null});
                 			linkID = subfromToList.get(0);
                 		}
                 		else
                 		{
                 			linkID = product.Link_ID;
                 		}
                 		productDetails = Map();
                 		productDetails.put("id",product.ID.toString());
                 		productDetails.put("name",product.Name);
                 		productDetails.put("price",ifnull(product.Price,0).toDecimal());
                 		productDetails.put("currency",product.Market_Lookup.Currency_Lookup.Symbol);
                 		productDetails.put("link_id",linkID);
                 		productDetails.put("public_image",krispy_kreme.PublicUrl.allProducts(product.Loyalty_Reference,thisapp.fileManagement.processImageUrl(product.Image_Mobile)));
                 		productDetails.put("mobile_image",thisapp.fileManagement.processImageUrl(product.Image_Mobile));
                 		productDetails.put("loyalty_reference",product.Loyalty_Reference.toString());
                 		imageData = Map();
                 		imageData.put("report_name","All_Products");
                 		imageData.put("field_name","Product_From_Catalog.Image_Mobile");
                 		imageData.put("image_src",thisapp.fileManagement.processImageUrl(product.Image_Mobile));
                 		imageData.put("image_refernce_id",product.Loyalty_Reference.toString());
                 		productDetails.put("image",imageData);
                 		categoryName = product.Item_Type_Lookup.Item_Type;
                 		categoryId = product.Item_Type_Lookup.ID;
                 		categoryGroup = categoryGroups.get(categoryId);
                 		if(categoryGroup == null)
                 		{
                 			categoryGroup = Map();
                 			categoryData = Map();
                 			categoryGroup.put("category_name",categoryName);
                 			categoryGroup.put("category_id",categoryId.toString());
                 			categoryData.put("category_name",categoryName);
                 			categoryData.put("category_id",categoryId.toString());
                 			categoryData.put("public_image",krispy_kreme.PublicUrl.itemType(product.Item_Type_Lookup.Loyalty_Reference,thisapp.fileManagement.processImageUrl(product.Item_Type_Lookup.Thumbnail_Image),2));
                 			imageDataThumbnail = Map();
                 			imageDataThumbnail.put("report_name","All_Categories");
                 			imageDataThumbnail.put("field_name","Item_Type.Thumbnail_Image");
                 			imageDataThumbnail.put("image_src",thisapp.fileManagement.processImageUrl(product.Item_Type_Lookup.Thumbnail_Image));
                 			imageDataThumbnail.put("image_refernce_id",product.Item_Type_Lookup.Loyalty_Reference.toString());
                 			categoryData.put("image",imageDataThumbnail);
                 			categoryGroup.put("category_data",categoryData);
                 			categoryGroup.put("menu_list",List());
                 		}
                 		menuList = categoryGroup.get("menu_list");
                 		menuList.add(productDetails);
                 		categoryGroup.put("menu_list",menuList);
                 		categoryGroups.put(categoryId,categoryGroup);
                 	}
                 	// 	newCategory = null;
                 	// 	for each  categoryKey in categoryGroups.keys()
                 	// 	{
                 	// 		//productList.add(categoryGroups.get(categoryKey));
                 	// 		categoryGroup = categoryGroups.get(categoryKey);
                 	// // 		if(categoryGroup.get("category_name") == "New")
                 	// // 		{
                 	// // 			newCategory = categoryGroup;
                 	// // 		}
                 	// // 		else
                 	// // 		{
                 	// 			productList.add(categoryGroup);
                 	// // 		}
                 	// 	}
                 	// // 	if(newCategory != null)
                 	// // 	{
                 	// // 		productList.add(newCategory,0);
                 	// // 	}
                 	newCategory = null;
                 	otherCategories = List();
                 	for each  categoryKey in categoryGroups.keys()
                 	{
                 		categoryGroup = categoryGroups.get(categoryKey);
                 		if(categoryGroup.get("category_name") == "New")
                 		{
                 			newCategory = categoryGroup;
                 		}
                 		else
                 		{
                 			otherCategories.add(categoryGroup);
                 		}
                 	}
                 	if(newCategory != null)
                 	{
                 		productList.add(newCategory);
                 	}
                 	productList.addAll(otherCategories);
                 	// 	info productList;
                 	mainList = List();
                 	mainList.add(productList);
                 	info mainList;
                 }
			 }
		 }


