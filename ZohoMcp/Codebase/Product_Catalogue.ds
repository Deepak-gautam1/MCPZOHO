 application "Product Catalogue"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Dubai"
 	time format = "24-hr"

 	forms
	{
		form Addon_Type
		{
			displayname = "Addon Type"
			success message = "Addon Type Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Market_Lookup_addt
			(
				type = picklist	
				displayname = "Market"
				values  = Market.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Brand_Lookup_addt
			(
				type = picklist	
				displayname = "Brand"
				values  = Brand[Market_Lookup.ID == input.Market_Lookup_addt].ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Add_On_Type
			(
    			type = text
				displayname = "Add On Type"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Addons1
		{
