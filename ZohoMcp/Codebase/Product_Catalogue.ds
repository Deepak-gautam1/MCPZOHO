			uploaditems as "uploaditems"
			{
				type =  form
				form = Bulk_Product_Upload

				record event = on add or edit
					status = inactive

				on user input of File_upload
				{
					actions 
					{
						custom deluge script
						(
											try 
										{
											fileContent = input.File_upload.content;
											lines = fileContent.toList("\n");
											if(lines.size() > 1)
											{
												header = lines.get(0).toList(",");
												if(header.get(0).trim() != "Brand" || header.get(1).trim() != "Item-type" || header.get(2).trim() != "PRODUCT NAME")
												{
													info "Missing or incorrect headers: " + header;
													return;
												}
												first_data_row = lines.get(1).toList(",");
												fixed_brand_name = first_data_row.get(0).trim();
												brand_id = Brand[Name == fixed_brand_name];
												if(brand_id == null)
												{
													info "Brand not found: " + fixed_brand_name;
													return;
												}
												size_map = Map();
												size_records = Size[Brand_Lookup == brand_id];
												for each  s in size_records
												{
													size_map.put(s.Size.trim(),s.ID);
												}
												store_types = restaurant_management.internal.getAllStoreTypes().toList(",");
												market_id = Market[Name == "United Arab Emirates"];
												if(market_id == null)
												{
													info "Market not found.";
													return;
												}
												for each  line in lines.subList(1,lines.size())
												{
													if(line != "")
													{
														row = line.toList(",");
														if(row.size() > 3)
														{
															itemType = row.get(1).trim();
															productName = row.get(2).trim();
															subform_rows = Collection();
															for each  t in store_types
															{
																store_type_clean = t.trim();
																store_type_value = restaurant_management.internal.getStoreType(store_type_clean);
																flat_price = "";
																for each  h in header
																{
																	if(h.trim().toLowerCase() == t.toLowerCase())
																	{
																		idx = header.indexOf(h);
																		if(row.size() > idx)
																		{
																			flat_price = row.get(idx).trim();
																		}
																	}
																}
																if(flat_price != "")
																{
																	r = Map();
																	r.put("Store_Type",store_type_value);
																	r.put("Item_Price",flat_price);
																	r.put("Currently_Active",true);
																	subform_rows.insert(r);
																}
																else
																{
																	// Look for size-based columns like "Regular_Small"
																	for each  h in header
																	{
																		if(h.trim().toLowerCase().startsWith(store_type_clean.toLowerCase() + "_"))
																		{
																			col_index = header.indexOf(h);
																			if(row.size() > col_index)
																			{
																				val = row.get(col_index).trim();
																				if(val != "")
																				{
																					size_name = h.replaceAll(store_type_clean + "_","").trim();
																					size_id = size_map.get(size_name);
																					if(size_id != null)
																					{
																						r = Map();
																						r.put("Store_Type",store_type_value);
																						r.put("Size_Lookup",size_id);
																						r.put("Item_Price",val);
																						r.put("Currently_Active",true);
																						subform_rows.insert(r);
																					}
																				}
																			}
																		}
																	}
																}
															}
															info {"Brand":fixed_brand_name,"Item_type":itemType,"Product_Name":productName,"Pricing_Categories":subform_rows};
														}
													}
												}
											}
											else
											{
												info "No valid lines found.";
											}
										}
										catch (e)
										{
											info "Error: " + e.toString();
										}
						)
					}
				}

			}
			uploadbulkitemprice as "uploadbulkitemprice"
			{
				type =  form
				form = Bulk_Product_Upload

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											try 
										{
											fileContent = input.File_upload.content;
											if(fileContent != null)
											{
												lines = fileContent.toList("\n");
												// 	if(!input.Size_lookup){
												// 		alert "Size must be selected" ;
												// 		return;
												// 	}
												// 	if(!input.Brand_lookup){
												// 		alert "Brand must be selected" ;
												// 		return;
												// 	}
												// 	if(!input.Market_lookup){
												// 		alert "Market must be selected" ;
												// 		return;
												// 	}
												if(lines.size() > 1)
												{
													header = lines.get(0).toList(",");
													if(header.get(0).trim() != "PRODUCT NAME")
													{
														info "missing header: " + header.get(0);
													}
													if(header.get(1).trim() != "Regular")
													{
														info "missing header: " + header.get(1);
													}
													if(header.get(2).trim() != "Premium")
													{
														info "missing header: " + header.get(2);
													}
													if(header.get(3).trim() != "Value")
													{
														info "missing header: " + header.get(3);
													}
													if(header.get(4).trim() != "Full Kitchen Regular Stores")
													{
														info "missing header: " + header.get(4);
													}
													if(header.get(5).trim() != "Full Kitchen Premium")
													{
														info "missing header: " + header.get(5);
													}
													if(header.get(6).trim() != "Full Kitchen Regular Milk")
													{
														info "missing header: " + header.get(6);
													}
													if(header.get(7).trim() != "KCL")
													{
														info "missing header: " + header.get(7);
													}
													for each  line in lines.subList(1,lines.size())
													{
														if(line != "")
														{
															try 
															{
																row = line.toList(",");
																if(row.size() == header.size())
																{
																	product_name = row.get(0).trim();
																	regular = row.get(1).trim();
																	premium = row.get(2).trim();
																	value = row.get(3).trim();
																	full_kitchen_regular_stores = row.get(4).trim();
																	full_kitchen_regular_premium = row.get(5).trim();
																	full_kitchen_regular_milk = row.get(6).trim();
																	kcl = row.get(7).trim();
																	product_record = Request_Product[Name == product_name && Brand_Lookup == input.Brand_lookup && Market_Lookup == input.Market_lookup];
																	if(input.Clear_old_Data == true)
																	{
																		product_record.Pricing_Categories.clear();
																	}
																	size_int = input.Size_lookup;
																	if(product_record != null)
																	{
																		try 
																		{
																			rows = Collection();
																			row1 = Request_Product.Pricing_Categories();
																			row1.Store_Type=restaurant_management.storemanagement.getStoreType("Regular");
																			row1.Size_Lookup=size_int;
																			row1.Item_Price=regular.toDecimal();
																			row1.inputcalories=kcl;
																			rows.insert(row1);
																			row2 = Request_Product.Pricing_Categories();
																			row2.Store_Type=restaurant_management.storemanagement.getStoreType("Premium");
																			row2.Size_Lookup=size_int;
																			row2.Item_Price=premium.toDecimal();
																			row2.inputcalories=kcl;
																			rows.insert(row2);
																			row3 = Request_Product.Pricing_Categories();
																			row3.Store_Type=restaurant_management.storemanagement.getStoreType("Value");
																			row3.Size_Lookup=size_int;
																			row3.Item_Price=value.toDecimal();
																			row3.inputcalories=kcl;
																			rows.insert(row3);
																			row4 = Request_Product.Pricing_Categories();
																			row4.Store_Type=restaurant_management.storemanagement.getStoreType("Full Kitchen Regular");
																			row4.Size_Lookup=size_int;
																			row4.Item_Price=full_kitchen_regular_stores.toDecimal();
																			row4.inputcalories=kcl;
																			rows.insert(row4);
																			// Full Kitchen Premium
																			row5 = Request_Product.Pricing_Categories();
																			row5.Store_Type=restaurant_management.storemanagement.getStoreType("Full Kitchen Premium");
																			row5.Size_Lookup=size_int;
																			row5.Item_Price=full_kitchen_regular_premium.toDecimal();
																			row5.inputcalories=kcl;
																			rows.insert(row5);
																			// Full Kitchen Regular Milk
																			row6 = Request_Product.Pricing_Categories();
																			row6.Store_Type=restaurant_management.storemanagement.getStoreType("Full Kitchen Regular Milk");
																			row6.Size_Lookup=size_int;
																			row6.Item_Price=full_kitchen_regular_milk.toDecimal();
																			row6.inputcalories=kcl;
																			rows.insert(row6);
																			// Final insert into subform
																			product_record.Pricing_Categories.insert(rows);
																		}
																		catch (e)
																		{
																			info "Error inserting subform for product: " + product_name + " | " + e.toString();
																		}
																	}
																	else
																	{
																		//info "No matching StoreId found for " + storeId;
																	}
																}
															}
															catch (e)
															{
																info "Error processing row: " + line + " | Error: " + e;
															}
														}
													}
												}
											}
											else
											{
												info "Please select file";
												return;
											}
										}
										catch (e)
										{
											info "An error occurred: " + e;
										}
						)
					}
				}

			}
