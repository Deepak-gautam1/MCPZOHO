	 			column = 0   
				width = medium
			)
			Brand
			(
				type = picklist	
				values  = Brand.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Addon_Type
			(
				type = picklist	
				displayname = "Addon Type"
				values  = Addon_Type[Brand_Lookup_addt.ID == input.Brand].ID
    			displayformat = [Add_On_Type]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Add_on_Type
			(
    			type = text
				displayname = "Add-on Type"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Name
			(
    			type = text
				displayname = "Name (EN)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Name_Localized
			(
    			type = text
				displayname = "Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Price
			(
				type = decimal
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pricing_Categories
			(
				type = grid
				displayname = "Pricing Categories"
				Store_Category
				(
					type = picklist	
					displayname = "Store Category"
					values  = restaurant_management.Store_Category.ID
    				displayformat = [Category_Name]
					sortorder = ascending
					width = medium
				)
				Decimal
				(
					type = decimal
					width = medium
				)
				Decision_box
				(
    				type = checkbox
					displayname = "Decision box"
					initial value = false
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Best_Seller
		{
			displayname = "Best Seller"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have M_lookup
			(
				type = picklist	
				displayname = "Market"
				values  = Market.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have P_lookup
			(
				type = picklist	
				displayname = "Request Product"
				values  = Request_Product[Market_Lookup.ID == input.M_lookup && Brand_Lookup.ID == input.B_lookup].ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Store_Category
			(
				type = picklist	
				displayname = "Store Category"
				values  = restaurant_management.Store_Category.ID
    			displayformat = [Category_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Display_Seq_Priority
			(
				type = number
				displayname = "Display Seq. Priority"
	 			row = 1
	 			column = 1   
				width = medium
			)
			isActive
			(
    			type = checkbox
				displayname = "Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have B_lookup
			(
				type = picklist	
				displayname = "Brand"
				values  = Brand[Market_Lookup.ID == input.M_lookup].ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Size_lookup
			(
				type = picklist	
				displayname = "Size"
				values  = Size[Brand_Lookup.ID == input.B_lookup].ID
    			displayformat = [Size]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Price_Bestseller
			(
				type = decimal
				displayname = "Price"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Calories
			(
				type = number
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
