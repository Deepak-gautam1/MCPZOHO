		schedule
		{
			Day_Counter as "Day Counter"
			{
				type =  schedule
					status = inactive
				start = "2024-10-10 00:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch pending price change requests
										lstrequests = Price_Change_Request[Request_Status == "Pending"];
										// Loop through each request
										for each  request in lstrequests
										{
											// Get the requested date and current date
											requestedDate = request.Added_Time.toDate();
											// Convert to date object, ignoring time
											currentDate = zoho.currentdate.toDate();
											// Convert to date object, ignoring time
											// Calculate the day difference using daysBetween()
											dayDifference = requestedDate.daysBetween(currentDate);
											info dayDifference;
											// Update the Requested_Day_Count field with the day difference as a string
											request.Requested_Day_Count=dayDifference.toString();
											// Update only the Requested_Day_Count field in the database, using record ID
											//updateMap = Map();
											//updateMap.put("Requested_Day_Count",dayDifference.toString());
											//Price_Change_Request.update(request.ID, updateMap);
										}
					)
					}
				}
			}
			Update_price_based_on_app as "Update_price_based_on_approval"
			{
				type =  schedule
				start = "2024-11-06 00:00:01"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Get the list of pending price change requests
										lstpendingchanges = Price_Change_Request[Request_Status == "Approved" && isDone == false];
										for each  records in lstpendingchanges
										{
											if(zoho.currentdate >= records.Effective_Date)
											{
												item = Price_Change_Request[ID == records.ID].Item_Name;
												n_price = Price_Change_Request[ID == records.ID].New_Price;
												i_name = Request_Product[ID == item].Name;
												item = Price_Change_Request[ID == records.ID].Item_Name;
												n_price = Price_Change_Request[ID == records.ID].New_Price;
												n_brandid = Price_Change_Request[ID == records.ID].Brand_Lookup;
												n_brand = Brand[ID = n_brandid].Name;
												n_marketid = Price_Change_Request[ID == records.ID].Market_Lookup;
												n_market = Market[ID == n_marketid].Name;
												n_channelid = Request_Product[ID == item].Channel_Lookup;
												n_channel = Channel[ID == n_channelid].Channel;
												n_subchannelid = Request_Product[ID == item].Sub_Channel_Lookup;
												n_subchannel = Sub_channel[ID == n_subchannelid].Sub_channel;
												n_reqdaycount = Price_Change_Request[ID == records.ID].Requested_Day_Count;
												n_status = Price_Change_Request[ID == records.ID].Request_Status;
												n_effectivedate = Price_Change_Request[ID == records.ID].Effective_Date;
												n_oldvalue = Price_Change_Request[ID == records.ID].Current_Price;
												n_newvalue = Price_Change_Request[ID == records.ID].New_Price;
												n_reqdate = Price_Change_Request[ID == records.ID].Added_Time;
												n_reqby = Price_Change_Request[ID == records.ID].Added_User;
												n_approveddt = Price_Change_Request[ID == records.ID].Action_date;
												n_approvedby = Price_Change_Request[ID == records.ID].Action_By;
												n_sizeid = Price_Change_Request[ID == records.ID].Size_Lookup;
												n_editby = Price_Change_Request[ID == records.ID].Edit_By;
												//n_sizeid = Price_Change_Request[ID == records.ID].Size_lookup;
												n_sizename = null;
												i_name = Request_Product[ID == item].Name;
												menuMixRecord = Request_Product[ID == item];
												if(menuMixRecord != null)
												{
													if(n_editby == "By Size")
													{
														for each  sizeRecord in menuMixRecord.Size_Subform
														{
															if(sizeRecord.Size_Lookup == n_sizeid)
															{
																sizeRecord.Price=n_newvalue;
																n_sizename = sizeRecord.Size_Lookup.Size;
																break;
															}
														}
													}
													else
													{
														menuMixRecord.Price=n_newvalue;
													}
												}
												update Price_Change_Request[ID == records.ID]
												[
													Effective_Date=zoho.currentdate
													isDone=true
													Source="Job"
												];
												new_data = insert into Price_History
												[
													Record_ID=item
													Item_Name=i_name
													Brand=n_brand
													Market=n_market
													Channel=n_channel
													Subchannel=n_subchannel
													Requested_Day_Count=n_reqdaycount
													Status=n_status
													Effective_date=n_effectivedate
													Old_Price=n_oldvalue
													New_Price=n_newvalue
													Requested_date=n_reqdate
													Requested_by=n_reqby
													Changed_On=n_approveddt
													Changed_By=n_approvedby
													Added_User=zoho.loginuser
													Size=n_sizename
												];
											}
										}
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.loginuserid
											subject :'Job Scheduler for Price Change'
											message :"Price update performed on: " + zoho.currenttime + "Total record " + lstpendingchanges.count()
										]
					)
					}
				}
			}
		}




		functions
		{
			Approve as "Approve"
			{
				type =  functions
				form = Price_Change_Request
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						item = Price_Change_Request[ID == input.ID].Item_Name;
										n_price = Price_Change_Request[ID == input.ID].New_Price;
										i_name = Request_Product[ID == item].Name;
										update Price_Change_Request[ID == input.ID]
										[
											Action_date=zoho.currentdate
											Action_By=zoho.loginuser
											Request_Status="Approved"
										];
										item = Price_Change_Request[ID == input.ID].Item_Name;
										n_price = Price_Change_Request[ID == input.ID].New_Price;
										n_brandid = Price_Change_Request[ID == input.ID].Brand_Lookup;
										n_brand = Brand[ID = n_brandid].Name;
										n_marketid = Price_Change_Request[ID == input.ID].Market_Lookup;
										n_market = Market[ID == n_marketid].Name;
										n_channelid = Request_Product[ID == item].Channel_Lookup;
										n_channel = Channel[ID == n_channelid].Channel;
										n_subchannelid = Request_Product[ID == item].Sub_Channel_Lookup;
										n_subchannel = Sub_channel[ID == n_subchannelid].Sub_channel;
										n_reqdaycount = Price_Change_Request[ID == input.ID].Requested_Day_Count;
										n_status = Price_Change_Request[ID == input.ID].Request_Status;
										n_effectivedate = Price_Change_Request[ID == input.ID].Effective_Date;
										n_oldvalue = Price_Change_Request[ID == input.ID].Current_Price;
										n_newvalue = Price_Change_Request[ID == input.ID].New_Price;
										n_reqdate = Price_Change_Request[ID == input.ID].Added_Time;
										n_reqby = Price_Change_Request[ID == input.ID].Added_User;
										n_approveddt = Price_Change_Request[ID == input.ID].Action_date;
										n_approvedby = Price_Change_Request[ID == input.ID].Action_By;
										n_editby = Price_Change_Request[ID == input.ID].Edit_By;
										n_sizeid = Price_Change_Request[ID == input.ID].Size_Lookup;
										n_sizename = null;
										//n_sizeid = Price_Change_Request[ID == input.ID].Size_lookup;
										i_name = Request_Product[ID == item].Name;
										if(zoho.currentdate >= Effective_Date)
										{
											menuMixRecord = Request_Product[ID == item];
											if(menuMixRecord != null)
											{
												if(n_editby == "By Size")
												{
													for each  sizeRecord in menuMixRecord.Size_Subform
													{
														if(sizeRecord.Size_Lookup == n_sizeid)
														{
															sizeRecord.Price=n_newvalue;
															n_sizename = sizeRecord.Size_Lookup.Size;
															break;
														}
													}
												}
												else
												{
													menuMixRecord.Price=n_newvalue;
												}
											}
											else
											{
												info "Item not found!";
											}
											//update Menu_Mix[ID == item]
											//[
											//Standard_Price=n_price
											//];
											update Price_Change_Request[ID == input.ID]
											[
												Effective_Date=zoho.currentdate
												isDone=true
												Source="User"
											];
											new_data = insert into Price_History
											[
												Record_ID=item
												Item_Name=i_name
												Brand=n_brand
												Market=n_market
												Channel=n_channel
												Subchannel=n_subchannel
												Requested_Day_Count=n_reqdaycount
												Status=n_status
												Effective_date=n_effectivedate
												Old_Price=n_oldvalue
												New_Price=n_newvalue
												Requested_date=n_reqdate
												Requested_by=n_reqby
												Changed_On=n_approveddt
												Changed_By=n_approvedby
												Added_User=zoho.loginuser
												Size=n_sizename
											];
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.loginuserid
												subject :'Job Scheduler for Price Change'
												message :"Price update performed on: " + zoho.currenttime + "Product name " + i_name
											]
										}
					)
					}
				}
			}
			Reject as "Reject"
			{
				type =  functions
				form = Price_Change_Request
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						update Price_Change_Request[ID == input.ID]
										[
											Action_date=zoho.currenttime
											Action_By=zoho.loginuserid
											Request_Status="Rejected"
											isDone=""
										];
					)
					}
				}
			}
			Approve_Menu_Mix_Item as "Approve Menu Mix Item"
			{
				type =  functions
				form = Request_Product
				execution type = for each record	
				on start
				{
					actions  (isApproved == false)
					{
					on click
					(
						input.isApproved = true;
					)
					}
				}
			}
			Reject_Menu_Mix_Item as "Reject Menu Mix Item"
			{
				type =  functions
				form = Request_Product
				execution type = for each record	
				on start
				{
				}
			}
		}
	}
