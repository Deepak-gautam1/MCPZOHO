	pages
	{
		page Approve_Price_Change
		{
			displayname = "Approve"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='15%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#FF4C2F'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='17%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#FF8318'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Request_Status == &quot;Pending&quot;'\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'Request_Status=Pending' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tcolor = '#FF8318'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Pending'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='16%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '50%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '10px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#1FBB52'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'ui-2-like'\n\tsize = '16px'\n\tcornerRadius = '26px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#047B33'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Request_Status == &quot;Approved&quot;'\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'Request_Status=Approved' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tcolor = '#047B33'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = '#FFFFFF'\n\n\n\n\n\n\n\t  value = 'Approved'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '17px'\n\tpaddingLeft = '0px'\n\tpaddingRight = '17px'\n\tpaddingBottom = '17px'\n\tbgColor = 'transparent'\n\n\t\twidth = '50%'\n\t\thAlign = 'center'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='14%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '10px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#951FB8'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'emoticons-like-no'\n\tsize = '16px'\n\tcornerRadius = '26px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#CB0038'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Request_Status == &quot;Rejected&quot;'\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'Request_Status=Rejected' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tcolor = '#AA002D'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Rejected'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='38%'\n   \t>\n\t<panel elementName='Panel 4'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\n\t\twidth = '46%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\n\tcolor = '#FFFFFF'\n\tbgColor = '#0ABB51'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'ui-2-like'\n\tsize = '16px'\n\tcornerRadius = '26px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'isDone=true' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tmarginTop = '3px'\n\tcolor = '#0ABB51'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'isDone == true'\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'isDone=true' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tmarginTop = '3px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Done'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '10px'\n\n\t\twidth = '54%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '10px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#FB0048'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'emoticons-like-no'\n\tsize = '16px'\n\tcornerRadius = '26px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tparameters = 'isDone=false' \n\t\tcomponentLinkName = 'Approve_Price_Change_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\n\tcolor = '#AA002D'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'isDone == false'\n\t  value = 'thisapp.Price_Change_Request.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#AA002D'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Not Done'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Approve_Price_Change_Report'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Approve_Product_Page
		{
			displayname = "Approve Product"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='31%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '5px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Menu_Mix_Approval_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#0ABB51'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Request_Product.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total Items'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='35%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '5px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tparameters = 'Menu_Mix_Record_Status=Approved' \n\t\tcomponentLinkName = 'Menu_Mix_Approval_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#0ABB51'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'isApproved == true'\n\t  value = 'thisapp.Request_Product.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Approved Item'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='34%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '5px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tparameters = 'Menu_Mix_Record_Status=Pending' \n\t\tcomponentLinkName = 'Menu_Mix_Approval_Report'\n\t\ttarget = 'popup'\n\t\tpopupWidth = '100%'\n\t  \tpopupHeight = '100%'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#0ABB51'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'isApproved == false'\n\t  value = 'thisapp.Request_Product.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '3px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Pending Approval'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Menu_Mix_Approval_Report'\n\t\tcriteriaString = 'isApproved == false'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page View_Menu(int brand_id, string brand_name_var, collection lstBrands, int market_id, string market_name_var)
		{
			displayname = "View Menu"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet5' elementName='Navigation'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet5()\ncontent\n&lt;%{\n\t%&gt;\n&lt;div style=&quot;padding: 10px 16px;display: flex;align-items: center;&quot;&gt;\n\t\n\t&lt;a href=&quot;#Page:View_Menu&quot;&gt;Dashboard&lt;/a&gt;\n&lt;%\n\tif(input.brand_id != null)\n\t{\n\t\tinput.brand_name_var = Brand[ID == input.brand_id].Name;\n\t\t%&gt;\n&lt;span style=&quot;padding: 0 0.5rem;font-size: 0.5rem;font-weight: 900;&quot;&gt;/&lt;/span&gt;&lt;a href=&quot;#Page:View_Menu?brand_id=&lt;%=input.brand_id%&gt;&quot;&gt;&lt;%=input.brand_name_var%&gt;&lt;/a&gt;\n&lt;%\n\t}\n\tif(input.market_id != null)\n\t{\n\t\tinput.market_name_var = Market[ID == input.market_id].Name;\n\t\t%&gt;\n&lt;span style=&quot;padding: 0 0.5rem;font-size: 0.5rem;font-weight: 900;&quot;&gt;/&lt;/span&gt;&lt;a href=&quot;#Page:View_Menu?brand_id=&lt;%=input.brand_id%&gt;&amp;market_id=&lt;%=input.market_id%&gt;&quot;&gt;&lt;%=input.market_name_var%&gt;&lt;/a&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet2' elementName='Brand Table'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet2()\ncontent\n&lt;%{\n\tif(input.market_id == null)\n\t{\n\t\tif(input.brand_id == null)\n\t\t{\n\t\t\tbrands_list = Brand[ID != 0];\n\t\t\t%&gt;\n&lt;table&gt;\n  &lt;tr&gt;\n    &lt;th&gt;Brand&lt;/th&gt;\n    &lt;th&gt;Markets&lt;/th&gt;\n    &lt;th&gt;Items&lt;/th&gt;\n  &lt;/tr&gt;\n&lt;%\n\t\t\tfor each  brand in brands_list\n\t\t\t{\n\t\t\t\tmenu_list = Request_Product[Brand_Lookup = brand];\n\t\t\t\t%&gt;\n&lt;tr&gt;\n    &lt;td&gt;\n\t&lt;a href=&quot;#Page:View_Menu?brand_id=&lt;%=brand.ID%&gt;&quot;&gt;\n\t&lt;%=brand.Name%&gt;\n\t&lt;/a&gt;\n\t&lt;/td&gt;\n\t&lt;td&gt;&lt;%=brand.Market_Lookup.size()%&gt;&lt;/td&gt;\n\t&lt;td&gt;&lt;%=menu_list.count()%&gt;&lt;/td&gt;\n  &lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/table&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tselected_brand = Brand[ID == input.brand_id];\n\t\t\t%&gt;\n&lt;table&gt;\n  &lt;tr&gt;\n    &lt;th&gt;Markets - &lt;%=selected_brand.Name%&gt;&lt;/th&gt;\n    &lt;th&gt;Items&lt;/th&gt;\n  &lt;/tr&gt;\n&lt;%\n\t\t\tfor each  market in selected_brand.Market_Lookup\n\t\t\t{\n\t\t\t\tmenu_list = Request_Product[Brand_Lookup == selected_brand &amp;&amp; Market_Lookup == market];\n\t\t\t\t%&gt;\n&lt;tr&gt;\n    &lt;td&gt;\n\t&lt;a href=&quot;#Page:View_Menu?brand_id=&lt;%=selected_brand.ID%&gt;&amp;market_id=&lt;%=market.ID%&gt;&quot;&gt;\n\t\t&lt;%=market.Name%&gt;\n\t&lt;/a&gt;\n\t&lt;/td&gt;\n\t&lt;td&gt;\n\t\t&lt;%=menu_list.count()%&gt;\n\t&lt;/td&gt;\n  &lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/table&gt;\n&lt;%\n\t\t}\n\t}\n\tif(input.brand_id != null &amp;&amp; input.market_id != null)\n\t{\n\t\tbrand_name = Brand[ID = input.brand_id].Name;\n\t\tmarket_name = Market[ID = input.market_id].Name;\n\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; viewLinkName=&apos;Menu_Mix_Report&apos; params=&quot;zc_Header=true&amp;Brand_Lookup=&lt;%=input.brand_name%&gt;&amp;Market_Lookup=&lt;%=input.market_name%&gt;&quot;&gt;Loading View...&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;style&gt;\ntable {\n  border-collapse: collapse;\n  width: 100%;\n}\n\ntd, th {\n  border: 1px solid #eeeeee;\n  text-align: left;\n  padding: 8px;\n}\n\ntr:nth-child(even) {\n  background-color: #eeeeee;\n}\n&lt;/style&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
			script
			{
				/* Write your script logic here. You can assign values to the page variables you've created in the previous tab. Enter 'input.' to list the created page variables. */
				input.lstBrands = Brand[ID != null];
			}
		}
	}


		 functions
		 {
			 Deluge
			 {
				 void checkCount()
                 {
                 	a = Request_Product[ID != 0].count();
                 	info a;
                 }
				 list getChannel(int uid)
                 {
                 	resp = List();
                 	obj = Sub_channel[Market_Lookup == uid];
                 	for each  item in obj
                 	{
                 		itemMap = Map();
                 		itemMap.put('uid',item.ID);
                 		itemMap.put('subchannel',item.Sub_channel);
                 		//
                 		marketMap = Map();
                 		marketMap.putAll({'name':item.Market_Lookup.Name,'uid':item.Market_Lookup});
                 		itemMap.put('market',marketMap);
                 		//
                 		//
                 		channelMap = Map();
                 		channelMap.putAll({'name':item.Channel_Lookup.Channel,'uid':item.Channel_Lookup});
                 		itemMap.put('channel',channelMap);
                 		//
                 		resp.add(itemMap);
                 	}
                 	return resp;
                 }
				 void syncKrispyKremeCategory(int categoryID)
                 {
                 	getRec = Item_Type[ID == categoryID && Brand == 4661594000001750007];
                 	for each  rec in getRec
                 	{
                 		referenceID = krispy_kreme.MainAppSync.syncCategory(rec.ID);
                 		if(referenceID != 0)
                 		{
                 			rec.Loyalty_Reference=referenceID;
                 		}
                 	}
                 }
				 void syncKrispyKremeKMarket(int marketID)
                 {
                 	market = Market[ID == input.marketID];
                 	referenceID = krispy_kreme.MainAppSync.syncMarket(market.ID);
                 	if(referenceID != 0)
                 	{
                 		market.Loyalty_Reference=referenceID;
                 	}
                 }
				 void syncKrispyKremeProduct(int productID)
                 {
                 	getRec = Request_Product[ID == productID && Brand_Lookup == 4661594000001750007];
                 	for each  rec in getRec
                 	{
                 		referenceID = krispy_kreme.MainAppSync.syncProductCatalog(rec.ID);
                 		if(referenceID != 0)
                 		{
                 			rec.Loyalty_Reference=referenceID;
                 		}
                 	}
                 }
				 list allItemTypeManagement.getAllItemType(String uid, Int language, int market)
                 {
                 	itemTypeList = List();
                 	userMarket = if(market != null,market,Market[Code == "UAE"].ID);
                 	itemTypes = Item_Type[Brand == toNumber(uid) && Market_item_type == market];
                 	for each  item in itemTypes
                 	{
                 		itemDetails = Map();
                 		itemDetails.put('uid',item.ID.toString());
                 		itemDetails.put('priority',item.Priority);
                 		itemDetails.put("item_type_image",krispy_kreme.PublicUrl.itemType(item.Loyalty_Reference,thisapp.fileManagement.processImageUrl(item.Item_Type_Image),1));
                 		itemDetails.put("thumbnail_image",thisapp.fileManagement.processImageUrl(item.Thumbnail_Image));
                 		itemDetails.put("loyalty_reference",item.Loyalty_Reference.toString());
                 		imageDataHome = Map();
                 		imageDataHome.put("report_name","All_Categories");
                 		imageDataHome.put("field_name","Item_Type.Item_Type_Image");
                 		imageDataHome.put("image_src",thisapp.fileManagement.processImageUrl(item.Item_Type_Image));
                 		imageDataHome.put("image_refernce_id",item.Loyalty_Reference.toString());
                 		itemDetails.put("image_home",imageDataHome);
                 		imageDataThumbnail = Map();
                 		imageDataThumbnail.put("report_name","All_Categories");
                 		imageDataThumbnail.put("field_name","Item_Type.Item_Type_Image");
                 		imageDataThumbnail.put("image_src",thisapp.fileManagement.processImageUrl(item.Thumbnail_Image));
                 		imageDataThumbnail.put("image_refernce_id",item.Loyalty_Reference.toString());
                 		itemDetails.put("image_thumbnail",imageDataThumbnail);
                 		if(language == 1)
                 		{
                 			itemDetails.put('item_type',item.Item_Type);
                 		}
                 		else
                 		{
                 			itemDetails.put('item_type',item.Item_Type_Localized);
                 		}
                 		itemTypeList.add(itemDetails);
                 	}
                 	listSize = itemTypeList.size();
                 	if(listSize > 1)
                 	{
                 		for each  index1 in itemTypeList
                 		{
                 			for each  index2 in itemTypeList
                 			{
                 				priority1 = index1.get("priority").toNumber();
                 				priority2 = index2.get("priority").toNumber();
                 				if(priority1 < priority2)
                 				{
                 					temp = index1;
                 					index1.putAll(index2);
                 					index2.putAll(temp);
                 				}
                 			}
                 		}
                 	}
                 	return itemTypeList;
                 }
				 list apiEndPoints.main(Map requestParams)
                 {
                 	action = toNumber(requestParams.get('action'));
                 	resp = List();
                 	try 
                 	{
                 		if(action == 1)
                 		{
                 			data = requestParams.get('data');
                 			if(data == null)
                 			{
                 				throws 'data is null';
                 			}
                 			modifiertype_uid = data.get('modifiertype_uid');
                 			if(modifiertype_uid == null)
                 			{
                 				throws 'modifiertype_uid is null';
                 			}
                 			resp = thisapp.modifiersManagement.getModifiersDetailByid(modifiertype_uid);
                 		}
                 		if(action == 2)
                 		{
                 			resp = thisapp.modifiersManagement.getAllModifiers();
                 		}
                 		if(action == 3)
                 		{
                 			resp = thisapp.statusManagement.getAllStatus();
                 		}
                 		if(action == 4)
                 		{
                 			resp = thisapp.serveTypesManagement.getAllServeTypes();
                 		}
                 		if(action == 5)
                 		{
                 			resp = thisapp.channelsManagement.getAllChannels();
                 		}
                 		if(action == 6)
                 		{
                 			// getAllBrands
                 			resp = thisapp.brandsManagement.getAllBrands();
                 		}
                 		if(action == 7)
                 		{
                 			// getSizeMasterById
                 			data = requestParams.get('data');
                 			if(data == null)
                 			{
                 				throws 'data is null';
                 			}
                 			brand_uid = data.get('brand_uid');
                 			if(brand_uid == null)
                 			{
                 				throws 'brand_uid is null';
                 			}
                 			resp = thisapp.sizeMasterManagement.getSizeMasterById(brand_uid);
                 		}
                 		if(action == 8)
                 		{
                 			// getChannel
                 			data = requestParams.get('data');
                 			if(data == null)
                 			{
                 				throws 'data is null';
                 			}
                 			market_uid = data.get('market_uid');
                 			if(market_uid == null)
                 			{
                 				throws 'market_uid is null';
                 			}
                 			resp = thisapp.getChannel(market_uid);
                 		}
                 		// Required
                 		if(action == 9)
                 		{
                 			// getAllMarkets
                 			data = requestParams.get('data');
                 			if(data == null)
                 			{
                 				throws 'data is null';
                 			}
                 			brand_uid = data.get('brand_uid');
                 			if(brand_uid == null)
                 			{
                 				throws 'brand_uid is null';
                 			}
                 			resp = thisapp.marketManagement.getAllMarkets(brand_uid);
                 		}
                 		if(action == 10)
                 		{
                 			// getAllItemType
                 			data = requestParams.get('data');
                 			if(data == null)
                 			{
                 				throws 'data is null';
                 			}
                 			brand_uid = data.get('brand_uid');
                 			if(brand_uid == null)
                 			{
                 				throws 'brand_uid is null';
                 			}
                 			language = data.get('language');
                 			if(language == null)
                 			{
                 				language = 2;
                 			}
                 			resp = thisapp.allItemTypeManagement.getAllItemType(brand_uid,language,null);
                 		}
                 		if(action == 11)
                 		{
                 			// getProductDetailView
                 			data = requestParams.get('data');
                 			if(data == null)
                 			{
                 				throws 'data is null';
                 			}
                 			product_uid = data.get('product_uid');
                 			if(product_uid == null)
                 			{
                 				throws 'invalid data';
                 			}
                 			resp = thisapp.productManagement.getProductDetailView(product_uid);
                 		}
                 		if(action == 12)
                 		{
                 			// getAllProducts
                 			data = requestParams.get('data');
                 			if(data == null)
                 			{
                 				throws 'data is null';
                 			}
                 			brand_uid = data.get('brand_uid');
                 			market_uid = data.get('market_uid');
                 			channel_uid = data.get('channel_uid');
                 			store_id = data.get('store_id');
                 			if(brand_uid == null || market_uid == null || channel_uid == null || store_id == null)
                 			{
                 				throws 'is null';
                 			}
                 			resp = thisapp.productManagement.getAllProducts(brand_uid,market_uid,channel_uid,store_id);
                 		}
                 	}
                 	catch (e)
                 	{
                 		thisapp.ErrorHandling.catchCall("main",e);
                 		// info e.lineNo; 
                 		// info e.message;
                 		// info e; 
                 		err = Map();
                 		err.put('error',true);
                 		resp.add(err);
                 	}
                 	return resp;
                 }
