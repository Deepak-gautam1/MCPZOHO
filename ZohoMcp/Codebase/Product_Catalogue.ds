		form Price_Change_Request
		{
			displayname = "Request"
			success message = "Price Change Request Added Successfully"
			Search
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Market_Lookup
			(
				type = picklist	
				displayname = "Market"
				values  = Market.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = small
			)
			must have Item_Name
			(
				type = picklist	
				displayname = "Item Name"
				values  = Request_Product[Brand_Lookup.ID == input.Brand_Lookup && Market_Lookup.ID == input.Market_Lookup].ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = small
			)
			must have Brand_Lookup
			(
				type = picklist	
				displayname = "Brand"
				values  = Brand[Market_Lookup.ID == input.Market_Lookup].ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = small
			)
			Currency
			(
    			type = text
	 			row = 1
	 			column = 2   
				width = small
			)
			Detail
			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Edit_By
			(
				type = radiobuttons
				displayname = "Edit By"
				maxchar = 100
				values = {"By Base Price","By Size"}
				layout = 2
    			description
    			[
    				type = tooltip
    			 	message = "Price change will be Based on Base price or Size"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Size_Lookup
			(
				type = picklist	
				displayname = "Size"
				values  = Size.ID
    			displayformat = [Size]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = small
			)
			must have Current_Price
			(
    			type = text
				displayname = "Current Price"
	 			row = 2
	 			column = 1   
				width = small
			)
			must have New_Price
			(
				type = decimal
				displayname = "New Price"
	 			row = 2
	 			column = 1   
				width = small
			)
			must have Effective_Date
			(
    			type = date
				displayname = "Effective Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = small
			)
			Comments
			(
    			type = textarea
				height = 100px
	 			row = 2
	 			column = 2   
				width = small
			)
			Details
			(
				type = section
	 			row = 3
	 			column = 0   
				width = medium
			)
			Comments_by_Mentor
			(
    			type = richtext
				displayname = "Comments by Mentor"
				height = 50px
				toolbar = disable
				private = true
	 			row = 3
	 			column = 1   
				width = small
			)
			Action_date
			(
    			type = datetime
				displayname = "Action date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
				private = true
	 			row = 3
	 			column = 1   
				width = small
			)
			Action_By
			(
    			type = text
				displayname = "Action By"
				private = true
	 			row = 3
	 			column = 1   
				width = small
			)
			Source
			(
    			type = text
				private = true
	 			row = 3
	 			column = 1   
				width = small
			)
			Request_Status
			(
				type = picklist
				displayname = "Status"
				maxchar = 100
				values = {"Approved","Rejected","Pending"}
				initial value = "Pending"
				private = true
	 			row = 3
	 			column = 2   
				width = small
			)
			Requested_Day_Count
			(
    			type = text
				displayname = "Requested Day Count"
				private = true
	 			row = 3
	 			column = 2   
				width = small
			)
			isDone
			(
    			type = checkbox
				initial value = false
				private = true
	 			row = 3
	 			column = 2   
				width = medium
			)
			Section
			(
				type = section
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Price_Change_Request
			(
				type = picklist	
				displayname = "Request"
				values  = Price_Change_Request.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Request_Product
		{
