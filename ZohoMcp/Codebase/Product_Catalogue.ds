				 list productManagement.getProductDetailView(String product_uid)
                 {
                 	responseList = List();
                 	productItem = Request_Product[ID == toNumber(product_uid)];
                 	productDetailsMap = Map();
                 	productDetailsMap.put('id',productItem.ID.toString());
                 	productDetailsMap.put('product_name',productItem.Name);
                 	productDetailsMap.put('product_description',productItem.Description);
                 	productDetailsMap.put('have_size',productItem.Item_Type_Lookup.Have_size);
                 	productDetailsMap.put('price',productItem.Price);
                 	productDetailsMap.put('item_type',productItem.Item_Type_Lookup.Item_Type);
                 	productDetailsMap.put('item_type_id',productItem.Item_Type_Lookup.ID.toString());
                 	productDetailsMap.put('rating',4.2);
                 	productDetailsMap.put('time',"15 min");
                 	productDetailsMap.put('link_id',productItem.Link_ID);
                 	productDetailsMap.put('additional_specifications',productItem.additional_specifications);
                 	productDetailsMap.put('currency',productItem.Market_Lookup.Currency_Lookup.Symbol);
                 	productDetailsMap.put('image',thisapp.fileManagement.processImageUrl(productItem.Image_Mobile));
                 	// modifiers
                 	modifierGroupsList = List();
                 	i = 1;
                 	//// modifiers - size
                 	sizeDetailsMap = Map();
                 	sizeValuesList = List();
                 	sizeDetailsMap.put("modifier_id",productItem.ID.toString());
                 	sizeDetailsMap.put("modifier_name","Size");
                 	sizeDetailsMap.put("selection_type",1);
                 	sizeDetailsMap.put("maximum_selection",1);
                 	sizeDetailsMap.put("priority",i);
                 	sizeDetailsMap.put("is_mandatory",true);
                 	for each  SizeLookupItem in productItem.Size_Subform
                 	{
                 		sizeLookupItemMap = Map();
                 		sizeLookupItemMap.put("id",SizeLookupItem.ID.toString());
                 		sizeLookupItemMap.put("name",SizeLookupItem.Size_Lookup.Size);
                 		sizeLookupItemMap.put("price",SizeLookupItem.Price);
                 		sizeDetailsMap.put("link_id",SizeLookupItem.Link_ID);
                 		sizeLookupItemMap.put("image",thisapp.fileManagement.processImageUrl(SizeLookupItem.Image));
                 		sizeValuesList.add(sizeLookupItemMap);
                 	}
                 	i = i + 1;
                 	sizeDetailsMap.put("values",sizeValuesList);
                 	modifierGroupsList.add(sizeDetailsMap);
                 	// 	
                 	//// modifiers - subform
                 	for each  modifier in productItem.Modifiers_Subform
                 	{
                 		modifierDetailsMap = Map();
                 		modifierValuesList = List();
                 		modifierDetailsMap.put("modifier_id",modifier.Modifier_Type_Lookup.ID.toString());
                 		modifierDetailsMap.put("modifier_name",modifier.Modifier_Type_Lookup.Name);
                 		modifierDetailsMap.put("selection_type",modifier.Selection_Type);
                 		modifierDetailsMap.put("maximum_selection",modifier.Choices);
                 		modifierDetailsMap.put("priority",i);
                 		modifierDetailsMap.put("is_mandatory",modifier.Mandatory);
                 		if(modifier.Selection_Type == 2)
                 		{
                 			modifierDetailsMap.put("quantity_adjuster",modifier.Quantity_Selector);
                 		}
                 		for each  ModifierLookupItem in modifier.Modifiers_Lookup
                 		{
                 			modifierLookupItemMap = Map();
                 			modifierLookupItemMap.put("id",ModifierLookupItem.ID.toString());
                 			modifierLookupItemMap.put("name",ModifierLookupItem.Name);
                 			if(modifier.Alternate_Price == true)
                 			{
                 				modifierLookupItemMap.put("price",ModifierLookupItem.Alternate_Price);
                 			}
                 			else
                 			{
                 				modifierLookupItemMap.put("price",ModifierLookupItem.Price);
                 			}
                 			modifierLookupItemMap.put("image",thisapp.fileManagement.processImageUrl(ModifierLookupItem.Image));
                 			modifierLookupItemMap.put("loyalty_reference",ifnull(ModifierLookupItem.Loyalty_Reference.toString(),""));
                 			modifierValuesList.add(modifierLookupItemMap);
                 		}
                 		i = i + 1;
                 		modifierDetailsMap.put("values",modifierValuesList);
                 		modifierGroupsList.add(modifierDetailsMap);
                 	}
                 	////
                 	productDetailsMap.put("modifiers",modifierGroupsList);
                 	// 	
                 	// tags
                 	tagsList = List();
                 	for each  tag in productItem.Tags_Lookup
                 	{
                 		tagDetailsMap = Map();
                 		tagDetailsMap.put("id",tag.ID.toString());
                 		tagDetailsMap.put("name",tag.Name);
                 		tagsList.add(tagDetailsMap);
                 	}
                 	productDetailsMap.put("tags",tagsList);
                 	//
                 	responseList.add(productDetailsMap);
                 	return responseList;
                 }
