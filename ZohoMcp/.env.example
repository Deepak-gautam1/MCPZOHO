# ---------------------------------------------------------------------------
# peetsmcp - Zoho Creator MCP server configuration
#
# Copy to .env for local experimentation, or paste these keys into the "env"
# block of your Claude Desktop MCP config (see README.md). The server itself
# does not load .env files - it reads process.env directly - so for Claude
# Desktop the values must live in the config's env block.
#
# Never commit real values. .env is gitignored; .env.example is not.
# ---------------------------------------------------------------------------

# --- OAuth credentials (Zoho API Console: https://api-console.zoho.com) ------

# Client ID of your Self Client.
# Create one at https://api-console.zoho.com -> ADD CLIENT -> Self Client.
# Self Client is the right flow here: it is app-to-app, with no redirect URI,
# which is what a local MCP server needs.
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Client Secret shown next to the Client ID on the same Self Client screen.
ZOHO_CLIENT_SECRET=your_client_secret_here

# Long-lived refresh token. You do NOT get this from the console directly:
# generate a short-lived grant token (Self Client -> Generate Code) and then
# exchange it once via curl for a refresh token. Full steps in README.md.
# It does not expire on a timer, but is revoked if you delete the client or
# revoke it in the Zoho console.
ZOHO_REFRESH_TOKEN=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Creator app identity ----------------------------------------------------

# Account owner name. Read it out of your Creator app URL:
#   https://creator.zoho.com/appbuilder/{ACCOUNT_OWNER}/{APP_LINK_NAME}/...
# It is usually your org or personal Creator handle, not your email address.
ZOHO_ACCOUNT_OWNER=your_account_owner_name

# Optional default application link name, also from the app URL (the segment
# after the account owner). When set, tool calls may omit appLinkName. Leave
# blank if you work across several apps and always want to pass it explicitly.
ZOHO_APP_LINK_NAME=your_app_link_name

# --- Data centre domains -----------------------------------------------------
#
# Zoho is regional: your credentials only work in the data centre that issued
# them. Both domains below must point at the SAME region. If token refresh
# returns "invalid_client" or "invalid_code", a region mismatch is the usual
# cause. Check the domain in the URL bar while signed in to Zoho.
#
#   Region          ZOHO_ACCOUNTS_DOMAIN            ZOHO_API_DOMAIN
#   -------------   -----------------------------   ------------------------------
#   US (default)    https://accounts.zoho.com       https://creator.zoho.com
#   India           https://accounts.zoho.in        https://creator.zoho.in
#   Europe          https://accounts.zoho.eu        https://creator.zoho.eu
#   Australia       https://accounts.zoho.com.au    https://creator.zoho.com.au
#   Japan           https://accounts.zoho.jp        https://creator.zoho.jp
#   Canada          https://accounts.zohocloud.ca   https://creator.zohocloud.ca
#   Saudi Arabia    https://accounts.zoho.sa        https://creator.zoho.sa

# OAuth token endpoint host. Optional; defaults to https://accounts.zoho.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# Creator REST API host. Optional; defaults to https://creator.zoho.com
# Some accounts are served from the unified API host instead
# (https://www.zohoapis.com and its regional variants) - if calls 404 against
# creator.zoho.*, try the zohoapis host for your region here.
ZOHO_API_DOMAIN=https://creator.zoho.com

# --- Exports -------------------------------------------------------------------

# Folder that zoho_creator_get_all_records writes to when called with saveAs.
# Optional; defaults to <system temp>/zoho-mcp-exports.
# ZOHO_EXPORT_DIR=
